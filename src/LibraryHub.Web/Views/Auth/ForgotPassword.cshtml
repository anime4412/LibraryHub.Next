@model ForgotPasswordInput
@{ ViewData["Title"] = "Quên mật khẩu"; }
<section class="auth-shell shell">
    <div class="auth-aside">
        <span class="eyebrow">Khôi phục tài khoản</span>
        <h1>Đặt lại mật khẩu an toàn.</h1>
        <p>Nhập email đã đăng ký. LibraryHub chỉ gửi liên kết khi tài khoản hợp lệ và dịch vụ email hoạt động.</p>
    </div>
    <form class="auth-card" method="post" asp-action="ForgotPassword">
        <h2>Quên mật khẩu</h2>
        <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
        <label>Email<input asp-for="Email" autocomplete="email" autofocus /></label>
        <span asp-validation-for="Email" class="field-error"></span>
        <button class="button" type="submit">Gửi liên kết đặt lại mật khẩu</button>
        <div class="auth-links"><a href="/login">Quay lại đăng nhập</a></div>
    </form>
</section>
