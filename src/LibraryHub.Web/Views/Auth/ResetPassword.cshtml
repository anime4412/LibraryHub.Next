@model ResetPasswordInput
@{ ViewData["Title"] = "Đặt lại mật khẩu"; }
<section class="auth-shell shell">
    <div class="auth-aside">
        <span class="eyebrow">Bảo mật tài khoản</span>
        <h1>Tạo mật khẩu mới.</h1>
        <p>Mật khẩu mới sẽ có hiệu lực ngay sau khi cập nhật thành công.</p>
    </div>
    <form class="auth-card" method="post" asp-action="ResetPassword">
        <h2>Đặt lại mật khẩu</h2>
        <input asp-for="UserId" type="hidden" />
        <input asp-for="Token" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
        <div class="password-help">
            <strong>Yêu cầu mật khẩu</strong>
            <span>Dùng ít nhất 8 ký tự, gồm tối thiểu một chữ cái và một chữ số.</span>
        </div>
        <label>Mật khẩu mới
            <span class="password-field">
                <input asp-for="Password" autocomplete="new-password" autofocus />
                <button class="password-toggle" type="button" data-password-toggle aria-label="Hiện mật khẩu">Hiện</button>
            </span>
        </label>
        <span asp-validation-for="Password" class="field-error"></span>
        <label>Nhập lại mật khẩu mới
            <span class="password-field">
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <button class="password-toggle" type="button" data-password-toggle aria-label="Hiện mật khẩu">Hiện</button>
            </span>
        </label>
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        <button class="button" type="submit">Cập nhật mật khẩu</button>
        <div class="auth-links"><a href="/login">Quay lại đăng nhập</a></div>
    </form>
</section>
