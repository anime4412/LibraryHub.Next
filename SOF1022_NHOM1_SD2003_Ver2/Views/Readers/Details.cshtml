@model SOF1022_NHOM1_SD2003_Ver2.Models.Readers

@{
    ViewData["Title"] = "Chi tiết Độc giả";
}

<div class="container-fluid py-4 px-md-5">
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-light p-3 rounded-circle text-danger shadow-sm">
                <i class="fas fa-users fa-lg"></i>
            </div>
            <div>
                <h4 class="mb-0 text-dark fw-bold">Quản lý Độc giả</h4>
                <small class="text-muted">Xem chi tiết thông tin độc giả trong hệ thống thư viện</small>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm bg-white rounded-3 overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 px-4" style="border-left: 4px solid #dc3545 !important;">
            <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-eye me-2 text-muted"></i>Chi tiết độc giả: @Model.FullName</h5>
        </div>
        <div class="card-body p-4 bg-light">
            <div class="card border-0 shadow-sm bg-white rounded-3">
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Mã độc giả</label>
                            <div class="fw-bold text-dark">@Model.ReaderCode</div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Họ và tên</label>
                            <div class="fw-bold text-primary fs-4">@Model.FullName</div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Ngày sinh</label>
                            <div class="text-dark">@Model.DateOfBirth?.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Giới tính</label>
                            <div class="text-dark">
                                @switch (Model.Genders)
                                {
                                    case SOF1022_NHOM1_SD2003_Ver2.Models.Enums.Genders.Male:
                                        <span>Nam</span>
                                        break;
                                    case SOF1022_NHOM1_SD2003_Ver2.Models.Enums.Genders.Female:
                                        <span>Nữ</span>
                                        break;
                                    default:
                                        <span>Khác</span>
                                        break;
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Số điện thoại</label>
                            <div class="text-dark">@Model.Phone</div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Email</label>
                            <div class="text-dark">@Model.Email</div>
                        </div>
                        <div class="col-md-12">
                            <label class="text-muted small fw-semibold">Địa chỉ</label>
                            <div class="text-dark">@Model.Address</div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">CMND/CCCD</label>
                            <div class="text-dark">@Model.IdentityNumber</div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Loại độc giả</label>
                            <div class="text-dark">
                                @switch (Model.ReadersType)
                                {
                                    case SOF1022_NHOM1_SD2003_Ver2.Models.Enums.ReadersType.Student:
                                        <span>Sinh viên</span>
                                        break;
                                    case SOF1022_NHOM1_SD2003_Ver2.Models.Enums.ReadersType.Teacher:
                                        <span>Giảng viên</span>
                                        break;
                                    case SOF1022_NHOM1_SD2003_Ver2.Models.Enums.ReadersType.Guest:
                                        <span>Khách</span>
                                        break;
                                    default:
                                        <span>Khác</span>
                                        break;
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Ngày đăng ký</label>
                            <div class="text-dark">@Model.RegisterDate.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Ngày hết hạn</label>
                            <div class="text-dark">@Model.ExpirationDate.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Số sách tối đa</label>
                            <div class="text-dark">@Model.MaxBorrowBooks</div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Trạng thái</label>
                            <div>
                                @if (Model.IsActive) {
                                    <span class="badge bg-success">Hoạt động</span>
                                } else {
                                    <span class="badge bg-danger">Đã khóa</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top d-flex gap-2 justify-content-end">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-danger btn-lg px-4 fs-6 rounded-2"><i class="fas fa-edit me-2"></i>Chỉnh sửa</a>
                <a asp-action="Index" class="btn btn-light border btn-lg px-4 fs-6 rounded-2 text-secondary"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
            </div>
        </div>
    </div>
</div>
