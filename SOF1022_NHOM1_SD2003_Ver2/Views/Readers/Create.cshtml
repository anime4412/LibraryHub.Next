@model SOF1022_NHOM1_SD2003_Ver2.Models.Readers

@{
    ViewData["Title"] = "Thêm Độc giả Mới";
}

<div class="container-fluid py-4 px-md-5">
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-light p-3 rounded-circle text-danger shadow-sm">
                <i class="fas fa-users fa-lg"></i>
            </div>
            <div>
                <h4 class="mb-0 text-dark fw-bold">Quản lý Độc giả</h4>
                <small class="text-muted">Thêm độc giả mới vào hệ thống thư viện</small>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm bg-white rounded-3 overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 px-4" style="border-left: 4px solid #dc3545 !important;">
            <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-plus-circle me-2 text-muted"></i>Biểu mẫu thêm độc giả mới</h5>
        </div>
        <div class="card-body p-4 bg-light">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="ReaderCode" class="form-label fw-semibold text-secondary">Mã độc giả</label>
                        <input asp-for="ReaderCode" class="form-control form-control-lg border-2 shadow-none rounded-2" placeholder="Nhập mã độc giả..." />
                        <span asp-validation-for="ReaderCode" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label fw-semibold text-secondary">Họ và tên</label>
                        <input asp-for="FullName" class="form-control form-control-lg border-2 shadow-none rounded-2" placeholder="Nhập họ và tên..." />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DateOfBirth" class="form-label fw-semibold text-secondary">Ngày sinh</label>
                        <input asp-for="DateOfBirth" class="form-control form-control-lg border-2 shadow-none rounded-2" type="date" />
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Genders" class="form-label fw-semibold text-secondary">Giới tính</label>
                        <select asp-for="Genders" class="form-select form-select-lg border-2 shadow-none rounded-2">
                            <option value="">-- Chọn giới tính --</option>
                            <option value="Male">Nam</option>
                            <option value="Female">Nữ</option>
                            <option value="Other">Khác</option>
                        </select>
                        <span asp-validation-for="Genders" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold text-secondary">Số điện thoại</label>
                        <input asp-for="Phone" class="form-control form-control-lg border-2 shadow-none rounded-2" placeholder="Nhập số điện thoại..." />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold text-secondary">Email</label>
                        <input asp-for="Email" class="form-control form-control-lg border-2 shadow-none rounded-2" placeholder="Nhập email..." />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Address" class="form-label fw-semibold text-secondary">Địa chỉ</label>
                        <input asp-for="Address" class="form-control form-control-lg border-2 shadow-none rounded-2" placeholder="Nhập địa chỉ..." />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="IdentityNumber" class="form-label fw-semibold text-secondary">CMND/CCCD</label>
                        <input asp-for="IdentityNumber" class="form-control form-control-lg border-2 shadow-none rounded-2" placeholder="Nhập số CMND/CCCD..." />
                        <span asp-validation-for="IdentityNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ReadersType" class="form-label fw-semibold text-secondary">Loại độc giả</label>
                        <select asp-for="ReadersType" class="form-select form-select-lg border-2 shadow-none rounded-2">
                            <option value="">-- Chọn loại độc giả --</option>
                            <option value="Student">Sinh viên</option>
                            <option value="Teacher">Giảng viên</option>
                            <option value="Staff">Nhân viên</option>
                            <option value="Other">Khác</option>
                        </select>
                        <span asp-validation-for="ReadersType" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="RegisterDate" class="form-label fw-semibold text-secondary">Ngày đăng ký</label>
                        <input asp-for="RegisterDate" class="form-control form-control-lg border-2 shadow-none rounded-2" type="date" />
                        <span asp-validation-for="RegisterDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ExpirationDate" class="form-label fw-semibold text-secondary">Ngày hết hạn</label>
                        <input asp-for="ExpirationDate" class="form-control form-control-lg border-2 shadow-none rounded-2" type="date" />
                        <span asp-validation-for="ExpirationDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MaxBorrowBooks" class="form-label fw-semibold text-secondary">Số sách tối đa</label>
                        <input asp-for="MaxBorrowBooks" class="form-control form-control-lg border-2 shadow-none rounded-2" placeholder="Nhập số sách tối đa..." />
                        <span asp-validation-for="MaxBorrowBooks" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="IsActive" class="form-label fw-semibold text-secondary">Trạng thái</label>
                        <div class="form-check mt-2">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">Đang hoạt động</label>
                        </div>
                        <span asp-validation-for="IsActive" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Avatar" class="form-label fw-semibold text-secondary">Link ảnh đại diện</label>
                        <input asp-for="Avatar" class="form-control form-control-lg border-2 shadow-none rounded-2" placeholder="Nhập link ảnh đại diện..." />
                        <span asp-validation-for="Avatar" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-5 pt-3 border-top d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-light border btn-lg px-4 fs-6 rounded-2 text-secondary"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
                    <button type="submit" class="btn btn-danger btn-lg px-5 fs-6 rounded-2 shadow-sm"><i class="fas fa-save me-2"></i>Lưu dữ liệu</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
