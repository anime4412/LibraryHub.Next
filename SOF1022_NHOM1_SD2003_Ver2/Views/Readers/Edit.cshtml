@model SOF1022_NHOM1_SD2003_Ver2.Models.Readers

@{
    ViewData["Title"] = "Chỉnh sửa Độc giả";
}

<div class="container-fluid py-4 px-md-5">
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-light p-3 rounded-circle text-danger shadow-sm">
                <i class="fas fa-users fa-lg"></i>
            </div>
            <div>
                <h4 class="mb-0 text-dark fw-bold">Quản lý Độc giả</h4>
                <small class="text-muted">Cập nhật thông tin độc giả trong hệ thống thư viện</small>
            </div>
        </div>
    </div>

    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Password" />
        <input type="hidden" asp-for="ExpirationDate" id="ExpirationDateHidden" />
        <input type="hidden" asp-for="MaxBorrowBooks" id="MaxBorrowBooksHidden" />

        <!-- SECTION 1: THÔNG TIN CÁ NHÂN -->
        <div class="card border-0 shadow-sm bg-white rounded-3 overflow-hidden mb-4">
            <div class="card-header bg-white border-bottom py-3 px-4" style="border-left: 4px solid #0d6efd !important;">
                <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-user me-2 text-muted"></i>Thông tin cá nhân</h5>
            </div>
            <div class="card-body p-4 bg-light">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label fw-semibold text-secondary">Họ và tên</label>
                        <input asp-for="FullName" class="form-control form-control-lg border-2 shadow-none rounded-2" placeholder="Nhập họ và tên..." />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DateOfBirth" class="form-label fw-semibold text-secondary">Ngày sinh</label>
                        <input asp-for="DateOfBirth" class="form-control form-control-lg border-2 shadow-none rounded-2" type="date" />
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Genders" class="form-label fw-semibold text-secondary">Giới tính</label>
                        <select asp-for="Genders" class="form-select form-select-lg border-2 shadow-none rounded-2">
                            <option value="">-- Chọn giới tính --</option>
                            <option value="Male">Nam</option>
                            <option value="Female">Nữ</option>
                            <option value="Other">Khác</option>
                        </select>
                        <span asp-validation-for="Genders" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold text-secondary">Số điện thoại</label>
                        <input asp-for="Phone" class="form-control form-control-lg border-2 shadow-none rounded-2" placeholder="Nhập số điện thoại..." />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold text-secondary">Email</label>
                        <input asp-for="Email" class="form-control form-control-lg border-2 shadow-none rounded-2" placeholder="Nhập email..." />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="IdentityNumber" class="form-label fw-semibold text-secondary">CMND/CCCD</label>
                        <input asp-for="IdentityNumber" class="form-control form-control-lg border-2 shadow-none rounded-2" placeholder="Nhập số CMND/CCCD..." />
                        <span asp-validation-for="IdentityNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Address" class="form-label fw-semibold text-secondary">Địa chỉ</label>
                        <input asp-for="Address" class="form-control form-control-lg border-2 shadow-none rounded-2" placeholder="Nhập địa chỉ..." />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- SECTION 2: CẤU HÌNH THẺ THƯ VIỆN -->
        <div class="card border-0 shadow-sm bg-white rounded-3 overflow-hidden mb-4">
            <div class="card-header bg-white border-bottom py-3 px-4" style="border-left: 4px solid #198754 !important;">
                <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-id-card me-2 text-muted"></i>Cấu hình Thẻ Thư viện</h5>
            </div>
            <div class="card-body p-4 bg-light">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="ReadersType" class="form-label fw-semibold text-secondary">Loại độc giả</label>
                        <select asp-for="ReadersType" class="form-select form-select-lg border-2 shadow-none rounded-2" id="ReadersTypeSelect">
                            <option value="">-- Chọn loại độc giả --</option>
                            <option value="Student">Sinh viên</option>
                            <option value="Teacher">Giảng viên</option>
                            <option value="Staff">Nhân viên</option>
                            <option value="Other">Khác</option>
                        </select>
                        <span asp-validation-for="ReadersType" class="text-danger small"></span>
                        <small class="text-muted">Hệ thống sẽ tự động tính toán ngày hết hạn và số sách tối đa dựa trên loại độc giả</small>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ReaderCode" class="form-label fw-semibold text-secondary">Mã độc giả</label>
                        <input asp-for="ReaderCode" class="form-control form-control-lg border-2 shadow-none rounded-2 bg-light" readonly />
                        <span asp-validation-for="ReaderCode" class="text-danger small"></span>
                        <small class="text-muted">Không thể thay đổi sau khi tạo</small>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary">Ngày đăng ký</label>
                        <input type="text" class="form-control form-control-lg border-2 shadow-none rounded-2 bg-light" value="@Model.RegisterDate.ToString("dd/MM/yyyy")" readonly />
                        <small class="text-muted">Ngày đăng ký gốc - Không thể thay đổi</small>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary">Ngày hết hạn</label>
                        <input type="text" class="form-control form-control-lg border-2 shadow-none rounded-2 bg-light" id="ExpirationDateDisplay" value="@Model.ExpirationDate.ToString("dd/MM/yyyy")" readonly />
                        <small class="text-muted">Tự động tính theo loại độc giả</small>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary">Số sách tối đa</label>
                        <input type="text" class="form-control form-control-lg border-2 shadow-none rounded-2 bg-light" id="MaxBorrowBooksDisplay" value="@Model.MaxBorrowBooks" readonly />
                        <small class="text-muted">Tự động tính theo loại độc giả</small>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="IsActive" class="form-label fw-semibold text-secondary">Trạng thái</label>
                        <div class="form-check mt-2">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">Đang hoạt động</label>
                        </div>
                        <span asp-validation-for="IsActive" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-5 pt-3 border-top d-flex gap-2 justify-content-between align-items-center">
            <button type="button" id="btnResetPassword" class="btn btn-warning btn-lg px-4 fs-6 rounded-2 shadow-sm">
                <i class="fas fa-key me-2"></i>Reset Mật khẩu
            </button>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-light border btn-lg px-4 fs-6 rounded-2 text-secondary"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
                <button type="submit" class="btn btn-danger btn-lg px-5 fs-6 rounded-2 shadow-sm"><i class="fas fa-save me-2"></i>Lưu thay đổi</button>
            </div>
        </div>
    </form>

    <form asp-action="ResetPassword" method="post" id="resetPasswordForm" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Handle reset password button
            document.getElementById('btnResetPassword').addEventListener('click', async function () {
                const { isConfirmed } = await Swal.fire({
                    title: 'Xác nhận',
                    text: 'Bạn có chắc chắn muốn reset mật khẩu cho độc giả này?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Huỷ'
                });
                if (isConfirmed) {
                    document.getElementById('resetPasswordForm').submit();
                }
            });

            const readersTypeSelect = document.getElementById('ReadersTypeSelect');
            const expirationDateHidden = document.getElementById('ExpirationDateHidden');
            const expirationDateDisplay = document.getElementById('ExpirationDateDisplay');
            const maxBorrowBooksHidden = document.getElementById('MaxBorrowBooksHidden');
            const maxBorrowBooksDisplay = document.getElementById('MaxBorrowBooksDisplay');
            const registerDate = new Date('@Model.RegisterDate.ToString("yyyy-MM-dd")');

            function calculateCardConfig() {
                const readerType = readersTypeSelect.value;
                let expirationDate = new Date(registerDate);
                let maxBooks = 5;

                switch (readerType) {
                    case 'Student':
                        expirationDate.setFullYear(expirationDate.getFullYear() + 1);
                        maxBooks = 5;
                        break;
                    case 'Teacher':
                        expirationDate.setFullYear(expirationDate.getFullYear() + 2);
                        maxBooks = 10;
                        break;
                    case 'Staff':
                        expirationDate.setFullYear(expirationDate.getFullYear() + 1);
                        maxBooks = 7;
                        break;
                    default:
                        expirationDate.setFullYear(expirationDate.getFullYear() + 1);
                        maxBooks = 3;
                        break;
                }

                const formattedDate = expirationDate.toLocaleDateString('vi-VN');
                expirationDateDisplay.value = formattedDate;
                expirationDateHidden.value = expirationDate.toISOString();
                maxBorrowBooksDisplay.value = maxBooks;
                maxBorrowBooksHidden.value = maxBooks;
            }

            readersTypeSelect.addEventListener('change', calculateCardConfig);

            // Initial calculation
            calculateCardConfig();
        });
    </script>
}
