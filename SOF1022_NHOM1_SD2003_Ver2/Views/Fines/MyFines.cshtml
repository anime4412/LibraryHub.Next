<script>
    document.addEventListener('DOMContentLoaded', function() {
        const fineDetailsModal = document.getElementById('fineDetailsModal');
        if (!fineDetailsModal) return;

        fineDetailsModal.addEventListener('show.bs.modal', function(event) {
            const button = event.relatedTarget;
            if (!button) return;

            const fineCode = button.getAttribute('data-fine-code');
            const bookTitle = button.getAttribute('data-book-title');
            const bookCover = button.getAttribute('data-book-cover');
            const fineAmount = button.getAttribute('data-fine-amount');
            const fineType = button.getAttribute('data-fine-type');
            const calculation = button.getAttribute('data-calculation');
            const createdDate = button.getAttribute('data-created-date');
            const dueDate = button.getAttribute('data-due-date');
            const returnedDate = button.getAttribute('data-returned-date');
            const isPaid = button.getAttribute('data-is-paid') === 'true';
            const paidDate = button.getAttribute('data-paid-date');
            const conditionAfter = button.getAttribute('data-condition-after');

            const setText = (id, value) => {
                const el = document.getElementById(id);
                if (el) el.textContent = value ?? '';
            };

            setText('fineDetailModalBookTitle', bookTitle);
            const coverEl = document.getElementById('fineDetailModalBookCover');
            if (coverEl) {
                coverEl.src = bookCover || '/images/no-book.png';
                coverEl.onerror = function() {
                    this.onerror = null;
                    this.src = '/images/no-book.png';
                };
            }
            setText('fineDetailModalFineCode', fineCode ? '#' + fineCode.replace('#', '') : '');
            setText('fineDetailModalFineType', getFineTypeText(fineType));
            setText('fineDetailModalCreatedDate', createdDate);
            setText('fineDetailModalDueDate', dueDate);
            setText('fineDetailModalReturnedDate', returnedDate);
            setText('fineDetailModalAmount', (fineAmount || '0') + ' VND');
            setText('fineDetailModalCalculation', calculation || 'Không có thông tin');

            const paymentStatusBadge = document.getElementById('fineDetailModalPaymentStatus');
            const paidDateRow = document.getElementById('fineDetailModalPaidDateRow');
            if (paymentStatusBadge) {
                if (isPaid) {
                    paymentStatusBadge.textContent = 'Đã tất toán';
                    paymentStatusBadge.className = 'badge bg-success';
                    setText('fineDetailModalPaidDate', paidDate);
                    if (paidDateRow) paidDateRow.style.display = 'flex';
                } else {
                    paymentStatusBadge.textContent = 'Chưa thanh toán';
                    paymentStatusBadge.className = 'badge bg-danger';
                    if (paidDateRow) paidDateRow.style.display = 'none';
                }
            }

            const conditionBox = document.getElementById('fineDetailModalConditionBox');
            if (conditionBox) {
                if (conditionAfter && conditionAfter !== 'N/A') {
                    setText('fineDetailModalConditionAfter', conditionAfter);
                    conditionBox.style.display = 'block';
                } else {
                    conditionBox.style.display = 'none';
                }
            }
        });

        function getFineTypeText(fineType) {
            switch (fineType) {
                case 'Late': return 'Trả muộn quá hạn';
                case 'Damaged': return 'Sách bị hư hại';
                case 'Lost': return 'Sách bị mất';
                default: return 'Khác';
            }
        }
    });
</script>