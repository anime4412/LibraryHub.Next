@model SOF1022_NHOM1_SD2003_Ver2.Models.Fines

@{
    ViewData["Title"] = "Thanh toán tiền phạt";
    var userRole = Context.Session.GetString("Role");
    var isAdmin = userRole == "Admin" || userRole == "Librarian";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-primary text-white py-3">
                    <h2 class="mb-0" style="font-family: var(--font-display); font-size: var(--text-3xl); font-weight: 600; margin-bottom: 12px;">
                        <i class="fa-solid fa-credit-card me-2"></i>Xác nhận thanh toán tiền phạt
                    </h2>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="mb-4">
                        <h3 class="text-muted mb-3" style="font-family: var(--font-sans); font-size: var(--text-xl); font-weight: 600; margin-bottom: 8px;">Thông tin khoản phạt</h3>
                        <div class="table-responsive">
                            <table class="table table-bordered">
                                <tbody>
                                    <tr>
                                        <th scope="row" style="width: 40%">Sách:</th>
                                        <td>@(Model.Books?.Title ?? Model.BorrowDetails?.Books?.Title ?? "Sách mượn thư viện")</td>
                                    </tr>
                                    <tr>
                                        <th scope="row">Lý do:</th>
                                        <td>@Model.Reason</td>
                                    </tr>
                                    @if (!string.IsNullOrEmpty(Model.BorrowDetails?.ConditionAfter))
                                    {
                                        <tr>
                                            <th scope="row">Tình trạng:</th>
                                            <td>@Model.BorrowDetails.ConditionAfter</td>
                                        </tr>
                                    }
                                    <tr>
                                        <th scope="row">Ngày lập:</th>
                                        <td>@Model.CreatedDate.ToString("dd/MM/yyyy")</td>
                                    </tr>
                                    <tr class="table-primary">
                                        <th scope="row">Số tiền phạt:</th>
                                        <td class="fw-bold fs-5">@Model.Amount.ToString("N0") VND</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <form asp-action="PayFine" method="post" class="d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        
                        <button type="submit" class="btn btn-success btn-lg flex-grow-1">
                            <i class="fa-solid fa-check-circle me-2"></i>Xác nhận thanh toán
                        </button>
                        @if (isAdmin)
                        {
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="fa-solid fa-arrow-left me-2"></i>Hủy bỏ
                            </a>
                        }
                        else
                        {
                            <a asp-action="MyFines" class="btn btn-secondary btn-lg">
                                <i class="fa-solid fa-arrow-left me-2"></i>Hủy bỏ
                            </a>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
