@model IEnumerable<SOF1022_NHOM1_SD2003_Ver2.Models.Fines>

@{
    ViewData["Title"] = "Lịch sử tiền phạt";
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h2 class="fw-bold mb-1">
                        <i class="fa-solid fa-clock-rotate-left text-primary me-2"></i>
                        Lịch sử Tiền Phạt
                    </h2>
                    <p class="text-muted mb-0">
                        Theo dõi lịch sử thanh toán các khoản phạt
                    </p>
                </div>
                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-arrow-left me-2"></i>
                        Quay lại
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- STATISTICS -->
    <div class="row g-3 mb-4">
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Tổng khoản phạt</div>
                    <h3 class="fw-bold mt-2">@Model.Count()</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Đã thanh toán</div>
                    <h3 class="fw-bold text-success mt-2">@Model.Count(m => m.IsPaid)</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Tổng tiền đã thu</div>
                    <h3 class="fw-bold text-primary mt-2">@Model.Sum(m => m.Amount).ToString("N0") VNĐ</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Phạt hư hại</div>
                    <h3 class="fw-bold text-warning mt-2">@Model.Count(m => m.DamageFine > 0)</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- HISTORY TABLE -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Lịch sử thanh toán</h5>
                <span class="text-muted">Tổng cộng @Model.Count() khoản phạt</span>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:100px">Mã phạt</th>
                        <th style="width:150px">Độc giả</th>
                        <th>Sách</th>
                        <th style="width:120px">Số tiền</th>
                        <th style="width:120px">Ngày tạo</th>
                        <th style="width:120px">Ngày thanh toán</th>
                        <th style="width:150px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <i class="fa-solid fa-inbox fa-4x text-secondary mb-3 opacity-50"></i>
                                <h5 class="fw-bold">Không có lịch sử</h5>
                                <p class="text-muted">Chưa có khoản phạt nào được thanh toán</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            var readerName = item.BorrowSlips?.Readers?.FullName ?? "N/A";
                            var bookTitle = item.Books?.Title ?? item.BorrowDetails?.Books?.Title ?? "Sách mượn thư viện";
                            var avatarLetter = !string.IsNullOrWhiteSpace(readerName) && readerName != "N/A" ? readerName.Substring(0, 1).ToUpper() : "N";

                            <tr>
                                <!-- Mã phạt -->
                                <td>
                                    <span class="badge bg-secondary">#@item.Id</span>
                                </td>

                                <!-- Độc giả -->
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold me-2" style="width:36px;height:36px;font-size:14px;">
                                            @avatarLetter
                                        </div>
                                        <div>
                                            <div class="fw-bold text-truncate" style="max-width:150px;" title="@readerName">
                                                @readerName
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Sách -->
                                <td>
                                    <div class="text-truncate" style="max-width:250px;" title="@bookTitle">
                                        <i class="fa-solid fa-book text-muted me-1"></i>
                                        @bookTitle
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.BorrowDetails?.ConditionAfter))
                                    {
                                        <small class="text-muted d-block">Tình trạng: @item.BorrowDetails.ConditionAfter</small>
                                    }
                                </td>

                                <!-- Số tiền -->
                                <td>
                                    <span class="fw-bold text-success">@item.Amount.ToString("N0") VNĐ</span>
                                </td>

                                <!-- Ngày tạo -->
                                <td>
                                    @item.CreatedDate.ToString("dd/MM/yyyy")
                                </td>

                                <!-- Ngày thanh toán -->
                                <td>
                                    @(item.PaidDate?.ToString("dd/MM/yyyy") ?? "N/A")
                                </td>

                                <!-- Thao tác -->
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm">
                                        <i class="fa-solid fa-eye me-1"></i>Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 14px;
    }
    .card-header {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border);
    }
    .table {
        margin-bottom: 0;
    }
    .table thead th {
        font-weight: 700;
        border-bottom: 2px solid var(--border);
        white-space: nowrap;
    }
    .table tbody td {
        vertical-align: middle;
    }
    .table tbody tr {
        transition: .25s ease;
    }
    .table tbody tr:hover {
        background: #f8fbff;
    }
    .btn {
        border-radius: 8px;
    }
    .badge {
        font-weight: 600;
        padding: 6px 10px;
    }
    @@media(max-width:992px) {
        .table {
            min-width: 1000px;
        }
    }
</style>
