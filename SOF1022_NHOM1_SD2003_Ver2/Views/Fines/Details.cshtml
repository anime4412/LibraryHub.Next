@model SOF1022_NHOM1_SD2003_Ver2.Models.Fines

@{
    ViewData["Title"] = "Biên bản vi phạm";
    var adminName = ViewBag.AdminName ?? "Admin";
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>
        function exportToPDF() {
            const element = document.getElementById('violation-report');
            const fineId = '@Model.Id';
            const opt = {
                margin: 10,
                filename: `Bien-ban-vi-pham-${fineId}.pdf`,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2 },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };
            html2pdf().set(opt).from(element).save();
        }
    </script>
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="fa-solid fa-file-contract me-2"></i>Biên bản vi phạm</h1>
            <p class="text-muted mb-0">Chi tiết biên bản vi phạm quy định thư viện</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="PrintReceipt" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-success">
                <i class="fa-solid fa-receipt me-2"></i>In biên lai thu tiền
            </a>
            <button onclick="window.print()" class="btn btn-outline-primary">
                <i class="fa-solid fa-print me-2"></i>In biên bản
            </button>
            <button onclick="exportToPDF()" class="btn btn-danger">
                <i class="fa-solid fa-file-pdf me-2"></i>Xuất PDF
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-left me-2"></i>Quay lại
            </a>
        </div>
    </div>

    <div class="card shadow-sm" id="violation-report">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fa-solid fa-gavel me-2"></i>BIÊN BẢN VI PHẠM QUY ĐỊNH THƯ VIỆN</h5>
        </div>
        <div class="card-body">
            <!-- THÔNG TIN CHUNG -->
            <div class="mb-4">
                <h6 class="fw-bold border-bottom pb-2 mb-3">
                    <i class="fa-solid fa-info-circle me-2 text-primary"></i>THÔNG TIN CHUNG
                </h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="text-muted small">Mã biên bản</label>
                        <div class="fw-bold">#@Model.Id</div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Mã tiền phạt</label>
                        <div class="fw-bold">FINE-@Model.Id.ToString("D6")</div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Ngày lập biên bản</label>
                        <div class="fw-bold">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Người lập biên bản</label>
                        <div class="fw-bold">@adminName</div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Mã phiếu mượn</label>
                        <div class="fw-bold">@(Model.BorrowSlips?.BorrowCode ?? "Không có dữ liệu")</div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Độc giả</label>
                        <div class="fw-bold">@(Model.BorrowSlips?.Readers?.FullName ?? "Không có dữ liệu")</div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Mã độc giả</label>
                        <div class="fw-bold">@(Model.BorrowSlips?.Readers?.ReaderCode ?? "Không có dữ liệu")</div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Trạng thái thanh toán</label>
                        <div class="fw-bold @(Model.IsPaid ? "text-success" : "text-danger")">
                            @(Model.IsPaid ? "Đã thanh toán" : "Chờ xử lý")
                        </div>
                    </div>
                </div>
            </div>

            <!-- CHI TIẾT SÁCH VI PHẠM (ITEMIZED BREAKDOWN) -->
            <div class="mb-4">
                <h6 class="fw-bold border-bottom pb-2 mb-3">
                    <i class="fa-solid fa-book me-2 text-primary"></i>CHI TIẾT SÁCH VI PHẠM
                </h6>
                
                @if (Model.FineDetails != null && Model.FineDetails.Any())
                {
                    // New consolidated fine with itemized details
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:50px">#</th>
                                    <th>Tên sách</th>
                                    <th style="width:120px">Loại vi phạm</th>
                                    <th style="width:150px">Chi tiết</th>
                                    <th style="width:120px">Giá sách</th>
                                    <th style="width:120px" class="text-end">Số tiền phạt</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (detail, index) in Model.FineDetails.Select((d, i) => (d, i + 1)))
                                {
                                    <tr>
                                        <td class="fw-bold">@index</td>
                                        <td>
                                            <div class="fw-bold">@(detail.Book?.Title ?? "Không rõ")</div>
                                            <small class="text-muted">Mã sách: @detail.BookId</small>
                                        </td>
                                        <td>
                                            @switch (detail.FinesType)
                                            {
                                                case SOF1022_NHOM1_SD2003_Ver2.Models.Enums.FinesType.Damaged:
                                                    <span class="badge bg-warning text-dark">Hư hỏng</span>
                                                    <!-- TODO: Keep text-dark here because bg-warning is a fixed light background that doesn't change with theme -->
                                                    break;
                                                case SOF1022_NHOM1_SD2003_Ver2.Models.Enums.FinesType.Lost:
                                                    <span class="badge bg-danger">Mất sách</span>
                                                    break;
                                                case SOF1022_NHOM1_SD2003_Ver2.Models.Enums.FinesType.Late:
                                                    <span class="badge bg-info">Trễ hạn</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-secondary">Khác</span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            <small class="text-muted">@detail.Reason</small>
                                            @if (detail.DamagePercent.HasValue)
                                            {
                                                <div class="small text-danger">@(detail.DamagePercent)% hư hại</div>
                                            }
                                        </td>
                                        <td>
                                            <span class="text-muted">@(detail.BookPrice?.ToString("N0") ?? "0") VNĐ</span>
                                        </td>
                                        <td class="text-end fw-bold text-danger">
                                            @detail.Amount.ToString("N0") VNĐ
                                        </td>
                                    </tr>
                                }
                                <tr class="table-primary fw-bold">
                                    <td colspan="5" class="text-end">TỔNG CỘNG</td>
                                    <td class="text-end fs-5">@Model.Amount.ToString("N0") VNĐ</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }
                else if (Model.Books != null)
                {
                    // Old single-book fine (backward compatibility)
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="text-muted small">Tên sách</label>
                            <div class="fw-bold">@Model.Books.Title</div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Tác giả</label>
                            <div class="fw-bold">@(Model.Books.Author?.Name ?? "Không có dữ liệu")</div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Thể loại</label>
                            <div class="fw-bold">@(Model.Books.Category?.Name ?? "Không có dữ liệu")</div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Giá sách</label>
                            <div class="fw-bold">@Model.Books.Price.ToString("N0") VNĐ</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="fa-solid fa-info-circle me-2"></i>Không có thông tin sách
                    </div>
                }
            </div>

            <!-- THÔNG TIN PHIẾU MƯỢN -->
            <div class="mb-4">
                <h6 class="fw-bold border-bottom pb-2 mb-3">
                    <i class="fa-solid fa-book me-2 text-primary"></i>THÔNG TIN PHIẾU MƯỢN
                </h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="text-muted small">Mã phiếu mượn</label>
                        <div class="fw-bold">@(Model.BorrowSlips?.BorrowCode ?? "Không có dữ liệu")</div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Ngày mượn</label>
                        <div class="fw-bold">@(Model.BorrowSlips?.BorrowDate.ToString("dd/MM/yyyy") ?? "Không có dữ liệu")</div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Hạn trả</label>
                        <div class="fw-bold">@(Model.BorrowSlips?.DueDate.ToString("dd/MM/yyyy") ?? "Không có dữ liệu")</div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Ngày trả thực tế</label>
                        <div class="fw-bold">@(Model.BorrowSlips?.ReturnDate?.ToString("dd/MM/yyyy") ?? "Không có dữ liệu")</div>
                    </div>
                </div>
            </div>

            <!-- NỘI DUNG VI PHẠM -->
            <div class="mb-4">
                <h6 class="fw-bold border-bottom pb-2 mb-3">
                    <i class="fa-solid fa-exclamation-triangle me-2 text-warning"></i>NỘI DUNG VI PHẠM
                </h6>
                <div class="list-group">
                    @if (Model.LateDays.HasValue && Model.LateDays > 0)
                    {
                        <div class="list-group-item list-group-item-action">
                            <div class="d-flex align-items-center">
                                <i class="fa-solid fa-check-circle text-success me-3"></i>
                                <div>
                                    <div class="fw-bold">Trả sách quá hạn</div>
                                    <small class="text-muted">Trễ @Model.LateDays ngày</small>
                                </div>
                            </div>
                        </div>
                    }
                    @if (Model.DamageFine.HasValue && Model.DamageFine > 0)
                    {
                        <div class="list-group-item list-group-item-action">
                            <div class="d-flex align-items-center">
                                <i class="fa-solid fa-check-circle text-success me-3"></i>
                                <div>
                                    <div class="fw-bold">Sách bị hư hại</div>
                                    <small class="text-muted">Tổng tiền hư hại: @Model.DamageFine.Value.ToString("N0") VNĐ</small>
                                </div>
                            </div>
                        </div>
                    }
                    @if (Model.LostFine.HasValue && Model.LostFine > 0)
                    {
                        <div class="list-group-item list-group-item-action">
                            <div class="d-flex align-items-center">
                                <i class="fa-solid fa-check-circle text-success me-3"></i>
                                <div>
                                    <div class="fw-bold">Sách bị mất</div>
                                    <small class="text-muted">Tổng tiền mất sách: @Model.LostFine.Value.ToString("N0") VNĐ</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- CHI TIẾT MỨC ĐỘ VI PHẠM -->
            @if (Model.DamagePercent.HasValue)
            {
                <div class="mb-4">
                    <h6 class="fw-bold border-bottom pb-2 mb-3">
                        <i class="fa-solid fa-chart-pie me-2 text-primary"></i>CHI TIẾT MỨC ĐỘ VI PHẠM
                    </h6>
                    <div class="alert alert-info">
                        <div class="row">
                            <div class="col-md-4">
                                <label class="text-muted small">Phần trăm hư hại:</label>
                                <div class="fw-bold fs-5">@Model.DamagePercent%</div>
                            </div>
                            <div class="col-md-4">
                                <label class="text-muted small">Kết luận:</label>
                                <div class="fw-bold">
                                    @if (Model.DamagePercent >= 80)
                                    {
                                        <span class="text-danger">Nghiêm trọng</span>
                                    }
                                    else if (Model.DamagePercent >= 50)
                                    {
                                        <span class="text-warning">Vượt mức cho phép</span>
                                    }
                                    else
                                    {
                                        <span class="text-success">Nhẹ</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- ĐIỀU KHOẢN VI PHẠM -->
            <div class="mb-4">
                <h6 class="fw-bold border-bottom pb-2 mb-3">
                    <i class="fa-solid fa-scale-balanced me-2 text-primary"></i>CĂN CỨ XỬ LÝ
                </h6>
                <div class="alert alert-secondary">
                    <ol class="mb-0 ps-3">
                        <li class="mb-2">Độc giả có trách nhiệm bảo quản sách trong suốt thời gian mượn.</li>
                        <li class="mb-2">Không được làm rách, viết, vẽ hoặc gây hư hỏng tài liệu.</li>
                        <li class="mb-2">Nếu mức độ hư hại từ 50% trở lên sẽ áp dụng mức bồi thường theo quy định của thư viện.</li>
                        <li class="mb-2">Nếu mức độ hư hại từ 80% trở lên hoặc sách không còn khả năng sử dụng thì độc giả phải bồi thường toàn bộ giá trị cuốn sách.</li>
                        <li class="mb-2">Nếu làm mất sách, độc giả phải bồi thường toàn bộ giá trị của cuốn sách.</li>
                        <li class="mb-2">Độc giả trả sách quá hạn sẽ chịu phí 5.000 VNĐ cho mỗi ngày trễ.</li>
                        <li>Nếu đồng thời vi phạm nhiều lỗi (ví dụ: hư hại và trả muộn, hoặc mất sách và trả muộn), tổng tiền phạt sẽ là tổng của các khoản vi phạm.</li>
                    </ol>
                </div>
            </div>

            <!-- CHI TIẾT TÍNH TIỀN -->
            <div class="mb-4">
                <h6 class="fw-bold border-bottom pb-2 mb-3">
                    <i class="fa-solid fa-calculator me-2 text-primary"></i>CHI TIẾT TÍNH TIỀN
                </h6>
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Khoản mục</th>
                                <th class="text-end">Số tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.DamageFine.HasValue && Model.DamageFine > 0)
                            {
                                <tr>
                                    <td>Tiền hư hại (@Model.DamagePercent%)</td>
                                    <td class="text-end fw-bold">@Model.DamageFine.Value.ToString("N0") VNĐ</td>
                                </tr>
                            }
                            @if (Model.LostFine.HasValue && Model.LostFine > 0)
                            {
                                <tr>
                                    <td>Tiền mất sách</td>
                                    <td class="text-end fw-bold">@Model.LostFine.Value.ToString("N0") VNĐ</td>
                                </tr>
                            }
                            @if (Model.LateFine.HasValue && Model.LateFine > 0)
                            {
                                <tr>
                                    <td>Tiền trả muộn (@Model.LateDays ngày)</td>
                                    <td class="text-end fw-bold">@Model.LateFine.Value.ToString("N0") VNĐ</td>
                                </tr>
                            }
                            <tr class="table-primary">
                                <td class="fw-bold">TỔNG CỘNG</td>
                                <td class="text-end fw-bold fs-5">@Model.Amount.ToString("N0") VNĐ</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TRẠNG THÁI THANH TOÁN -->
            <div class="mb-4">
                <h6 class="fw-bold border-bottom pb-2 mb-3">
                    <i class="fa-solid fa-credit-card me-2 text-primary"></i>TRẠNG THÁI THANH TOÁN
                </h6>
                <div class="alert @(Model.IsPaid ? "alert-success" : "alert-warning")">
                    <div class="d-flex align-items-center">
                        <i class="fa-solid fa-circle-check fa-2x me-3 @(Model.IsPaid ? "text-success" : "text-warning")"></i>
                        <div>
                            <div class="fw-bold fs-5">@(Model.IsPaid ? "Đã thanh toán" : "Chờ xử lý")</div>
                            @if (Model.IsPaid && Model.PaidDate.HasValue)
                            {
                                <small class="text-muted">Ngày thanh toán: @Model.PaidDate.Value.ToString("dd/MM/yyyy HH:mm")</small>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- KẾT LUẬN BIÊN BẢN -->
            <div class="mb-4">
                <div class="alert alert-primary">
                    <div class="d-flex align-items-start">
                        <i class="fa-solid fa-file-signature fa-2x me-3 mt-1"></i>
                        <div>
                            <div class="fw-bold mb-2">KẾT LUẬN BIÊN BẢN</div>
                            <p class="mb-0">
                                Kết quả kiểm tra xác nhận độc giả đã vi phạm các quy định của thư viện như đã nêu ở trên. 
                                Tiền bồi thường được tính theo quy định hiện hành của thư viện và được lưu vào hệ thống quản lý.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CHỮ KÝ -->
            <div class="row mt-5 pt-4 border-top">
                <div class="col-md-6 text-center">
                    <div class="mb-3" style="height: 80px;"></div>
                    <div class="fw-bold border-top pt-2">Người lập biên bản</div>
                    <small class="text-muted">(@adminName)</small>
                </div>
                <div class="col-md-6 text-center">
                    <div class="mb-3" style="height: 80px;"></div>
                    <div class="fw-bold border-top pt-2">Độc giả xác nhận</div>
                    <small class="text-muted">(@(Model.BorrowSlips?.Readers?.FullName ?? "........................."))</small>
                </div>
            </div>
        </div>
        <div class="card-footer text-muted small">
            <i class="fa-solid fa-clock me-1"></i>Biên bản được tạo tự động bởi hệ thống quản lý thư viện
        </div>
    </div>
</div>

<style>
    @@media print {
        body * {
            visibility: hidden;
        }
        #violation-report, #violation-report * {
            visibility: visible;
        }
        #violation-report {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            box-shadow: none !important;
        }
        .btn, .d-flex.justify-content-between {
            display: none !important;
        }
    }
</style>
