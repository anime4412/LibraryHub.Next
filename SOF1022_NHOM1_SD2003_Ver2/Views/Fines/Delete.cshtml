        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BorrowSlipId)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Amount)
