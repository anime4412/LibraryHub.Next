@model SOF1022_NHOM1_SD2003_Ver2.Models.Fines
@{
    Layout = null;
    var reader = Model.BorrowSlips?.Readers;
    var borrowSlip = Model.BorrowSlips;
    var incidentCount = Model.FineDetails?.Count ?? 0;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Biên lai thu tiền phạt #@Model.Id - Thư viện điện tử</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: 'Inter', sans-serif;
            background: #eef2f6;
            color: #1e293b;
            padding: 30px 15px;
            display: flex;
            justify-content: center;
        }
        .receipt-card {
            background: #ffffff;
            width: 100%;
            max-width: 720px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            padding: 40px;
            position: relative;
        }
        .no-print-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 1px dashed #cbd5e1;
        }
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 18px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 8px;
            text-decoration: none;
            cursor: pointer;
            border: none;
            transition: 0.2s ease;
        }
        .btn-print {
            background: #0ea5e9;
            color: #fff;
        }
        .btn-print:hover {
            background: #0284c7;
        }
        .btn-back {
            background: #f1f5f9;
            color: #475569;
        }
        .btn-back:hover {
            background: #e2e8f0;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 30px;
        }
        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .brand-icon {
            width: 48px;
            height: 48px;
            background: #0ea5e9;
            color: #fff;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }
        .brand-name {
            font-size: 18px;
            font-weight: 700;
            color: #0f172a;
        }
        .brand-sub {
            font-size: 12px;
            color: #64748b;
        }
        .receipt-title {
            text-align: right;
        }
        .receipt-title h2 {
            font-size: 20px;
            color: #0f172a;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .receipt-code {
            font-family: monospace;
            font-size: 14px;
            color: #0284c7;
            font-weight: 700;
            margin-top: 4px;
        }
        .status-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            margin-top: 6px;
        }
        .status-paid {
            background: #dcfce7;
            color: #15803d;
        }
        .status-unpaid {
            background: #fee2e2;
            color: #b91c1c;
        }
        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            background: #f8fafc;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 25px;
        }
        .info-group label {
            display: block;
            font-size: 11px;
            font-weight: 600;
            color: #64748b;
            text-transform: uppercase;
            margin-bottom: 4px;
        }
        .info-group span {
            font-size: 14px;
            font-weight: 600;
            color: #0f172a;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 25px;
        }
        table th {
            background: #f1f5f9;
            text-align: left;
            padding: 12px 14px;
            font-size: 12px;
            font-weight: 700;
            color: #475569;
            text-transform: uppercase;
        }
        table td {
            padding: 12px 14px;
            border-bottom: 1px solid #f1f5f9;
            font-size: 13px;
        }
        .total-box {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 35px;
        }
        .total-row {
            width: 280px;
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            font-size: 14px;
        }
        .total-row.grand {
            border-top: 2px solid #0f172a;
            font-size: 18px;
            font-weight: 800;
            color: #0f172a;
            padding-top: 12px;
        }
        .signatures {
            display: grid;
            grid-template-columns: 1fr 1fr;
            text-align: center;
            margin-top: 30px;
            padding-top: 20px;
        }
        .sig-title {
            font-size: 13px;
            font-weight: 700;
            color: #334155;
            margin-bottom: 60px;
        }
        .sig-name {
            font-size: 13px;
            font-weight: 600;
            color: #0f172a;
        }
        .footer-note {
            text-align: center;
            margin-top: 40px;
            padding-top: 15px;
            border-top: 1px solid #e2e8f0;
            font-size: 11px;
            color: #94a3b8;
        }
        @@media print {
            body {
                background: #fff;
                padding: 0;
            }
            .receipt-card {
                box-shadow: none;
                border: none;
                padding: 0;
                max-width: 100%;
            }
            .no-print-bar {
                display: none !important;
            }
        }
    </style>
</head>
<body>

<div class="receipt-card">
    <div class="no-print-bar">
        <a href="javascript:history.back()" class="btn btn-back">
            <i class="fa-solid fa-arrow-left"></i> Quay lại
        </a>
        <button onclick="window.print()" class="btn btn-print">
            <i class="fa-solid fa-print"></i> In biên lai (Print)
        </button>
    </div>

    <div class="header">
        <div class="brand">
            <div class="brand-icon">
                <i class="fa-solid fa-book-open"></i>
            </div>
            <div>
                <div class="brand-name">THƯ VIỆN ĐIỆN TỬ</div>
                <div class="brand-sub">Bộ phận Quản lý & Thu phí Thư viện</div>
            </div>
        </div>
        <div class="receipt-title">
            <h2>Biên lai thu phạt</h2>
            <div class="receipt-code">PHIẾU #@Model.Id</div>
            @if (Model.IsPaid)
            {
                <span class="status-badge status-paid"><i class="fa-solid fa-circle-check"></i> ĐÃ THANH TOÁN</span>
            }
            else
            {
                <span class="status-badge status-unpaid"><i class="fa-solid fa-clock"></i> CHƯA THANH TOÁN</span>
            }
        </div>
    </div>

    <div class="info-grid">
        <div class="info-group">
            <label>Độc giả nộp phạt</label>
            <span>@(reader?.FullName ?? "N/A")</span>
            <div style="font-size: 12px; color: #64748b; margin-top: 2px;">
                Mã thẻ: @(reader?.ReaderCode ?? "N/A") | ĐT: @(reader?.Phone ?? "N/A")
            </div>
        </div>
        <div class="info-group">
            <label>Mã phiếu mượn gốc</label>
            <span>@(borrowSlip?.BorrowCode ?? $"#{borrowSlip?.Id}")</span>
            <div style="font-size: 12px; color: #64748b; margin-top: 2px;">
                Ngày lập phiếu phạt: @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>
        <div class="info-group">
            <label>Ngày nộp tiền</label>
            <span>@(Model.PaidDate.HasValue ? Model.PaidDate.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa thanh toán")</span>
        </div>
        <div class="info-group">
            <label>Hình thức nộp</label>
            <span>@(Model.IsPaid ? "Tiền mặt / Chuyển khoản thư viện" : "Ghi nợ hệ thống")</span>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th style="width: 50px;">STT</th>
                <th>Lý do vi phạm / Hư hại</th>
                <th>Sách liên quan</th>
                <th style="text-align: right;">Số tiền</th>
            </tr>
        </thead>
        <tbody>
            @if (incidentCount > 0)
            {
                int stt = 1;
                foreach (var fd in Model.FineDetails!)
                {
                    <tr>
                        <td>@(stt++)</td>
                        <td>
                            <strong>@fd.FinesType</strong>
                            @if (!string.IsNullOrEmpty(fd.Reason))
                            {
                                <div style="font-size: 11px; color: #64748b;">@fd.Reason</div>
                            }
                        </td>
                        <td>@(fd.Book?.Title ?? "Tài liệu thư viện")</td>
                        <td style="text-align: right; font-weight: 600;">@fd.Amount.ToString("N0") VNĐ</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td>1</td>
                    <td>
                        <strong>@(Model.Reason ?? "Vi phạm quy chế mượn trả")</strong>
                        <div style="font-size: 11px; color: #64748b;">@Model.FinesType</div>
                    </td>
                    <td>@(Model.Books?.Title ?? "Tài liệu thư viện")</td>
                    <td style="text-align: right; font-weight: 600;">@Model.Amount.ToString("N0") VNĐ</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="total-box">
        <div>
            <div class="total-row grand">
                <span>Tổng tiền phạt:</span>
                <span>@Model.Amount.ToString("N0") VNĐ</span>
            </div>
        </div>
    </div>

    <div class="signatures">
        <div>
            <div class="sig-title">NGƯỜI NỘP TIỀN<br><small style="font-weight: 400; color: #94a3b8;">(Ký & ghi rõ họ tên)</small></div>
            <div class="sig-name">@(reader?.FullName ?? "Độc giả")</div>
        </div>
        <div>
            <div class="sig-title">NGƯỜI THU TIỀN (THỦ THƯ)<br><small style="font-weight: 400; color: #94a3b8;">(Ký, đóng dấu xác nhận)</small></div>
            <div class="sig-name">Thủ thư phụ trách quầy</div>
        </div>
    </div>

    <div class="footer-note">
        Biên lai điện tử hợp lệ được xuất từ Hệ thống Quản trị Thư viện Điện tử. Cảm ơn bạn đọc đã chấp hành đúng quy định thư viện!
    </div>
</div>

</body>
</html>
