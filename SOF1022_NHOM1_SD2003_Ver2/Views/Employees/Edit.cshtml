@model SOF1022_NHOM1_SD2003_Ver2.Models.Employee
@using SOF1022_NHOM1_SD2003_Ver2.Models.Enums

@{
    ViewData["Title"] = "Edit Employee";
}

<div class="container-fluid">

    <!-- ========================= PAGE HEADER ========================= -->

    <div class="d-sm-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold text-warning mb-1">
                <i class="fas fa-user-edit"></i>
                Chỉnh sửa nhân viên
            </h2>

            <nav aria-label="breadcrumb">

                <ol class="breadcrumb">

                    <li class="breadcrumb-item">
                        <a asp-controller="Home"
                           asp-action="Index">
                            Dashboard
                        </a>
                    </li>

                    <li class="breadcrumb-item">
                        <a asp-action="Index">
                            Quản lý nhân viên
                        </a>
                    </li>

                    <li class="breadcrumb-item active">
                        Chỉnh sửa
                    </li>

                </ol>

            </nav>

        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="fas fa-arrow-left"></i>

            Quay lại

        </a>

    </div>

    <!-- ========================= CARD ========================= -->

    <div class="card shadow-lg border-0">

        <div class="card-header bg-warning text-dark">

            <h5 class="mb-0">

                <i class="fas fa-id-card"></i>

                Thông tin nhân viên

            </h5>

        </div>

        <div class="card-body">

            <!-- Hiển thị lỗi từ Controller -->

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">

            </div>

            <form asp-action="Edit"
                  method="post"
                  id="editForm">

                @Html.AntiForgeryToken()

                <!-- Hidden ID -->

                <input asp-for="Id"
                       type="hidden" />

                <!-- ========================= THÔNG TIN CƠ BẢN ========================= -->

                <div class="row">

                    <!-- EmployeeId -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="EmployeeId"
                               class="form-label fw-semibold">

                        </label>

                        <span class="text-danger">*</span>

                        <input asp-for="EmployeeId"
                               class="form-control"
                               readonly />

                        <span asp-validation-for="EmployeeId"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- FullName -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="FullName"
                               class="form-label fw-semibold">

                        </label>

                        <span class="text-danger">*</span>

                        <input asp-for="FullName"
                               class="form-control"
                               placeholder="Nhập họ và tên nhân viên" />

                        <span asp-validation-for="FullName"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

                <!-- ========================= EMAIL ========================= -->

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Email"
                               class="form-label fw-semibold">

                        </label>

                        <span class="text-danger">*</span>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="example@gmail.com" />

                        <span asp-validation-for="Email"
                              class="text-danger small">
                        </span>

                    </div>
                    <!-- ========================= PHONE ========================= -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Phone"
                               class="form-label fw-semibold">
                        </label>

                        <span class="text-danger">*</span>

                        <input asp-for="Phone"
                               class="form-control"
                               placeholder="Ví dụ: 0912345678" />

                        <span asp-validation-for="Phone"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

                <!-- ========================= ĐỊA CHỈ ========================= -->

                <div class="row">

                    <div class="col-12 mb-3">

                        <label asp-for="Address"
                               class="form-label fw-semibold">
                        </label>

                        <span class="text-danger">*</span>

                        <textarea asp-for="Address"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Nhập địa chỉ hiện tại"></textarea>

                        <span asp-validation-for="Address"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

                <!-- ========================= CCCD & GIỚI TÍNH ========================= -->

                <div class="row">

                    <!-- CCCD -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="CCCD"
                               class="form-label fw-semibold">
                        </label>

                        <span class="text-danger">*</span>

                        <input asp-for="CCCD"
                               maxlength="12"
                               class="form-control"
                               placeholder="Nhập CCCD hoặc CMND" />

                        <span asp-validation-for="CCCD"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- Gender -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Gender"
                               class="form-label fw-semibold">
                        </label>

                        <span class="text-danger">*</span>

                        <select asp-for="Gender"
                                asp-items="Html.GetEnumSelectList<SOF1022_NHOM1_SD2003_Ver2.Models.Gender>()"
                                class="form-select">

                            <option value="">
                                -- Chọn giới tính --
                            </option>

                        </select>

                        <span asp-validation-for="Gender"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- ========================= CHỨC VỤ & TRẠNG THÁI ========================= -->
                </div>

                <div class="row">

                    <!-- Position -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="PositionId"
                               class="form-label fw-semibold">
                        </label>

                        <span class="text-danger">*</span>

                        <select asp-for="PositionId"
                                id="PositionId"
                                asp-items="@(new SelectList(ViewBag.Positions, "Id", "Name"))"
                                class="form-select">
                            <option value="">-- Chọn chức vụ --</option>
                        </select>

                        <span asp-validation-for="PositionId"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- Status -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="StatusId"
                               class="form-label fw-semibold">
                        </label>

                        <span class="text-danger">*</span>

                        <select asp-for="StatusId"
                                asp-items="@(new SelectList(ViewBag.StatusOptions, "Id", "Name"))"
                                class="form-select">
                            <option value="">-- Chọn trạng thái --</option>
                        </select>

                        <span asp-validation-for="StatusId"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

                <!-- ========================= THÔNG TIN CÔNG VIỆC ========================= -->

                <div class="card mt-4 border-0 shadow-sm">

                    <div class="card-header bg-light">

                        <h5 class="mb-0 fw-bold">
                            <i class="fas fa-briefcase text-primary"></i>
                            Thông tin công việc
                        </h5>

                    </div>

                    <div class="card-body">

                        <div class="row">

                            <!-- Ngày sinh -->
                            <div class="col-md-6 mb-3">

                                <label asp-for="DateOfBirth"
                                       class="form-label fw-semibold">
                                </label>

                                <span class="text-danger">*</span>

                                <input asp-for="DateOfBirth"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="DateOfBirth"
                                      class="text-danger small">
                                </span>

                            </div>

                            <!-- Ngày vào làm -->
                            <div class="col-md-6 mb-3">

                                <label asp-for="HireDate"
                                       class="form-label fw-semibold">
                                </label>

                                <span class="text-danger">*</span>

                                <input asp-for="HireDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="HireDate"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                        <div class="row">

                            <!-- Lương -->
                            <div class="col-md-6 mb-3">

                                <label asp-for="Salary"
                                       class="form-label fw-semibold">
                                </label>

                                <span class="text-danger">*</span>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        VNĐ
                                    </span>

                                    <input asp-for="Salary"
                                           id="Salary"
                                           type="number"
                                           min="0"
                                           step="1000"
                                           class="form-control"
                                           placeholder="Nhập mức lương thỏa thuận" />

                                </div>

                                <span asp-validation-for="Salary"
                                      class="text-danger small">
                                </span>

                            </div>

                            <!-- Ghi chú -->
                            <div class="col-md-6">

                                <div class="alert alert-warning mb-0">

                                    <strong>
                                        <i class="fas fa-triangle-exclamation"></i>
                                        Lương tự động
                                    </strong>

                                    <hr>

                                    <ul class="mb-0">

                                        <li>Lương được tự động tính theo chức vụ.</li>

                                        <li>Thủ thư & Nhân viên mượn trả: <strong>5,000,000 VNĐ</strong></li>

                                        <li>Admin: <strong>15,000,000 VNĐ</strong></li>

                                    </ul>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            <!-- ========================= THÔNG BÁO HƯỚNG DẪN ========================= -->

            <div class="alert alert-warning border-start border-4 border-warning">

                <h6 class="fw-bold">

                    <i class="fas fa-circle-info"></i>

                    Lưu ý khi chỉnh sửa

                </h6>

                <hr />

                <ul class="mb-0">

                    <li>
                        Có thể thay đổi tất cả thông tin của nhân viên.
                    </li>

                    <li>
                        Mã nhân viên phải là duy nhất trong hệ thống.
                    </li>

                    <li>
                        Email không được trùng với nhân viên khác.
                    </li>

                    <li>
                        CCCD/CMND không được trùng với nhân viên khác.
                    </li>

                    <li>
                        Nếu giữ nguyên Email, CCCD hoặc Mã nhân viên thì hệ thống sẽ không báo trùng.
                    </li>

                    <li>
                        Sau khi nhấn <strong>Cập nhật</strong>, dữ liệu sẽ được kiểm tra trước khi lưu.
                    </li>

                </ul>

            </div>
                            <!-- ========================= BUTTON ACTION ========================= -->

                <div class="row mt-4">

                    <div class="col-12">

                        <hr />

                        <div class="d-flex justify-content-end gap-2">

                            <!-- Quay lại -->

                            <a asp-action="Index"
                               class="btn btn-secondary">

                                <i class="fas fa-arrow-left"></i>

                                Quay lại

                            </a>

                            <!-- Làm mới -->

                            <button type="reset"
                                    id="btnReset"
                                    class="btn btn-warning">

                                <i class="fas fa-rotate"></i>

                                Khôi phục

                            </button>

                            <!-- Cập nhật -->

                            <button type="submit"
                                    id="btnUpdate"
                                    class="btn btn-primary">

                                <i class="fas fa-save"></i>

                                Cập nhật nhân viên

                            </button>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>

<script>

document.addEventListener("DOMContentLoaded", function () {

    // ==========================================
    // Focus vào ô đầu tiên bị lỗi
    // ==========================================

    let firstError = document.querySelector(".input-validation-error");

    if (firstError) {

        firstError.focus();

    }

    // ==========================================
    // Giới hạn ngày sinh
    // ==========================================

    let today = new Date().toISOString().split('T')[0];

    let dateOfBirth = document.getElementById("DateOfBirth");

    if (dateOfBirth) {

        dateOfBirth.max = today;

    }

    // ==========================================
    // Giới hạn ngày vào làm
    // ==========================================

    let hireDate = document.getElementById("HireDate");

    if (hireDate) {

        hireDate.min = "2000-01-01";

        hireDate.max = today;

    }

    // ==========================================
    // CCCD chỉ được nhập số
    // ==========================================

    let cccd = document.getElementById("CCCD");

    if (cccd) {

        cccd.addEventListener("input", function () {

            this.value = this.value.replace(/\D/g, '');

        });

    }

    // ==========================================
    // Phone chỉ nhập số và dấu +
    // ==========================================

    let phone = document.getElementById("Phone");

    if (phone) {

        phone.addEventListener("input", function () {

            this.value = this.value.replace(/[^0-9+]/g, '');

        });

    }

    // ==========================================
    // Auto-update salary based on position
    // ==========================================

    const positionSalaryMap = {
        'Thủ thư': 5000000,
        'Nhân viên mượn trả': 5000000,
        'Admin': 15000000
    };

    const positionSelect = document.getElementById("PositionId");
    const salaryInput = document.getElementById("Salary");

    function updateSalary() {
        const selectedOption = positionSelect.options[positionSelect.selectedIndex];
        const positionName = selectedOption ? selectedOption.text : '';
        
        if (positionSalaryMap[positionName]) {
            salaryInput.value = positionSalaryMap[positionName];
        } else {
            salaryInput.value = '';
        }
    }

    if (positionSelect) {
        positionSelect.addEventListener("change", updateSalary);
        // Initialize salary on page load
        updateSalary();
    }

    // ==========================================
    // Theo dõi thay đổi dữ liệu
    // ==========================================

    let formChanged = false;

    let form = document.getElementById("editForm");

    form.querySelectorAll("input, textarea, select")
        .forEach(element => {

            element.addEventListener("change", function () {

                formChanged = true;

            });

        });

    // ==========================================
    // Xác nhận trước khi cập nhật
    // ==========================================

    document.getElementById("btnUpdate")
        .addEventListener("click", async function (e) {
            const { isConfirmed } = await Swal.fire({
                title: 'Xác nhận',
                text: 'Bạn có chắc muốn cập nhật thông tin nhân viên này?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Huỷ'
            });
            if (!isConfirmed) {
                e.preventDefault();
            }
        });

    // ==========================================
    // Khôi phục form
    // ==========================================

    document.getElementById("btnReset")
        .addEventListener("click", async function (e) {
            const { isConfirmed } = await Swal.fire({
                title: 'Xác nhận',
                text: 'Bạn có chắc muốn khôi phục dữ liệu ban đầu?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Huỷ'
            });
            if (!isConfirmed) {
                e.preventDefault();
            }
        });

    // ==========================================
    // Cảnh báo khi rời trang
    // ==========================================

    window.addEventListener("beforeunload", function (e) {

        if (formChanged) {

            e.preventDefault();

            e.returnValue = '';

        }

    });

    // ==========================================
    // Sau submit thành công
    // ==========================================

    form.addEventListener("submit", function (e) {
        formChanged = false;
    });

});

</script>