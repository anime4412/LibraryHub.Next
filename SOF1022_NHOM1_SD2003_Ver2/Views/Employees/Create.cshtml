@model SOF1022_NHOM1_SD2003_Ver2.Models.Employee
@using SOF1022_NHOM1_SD2003_Ver2.Models.Enums

@{
    ViewData["Title"] = "Thêm Nhân viên Mới";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">

        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="fas fa-user-plus text-primary"></i>
                Thêm nhân viên
            </h2>

            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">
                            Dashboard
                        </a>
                    </li>

                    <li class="breadcrumb-item">
                        <a asp-action="Index">
                            Quản lý nhân viên
                        </a>
                    </li>

                    <li class="breadcrumb-item active">
                        Thêm nhân viên
                    </li>
                </ol>
            </nav>
        </div>

        <a asp-action="Index" class="btn btn-secondary shadow-sm">
            <i class="fas fa-arrow-left"></i>
            Quay lại
        </a>

    </div>

    <!-- Card -->
    <div class="card shadow-lg border-0">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">
                <i class="fas fa-id-card"></i>
                Thông tin nhân viên
            </h5>

        </div>

        <div class="card-body">

            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <!-- ========================= THÔNG TIN CƠ BẢN ========================= -->

                <div class="row">

                    <!-- Employee ID -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="EmployeeId"
                               class="form-label fw-semibold">
                        </label>

                        <span class="text-danger">*</span>

                        <input asp-for="EmployeeId"
                               class="form-control"
                               placeholder="Ví dụ: NV001" />

                        <span asp-validation-for="EmployeeId"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- FullName -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="FullName"
                               class="form-label fw-semibold">
                        </label>

                        <span class="text-danger">*</span>

                        <input asp-for="FullName"
                               class="form-control"
                               placeholder="Nhập họ và tên nhân viên" />

                        <span asp-validation-for="FullName"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

                <!-- ========================= EMAIL ========================= -->

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Email"
                               class="form-label fw-semibold">
                        </label>

                        <span class="text-danger">*</span>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="example@gmail.com" />

                        <span asp-validation-for="Email"
                              class="text-danger small">
                        </span>

                    </div>
                    <!-- ========================= SỐ ĐIỆN THOẠI ========================= -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Phone"
                               class="form-label fw-semibold">
                        </label>

                        <span class="text-danger">*</span>

                        <input asp-for="Phone"
                               class="form-control"
                               placeholder="Ví dụ: 0912345678" />

                        <span asp-validation-for="Phone"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

                <!-- ========================= ĐỊA CHỈ ========================= -->

                <div class="row">

                    <div class="col-12 mb-3">

                        <label asp-for="Address"
                               class="form-label fw-semibold">
                        </label>

                        <span class="text-danger">*</span>

                        <textarea asp-for="Address"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Nhập địa chỉ hiện tại"></textarea>

                        <span asp-validation-for="Address"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

                <!-- ========================= CCCD - GIỚI TÍNH ========================= -->

                <div class="row">

                    <!-- CCCD -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="CCCD"
                               class="form-label fw-semibold">
                        </label>

                        <span class="text-danger">*</span>

                        <input asp-for="CCCD"
                               class="form-control"
                               maxlength="12"
                               placeholder="Nhập CCCD hoặc CMND" />

                        <span asp-validation-for="CCCD"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- Gender -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Gender"
                               class="form-label fw-semibold">
                        </label>

                        <span class="text-danger">*</span>

                        <select asp-for="Gender"
                                asp-items="Html.GetEnumSelectList<SOF1022_NHOM1_SD2003_Ver2.Models.Gender>()"
                                class="form-select">

                            <option value="">
                                -- Chọn giới tính --
                            </option>

                        </select>

                        <span asp-validation-for="Gender"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

                <!-- ========================= GỢI Ý NHẬP DỮ LIỆU ========================= -->

                <div class="alert alert-info border-start border-4 border-info">

                    <h6 class="fw-bold mb-2">
                        <i class="fas fa-circle-info"></i>
                        Lưu ý
                    </h6>

                    <ul class="mb-0">

                        <li>Mã nhân viên không được trùng.</li>

                        <li>Email phải đúng định dạng và chưa tồn tại.</li>

                        <li>CCCD chỉ được phép gồm 9 hoặc 12 chữ số.</li>

                        <li>Số điện thoại bắt đầu bằng <strong>0</strong> hoặc <strong>+84</strong>.</li>

                    </ul>

                </div>
                <!-- ========================= THÔNG TIN CÔNG VIỆC ========================= -->

                <div class="card mt-4 border-0 shadow-sm">

                    <div class="card-header bg-light">

                        <h5 class="mb-0 fw-bold">
                            <i class="fas fa-briefcase text-primary"></i>
                            Thông tin công việc
                        </h5>

                    </div>

                    <div class="card-body">

                        <div class="row">

                            <!-- Ngày sinh -->
                            <div class="col-md-6 mb-3">

                                <label asp-for="DateOfBirth"
                                       class="form-label fw-semibold">
                                </label>

                                <span class="text-danger">*</span>

                                <input asp-for="DateOfBirth"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="DateOfBirth"
                                      class="text-danger small">
                                </span>

                            </div>

                            <!-- Ngày vào làm -->
                            <div class="col-md-6 mb-3">

                                <label asp-for="HireDate"
                                       class="form-label fw-semibold">
                                </label>

                                <span class="text-danger">*</span>

                                <input asp-for="HireDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="HireDate"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                        <div class="row">

                            <!-- Chức vụ -->
                            <div class="col-md-6 mb-3">

                                <label asp-for="PositionId"
                                       class="form-label fw-semibold">
                                </label>

                                <span class="text-danger">*</span>

                                <select asp-for="PositionId"
                                        id="PositionId"
                                        asp-items="@(new SelectList(ViewBag.Positions, "Id", "Name"))"
                                        class="form-select">
                                    <option value="">-- Chọn chức vụ --</option>
                                </select>

                                <span asp-validation-for="PositionId"
                                      class="text-danger small">
                                </span>

                            </div>

                            <!-- Lương -->
                            <div class="col-md-6 mb-3">

                                <label asp-for="Salary"
                                       class="form-label fw-semibold">
                                </label>

                                <span class="text-danger">*</span>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        VNĐ
                                    </span>

                                    <input asp-for="Salary"
                                           id="Salary"
                                           type="number"
                                           min="0"
                                           step="1000"
                                           class="form-control"
                                           placeholder="Nhập mức lương thỏa thuận" />

                                </div>

                                <span asp-validation-for="Salary"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                        <div class="row">

                            <!-- ========================= TRẠNG THÁI ========================= -->

                            <div class="col-md-6 mb-3">

                                <label asp-for="StatusId"
                                       class="form-label fw-semibold">
                                </label>

                                <span class="text-danger">*</span>

                                <select asp-for="StatusId"
                                        asp-items="@(new SelectList(ViewBag.StatusOptions, "Id", "Name"))"
                                        class="form-select">
                                    <option value="">-- Chọn trạng thái --</option>
                                </select>

                                <span asp-validation-for="StatusId"
                                      class="text-danger small">
                                </span>

                            </div>

                            <!-- Ghi chú -->
                            <div class="col-md-6">

                                <div class="alert alert-warning mb-0">

                                    <strong>
                                        <i class="fas fa-triangle-exclamation"></i>
                                        Điều kiện nghiệp vụ
                                    </strong>

                                    <hr>

                                    <ul class="mb-0">

                                        <li>Nhân viên phải đủ <strong>18 tuổi</strong>.</li>

                                        <li>Ngày vào làm không được nhỏ hơn ngày sinh.</li>

                                        <li>Ngày vào làm phải từ năm <strong>2000</strong> đến hiện tại.</li>

                                        <li>Lương phải lớn hơn hoặc bằng <strong>0 VNĐ</strong>.</li>

                                    </ul>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
                <!-- ========================= BUTTON ACTION ========================= -->

                <div class="row mt-4">

                    <div class="col-12">

                        <hr />

                        <div class="d-flex justify-content-end gap-2">

                            <!-- Quay lại -->
                            <a asp-action="Index"
                               class="btn btn-secondary">

                                <i class="fas fa-arrow-left"></i>
                                Quay lại

                            </a>

                            <!-- Làm mới -->
                            <button type="reset"
                                    id="btnReset"
                                    class="btn btn-warning">

                                <i class="fas fa-rotate"></i>
                                Làm mới

                            </button>

                            <!-- Lưu -->
                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="fas fa-save"></i>
                                Lưu nhân viên

                            </button>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            //==========================
            // Focus vào ô lỗi đầu tiên
            //==========================

            let firstError = document.querySelector(".input-validation-error");

            if (firstError) {

                firstError.focus();

            }

            //==========================
            // Xác nhận khi làm mới form
            //==========================

            document.getElementById("btnReset").addEventListener("click", async function (e) {
                const { isConfirmed } = await Swal.fire({
                    title: 'Xác nhận',
                    text: 'Bạn có chắc muốn xóa toàn bộ dữ liệu vừa nhập?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Huỷ'
                });
                if (!isConfirmed) {
                    e.preventDefault();
                }
            });

            //==========================
            // Giới hạn ngày sinh
            // Không được lớn hơn hôm nay
            //==========================

            let today = new Date().toISOString().split('T')[0];

            let dob = document.getElementById("DateOfBirth");

            if (dob) {

                dob.max = today;

            }

            //==========================
            // Giới hạn ngày vào làm
            //==========================

            let hireDate = document.getElementById("HireDate");

            if (hireDate) {

                hireDate.max = today;

                hireDate.min = "2000-01-01";

            }

            //==========================
            // Chỉ nhập số cho CCCD
            //==========================

            let cccd = document.getElementById("CCCD");

            if (cccd) {

                cccd.addEventListener("input", function () {

                    this.value = this.value.replace(/\D/g, '');

                });

            }

            //==========================
            // Chỉ nhập số cho Phone
            //==========================

            let phone = document.getElementById("Phone");

            if (phone) {

                phone.addEventListener("input", function () {

                    this.value = this.value.replace(/[^0-9+]/g, '');

                });

            }

            //==========================
            // Auto-update salary based on position
            //==========================

            const positionSalaryMap = {
                'Thủ thư': 5000000,
                'Nhân viên mượn trả': 5000000,
                'Admin': 15000000
            };

            const positionSelect = document.getElementById("PositionId");
            const salaryInput = document.getElementById("Salary");

            function updateSalary() {
                const selectedOption = positionSelect.options[positionSelect.selectedIndex];
                const positionName = selectedOption ? selectedOption.text : '';
                
                if (positionSalaryMap[positionName]) {
                    salaryInput.value = positionSalaryMap[positionName];
                } else {
                    salaryInput.value = '';
                }
            }

            if (positionSelect) {
                positionSelect.addEventListener("change", updateSalary);
            }

        });

    </script>

}