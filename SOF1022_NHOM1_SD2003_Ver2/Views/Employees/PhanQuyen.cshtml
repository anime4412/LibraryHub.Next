@model SOF1022_NHOM1_SD2003_Ver2.Models.ViewModels.PhanQuyenViewModel

@{
    ViewData["Title"] = "Phân quyền nhân viên";
    var totalPermissions = Model.PermissionGroups.Sum(g => g.Value.Count);
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-11">
            <!-- Header -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div>
                    <h3 class="fw-bold mb-1 text-dark">
                        <i class="fas fa-shield-halved text-primary me-2"></i>Phân quyền tài khoản
                    </h3>
                    <p class="text-muted mb-0 small">Thiết lập vai trò và cấu hình quyền truy cập chi tiết cho nhân viên trong hệ thống</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary px-3">
                    <i class="fas fa-arrow-left me-2"></i>Quay lại danh sách
                </a>
            </div>

            <!-- Employee Card -->
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 52px; height: 52px; font-size: 1.25rem;">
                                @(string.IsNullOrWhiteSpace(Model.EmployeeName) ? "NV" : Model.EmployeeName.Substring(0, 1).ToUpper())
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1 text-dark">@Model.EmployeeName</h5>
                                <div class="d-flex flex-wrap align-items-center gap-2 text-muted small">
                                    <span><i class="fas fa-envelope me-1 text-secondary"></i>@(string.IsNullOrWhiteSpace(Model.EmployeeEmail) ? "Chưa có email" : Model.EmployeeEmail)</span>
                                    <span>•</span>
                                    <span>
                                        @if (Model.HasReaderAccount)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                                <i class="fas fa-circle-check me-1"></i>Đã kích hoạt tài khoản
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25">
                                                <i class="fas fa-triangle-exclamation me-1"></i>Chưa có tài khoản đăng nhập
                                            </span>
                                        }
                                    </span>
                                </div>
                            </div>
                        </div>

                        @if (Model.HasReaderAccount)
                        {
                            <button type="button" class="btn btn-outline-warning btn-sm px-3" onclick="resetPassword()">
                                <i class="fas fa-key me-1"></i>Cấp lại mật khẩu
                            </button>
                        }
                    </div>

                    @if (!Model.HasReaderAccount)
                    {
                        <div class="alert alert-warning border-0 bg-warning bg-opacity-10 rounded-3 mt-3 mb-0 small">
                            <i class="fas fa-info-circle me-2"></i>
                            Nhân viên chưa có tài khoản đăng nhập độc lập. Khi bạn lưu phân quyền, hệ thống sẽ tự động tạo tài khoản đăng nhập theo email trên.
                        </div>
                    }
                </div>
            </div>

            <!-- Permission Form -->
            <form asp-action="PhanQuyen" method="post" id="formPhanQuyen">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="EmployeeId" />

                <!-- Role Selection Section -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-body p-4">
                        <label class="form-label fw-bold mb-2">
                            <i class="fas fa-user-gear me-2 text-primary"></i>Vai trò chính (Role)
                        </label>
                        <select asp-for="RoleId" class="form-select form-select-lg" id="roleSelect">
                            <option value="">-- Chọn vai trò hệ thống --</option>
                            @foreach (var role in Model.Roles)
                            {
                                <option value="@role.Id" data-name="@role.Name">@role.Name - @role.Description</option>
                            }
                        </select>
                        <div class="form-text mt-2 text-muted small">
                            Mỗi vai trò có các quyền mặc định riêng. Khi bạn đổi vai trò, các quyền mặc định tương ứng sẽ được áp dụng. Bạn có thể tự do tùy biến thêm/bớt quyền cụ thể bên dưới.
                        </div>

                        <div id="adminNotice" class="alert alert-primary border-0 bg-primary bg-opacity-10 rounded-3 mt-3 mb-0 d-none">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fas fa-crown text-primary fs-5"></i>
                                <div>
                                    <strong>Vai trò Quản trị viên (Admin):</strong> Tài khoản này sở hữu toàn bộ các quyền trong toàn hệ thống. Mọi quyền bên dưới được tự động kích hoạt.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Permission Checklist Section -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-white border-bottom py-3 px-4">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                            <div class="d-flex align-items-center gap-2">
                                <h5 class="fw-bold mb-0 text-dark">
                                    <i class="fas fa-list-check me-2 text-primary"></i>Danh mục quyền chi tiết
                                </h5>
                                <span class="badge bg-secondary rounded-pill px-2" id="badgeCounter">
                                    Đã chọn <span id="selectedCount">0</span> / @totalPermissions
                                </span>
                            </div>

                            <!-- Quick Action Toolbar -->
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <div class="input-group input-group-sm" style="width: 200px;">
                                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
                                    <input type="text" id="filterPermission" class="form-control border-start-0 bg-light" placeholder="Tìm quyền...">
                                </div>
                                <button type="button" class="btn btn-outline-primary btn-sm" id="btnSelectAll" title="Chọn tất cả quyền">
                                    <i class="fas fa-check-double me-1"></i>Chọn tất cả
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="btnDeselectAll" title="Bỏ chọn tất cả">
                                    <i class="fas fa-xmark me-1"></i>Bỏ chọn tất cả
                                </button>
                                <button type="button" class="btn btn-outline-info btn-sm" id="btnResetRole" title="Khôi phục quyền mặc định theo vai trò đang chọn">
                                    <i class="fas fa-rotate-left me-1"></i>Theo vai trò
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        <div class="row g-4" id="permissionGrid">
                            @foreach (var group in Model.PermissionGroups)
                            {
                                var groupSlug = "grp_" + Math.Abs(group.Key.GetHashCode());
                                <div class="col-12 col-lg-6 permission-group-card">
                                    <div class="card border border-light-subtle rounded-3 h-100 shadow-none">
                                        <div class="card-header bg-light py-2 px-3 d-flex justify-content-between align-items-center">
                                            <div class="fw-bold text-dark small">
                                                @switch (group.Key)
                                                {
                                                    case "Tổng quan":
                                                        <i class="fa-solid fa-chart-line text-primary me-2"></i>@group.Key
                                                        break;
                                                    case "Quản lý sách":
                                                        <i class="fa-solid fa-book text-primary me-2"></i>@group.Key
                                                        break;
                                                    case "Danh mục sách":
                                                        <i class="fa-solid fa-folder text-secondary me-2"></i>@group.Key
                                                        break;
                                                    case "Tác giả":
                                                        <i class="fa-solid fa-feather-pointed text-info me-2"></i>@group.Key
                                                        break;
                                                    case "Nhà xuất bản":
                                                        <i class="fa-solid fa-building text-success me-2"></i>@group.Key
                                                        break;
                                                    case "Kệ sách":
                                                        <i class="fa-solid fa-boxes-stacked text-warning me-2"></i>@group.Key
                                                        break;
                                                    case "Độc giả":
                                                        <i class="fa-solid fa-users text-info me-2"></i>@group.Key
                                                        break;
                                                    case "Nhân viên":
                                                        <i class="fa-solid fa-user-tie text-danger me-2"></i>@group.Key
                                                        break;
                                                    case "Phiếu mượn sách":
                                                        <i class="fa-solid fa-clipboard-list text-success me-2"></i>@group.Key
                                                        break;
                                                    case "Đơn đặt trước":
                                                        <i class="fa-solid fa-bookmark text-primary me-2"></i>@group.Key
                                                        break;
                                                    case "Quản lý phạt tiền":
                                                        <i class="fa-solid fa-file-invoice-dollar text-warning me-2"></i>@group.Key
                                                        break;
                                                    case "Thông báo":
                                                        <i class="fa-solid fa-bell text-info me-2"></i>@group.Key
                                                        break;
                                                    case "Hỗ trợ":
                                                        <i class="fa-solid fa-headset text-danger me-2"></i>@group.Key
                                                        break;
                                                    case "Trang độc giả":
                                                        <i class="fa-solid fa-globe text-success me-2"></i>@group.Key
                                                        break;
                                                    default:
                                                        <i class="fa-solid fa-clipboard text-muted me-2"></i>@group.Key
                                                        break;
                                                }
                                                <span class="text-muted fw-normal ms-1">(@group.Value.Count)</span>
                                            </div>
                                            <button type="button" class="btn btn-link btn-sm text-decoration-none p-0 toggle-group-btn" data-target="@groupSlug">
                                                Chọn nhóm
                                            </button>
                                        </div>

                                        <div class="card-body p-3" id="@groupSlug">
                                            <div class="row g-2">
                                                @foreach (var permission in group.Value)
                                                {
                                                    var isChecked = Model.UserPermissionIds.Contains(permission.Id);
                                                    <div class="col-12 permission-item" data-name="@permission.DisplayName.ToLower()" data-code="@permission.Code.ToLower()">
                                                        <div class="form-check custom-permission-checkbox p-2 rounded-2">
                                                            <input type="checkbox"
                                                                   class="form-check-input permission-checkbox"
                                                                   name="SelectedPermissionIds"
                                                                   value="@permission.Id"
                                                                   id="perm_@permission.Id"
                                                                   @(isChecked ? "checked" : "") />
                                                            <label class="form-check-label d-flex justify-content-between align-items-center w-100" for="perm_@permission.Id">
                                                                <span class="perm-title text-dark">@permission.DisplayName</span>
                                                                <code class="perm-code text-muted small">@permission.Code</code>
                                                            </label>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Bottom Bar -->
                    <div class="card-footer bg-white border-top py-3 px-4 d-flex justify-content-between align-items-center">
                        <span class="text-muted small">
                            <i class="fas fa-shield text-primary me-1"></i>Thay đổi sẽ có hiệu lực ngay sau khi lưu.
                        </span>
                        <div class="d-flex gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-primary px-4 fw-semibold" id="btnSubmit">
                                <i class="fas fa-floppy-disk me-2"></i>Lưu phân quyền
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .custom-permission-checkbox {
        transition: background-color 0.15s ease-in-out;
        cursor: pointer;
    }
    .custom-permission-checkbox:hover {
        background-color: rgba(13, 110, 253, 0.05);
    }
    .custom-permission-checkbox .form-check-input {
        width: 1.25em;
        height: 1.25em;
        margin-top: 0.15em;
        cursor: pointer;
    }
    .custom-permission-checkbox .form-check-label {
        cursor: pointer;
        padding-left: 0.35rem;
    }
    .perm-title {
        font-weight: 500;
        font-size: 0.925rem;
    }
    .perm-code {
        font-size: 0.75rem;
        background-color: rgba(0, 0, 0, 0.04);
        padding: 0.15rem 0.35rem;
        border-radius: 0.25rem;
    }
    .custom-permission-checkbox .form-check-input:checked ~ .form-check-label .perm-title {
        color: #0d6efd !important;
        font-weight: 600;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Function to test if current selection is Admin
            function isSelectedRoleAdmin() {
                var selectedOption = $('#roleSelect option:selected');
                var roleName = selectedOption.data('name') || selectedOption.text();
                return roleName && roleName.toLowerCase().indexOf('admin') !== -1;
            }

            // Update live counter of checked permissions
            function updateCounter() {
                var count = $('.permission-checkbox:checked').length;
                $('#selectedCount').text(count);
            }

            // Update Admin visual mode
            function updateAdminMode(isAdmin) {
                if (isAdmin) {
                    $('#adminNotice').removeClass('d-none');
                    $('.permission-checkbox').prop('checked', true);
                } else {
                    $('#adminNotice').addClass('d-none');
                }
                updateCounter();
            }

            // Initial counter and admin notice on page load
            var initialIsAdmin = isSelectedRoleAdmin();
            if (initialIsAdmin) {
                $('#adminNotice').removeClass('d-none');
            }
            updateCounter();

            // When user explicitly changes the role dropdown
            $('#roleSelect').on('change', function () {
                var roleId = $(this).val();
                var isAdmin = isSelectedRoleAdmin();

                if (isAdmin) {
                    updateAdminMode(true);
                    return;
                }

                $('#adminNotice').addClass('d-none');

                if (roleId) {
                    // Fetch role default permissions
                    $.get('/api/roles/' + roleId + '/permissions', function (permIds) {
                        $('.permission-checkbox').prop('checked', false);
                        if (permIds && permIds.length > 0) {
                            permIds.forEach(function (id) {
                                $('#perm_' + id).prop('checked', true);
                            });
                        }
                        updateCounter();
                    }).fail(function () {
                        console.error('Không thể tải quyền mặc định cho vai trò.');
                    });
                } else {
                    $('.permission-checkbox').prop('checked', false);
                    updateCounter();
                }
            });

            // Update counter on single checkbox toggle
            $(document).on('change', '.permission-checkbox', function () {
                updateCounter();
            });

            // Button: Select All
            $('#btnSelectAll').on('click', function () {
                $('.permission-checkbox').prop('checked', true);
                updateCounter();
            });

            // Button: Deselect All
            $('#btnDeselectAll').on('click', function () {
                $('.permission-checkbox').prop('checked', false);
                updateCounter();
            });

            // Button: Reset to current role defaults
            $('#btnResetRole').on('click', function () {
                var roleId = $('#roleSelect').val();
                var isAdmin = isSelectedRoleAdmin();

                if (isAdmin) {
                    $('.permission-checkbox').prop('checked', true);
                    updateCounter();
                    return;
                }

                if (roleId) {
                    $.get('/api/roles/' + roleId + '/permissions', function (permIds) {
                        $('.permission-checkbox').prop('checked', false);
                        if (permIds && permIds.length > 0) {
                            permIds.forEach(function (id) {
                                $('#perm_' + id).prop('checked', true);
                            });
                        }
                        updateCounter();
                    });
                } else {
                    alert('Vui lòng chọn một vai trò trước.');
                }
            });

            // Button: Toggle group in card
            $('.toggle-group-btn').on('click', function () {
                var targetId = $(this).data('target');
                var $group = $('#' + targetId);
                var $boxes = $group.find('.permission-checkbox');
                var allChecked = $boxes.length > 0 && $boxes.filter(':checked').length === $boxes.length;
                $boxes.prop('checked', !allChecked);
                updateCounter();
            });

            // Search/Filter permission items
            $('#filterPermission').on('input', function () {
                var term = $(this).val().toLowerCase().trim();
                if (!term) {
                    $('.permission-item').show();
                    $('.permission-group-card').show();
                    return;
                }

                $('.permission-group-card').each(function () {
                    var $card = $(this);
                    var matchCount = 0;

                    $card.find('.permission-item').each(function () {
                        var $item = $(this);
                        var name = $item.data('name') || '';
                        var code = $item.data('code') || '';

                        if (name.indexOf(term) !== -1 || code.indexOf(term) !== -1) {
                            $item.show();
                            matchCount++;
                        } else {
                            $item.hide();
                        }
                    });

                    if (matchCount > 0) {
                        $card.show();
                    } else {
                        $card.hide();
                    }
                });
            });

            // Ensure checkboxes are enabled before form submits
            $('#formPhanQuyen').on('submit', function () {
                $('.permission-checkbox').prop('disabled', false);
                $('#btnSubmit').prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Đang lưu...');
            });
        });

        function resetPassword() {
            if (!confirm('Bạn có chắc chắn muốn cấp lại mật khẩu cho nhân viên này? Mật khẩu ngẫu nhiên mới sẽ được tạo và yêu cầu nhân viên đổi mật khẩu ở lần đăng nhập tiếp theo.')) {
                return;
            }

            var employeeId = @Model.EmployeeId;

            $.post('/Employees/ResetPasswordFromPhanQuyen', { id: employeeId }, function (response) {
                if (response.success) {
                    alert(response.message);
                } else {
                    alert('Lỗi: ' + response.message);
                }
            }).fail(function () {
                alert('Đã xảy ra lỗi kết nối khi cấp lại mật khẩu.');
            });
        }
    </script>
}
