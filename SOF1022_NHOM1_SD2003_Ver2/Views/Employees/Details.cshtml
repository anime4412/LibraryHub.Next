@model SOF1022_NHOM1_SD2003_Ver2.Models.Employee
@using SOF1022_NHOM1_SD2003_Ver2.Models.Enums

@{
    ViewData["Title"] = "Chi tiết nhân viên";
}

<div class="container-fluid">

    <!-- ========================= PAGE HEADER ========================= -->

    <div class="d-sm-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold text-primary mb-1">

                <i class="fas fa-user-circle"></i>

                Chi tiết nhân viên

            </h2>

            <nav aria-label="breadcrumb">

                <ol class="breadcrumb">

                    <li class="breadcrumb-item">

                        <a asp-controller="Home"
                           asp-action="Index">

                            Dashboard

                        </a>

                    </li>

                    <li class="breadcrumb-item">

                        <a asp-action="Index">

                            Quản lý nhân viên

                        </a>

                    </li>

                    <li class="breadcrumb-item active">

                        Chi tiết

                    </li>

                </ol>

            </nav>

        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">

                <i class="fas fa-edit"></i>

                Chỉnh sửa

            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-danger">

                <i class="fas fa-trash"></i>

                Xóa

            </a>

            <a asp-action="Index"
               class="btn btn-secondary">

                <i class="fas fa-arrow-left"></i>

                Quay lại

            </a>

        </div>

    </div>

    <!-- ========================= CARD ========================= -->

    <div class="card shadow-lg border-0">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">

                <i class="fas fa-address-card"></i>

                Thông tin nhân viên

            </h5>

        </div>

        <div class="card-body">

            <!-- ========================= THÔNG TIN CÁ NHÂN ========================= -->

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-light">

                    <h6 class="mb-0 fw-bold">

                        <i class="fas fa-user"></i>

                        Thông tin cá nhân

                    </h6>

                </div>

                <div class="card-body">

                    <div class="row">

                        <!-- Mã nhân viên -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-semibold">

                                @Html.DisplayNameFor(model => model.EmployeeId)

                            </label>

                            <input class="form-control"
                                   value="@Model.EmployeeId"
                                   readonly />

                        </div>

                        <!-- Họ tên -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-semibold">

                                @Html.DisplayNameFor(model => model.FullName)

                            </label>

                            <input class="form-control"
                                   value="@Model.FullName"
                                   readonly />

                        </div>

                    </div>

                    <div class="row">

                        <!-- Email -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-semibold">

                                @Html.DisplayNameFor(model => model.Email)

                            </label>

                            <input class="form-control"
                                   value="@Model.Email"
                                   readonly />

                        </div>
                        <!-- ========================= PHONE ========================= -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-semibold">

                                @Html.DisplayNameFor(model => model.Phone)

                            </label>

                            <input class="form-control"
                                   value="@Model.Phone"
                                   readonly />

                        </div>

                    </div>

                    <!-- ========================= ĐỊA CHỈ ========================= -->

                    <div class="row">

                        <div class="col-12 mb-3">

                            <label class="form-label fw-semibold">

                                @Html.DisplayNameFor(model => model.Address)

                            </label>

                            <textarea class="form-control"
                                      rows="3"
                                      readonly>@Model.Address</textarea>

                        </div>

                    </div>

                    <!-- ========================= CCCD & GIỚI TÍNH ========================= -->

                    <div class="row">

                        <!-- CCCD -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-semibold">

                                @Html.DisplayNameFor(model => model.CCCD)

                            </label>

                            <input class="form-control"
                                   value="@Model.CCCD"
                                   readonly />

                        </div>

                        <!-- Giới tính -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-semibold">

                                @Html.DisplayNameFor(model => model.Gender)

                            </label>

                            <input class="form-control"
                                   value="@(Model.Gender switch
                                   {
                                       SOF1022_NHOM1_SD2003_Ver2.Models.Gender.Male => "Nam",
                                       SOF1022_NHOM1_SD2003_Ver2.Models.Gender.Female => "Nữ",
                                       SOF1022_NHOM1_SD2003_Ver2.Models.Gender.Other => "Khác",
                                       _ => ""
                                   })"
                                   readonly />

                        </div>

                    </div>

                </div>

            </div>

            <!-- ========================= THÔNG TIN CÔNG VIỆC ========================= -->

            <div class="card border-0 shadow-sm mt-4">

                <div class="card-header bg-light">

                    <h6 class="mb-0 fw-bold">

                        <i class="fas fa-briefcase"></i>

                        Thông tin công việc

                    </h6>

                </div>

                <div class="card-body">
                    <div class="row">

                        <!-- Ngày sinh -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-semibold">

                                @Html.DisplayNameFor(model => model.DateOfBirth)

                            </label>

                            <input class="form-control"
                                   value="@Model.DateOfBirth.ToString("dd/MM/yyyy")"
                                   readonly />

                        </div>

                        <!-- Ngày vào làm -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-semibold">

                                @Html.DisplayNameFor(model => model.HireDate)

                            </label>

                            <input class="form-control"
                                   value="@Model.HireDate.ToString("dd/MM/yyyy")"
                                   readonly />

                        </div>

                    </div>

                    <div class="row">

                        <!-- Chức vụ -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-semibold">

                                @Html.DisplayNameFor(model => model.Position)

                            </label>

                            <input class="form-control"
                                   value="@Model.Position"
                                   readonly />

                        </div>

                        <!-- Lương -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-semibold">

                                @Html.DisplayNameFor(model => model.Salary)

                            </label>

                            <div class="input-group">

                                <input class="form-control"
                                       value="@Model.Salary.ToString("N0")"
                                       readonly />

                                <span class="input-group-text">

                                    VNĐ

                                </span>

                            </div>

                        </div>

                    </div>

                    <div class="row">

                        <!-- Trạng thái -->

                        <div class="col-md-6 mb-3">

                            <label asp-for="Status"
                                   class="form-label fw-semibold">
                            </label>

                            <div class="mt-2">

                                @if (Model.Status == EmployeeStatus.Working)
                                {
                                    <span class="badge bg-success fs-6">

                                        <i class="fas fa-user-check me-1"></i>

                                        Đang làm việc

                                    </span>
                                }
                                else if (Model.Status == EmployeeStatus.Suspended)
                                {
                                    <span class="badge bg-warning text-dark fs-6">

                                        <i class="fas fa-user-clock me-1"></i>

                                        Tạm ngưng

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger fs-6">

                                        <i class="fas fa-user-slash me-1"></i>

                                        Đã nghỉ việc

                                    </span>
                                }

                            </div>

                        </div>

                        <!-- Thông tin bổ sung -->

                        <div class="col-md-6">

                            <div class="alert alert-info mb-0">

                                <h6 class="fw-bold">

                                    <i class="fas fa-circle-info"></i>

                                    Thông tin bổ sung

                                </h6>

                                <hr />

                                <ul class="mb-0">

                                    <li>
                                        Đây là trang chỉ dùng để xem thông tin nhân viên.
                                    </li>

                                    <li>
                                        Muốn thay đổi thông tin, vui lòng chọn chức năng
                                        <strong>Chỉnh sửa</strong>.
                                    </li>

                                    <li>
                                        Muốn xóa nhân viên, vui lòng chọn
                                        <strong>Xóa</strong> để xác nhận.
                                    </li>

                                    <li>
                                        Thông tin hiển thị phản ánh dữ liệu hiện tại trong hệ thống.
                                    </li>

                                </ul>

                            </div>

                        </div>

                    </div>

                </div>

            </div>
            <!-- ========================= BUTTON ACTION ========================= -->

            <div class="mt-4">

                <hr />

                <div class="d-flex justify-content-end gap-2 flex-wrap">

                    <!-- Quay lại -->

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        <i class="fas fa-arrow-left"></i>

                        Quay lại

                    </a>

                    <!-- Chỉnh sửa -->

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-warning">

                        <i class="fas fa-edit"></i>

                        Chỉnh sửa

                    </a>

                    <!-- Xóa -->

                    <a asp-action="Delete"
                       asp-route-id="@Model.Id"
                       class="btn btn-danger">

                        <i class="fas fa-trash-alt"></i>

                        Xóa nhân viên

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            //=========================================
            // Hiệu ứng Fade khi trang tải xong
            //=========================================

            const card = document.querySelector(".card.shadow-lg");

            if (card) {

                card.style.opacity = "0";

                card.style.transition = "opacity 0.35s ease";

                setTimeout(function () {

                    card.style.opacity = "1";

                }, 100);

            }

            //=========================================
            // Tooltip Bootstrap (nếu có)
            //=========================================

            const tooltipTriggerList = [].slice.call(
                document.querySelectorAll('[data-bs-toggle="tooltip"]')
            );

            tooltipTriggerList.map(function (tooltipTriggerEl) {

                return new bootstrap.Tooltip(tooltipTriggerEl);

            });

        });

    </script>
}