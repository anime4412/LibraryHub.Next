@model IEnumerable<SOF1022_NHOM1_SD2003_Ver2.Models.Categories>

@{
    ViewData["Title"] = "Quản lý danh mục";
}

<div class="container-fluid py-4">

    <!-- ========================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row align-items-center">

                <div class="col-lg-8">

                    <h2 class="fw-bold mb-1">

                        <i class="fa-solid fa-tags text-primary me-2"></i>

                        Quản lý danh mục

                    </h2>

                    <p class="text-muted mb-0">

                        Quản lý toàn bộ danh mục sách trong thư viện

                    </p>

                </div>

                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">

                    @if (Context.HasPermission("category.create"))
                    {
                        <a asp-action="Create"
                           class="btn btn-primary">
                            <i class="fa-solid fa-plus me-2"></i>
                            Thêm danh mục
                        </a>
                    }

                </div>

            </div>

        </div>

    </div>

    <!-- ========================================= -->
    <!-- ALERT MESSAGES -->
    <!-- ========================================= -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ========================================= -->
    <!-- STATISTICS -->
    <!-- ========================================= -->

    <div class="row g-3 mb-4">

        <div class="col-xl-4 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted">

                        Tổng danh mục

                    </div>

                    <h3 class="fw-bold mt-2">

                        @Model.Count()

                    </h3>

                </div>

            </div>

        </div>

        <div class="col-xl-4 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted">

                        Đang sử dụng

                    </div>

                    <h3 class="fw-bold text-success mt-2">

                        @Model.Count()

                    </h3>

                </div>

            </div>

        </div>

        <div class="col-xl-4 col-md-12">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted">

                        Tìm kiếm hiện tại

                    </div>

                    <h5 class="fw-semibold mt-2">

                        @(string.IsNullOrWhiteSpace(ViewBag.SearchString)
                            ? "Tất cả danh mục"
                            : ViewBag.SearchString)

                    </h5>

                </div>

            </div>

        </div>

    </div>

    <!-- ========================================= -->
    <!-- SEARCH -->
    <!-- ========================================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-lg-10">

                        <label class="form-label fw-semibold">

                            Tìm kiếm danh mục

                        </label>

                        <input class="form-control"
                               name="searchString"
                               value="@ViewBag.SearchString"
                               placeholder="Nhập tên danh mục..." />

                    </div>

                    <div class="col-lg-2 d-grid">

                        <button class="btn btn-primary">

                            <i class="fa-solid fa-magnifying-glass me-2"></i>

                            Tìm kiếm

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- ========================================= -->
    <!-- CATEGORY TABLE -->
    <!-- ========================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="fw-bold mb-0">

                    Danh sách danh mục

                </h5>

                <span class="text-muted">

                    Tổng cộng @Model.Count() danh mục

                </span>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th style="width:90px">

                            ID

                        </th>

                        <th>

                            Tên danh mục

                        </th>

                        <th style="width:180px">

                            Trạng thái

                        </th>

                        <th style="width:220px" class="text-center">

                            Thao tác

                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {

                        <tr>

                            <!-- ID -->

                            <td>

                                <span class="badge bg-secondary fs-6">

                                    #@item.Id

                                </span>

                            </td>

                            <!-- NAME -->

                            <td>

                                <div class="d-flex align-items-center">

                                    <div class="rounded-circle bg-primary text-white
                                        d-flex align-items-center
                                        justify-content-center me-3"
                                         style="width:48px;height:48px;">

                                        <i class="fa-solid fa-tags"></i>

                                    </div>

                                    <div>

                                        <div class="fw-bold">

                                            @item.Name

                                        </div>

                                        <small class="text-muted">

                                            Danh mục sách

                                        </small>

                                    </div>

                                </div>

                            </td>

                            <!-- STATUS -->

                            <td>

                                <span class="badge bg-success">

                                    Đang sử dụng

                                </span>

                            </td>

                            <!-- ACTION -->

                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-primary btn-sm" title="Chi tiết">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    @if (Context.HasPermission("category.edit"))
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-warning btn-sm" title="Sửa">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                    }
                                    @if (Context.HasPermission("category.delete"))
                                    {
                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-danger btn-sm" title="Xóa">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    }
                                </div>
                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    </div>
    <!-- ========================================= -->
    <!-- EMPTY STATE -->
    <!-- ========================================= -->
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm mt-4">

            <div class="card-body text-center py-5">

                <i class="fa-solid fa-tags fa-5x text-secondary mb-4"></i>

                <h3 class="fw-bold">

                    Chưa có danh mục nào

                </h3>

                <p class="text-muted">

                    Hệ thống hiện chưa có dữ liệu danh mục.
                    Hãy tạo danh mục đầu tiên.

                </p>

                <a asp-action="Create"
                   class="btn btn-primary px-4">

                    <i class="fa-solid fa-plus me-2"></i>

                    Thêm danh mục

                </a>

            </div>

        </div>
    }

</div>

<style>

    /* ========================= */

    .card {
        border-radius: 14px;
    }

    /* ========================= */

    .table {
        margin-bottom: 0;
    }

        .table thead th {
            font-weight: 700;
            border-bottom: 2px solid var(--border);
            vertical-align: middle;
        }

        .table tbody td {
            vertical-align: middle;
        }

        /* ========================= */

        .table tbody tr {
            transition: .25s;
        }

            .table tbody tr:hover {
                background: #f8fbff;
            }

    /* ========================= */

    .form-control {
        height: 46px;
    }

        .form-control:focus {
            box-shadow: none;
            border-color: #0d6efd;
        }

    /* ========================= */

    .btn {
        border-radius: 8px;
    }

    /* ========================= */

    .badge {
        font-weight: 600;
        padding: 8px 12px;
    }

    /* ========================= */

    .card-header {
        border-bottom: 1px solid #eee;
        padding: 16px 20px;
    }

    /* ========================= */

    @@media(max-width:992px) {

        .table {
            min-width: 850px;
        }
    }

    @@media(max-width:768px) {

        h2 {
            font-size: 26px;
        }
    }

</style>