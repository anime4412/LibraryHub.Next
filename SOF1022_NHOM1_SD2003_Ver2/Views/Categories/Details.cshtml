@model SOF1022_NHOM1_SD2003_Ver2.Models.Categories

@{
    ViewData["Title"] = "Chi tiết Danh mục";
}

<div class="container-fluid py-4 px-md-5">
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-light p-3 rounded-circle text-success shadow-sm">
                <i class="fas fa-tags fa-lg"></i>
            </div>
            <div>
                <h4 class="mb-0 text-dark fw-bold">Quản lý Danh mục</h4>
                <small class="text-muted">Xem chi tiết thông tin danh mục trong hệ thống thư viện</small>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm bg-white rounded-3 overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 px-4" style="border-left: 4px solid #198754 !important;">
            <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-eye me-2 text-muted"></i>Chi tiết danh mục: @Model.Name</h5>
        </div>
        <div class="card-body p-4 bg-light">
            <div class="card border-0 shadow-sm bg-white rounded-3">
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-12">
                            <label class="text-muted small fw-semibold">Tên danh mục</label>
                            <div class="fw-bold text-primary fs-4">@Model.Name</div>
                        </div>
                        <div class="col-md-12">
                            <label class="text-muted small fw-semibold">Mô tả</label>
                            <div class="text-muted">@Model.Description</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top d-flex gap-2 justify-content-end">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-success btn-lg px-4 fs-6 rounded-2"><i class="fas fa-edit me-2"></i>Chỉnh sửa</a>
                <a asp-action="Index" class="btn btn-light border btn-lg px-4 fs-6 rounded-2 text-secondary"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
            </div>
        </div>
    </div>
</div>
