@model SOF1022_NHOM1_SD2003_Ver2.Models.Books
@using SOF1022_NHOM1_SD2003_Ver2.Models.Enums

@{
    ViewData["Title"] = "Chi tiết Sách (Admin)";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">
            <i class="fas fa-book"></i>
            Chi tiết Sách (Quản trị viên)
        </h2>
        <div>
            <a asp-action="AdminIndex" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i>
                Quay lại
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="fas fa-edit"></i>
                Chỉnh sửa
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-info-circle"></i>
                Thông tin Sách
            </h5>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-4 text-center">
                    @if (!string.IsNullOrEmpty(Model.CoverImage))
                    {
                        <img src="@Model.CoverImage" alt="@Model.Title" class="img-fluid rounded shadow" style="max-height: 400px;" />
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center rounded" style="height: 400px;">
                            <span class="text-muted">Không có ảnh bìa</span>
                        </div>
                    }
                </div>
                <div class="col-md-8">
                    <h3 class="mb-3">@Model.Title</h3>
                    <p class="text-muted mb-4">@Model.Description</p>

                    <div class="table-responsive">
                        <table class="table table-bordered table-light">
                            <tbody>
                                <tr>
                                    <th class="bg-light" style="width: 30%;">ISBN</th>
                                    <td>@Model.ISBN</td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Tác giả</th>
                                    <td>@Model.Author?.Name</td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Danh mục</th>
                                    <td>@Model.Category?.Name</td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Nhà xuất bản</th>
                                    <td>@Model.Publisher?.Name</td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Kệ sách</th>
                                    <td>@Model.Shelf?.Name (@Model.Shelf?.Code)</td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Năm xuất bản</th>
                                    <td>@Model.PublishYear</td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Số trang</th>
                                    <td>@Model.PageCount</td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Ngôn ngữ</th>
                                    <td>@Model.Language</td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Giá</th>
                                    <td>@Model.Price.ToString("N0") VNĐ</td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Tổng số lượng</th>
                                    <td><span class="badge bg-info">@Model.Quantity</span></td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Số lượng còn</th>
                                    <td><span class="badge bg-success">@Model.AvailableQuantity</span></td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Trạng thái</th>
                                    <td>
                                        @if (Model.BooksStatus == BooksStatus.Available)
                                        {
                                            <span class="badge bg-success">Có sẵn</span>
                                        }
                                        else if (Model.BooksStatus == BooksStatus.Hidden)
                                        {
                                            <span class="badge bg-secondary">Đã ẩn</span>
                                        }
                                        else if (Model.BooksStatus == BooksStatus.Lost)
                                        {
                                            <span class="badge bg-danger">Đã mất</span>
                                        }
                                        else if (Model.BooksStatus == BooksStatus.Maintenance)
                                        {
                                            <span class="badge bg-warning">Đang bảo trì</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @switch (Model.BooksStatus)
                                                {
                                                    case BooksStatus.Available:
                                                        <span>Có sẵn</span>
                                                        break;
                                                    case BooksStatus.Hidden:
                                                        <span>Ẩn</span>
                                                        break;
                                                    case BooksStatus.Lost:
                                                        <span>Đã mất</span>
                                                        break;
                                                    case BooksStatus.Maintenance:
                                                        <span>Đang bảo trì</span>
                                                        break;
                                                    case BooksStatus.OutOfStock:
                                                        <span>Hết sách</span>
                                                        break;
                                                    case BooksStatus.Discontinued:
                                                        <span>Ngừng kinh doanh</span>
                                                        break;
                                                    default:
                                                        <span>@Model.BooksStatus</span>
                                                        break;
                                                }
                                            </span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Lần mượn gần nhất</th>
                                    <td>@(Model.LastBorrowDate?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa mượn")</td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Người tạo</th>
                                    <td>@Model.CreatedBy</td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Từ khóa</th>
                                    <td>@Model.Keywords</td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Phiên bản</th>
                                    <td>@Model.Edition</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer bg-white">
            <div class="d-flex justify-content-between">
                <a asp-action="AdminIndex" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i>
                    Quay lại
                </a>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="fas fa-edit"></i>
                        Chỉnh sửa
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                        <i class="fas fa-trash"></i>
                        Xóa
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
