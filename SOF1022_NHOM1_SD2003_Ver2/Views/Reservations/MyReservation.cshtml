@model IEnumerable<SOF1022_NHOM1_SD2003_Ver2.Models.Reservations>

@{
    ViewData["Title"] = "Sách đã đặt trước";
}

<div class="container" style="padding-top: var(--section-gap); padding-bottom: var(--section-gap);">
        <style>
            @@media (max-width: 991px) {
                .container {
                    padding-top: var(--section-gap-sm) !important;
                    padding-bottom: var(--section-gap-sm) !important;
                }
            }
        </style>
    <!-- ======================================= -->
    <!--               HEADER SECTION            -->
    <!-- ======================================= -->
    <div class="text-center mb-5 animate fade-in">
        <span class="badge badge-emerald-soft px-3 py-2 rounded-pill fw-semibold tracking-wider text-uppercase">
            <i class="fa-solid fa-bookmark me-1"></i> Không gian cá nhân
        </span>
        <h1 class="display-5 fw-extrabold mt-3 text-gradient" style="font-family: var(--font-display); font-size: var(--text-4xl); font-weight: 600; margin-bottom: 16px;"><i class="fa-solid fa-book-bookmark me-2"></i>Sách Đã Đặt Trước</h1>
        <p class="text-secondary max-w-md mx-auto fs-15" style="color: var(--text-secondary) !important;">
            Theo dõi và quản lý danh sách những cuốn sách bạn đang xếp hàng chờ mượn trên hệ thống.
        </p>
    </div>

    <!-- ======================================= -->
    <!--             MAIN CONTENT ZONE           -->
    <!-- ======================================= -->
    @if (Model == null || !Model.Any())
    {
        <!-- EMPTY STATE: Hiển thị khi không có dữ liệu đặt trước -->
        <div class="text-center py-5 animate fade-in">
            <div class="empty-icon-box mb-4 mx-auto text-secondary rounded-circle d-flex align-items-center justify-content-center">
                <i class="fa-solid fa-book-bookmark fa-2x opacity-50"></i>
            </div>
            <h3 class="text-heading fw-bold mb-2" style="font-family: var(--font-sans); font-size: var(--text-xl); font-weight: 600; margin-bottom: 8px;">Bạn chưa đặt trước cuốn sách nào</h3>
            <p class="text-secondary fs-14 mb-4 mx-auto" style="max-width: 380px; color: var(--text-secondary) !important;">
                Hãy khám phá kho tài liệu khổng lồ của thư viện và chọn đặt trước cho mình những tựa sách yêu thích nhé.
            </p>
            <a asp-controller="Books" asp-action="Index" class="btn btn-emerald rounded-pill px-4 fw-semibold shadow-sm">
                <i class="fa-solid fa-compass me-2"></i>Khám phá kho sách
            </a>
        </div>
    }
    else
    {
        <!-- GRID CARDS: Danh sách sách đặt trước -->
        <div class="row g-4 animate fade-in">
            @foreach (var item in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="reservation-card h-100 d-flex flex-column">
                        
                        <!-- Image Container with Floating Badge -->
                        <div class="position-relative book-img-container">
                            <img src="@item.Book?.CoverImage"
                                 class="book-image"
                                 alt="@item.Book?.Title"
                                 onerror="this.src='/images/no-book.png'" />
                            
                            <!-- Đưa Badge trạng thái đè lên ảnh nhìn sang xịn mịn hơn -->
                            <span class="position-absolute top-0 end-0 m-3 badge bg-warning text-dark fw-bold shadow-sm px-2.5 py-1.5 rounded-3 fs-12">
                                <!-- TODO: Keep text-dark here because bg-warning is a fixed light background that doesn't change with theme -->
                                <i class="fa-solid fa-hourglass-half me-1 spin-slow"></i> Đang chờ
                            </span>
                        </div>

                        <!-- Card Body -->
                        <div class="p-4 d-flex flex-column flex-grow-1 justify-content-between">
                            <div>
                                <h3 class="text-heading fw-bold text-line-clamp-2 mb-1" title="@item.Book?.Title" style="font-family: var(--font-sans); font-size: var(--text-xl); font-weight: 600; margin-bottom: 8px;">
                                    @item.Book?.Title
                                </h3>
                                <p class="text-emerald fs-14 mb-3 d-flex align-items-center gap-1">
                                    <i class="fa-solid fa-pen-nib fs-12"></i> @item.Book?.Author?.Name
                                </p>
                                
                                <div class="meta-info-box p-3 rounded-3 mb-4">
                                    <div class="d-flex justify-content-between align-items-center fs-13">
                                        <span class="text-secondary"><i class="fa-regular fa-calendar me-1"></i> Ngày đặt:</span>
                                        <strong class="text-heading">@item.ReservationDate.ToString("dd/MM/yyyy")</strong>
                                    </div>
                                </div>
                            </div>

                            <div class="d-grid">
                                <a asp-controller="Books" asp-action="Details" asp-route-id="@item.BookId" 
                                   class="btn btn-emerald-soft rounded-pill fw-semibold py-2">
                                    <i class="fa-solid fa-circle-info me-1"></i> Xem chi tiết
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ======================================= -->
<!--             OPTIMIZED STYLES            -->
<!-- ======================================= -->
<style>
    /* Kế thừa biến màu hệ thống từ Layout */
    .badge-emerald-soft {
        background-color: var(--emerald-soft);
        color: var(--emerald-base);
        border: 1px solid rgba(16, 185, 129, 0.2);
    }

    .text-gradient {
        background: linear-gradient(135deg, var(--text-primary) 30%, var(--brand-base) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .fw-extrabold { font-weight: 800; }
    .fs-12 { font-size: 12px; }
    .fs-15 { font-size: 15px; }

    /* Thẻ Card Sách đặt trước */
    .reservation-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        overflow: hidden;
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease;
    }

    .reservation-card:hover {
        transform: translateY(-6px);
        border-color: rgba(16, 185, 129, 0.4);
        box-shadow: 0 16px 30px rgba(16, 185, 129, 0.08);
    }

    /* Bo góc và xử lý ảnh */
    .book-img-container {
        overflow: hidden;
        border-bottom: 1px solid var(--border-color);
        background: var(--bg-input);
    }

    .book-image {
        width: 100%;
        height: 280px;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .reservation-card:hover .book-image {
        transform: scale(1.04);
    }

    /* Hộp thông tin phụ */
    .meta-info-box {
        background-color: var(--bg-input);
        border: 1px solid var(--border-color);
    }

    /* Empty state */
    .empty-icon-box {
        width: 80px;
        height: 80px;
        background-color: var(--bg-input);
        border: 1px solid var(--border-color);
    }

    /* Giới hạn text tối đa 2 dòng chống vỡ bố cục */
    .text-line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        min-height: 48px; /* Đảm bảo chiều cao đồng đều */
    }

    /* Hiệu ứng xoay nhẹ cho icon đồng hồ cát */
    .spin-slow {
        animation: fa-spin 3s infinite linear;
    }
</style>