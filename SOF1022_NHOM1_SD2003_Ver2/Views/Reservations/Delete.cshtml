@model SOF1022_NHOM1_SD2003_Ver2.Models.Reservations

@{
    ViewData["Title"] = "Xóa đặt trước";
}

<h1>Xóa</h1>

<h3>Bạn có chắc chắn muốn xóa thông tin đặt trước này?</h3>
<div>
    <h4>Thông tin đặt trước</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ReaderId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ReaderId)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BookId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BookId)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ReservationDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ReservationDate)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ExpirationDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ExpirationDate)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Note)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Note)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BooksStatus)
        </dt>
        <dd class = "col-sm-10">
            @switch (Model.BooksStatus)
            {
                case SOF1022_NHOM1_SD2003_Ver2.Models.Enums.ReservationsStatus.Waiting:
                    <span>Chờ xử lý</span>
                    break;
                case SOF1022_NHOM1_SD2003_Ver2.Models.Enums.ReservationsStatus.Approved:
                    <span>Đã duyệt</span>
                    break;
                case SOF1022_NHOM1_SD2003_Ver2.Models.Enums.ReservationsStatus.ReadyToBorrow:
                    <span>Sẵn sàng mượn</span>
                    break;
                case SOF1022_NHOM1_SD2003_Ver2.Models.Enums.ReservationsStatus.Rejected:
                    <span>Từ chối</span>
                    break;
                case SOF1022_NHOM1_SD2003_Ver2.Models.Enums.ReservationsStatus.Completed:
                    <span>Hoàn tất</span>
                    break;
                case SOF1022_NHOM1_SD2003_Ver2.Models.Enums.ReservationsStatus.Cancelled:
                    <span>Đã hủy</span>
                    break;
                case SOF1022_NHOM1_SD2003_Ver2.Models.Enums.ReservationsStatus.Expired:
                    <span>Hết hạn</span>
                    break;
                default:
                    <span>@Model.BooksStatus</span>
                    break;
            }
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Reader)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Reader)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Book)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Book)
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="Index">Quay lại danh sách</a>
    </form>
</div>
