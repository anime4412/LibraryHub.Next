@model SOF1022_NHOM1_SD2003_Ver2.Models.Reservations

@{
    ViewData["Title"] = "Chỉnh sửa đặt trước";
}

<h1>Chỉnh sửa</h1>

<h4>Thông tin đặt trước</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="ReaderId" class="control-label">Mã độc giả</label>
                <input asp-for="ReaderId" class="form-control" />
                <span asp-validation-for="ReaderId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BookId" class="control-label">Mã sách</label>
                <input asp-for="BookId" class="form-control" />
                <span asp-validation-for="BookId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ReservationDate" class="control-label">Ngày đặt trước</label>
                <input asp-for="ReservationDate" class="form-control" />
                <span asp-validation-for="ReservationDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ExpirationDate" class="control-label">Ngày hết hạn</label>
                <input asp-for="ExpirationDate" class="form-control" />
                <span asp-validation-for="ExpirationDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label">Trạng thái</label>
                <input asp-for="Status" class="form-control" />
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Note" class="control-label">Ghi chú</label>
                <input asp-for="Note" class="form-control" />
                <span asp-validation-for="Note" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BooksStatus" class="control-label">Trạng thái sách</label>
                <input asp-for="BooksStatus" class="form-control" />
                <span asp-validation-for="BooksStatus" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Reader" class="control-label">Độc giả</label>
                <input asp-for="Reader" class="form-control" />
                <span asp-validation-for="Reader" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Book" class="control-label">Sách</label>
                <input asp-for="Book" class="form-control" />
                <span asp-validation-for="Book" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Lưu" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Quay lại danh sách</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
