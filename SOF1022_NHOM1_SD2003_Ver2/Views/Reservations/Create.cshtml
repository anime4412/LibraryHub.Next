@model SOF1022_NHOM1_SD2003_Ver2.Models.Reservations

@{
    ViewData["Title"] = "Đặt trước sách";
    var books = ViewData["Books"] as List<SOF1022_NHOM1_SD2003_Ver2.Models.Books>;
    var lockedBook = ViewData["LockedBook"] as SOF1022_NHOM1_SD2003_Ver2.Models.Books;
    var readers = ViewData["Readers"] as List<SOF1022_NHOM1_SD2003_Ver2.Models.Readers>;
    var userRole = ViewData["UserRole"] as string;
    var isAdmin = userRole == "Admin" || userRole == "Librarian";
    var isBookLocked = lockedBook != null;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />

@if (isAdmin)
{
    <div class="container py-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3">
                <h4 class="mb-0">
                    <i class="fa-solid fa-calendar-plus text-primary me-2"></i>
                    Đặt trước sách (Quản trị viên)
                </h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="card bg-light border-0 mb-3">
                                <div class="card-body">
                                    <h5 class="mb-3">
                                        <i class="fa-solid fa-user-circle text-primary me-2"></i>
                                        Chọn độc giả
                                    </h5>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Tìm kiếm độc giả</label>
                                        <select id="readerSelect" name="readerId" class="form-select select2" style="width: 100%;" required>
                                            <option value="">-- Chọn độc giả --</option>
                                            @if (readers != null)
                                            {
                                                @foreach (var reader in readers)
                                                {
                                                    <option value="@reader.Id" data-card="@reader.ReaderCode" data-phone="@reader.Phone">
                                                        @reader.FullName (@reader.ReaderCode)
                                                    </option>
                                                }
                                            }
                                        </select>
                                        <small class="text-muted">Tìm theo tên, số thẻ hoặc số điện thoại</small>
                                    </div>
                                    <div id="selectedReaderInfo" class="alert alert-info d-none">
                                        <strong>Độc giả đã chọn:</strong>
                                        <span id="selectedReaderName"></span><br>
                                        <small>Số thẻ: <span id="selectedReaderCard"></span></small><br>
                                        <small>SĐT: <span id="selectedReaderPhone"></span></small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="card bg-light border-0 mb-3">
                                <div class="card-body">
                                    <h5 class="mb-3">
                                        <i class="fa-solid fa-book text-primary me-2"></i>
                                        @if (isBookLocked)
                                        {
                                            <span>Sách đã chọn</span>
                                        }
                                        else
                                        {
                                            <span>Chọn sách</span>
                                        }
                                    </h5>
                                    @if (isBookLocked)
                                    {
                                        <div class="alert alert-info">
                                            <div class="d-flex align-items-center">
                                                <img src="@(lockedBook?.CoverImage ?? "/images/no-book.png")" 
                                                     onerror="this.onerror=null;this.src='/images/no-book.png';"
                                                     alt="@lockedBook?.Title" 
                                                     class="me-3" 
                                                     style="width: 60px; height: 80px; object-fit: cover; border-radius: 4px;">
                                                <div>
                                                    <strong>@lockedBook?.Title</strong><br>
                                                    <small class="text-muted">Tác giả: @lockedBook?.Author?.Name</small><br>
                                                    <small class="text-muted">ISBN: @lockedBook?.ISBN</small>
                                                </div>
                                            </div>
                                            <input type="hidden" asp-for="BookId" value="@lockedBook?.Id" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold">Tìm kiếm sách</label>
                                            <select asp-for="BookId" class="form-select select2" style="width: 100%;" required>
                                                <option value="">-- Chọn sách --</option>
                                                @if (books != null)
                                                {
                                                    @foreach (var book in books)
                                                    {
                                                        <option value="@book.Id">
                                                            @book.Title - @book.Author?.Name (@book.ISBN)
                                                        </option>
                                                    }
                                                }
                                            </select>
                                            <small class="text-muted">Tìm theo tên sách, tác giả hoặc ISBN</small>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="card bg-light border-0">
                                <div class="card-body">
                                    <h5 class="mb-3">
                                        <i class="fa-solid fa-calendar-check text-primary me-2"></i>
                                        Thông tin đặt trước
                                    </h5>
                                    <div class="mb-3">
                                        <label asp-for="Note" class="form-label fw-semibold">Ghi chú</label>
                                        <textarea asp-for="Note" rows="3" class="form-control"></textarea>
                                    </div>
                                    <div class="alert alert-info">
                                        <small>
                                            <i class="fa-solid fa-info-circle me-1"></i>
                                            Đặt trước sẽ hết hạn sau 3 ngày. Vui lòng đến nhận sách trước thời hạn.
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">
                            <i class="fa-solid fa-check-circle me-2"></i> Xác nhận đặt trước
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
else
{
    <div class="container py-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3">
                <h4 class="mb-0">
                    <i class="fa-solid fa-calendar-plus text-primary me-2"></i>
                    Đặt trước sách
                </h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    @if (isBookLocked)
                                    {
                                        <span>Sách đã chọn</span>
                                    }
                                    else
                                    {
                                        <span>Chọn sách</span>
                                    }
                                </label>
                                @if (isBookLocked)
                                {
                                    <div class="alert alert-info">
                                        <div class="d-flex align-items-center">
                                            <img src="@(lockedBook?.CoverImage ?? "/images/no-book.png")" 
                                                 onerror="this.onerror=null;this.src='/images/no-book.png';"
                                                 alt="@lockedBook?.Title" 
                                                 class="me-3" 
                                                 style="width: 60px; height: 80px; object-fit: cover; border-radius: 4px;">
                                            <div>
                                                <strong>@lockedBook?.Title</strong><br>
                                                <small class="text-muted">Tác giả: @lockedBook?.Author?.Name</small>
                                            </div>
                                        </div>
                                        <input type="hidden" asp-for="BookId" value="@lockedBook?.Id" />
                                    </div>
                                }
                                else
                                {
                                    <select asp-for="BookId" class="form-select select2" style="width: 100%;" required>
                                        <option value="">-- Chọn sách --</option>
                                        @if (books != null)
                                        {
                                            @foreach (var book in books)
                                            {
                                                <option value="@book.Id">
                                                    @book.Title - @book.Author?.Name
                                                </option>
                                            }
                                        }
                                    </select>
                                }
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label asp-for="Note" class="form-label fw-semibold">Ghi chú</label>
                                <textarea asp-for="Note" rows="3" class="form-control"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <small>
                            <i class="fa-solid fa-info-circle me-1"></i>
                            Đặt trước sẽ hết hạn sau 3 ngày. Vui lòng đến nhận sách trước thời hạn.
                        </small>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">
                            <i class="fa-solid fa-check-circle me-2"></i> Xác nhận đặt trước
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<div class="mt-3">
    @if (isAdmin)
    {
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-2"></i> Quay lại danh sách
        </a>
    }
    else
    {
        <a asp-action="MyReservation" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-2"></i> Quay lại danh sách
        </a>
    }
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const isAdmin = @Html.Raw(Json.Serialize(isAdmin));

        // Initialize Select2 for all dropdowns
        $('.select2').select2({
            placeholder: "Tìm kiếm...",
            allowClear: true,
            width: '100%'
        });

        // Handle reader selection for admin mode
        if (isAdmin) {
            $('#readerSelect').on('select2:select', function(e) {
                const data = e.params.data;
                const option = $(this).find('option:selected');
                
                $('#selectedReaderInfo').removeClass('d-none');
                $('#selectedReaderName').text(data.text);
                $('#selectedReaderCard').text(option.data('card'));
                $('#selectedReaderPhone').text(option.data('phone'));
            });

            $('#readerSelect').on('select2:unselect', function() {
                $('#selectedReaderInfo').addClass('d-none');
            });
        }
    });
</script>
