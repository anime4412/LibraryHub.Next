@model SOF1022_NHOM1_SD2003_Ver2.Models.Reservations

@{
    ViewData["Title"] = "Chi tiết đặt trước";
}

@Html.AntiForgeryToken()

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Header -->
            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary me-3">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h2 class="fw-bold mb-0">Chi tiết đặt trước #@Model.Id</h2>
                    <p class="text-muted mb-0">Xem thông tin chi tiết về yêu cầu đặt trước sách</p>
                </div>
            </div>

            <!-- Main Card -->
            <div class="card shadow-sm">
                <div class="card-body">
                    <!-- Status Badge -->
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        @switch (Model.BooksStatus)
                        {
                            case SOF1022_NHOM1_SD2003_Ver2.Models.Enums.ReservationsStatus.Waiting:
                                <span class="badge bg-warning text-dark fs-14 px-3 py-2">
                                    <!-- TODO: Keep text-dark here because bg-warning is a fixed light background that doesn't change with theme -->
                                    <i class="fas fa-clock me-1"></i> Chờ xử lý
                                </span>
                                break;
                            case SOF1022_NHOM1_SD2003_Ver2.Models.Enums.ReservationsStatus.Approved:
                                <span class="badge bg-info text-white fs-14 px-3 py-2">
                                    <i class="fas fa-check-circle me-1"></i> Đã duyệt
                                </span>
                                break;
                            case SOF1022_NHOM1_SD2003_Ver2.Models.Enums.ReservationsStatus.ReadyToBorrow:
                                <span class="badge bg-success text-white fs-14 px-3 py-2">
                                    <i class="fas fa-box me-1"></i> Sẵn sàng mượn
                                </span>
                                break;
                            case SOF1022_NHOM1_SD2003_Ver2.Models.Enums.ReservationsStatus.Completed:
                                <span class="badge bg-success text-white fs-14 px-3 py-2">
                                    <i class="fas fa-check-double me-1"></i> Hoàn tất
                                </span>
                                break;
                            case SOF1022_NHOM1_SD2003_Ver2.Models.Enums.ReservationsStatus.Cancelled:
                                <span class="badge bg-danger text-white fs-14 px-3 py-2">
                                    <i class="fas fa-times-circle me-1"></i> Đã hủy
                                </span>
                                break;
                            case SOF1022_NHOM1_SD2003_Ver2.Models.Enums.ReservationsStatus.Expired:
                                <span class="badge bg-secondary text-white fs-14 px-3 py-2">
                                    <i class="fas fa-hourglass-end me-1"></i> Hết hạn
                                </span>
                                break;
                            default:
                                <span class="badge bg-secondary text-white fs-14 px-3 py-2">
                                    Không rõ
                                </span>
                                break;
                        }
                    </div>

                    <!-- Reader Information -->
                    <div class="mb-4 p-3 bg-light rounded">
                        <h6 class="fw-bold mb-3">
                            <i class="fas fa-user me-2"></i>Thông tin độc giả
                        </h6>
                        <div class="row">
                            <div class="col-md-6">
                                <p class="mb-1"><strong>Họ tên:</strong> @(Model.Reader?.FullName ?? "N/A")</p>
                                <p class="mb-1"><strong>Mã độc giả:</strong> @Model.ReaderId</p>
                            </div>
                            <div class="col-md-6">
                                <p class="mb-1"><strong>Email:</strong> @(Model.Reader?.Email ?? "N/A")</p>
                                <p class="mb-1"><strong>SĐT:</strong> @(Model.Reader?.Phone ?? "N/A")</p>
                            </div>
                        </div>
                    </div>

                    <!-- Book Information -->
                    <div class="mb-4 p-3 bg-light rounded">
                        <h6 class="fw-bold mb-3">
                            <i class="fas fa-book me-2"></i>Thông tin sách
                        </h6>
                        <div class="row">
                            <div class="col-md-6">
                                <p class="mb-1"><strong>Tên sách:</strong> @(Model.Book?.Title ?? "N/A")</p>
                                <p class="mb-1"><strong>Tác giả:</strong> @(Model.Book?.Author?.Name ?? "N/A")</p>
                            </div>
                            <div class="col-md-6">
                                <p class="mb-1"><strong>ISBN:</strong> @(Model.Book?.ISBN ?? "N/A")</p>
                                <p class="mb-1"><strong>Danh mục:</strong> @(Model.Book?.Category?.Name ?? "N/A")</p>
                            </div>
                        </div>
                    </div>

                    <!-- Reservation Details -->
                    <div class="mb-4 p-3 bg-light rounded">
                        <h6 class="fw-bold mb-3">
                            <i class="fas fa-info-circle me-2"></i>Chi tiết đặt trước
                        </h6>
                        <div class="row">
                            <div class="col-md-6">
                                <p class="mb-1"><strong>Ngày đặt:</strong> @Model.ReservationDate.ToString("dd/MM/yyyy HH:mm")</p>
                                <p class="mb-1"><strong>Hạn hết:</strong> @(Model.ExpirationDate?.ToString("dd/MM/yyyy") ?? "N/A")</p>
                            </div>
                            <div class="col-md-6">
                                <p class="mb-1"><strong>Trạng thái:</strong> @Model.Status</p>
                                <p class="mb-1"><strong>Ghi chú:</strong> @(Model.Note ?? "Không có")</p>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2 flex-wrap">
                        @if (Model.BooksStatus == SOF1022_NHOM1_SD2003_Ver2.Models.Enums.ReservationsStatus.Waiting)
                        {
                            <button type="button" class="btn btn-success" onclick="approveReservation(@Model.Id)">
                                <i class="fas fa-check me-1"></i> Duyệt
                            </button>
                            <a asp-action="Cancel" asp-route-id="@Model.Id" class="btn btn-danger">
                                <i class="fas fa-times me-1"></i> Hủy
                            </a>
                        }
                        else if (Model.BooksStatus == SOF1022_NHOM1_SD2003_Ver2.Models.Enums.ReservationsStatus.Approved)
                        {
                            <a asp-action="ReadyForPickup" asp-route-id="@Model.Id" class="btn btn-success">
                                <i class="fas fa-box me-1"></i> Sẵn sàng mượn
                            </a>
                        }
                        else if (Model.BooksStatus == SOF1022_NHOM1_SD2003_Ver2.Models.Enums.ReservationsStatus.ReadyToBorrow)
                        {
                            <a asp-action="Complete" asp-route-id="@Model.Id" class="btn btn-success">
                                <i class="fas fa-check-double me-1"></i> Hoàn tất
                            </a>
                        }
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-list me-1"></i> Quay lại danh sách
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function approveReservation(id) {
            const { isConfirmed } = await Swal.fire({
                title: 'Xác nhận',
                text: 'Bạn có chắc chắn muốn duyệt yêu cầu đặt trước này? Hệ thống sẽ tự động tạo phiếu mượn và trừ kho sách.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Huỷ'
            });
            if (!isConfirmed) {
                return;
            }

            $.ajax({
                url: '/Admin/Reservations/Approve/' + id,
                type: 'POST',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        Swal.fire({ icon: 'success', title: 'Thông báo', text: response.message });
                        if (response.redirectUrl) {
                            window.location.href = response.redirectUrl;
                        } else {
                            location.reload();
                        }
                    } else {
                        Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Lỗi: ' + response.message });
                    }
                },
                error: function(xhr, status, error) {
                    Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Đã xảy ra lỗi: ' + error });
                }
            });
        }
    </script>
}
