@model IEnumerable<SOF1022_NHOM1_SD2003_Ver2.Models.Books>

@{
    ViewData["Title"] = "Thư viện Sách Điện Tử";
    Layout = "_ReaderLayout";
}

<div class="books-page">
    <!-- Hero Section -->
    <div class="hero-section" style="padding-top: var(--section-gap); padding-bottom: var(--section-gap);">
        <style>
            @@media (max-width: 991px) {
                .hero-section {
                    padding-top: var(--section-gap-sm) !important;
                    padding-bottom: var(--section-gap-sm) !important;
                }
            }
        </style>
        <div class="container">
            <div class="hero-content">
                <div class="eyebrow-pill mb-2">
                    <i class="fa-solid fa-sparkles text-warning"></i> KHO SÁCH SỐ HIỆN ĐẠI
                </div>
                <h1 class="hero-title fw-bold" style="font-family: var(--sans); font-size: clamp(34px, 5vw, 60px); letter-spacing: -0.035em; line-height: 1.05; margin-bottom: 16px;">Khám Phá Kho Tri Thức</h1>
                <p class="hero-subtitle text-secondary" style="font-family: var(--sans); font-size: var(--text-lg); font-weight: 400; max-width: 58ch; margin: 0 auto 20px;">Tìm kiếm, mượn sách trực tuyến và quản lý hành trình đọc của bạn một cách mượt mà và dễ dàng.</p>
                <div class="hero-stats d-flex flex-wrap gap-2 justify-content-center">
                    <span class="stat-badge"><i class="bi bi-collection me-1 text-warning"></i> Kho sách: @(ViewBag.TotalItems ?? Model.Count()) đầu sách</span>
                    <span class="stat-badge"><i class="bi bi-box-seam me-1 text-success"></i> Sẵn sàng: @Model.Sum(x => x.AvailableQuantity) cuốn</span>
                    <span class="stat-badge"><i class="bi bi-clock-history me-1 text-info"></i> Mượn & đọc online 24/7</span>
                </div>
            </div>
        </div>
    </div>

    <div class="container" style="padding-top: var(--section-gap-sm); padding-bottom: var(--section-gap);">
        <!-- Filter Section (Taste-Soft Double-Bezel) -->
        <div class="double-bezel">
            <div class="double-bezel-core filter-card">
                <form asp-action="Index" method="get">
                    <div class="row g-2 g-xl-3 align-items-center">
                        <div class="col-xl-3 col-lg-6 col-md-6 col-12">
                            <div class="search-group">
                                <span class="search-icon"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control" id="liveSearchInput" name="searchString" value="@ViewBag.SearchString" placeholder="Nhập tên sách, tác giả..." />
                            </div>
                        </div>
                        <div class="col-xl-3 col-lg-6 col-md-6 col-12">
                            <select class="form-select w-100" name="categoryId">
                                <option value="">Tất cả danh mục</option>
                                @if (ViewBag.Categories != null)
                                {
                                    @foreach (var cat in ViewBag.Categories)
                                    {
                                        <option value="@cat.Id" selected="@(ViewBag.CategoryId == cat.Id ? "selected" : null)">@cat.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-4 col-md-4 col-12">
                            <select class="form-select w-100" name="authorId">
                                <option value="">Tất cả tác giả</option>
                                @if (ViewBag.Authors != null)
                                {
                                    @foreach (var author in ViewBag.Authors)
                                    {
                                        <option value="@author.Id" selected="@(ViewBag.AuthorId == author.Id ? "selected" : null)">@author.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-4 col-md-4 col-12">
                            <select class="form-select w-100" name="sortOrder" aria-label="Sắp xếp kết quả">
                                <option value="new" selected="@(ViewBag.SortOrder == "new" ? "selected" : null)">Mới nhất</option>
                                <option value="name" selected="@(ViewBag.SortOrder == "name" ? "selected" : null)">Tên A-Z</option>
                                <option value="quantity" selected="@(ViewBag.SortOrder == "quantity" ? "selected" : null)">Sẵn có</option>
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-4 col-md-4 col-12 d-flex gap-2">
                            <button type="submit" class="btn btn-taste-gold flex-fill d-inline-flex align-items-center justify-content-center gap-2 py-2 px-3 fw-bold rounded-pill text-nowrap" title="Áp dụng bộ lọc">
                                <i class="fa-solid fa-filter"></i>
                                <span>Lọc</span>
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-3 d-inline-flex align-items-center justify-content-center rounded-pill flex-shrink-0" title="Đặt lại bộ lọc">
                                <i class="fa-solid fa-arrow-rotate-left"></i>
                            </a>
                        </div>
                    </div>

                @if (!string.IsNullOrEmpty(ViewBag.SearchString) || ViewBag.CategoryId != null || ViewBag.AuthorId != null)
                {
                    <div class="active-filters mt-3 pt-3 border-top d-flex align-items-center flex-wrap gap-2">
                        <span class="text-muted small fw-semibold">Đang lọc theo:</span>
                        @if (!string.IsNullOrEmpty(ViewBag.SearchString))
                        {
                            <span class="badge bg-light text-dark border px-2 py-1">
                                Từ khóa: "@ViewBag.SearchString"
                            </span>
                        }
                        @if (ViewBag.CategoryId != null)
                        {
                            var catName = (ViewBag.Categories as IEnumerable<SOF1022_NHOM1_SD2003_Ver2.Models.Categories>)?.FirstOrDefault(c => c.Id == (int)ViewBag.CategoryId)?.Name;
                            <span class="badge bg-primary-subtle text-primary border border-primary px-2 py-1">
                                Danh mục: @catName
                            </span>
                        }
                        @if (ViewBag.AuthorId != null)
                        {
                            var authorName = (ViewBag.Authors as IEnumerable<SOF1022_NHOM1_SD2003_Ver2.Models.Authors>)?.FirstOrDefault(a => a.Id == (int)ViewBag.AuthorId)?.Name;
                            <span class="badge bg-warning-subtle text-warning border border-warning px-2 py-1">
                                Tác giả: @authorName
                            </span>
                        }
                        <a asp-action="Index" class="btn btn-sm btn-link text-danger text-decoration-none p-0 ms-2">
                            <i class="bi bi-x-circle me-1"></i>Xóa bộ lọc
                        </a>
                    </div>
                }
            </form>
        </div>
    </div>

        <!-- Books Grid -->
        <div class="books-grid" style="gap: var(--card-gap);">
            @foreach (var item in Model)
            {
                var availability = ViewBag.BookAvailability as Dictionary<int, (int availableCount, bool isAvailable)>;
                var (availableCount, isAvailable) = availability != null && availability.ContainsKey(item.Id) 
                    ? availability[item.Id] 
                    : (item.AvailableQuantity, item.AvailableQuantity > 0);
                
                <div class="book-card card-elevated" style="cursor: pointer;" onclick="if (!event.target.closest('a, button')) { window.location.href='@Url.Action("Details", "Books", new { id = item.Id })'; }">
                    <div class="book-cover">
                        <img src="@(string.IsNullOrEmpty(item.CoverImage) ? "/images/no-book.png" : item.CoverImage)"
                             onerror="this.src='/images/no-book.png'"
                             alt="@item.Title" />
                        <div class="book-badge @(availableCount == 0 ? "badge-out" : availableCount <= 5 ? "badge-low" : "badge-available")">
                            @(availableCount == 0 ? "Hết sách" : availableCount <= 5 ? "Sắp hết" : "Có sẵn")
                        </div>
                    </div>
                    <div class="book-info">
                        <span class="book-category">@item.Category?.Name</span>
                        <h3 class="book-title text-heading" style="font-family: var(--font-sans); font-size: var(--text-xl); font-weight: 600; margin-bottom: 8px;">@item.Title</h3>
                        <p class="book-author text-subtle">Tác giả: @(item.Author?.Name ?? "Đang cập nhật")</p>
                        <div class="book-meta">
                            <span class="meta-item"><i class="bi bi-geo-alt"></i> @item.Shelf?.Name</span>
                            <span class="meta-item"><i class="bi bi-book"></i> Còn @availableCount</span>
                        </div>
                        @if (!isAvailable && availableCount == 0)
                        {
                            <div class="mt-2">
                                <a asp-controller="Reservations" asp-action="Create" asp-route-bookId="@item.Id" class="btn btn-sm btn-warning w-100" onclick="event.stopPropagation();">
                                    <i class="bi bi-calendar-plus"></i> Đăng ký trước
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Empty State -->
        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="bi bi-search"></i></div>
                <h3 style="font-family: var(--font-sans); font-size: var(--text-xl); font-weight: 600; margin-bottom: 8px;">Không tìm thấy cuốn sách nào!</h3>
                <p>Hãy thử kiểm tra lỗi chính tả hoặc tìm kiếm bằng một danh mục khác.</p>
                <a asp-action="Index" class="btn btn-primary">Tải lại toàn bộ</a>
            </div>
        }
    </div>
</div>

<style>
    body {
        background-color: var(--bg-deep);
        color: var(--text-primary);
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .books-page {
        min-height: 100vh;
    }

    .hero-section {
        background: var(--bg-deep);
        padding: 3rem 0;
        border-bottom: 1px solid var(--border-color);
        margin-bottom: 2rem;
    }

    .hero-content {
        text-align: center;
    }

    .hero-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
        font-family: var(--font-display);
    }

    .hero-subtitle {
        font-size: 1.1rem;
        color: var(--text-secondary);
        margin-bottom: 1.5rem;
    }

    .hero-stats {
        display: flex;
        justify-content: center;
        gap: 1rem;
    }

    .stat-badge {
        background: var(--info-bg);
        color: var(--info);
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.9rem;
        border: 1px solid var(--info);
    }

    .filter-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: var(--card-pad);
        margin-bottom: 2rem;
        box-shadow: var(--shadow-md);
    }

    .search-group {
        position: relative;
        display: flex;
        align-items: center;
    }

    .search-icon {
        position: absolute;
        left: 1rem;
        color: var(--text-secondary);
    }

    .search-group input {
        padding-left: 2.5rem;
        background: var(--bg-input);
        border: 1px solid var(--border-color);
        color: var(--text-primary);
    }

    .search-group input:focus {
        background: var(--bg-input);
        border-color: var(--brand-base);
        color: var(--text-primary);
        box-shadow: 0 0 0 3px var(--brand-soft);
    }

    .form-select {
        background-color: var(--bg-input);
        border: 1px solid var(--border-color);
        color: var(--text-primary);
        min-width: 120px;
    }

    .form-select:focus {
        background-color: var(--bg-input);
        border-color: var(--brand-base);
        color: var(--text-primary);
        box-shadow: 0 0 0 3px var(--brand-soft);
    }

    .books-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
    }

    .book-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-md);
    }

    .book-card:hover {
        transform: translateY(-8px);
        box-shadow: var(--shadow-lg);
        border-color: var(--brand-base);
        z-index: 10;
    }

    .book-cover {
        position: relative;
        height: 200px;
        overflow: hidden;
        background: var(--bg-input);
    }

    .book-cover img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 1rem;
        transition: transform 0.3s ease;
    }

    .book-card:hover .book-cover img {
        transform: scale(1.05);
    }

    /* Clickable Book Cards */
    .book-card {
        position: relative;
        cursor: pointer;
    }

    .book-badge {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        z-index: 2;
    }

    .badge-available {
        background: var(--success);
        color: var(--brand-ink);
    }

    .badge-low {
        background: var(--warning);
        color: var(--brand-ink);
    }

    .badge-out {
        background: var(--danger);
        color: var(--brand-ink);
    }

    .book-info {
        padding: var(--card-pad);
    }

    .book-category {
        display: inline-block;
        background: var(--info-bg);
        color: var(--info);
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        font-size: 0.75rem;
        margin-bottom: 0.5rem;
    }

    .book-title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 2.4em;
        line-height: 1.2;
    }

    .book-author {
        font-size: 0.875rem;
        color: var(--text-secondary);
        margin-bottom: 0.75rem;
    }

    .book-meta {
        display: flex;
        justify-content: space-between;
        gap: 0.5rem;
    }

    .meta-item {
        font-size: 0.75rem;
        color: var(--text-secondary);
    }

    .meta-item i {
        margin-right: 0.25rem;
    }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: var(--bg-card);
        border: 1px dashed var(--border-color);
        border-radius: 12px;
    }

    .empty-icon {
        font-size: 4rem;
        color: var(--text-secondary);
        margin-bottom: 1rem;
    }

    .empty-state h3 {
        color: var(--text-primary);
        margin-bottom: 0.5rem;
    }

    .empty-state p {
        color: var(--text-muted);
        margin-bottom: 1.5rem;
    }

    .btn-primary {
        background: var(--brand-base);
        border-color: var(--brand-base);
        color: var(--brand-ink);
        padding: 0.5rem 1.5rem;
        border-radius: 8px;
    }

    .btn-primary:hover {
        background: var(--brand-hover);
        border-color: var(--brand-hover);
        color: var(--brand-ink);
    }

    @@media(max-width:768px) {
        .hero-title {
            font-size: 1.75rem;
        }

        .books-grid {
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 1rem;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('liveSearchInput');
        const bookCards = document.querySelectorAll('.book-card');
        
        if (searchInput) {
            searchInput.addEventListener('input', function() {
                const searchTerm = this.value.toLowerCase().trim();
                
                bookCards.forEach(card => {
                    const title = card.querySelector('.book-title')?.textContent.toLowerCase() || '';
                    const author = card.querySelector('.book-author')?.textContent.toLowerCase() || '';
                    const category = card.querySelector('.book-category')?.textContent.toLowerCase() || '';
                    
                    const matchesSearch = title.includes(searchTerm) || 
                                         author.includes(searchTerm) || 
                                         category.includes(searchTerm);
                    
                    card.style.display = matchesSearch ? 'block' : 'none';
                });
            });
        }
    });
</script>