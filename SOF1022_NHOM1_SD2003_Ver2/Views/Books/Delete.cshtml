@model SOF1022_NHOM1_SD2003_Ver2.Models.Books

@{
    ViewData["Title"] = "Xóa Sách";
}

<div class="container py-5 d-flex justify-content-center">
    <div class="card border border-danger shadow-sm rounded-3" style="max-width: 500px; width: 100%;">
        <div class="card-header bg-danger text-white py-3">
            <h5 class="card-title mb-0 fw-bold"><i class="fas fa-exclamation-triangle me-2"></i>Xác nhận xóa dữ liệu</h5>
        </div>
        <div class="card-body p-4 text-center">
            <p class="text-secondary fs-6 mb-4">Bạn có chắc chắn muốn xóa bản ghi này không? Hành động này không thể hoàn tác.</p>
            <div class="alert alert-light border text-start text-dark py-2 mb-4">
                <strong>Tên sách:</strong> <span class="text-danger fw-bold">@Model.Title (@Model.ISBN)</span>
            </div>
            
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-center gap-2">
                    <button type="submit" class="btn btn-danger px-4 rounded-2"><i class="fas fa-trash-alt me-2"></i>Xác nhận Xóa</button>
                    <a asp-action="AdminIndex" asp-controller="Books" class="btn btn-light border px-4 rounded-2">Hủy bỏ</a>
                </div>
            </form>
        </div>
    </div>
</div>
