@model IEnumerable<SOF1022_NHOM1_SD2003_Ver2.Models.Books>
@{
    ViewData["Title"] = "Quản lý Sách";
 // Giữ lại Layout Admin nếu cần
}
@Html.AntiForgeryToken()

<div class="container-fluid py-4">

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <h2 class="fw-bold mb-1">
                        <i class="fa-solid fa-book text-primary me-2"></i>
                        Quản lý Sách
                    </h2>
                    <p class="text-muted mb-0">
                        Quản lý toàn bộ danh sách sách trong hệ thống thư viện
                    </p>
                </div>
                <div class="col-lg-6 text-lg-end mt-3 mt-lg-0">
                    <div class="d-flex gap-2 justify-content-lg-end flex-wrap">
                        @if (Context.HasPermission("book.view"))
                        {
                            <a asp-action="ExportToExcel" class="btn btn-outline-success">
                                <i class="fa-solid fa-file-excel me-1"></i>
                                Xuất Excel
                            </a>
                        }
                        @if (Context.HasPermission("book.create"))
                        {
                            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#importExcelModal">
                                <i class="fa-solid fa-file-import me-1"></i>
                                Nhập Excel
                            </button>
                        }
                        @if (Context.HasPermission("shelf.view") || Context.HasPermission("book.view"))
                        {
                            <a asp-action="Inventory" class="btn btn-info">
                                <i class="fas fa-boxes me-1"></i>
                                Kho sách
                            </a>
                        }
                        @if (Context.HasPermission("book.create"))
                        {
                            <a asp-action="Create" class="btn btn-primary">
                                <i class="fa-solid fa-plus me-1"></i>
                                Thêm sách
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Tổng số sách</div>
                    <h3 class="fw-bold mt-2">@ViewBag.TotalBooks</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Sách có sẵn</div>
                    <h3 class="fw-bold text-success mt-2">@ViewBag.AvailableBooks</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Danh mục</div>
                    <h3 class="fw-bold text-info mt-2">@ViewBag.TotalCategories</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Tác giả</div>
                    <h3 class="fw-bold text-warning mt-2">@ViewBag.TotalAuthors</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="AdminIndex" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Tìm kiếm sách</label>
                        <input type="text" class="form-control" name="searchString" value="@ViewBag.SearchString" placeholder="Tìm kiếm sách..." />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Danh mục</label>
                        <select class="form-select" name="categoryId">
                            <option value="">Tất cả danh mục</option>
                            @if (ViewBag.Categories != null)
                            {
                                @foreach (var cat in ViewBag.Categories)
                                {
                                    <option value="@cat.Id" selected="@(ViewBag.CategoryId == cat.Id ? "selected" : null)">@cat.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Tác giả</label>
                        <select class="form-select" name="authorId">
                            <option value="">Tất cả tác giả</option>
                            @if (ViewBag.Authors != null)
                            {
                                @foreach (var author in ViewBag.Authors)
                                {
                                    <option value="@author.Id" selected="@(ViewBag.AuthorId == author.Id ? "selected" : null)">@author.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Sắp xếp</label>
                        <select class="form-select" name="sortOrder">
                            <option value="new">Mới nhất</option>
                            <option value="name">Tên A-Z</option>
                            <option value="quantity">Số lượng</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-grow-1" style="height: 46px;">
                                <i class="fa-solid fa-magnifying-glass me-2"></i>Tìm kiếm
                            </button>
                            <a asp-action="AdminIndex" class="btn btn-outline-secondary d-flex align-items-center justify-content-center" style="height: 46px; width: 46px;">
                                <i class="fa-solid fa-circle-xmark"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Danh sách sách</h5>
                <span class="text-muted">Tổng cộng @(ViewBag.TotalBooks ?? Model.Count()) cuốn sách</span>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="booksTable">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 140px;">ISBN</th>
                            <th>Tên sách</th>
                            <th>Danh mục</th>
                            <th>Tác giả</th>
                            <th style="width: 110px;">Số lượng</th>
                            <th>Vị trí</th>
                            <th style="width: 130px;">Giá</th>
                            <th style="width: 130px;">Trạng thái</th>
                            <th class="text-center" style="width: 200px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@item.ISBN</span></td>
                                <td><div class="fw-bold">@item.Title</div></td>
                                <td>
                                    <span class="text-dark">@(item.Category?.Name ?? "Chưa phân loại")</span>
                                </td>
                                <td>@(item.Author?.Name ?? "Ẩn danh")</td>
                                <td>
                                    <span class="fw-bold">@item.AvailableQuantity</span>
                                </td>
                                <td>@(item.Shelf?.Name ?? "Chưa xếp kệ")</td>
                                <td class="fw-bold text-secondary">@(item.Price.ToString("N0"))đ</td>
                                <td>
                                    @if (Context.HasPermission("book.edit"))
                                    {
                                        <select class="form-select form-select-sm status-dropdown" 
                                                data-book-id="@item.Id" 
                                                data-current-status="@item.BooksStatus"
                                                onchange="updateBookStatus(this)">
                                            <option value="0" selected="@(item.BooksStatus == SOF1022_NHOM1_SD2003_Ver2.Models.Enums.BooksStatus.Available)">Có sẵn</option>
                                            <option value="1" selected="@(item.BooksStatus == SOF1022_NHOM1_SD2003_Ver2.Models.Enums.BooksStatus.Hidden)">Ẩn</option>
                                            <option value="2" selected="@(item.BooksStatus == SOF1022_NHOM1_SD2003_Ver2.Models.Enums.BooksStatus.Lost)">Mất</option>
                                            <option value="3" selected="@(item.BooksStatus == SOF1022_NHOM1_SD2003_Ver2.Models.Enums.BooksStatus.Maintenance)">Đang bảo trì</option>
                                            <option value="4" selected="@(item.BooksStatus == SOF1022_NHOM1_SD2003_Ver2.Models.Enums.BooksStatus.OutOfStock)">Hết sách</option>
                                            <option value="5" selected="@(item.BooksStatus == SOF1022_NHOM1_SD2003_Ver2.Models.Enums.BooksStatus.Discontinued)">Ngừng kinh doanh</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.BooksStatus</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-action="AdminDetails" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm" title="Chi tiết">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        @if (Context.HasPermission("book.view"))
                                        {
                                            <a asp-action="PrintLabel" asp-route-id="@item.Id" target="_blank" class="btn btn-outline-secondary btn-sm" title="In nhãn mã vạch & QR gáy sách">
                                                <i class="fa-solid fa-qrcode"></i>
                                            </a>
                                        }
                                        @if (Context.HasPermission("book.edit"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm" title="Sửa">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                        }
                                        @if (Context.HasPermission("book.delete"))
                                        {
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Xóa">
                                                <i class="fa-solid fa-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body text-center py-5">
                <i class="fa-solid fa-book-open fa-5x text-secondary mb-4"></i>
                <h3 class="fw-bold">Không tìm thấy sách nào</h3>
                <p class="text-muted">Hãy thử thay đổi từ khóa hoặc điều kiện bộ lọc tìm kiếm.</p>
                <a asp-action="AdminIndex" class="btn btn-primary px-4">
                    Hiển thị tất cả
                </a>
            </div>
        </div>
    }

    @if (ViewBag.TotalPages > 1)
    {
        <div class="pagination-section mt-4">
            <nav>
                <ul class="pagination justify-content-center">
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="AdminIndex" asp-route-pageCount="@(ViewBag.CurrentPage - 1)" asp-route-searchString="@ViewBag.SearchString" asp-route-categoryId="@ViewBag.CategoryId">Trước</a>
                        </li>
                    }

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="AdminIndex" asp-route-pageCount="@i" asp-route-searchString="@ViewBag.SearchString" asp-route-categoryId="@ViewBag.CategoryId">@i</a>
                        </li>
                    }

                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="AdminIndex" asp-route-pageCount="@(ViewBag.CurrentPage + 1)" asp-route-searchString="@ViewBag.SearchString" asp-route-categoryId="@ViewBag.CategoryId">Sau</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }

</div>

<style>
    .card {
        border: none;
        border-radius: 14px;
        overflow: hidden;
    }

    .card-header {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border);
    }

    .table {
        margin-bottom: 0;
    }

    .table thead th {
        font-weight: 700;
        white-space: nowrap;
        border-bottom: 2px solid var(--border);
    }

    .table tbody td {
        vertical-align: middle;
    }

    .table tbody tr {
        transition: .25s ease;
    }

    .table tbody tr:hover {
        background: rgba(var(--bs-primary-rgb, 13, 110, 253), 0.04);
    }

    .form-control, .form-select {
        height: 46px;
        border-radius: 8px;
    }

    .form-control:focus, .form-select:focus {
        box-shadow: none;
        border-color: #0d6efd;
    }

    .btn {
        border-radius: 8px;
    }

    .badge {
        padding: 7px 12px;
        font-weight: 600;
    }

    .text-muted {
        color: #6c757d !important;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .pagination .page-link {
        color: #0d6efd;
        border-radius: 8px;
        margin: 0 4px;
    }

    .pagination .page-item.active .page-link {
        background-color: #0d6efd;
        border-color: #0d6efd;
        color: #fff;
    }

    /* Đã sửa thêm 2 dấu @@ để không bị lỗi Razor */
    @@media(max-width:992px) {
        .table {
            min-width: 950px;
        }
    }

    @@media(max-width:768px) {
        h2 {
            font-size: 28px;
        }
    }

    .status-dropdown {
        min-width: 140px;
    }
</style>

<script>
    async function updateBookStatus(selectElement) {
        const bookId = selectElement.getAttribute('data-book-id');
        const newStatus = parseInt(selectElement.value);
        const currentStatus = parseInt(selectElement.getAttribute('data-current-status'));
        
        // If status hasn't changed, do nothing
        if (newStatus === currentStatus) {
            return;
        }

        // Get anti-forgery token
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        const { isConfirmed } = await Swal.fire({
            title: 'Xác nhận',
            text: 'Bạn có chắc muốn thay đổi trạng thái của sách này?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Đồng ý',
            cancelButtonText: 'Huỷ'
        });
        if (!isConfirmed) {
            // Revert to original selection
            selectElement.value = currentStatus;
            return;
        }

        fetch('/Books/UpdateStatus', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: `bookId=${bookId}&newStatus=${newStatus}`
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Update the current status attribute
                selectElement.setAttribute('data-current-status', newStatus);
                // Show success message
                Swal.fire({ icon: 'success', title: 'Thông báo', text: data.message });
                // Optionally reload the page to reflect changes
                location.reload();
            } else {
                // Revert to original selection
                selectElement.value = currentStatus;
                Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Lỗi: ' + data.message });
            }
        })
        .catch(error => {
            // Revert to original selection
            selectElement.value = currentStatus;
            Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Có lỗi xảy ra: ' + error.message });
        });
    }
</script>

<!-- Modal Nhập Sách Từ Excel -->
<div class="modal fade" id="importExcelModal" tabindex="-1" aria-labelledby="importExcelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="ImportFromExcel" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="importExcelModalLabel">
                        <i class="fa-solid fa-file-excel me-2"></i>Nhập danh mục sách từ file Excel
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        Vui lòng chuẩn bị file định dạng <strong>.xlsx</strong> theo đúng cấu trúc tiêu chuẩn để dữ liệu không bị lỗi.
                    </div>
                    <div class="mb-3 text-end">
                        <a asp-action="DownloadImportTemplate" class="btn btn-outline-success btn-sm">
                            <i class="fa-solid fa-download me-1"></i> Tải file mẫu nhập sách (.xlsx)
                        </a>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Chọn file dữ liệu (.xlsx):</label>
                        <input type="file" name="file" class="form-control" accept=".xlsx" required />
                    </div>
                    <div class="small text-muted">
                        <em>Hệ thống sẽ tự động liên kết hoặc tạo mới Tác giả, Thể loại và Nhà xuất bản tương ứng nếu chưa tồn tại.</em>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-cloud-arrow-up me-1"></i> Bắt đầu nhập dữ liệu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


