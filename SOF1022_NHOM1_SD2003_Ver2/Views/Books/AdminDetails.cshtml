@model SOF1022_NHOM1_SD2003_Ver2.Models.Books

@{
    ViewData["Title"] = "Chi tiết Sách";
}

<div class="container-fluid py-4 px-md-5">
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-light p-3 rounded-circle text-primary shadow-sm">
                <i class="fas fa-book fa-lg"></i>
            </div>
            <div>
                <h4 class="mb-0 text-dark fw-bold">Quản lý Sách</h4>
                <small class="text-muted">Xem chi tiết thông tin sách trong hệ thống thư viện</small>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm bg-white rounded-3 overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 px-4" style="border-left: 4px solid #0d6efd !important;">
            <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-eye me-2 text-muted"></i>Chi tiết sách: @Model.Title</h5>
        </div>
        <div class="card-body p-4 bg-light">
            <div class="row">
                <div class="col-md-4 text-center mb-4">
                    @if (!string.IsNullOrEmpty(Model.CoverImage)) {
                        <img src="@Model.CoverImage" class="img-fluid rounded shadow-sm" style="max-height: 350px; object-fit: cover;" alt="Bìa sách" />
                    } else {
                        <div class="bg-light text-muted d-flex align-items-center justify-content-center rounded" style="height: 350px;">
                            <i class="fas fa-book fa-3x"></i>
                        </div>
                    }
                </div>
                <div class="col-md-8">
                    <div class="card border-0 shadow-sm bg-white rounded-3">
                        <div class="card-body p-4">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="text-muted small fw-semibold">ISBN</label>
                                    <div class="fw-bold text-dark font-monospace">@Model.ISBN</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small fw-semibold">Tên sách</label>
                                    <div class="fw-bold text-primary fs-5">@Model.Title</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small fw-semibold">Tác giả</label>
                                    <div class="text-dark fw-semibold">
                                        @(Model.Author?.Name ?? "N/A")
                                        @if (!string.IsNullOrEmpty(Model.Author?.Nationality))
                                        {
                                            <span class="badge bg-light text-dark border ms-1">@Model.Author.Nationality</span>
                                        }
                                        @if (Model.Author?.DateOfBirth.HasValue == true)
                                        {
                                            <small class="text-muted d-block mt-1"><i class="fas fa-birthday-cake me-1"></i>Sinh: @Model.Author.DateOfBirth.Value.ToString("dd/MM/yyyy")</small>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small fw-semibold">Danh mục</label>
                                    <div class="text-dark"><span class="badge bg-primary-subtle text-primary border border-primary fs-6">@(Model.Category?.Name ?? "N/A")</span></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small fw-semibold">Nhà xuất bản</label>
                                    <div class="text-dark fw-semibold">
                                        @(Model.Publisher?.Name ?? "N/A")
                                        @if (!string.IsNullOrEmpty(Model.Publisher?.Phone) || !string.IsNullOrEmpty(Model.Publisher?.Email))
                                        {
                                            <small class="text-muted d-block mt-1">
                                                <i class="fas fa-phone-alt me-1"></i>@(Model.Publisher?.Phone ?? "-") | <i class="fas fa-envelope me-1"></i>@(Model.Publisher?.Email ?? "-")
                                            </small>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small fw-semibold">Vị trí Kệ sách</label>
                                    <div class="text-dark">
                                        <span class="badge bg-success-subtle text-success border border-success fs-6"><i class="fas fa-archive me-1"></i>@(Model.Shelf?.Name ?? "N/A")</span>
                                        <small class="text-muted d-block mt-1">Khu vực: @(Model.Shelf?.Area ?? "-") | Mã ô: @(Model.Shelf?.LocationCode ?? Model.Shelf?.Code ?? "-") | Sức chứa: @(Model.Shelf?.Capacity ?? 300) cuốn</small>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <label class="text-muted small fw-semibold">Năm xuất bản</label>
                                    <div class="text-dark fw-bold">@(Model.PublishYear > 0 ? $"Năm {Model.PublishYear}" : "-")</div>
                                </div>
                                <div class="col-md-3">
                                    <label class="text-muted small fw-semibold">Ấn bản / Lần in</label>
                                    <div class="text-dark">@(string.IsNullOrEmpty(Model.Edition) ? "Bản chuẩn" : Model.Edition)</div>
                                </div>
                                <div class="col-md-3">
                                    <label class="text-muted small fw-semibold">Số trang</label>
                                    <div class="text-dark">@(Model.PageCount > 0 ? $"{Model.PageCount} trang" : "-")</div>
                                </div>
                                <div class="col-md-3">
                                    <label class="text-muted small fw-semibold">Ngôn ngữ</label>
                                    <div class="text-dark">@(string.IsNullOrEmpty(Model.Language) ? "Tiếng Việt" : Model.Language)</div>
                                </div>
                                <div class="col-md-4">
                                    <label class="text-muted small fw-semibold">Giá bìa niêm yết</label>
                                    <div class="fw-bold text-success fs-5">@Model.Price.ToString("N0") VNĐ</div>
                                </div>
                                <div class="col-md-4">
                                    <label class="text-muted small fw-semibold">Lần mượn gần nhất</label>
                                    <div class="text-dark">@(Model.LastBorrowDate.HasValue ? Model.LastBorrowDate.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa có lượt mượn")</div>
                                </div>
                                <div class="col-md-4">
                                    <label class="text-muted small fw-semibold">Độ tuổi tối thiểu</label>
                                    <div class="text-dark">@(Model.MinimumAge > 0 ? $"{Model.MinimumAge}+ tuổi" : "Mọi độ tuổi")</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small fw-semibold">Tổng số lượng trong kho</label>
                                    <div><span class="badge bg-info fs-6">@Model.Quantity cuốn</span></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small fw-semibold">Số lượng sẵn sàng</label>
                                    <div><span class="badge bg-success fs-6">@Model.AvailableQuantity cuốn</span></div>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.Keywords))
                                {
                                    <div class="col-12">
                                        <label class="text-muted small fw-semibold">Từ khóa</label>
                                        <div>
                                            @foreach (var kw in Model.Keywords.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries))
                                            {
                                                <span class="badge bg-light text-secondary border me-1">@kw.Trim()</span>
                                            }
                                        </div>
                                    </div>
                                }
                                <div class="col-12">
                                    <label class="text-muted small fw-semibold">Mô tả tóm tắt</label>
                                    <div class="text-muted" style="line-height: 1.6;">@(string.IsNullOrWhiteSpace(Model.Description) ? "Chưa có mô tả" : Model.Description)</div>
                                </div>
                                @if (Model.Author != null && !string.IsNullOrWhiteSpace(Model.Author.Biography))
                                {
                                    <div class="col-12 pt-2 border-top">
                                        <label class="text-muted small fw-semibold"><i class="fas fa-feather-alt text-warning me-1"></i>Tiểu sử tác giả (@Model.Author.Name)</label>
                                        <div class="text-muted small" style="line-height: 1.6;">@Model.Author.Biography</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top d-flex gap-2 justify-content-end">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-lg px-4 fs-6 rounded-2"><i class="fas fa-edit me-2"></i>Chỉnh sửa</a>
                <a asp-action="AdminIndex" class="btn btn-light border btn-lg px-4 fs-6 rounded-2 text-secondary"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
            </div>
        </div>
    </div>
</div>
