@model IEnumerable<SOF1022_NHOM1_SD2003_Ver2.Models.Books>

@{
    ViewData["Title"] = "Kết quả tìm kiếm";
    Layout = "_ReaderLayout";
}

<div class="search-header py-5">
    <div class="container text-center">
        <h1 class="display-4 fw-bold text-white mb-3">
            <i class="bi bi-search me-2"></i>Kết quả tìm kiếm
        </h1>
        <p class="lead text-secondary">
            Từ khóa: <span class="text-warning fw-bold">"@ViewBag.Keyword"</span>
        </p>
        <span class="badge bg-secondary px-3 py-2 fs-6 mt-2">
            Tìm thấy <strong>@Model.Count()</strong> cuốn sách
        </span>
    </div>
</div>

<div class="container py-5">

    @if (!Model.Any())
    {
        <div class="empty-search text-center py-5">
            <div class="display-1 mb-4 text-muted"><i class="bi bi-journal-x"></i></div>
            <h3 class="fw-bold text-white mb-3">Không tìm thấy sách phù hợp</h3>
            <p class="text-secondary mb-4">
                Hãy thử tìm bằng tên sách, tác giả, ISBN hoặc từ khóa khác.
            </p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-success btn-lg rounded-pill px-4">
                Quay lại trang chủ
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="book-card h-100">
                        
                        <div class="book-image">
                            <img src="@item.CoverImage" onerror="this.src='/images/no-book.png'" alt="@item.Title">
                            
                            @if (item.AvailableQuantity > 0)
                            {
                                <span class="badge bg-success position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill">
                                    Còn sách
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill">
                                    Hết sách
                                </span>
                            }
                        </div>

                        <div class="book-content">
                            <h5>@item.Title</h5>
                            <p class="text-secondary mb-1"><i class="bi bi-person me-1"></i>@item.Author?.Name</p>
                            <small class="text-muted d-block mb-2"><i class="bi bi-folder me-1"></i>@item.Category?.Name</small>
                            <hr>
                            
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-success fw-bold">
                                    Còn @item.AvailableQuantity quyển
                                </span>
                            </div>

                            <div class="d-grid mt-3">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-success rounded-pill">
                                    Xem chi tiết
                                </a >
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .search-header {
        background: #FFFFFF;
        border-bottom: 1px solid #E2E8F0;
    }

    .empty-search {
        background: #FFFFFF;
        border-radius: 20px;
        border: 1px solid #E2E8F0;
    }

    .book-card {
        background: #FFFFFF;
        border-radius: 20px;
        overflow: hidden;
        transition: .35s;
        border: 1px solid #E2E8F0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

    .book-card:hover {
        box-shadow: 0 15px 35px rgba(0,255,120,.15);
    }

    .book-image {
        height: 320px;
        overflow: hidden;
        position: relative;
    }

    .book-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: .5s;
    }

    .book-content {
        padding: 22px;
    }

    .book-content h5 {
        height: 56px;
        overflow: hidden;
        font-weight: 600;
        color: white;
    }

    @@media(max-width:768px) {
        .book-image {
            height: 260px;
        }
    }
</style>