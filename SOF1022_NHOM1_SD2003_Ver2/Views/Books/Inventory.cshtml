@model IEnumerable<SOF1022_NHOM1_SD2003_Ver2.Models.Books>

@{
    ViewData["Title"] = "Quản lý Kho Sách";
}

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h2 class="fw-bold mb-1">
                        <i class="fas fa-boxes text-info me-2"></i>
                        Quản lý Kho Sách
                    </h2>
                    <p class="text-muted mb-0">
                        Cập nhật số lượng tồn kho cho toàn bộ danh sách sách
                    </p>
                </div>
                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                    <a asp-action="AdminIndex" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>
                        Quay lại danh sách
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Danh sách kho sách</h5>
                <span class="text-muted">Tổng cộng @Model.Count() cuốn sách</span>
            </div>
        </div>
        <div class="card-body">
            <!-- Filter Toolbar -->
            <div class="card p-3 mb-4 shadow-sm border-0 bg-light">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-secondary small mb-1">Tìm kiếm</label>
                        <input type="text" id="search-input" class="form-control" placeholder="Nhập tên sách hoặc ISBN..." />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-secondary small mb-1">Danh mục</label>
                        <select id="category-filter" class="form-select">
                            <option value="">Tất cả danh mục</option>
                            @if (ViewBag.Categories != null)
                            {
                                @foreach (var cat in ViewBag.Categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-secondary small mb-1">Kệ sách</label>
                        <select id="shelf-filter" class="form-select">
                            <option value="">Tất cả kệ sách</option>
                            @if (ViewBag.Shelves != null)
                            {
                                @foreach (var shelf in ViewBag.Shelves)
                                {
                                    <option value="@shelf.Id">@shelf.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="button" id="clear-filters" class="btn btn-outline-secondary w-100">
                            <i class="fas fa-times me-1"></i>Xóa bộ lọc
                        </button>
                    </div>
                </div>
            </div>
            <!-- Bulk Operations Area -->
            <div class="card p-3 mb-4 shadow-sm border-0 bg-light">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold text-secondary">Cập nhật kho hàng loạt:</span>
                        <input type="number" id="bulk-modifier-input" class="form-control" style="width: 100px;" value="1" min="1" max="1000" disabled />
                    </div>
                    
                    <div class="bulk-buttons-group">
                        <button type="button" id="btn-trigger-bulk" class="btn btn-primary">
                            <i class="fas fa-edit me-1"></i> Bật chỉnh sửa hàng loạt
                        </button>

                        <div id="bulk-action-group" class="d-none">
                            <button type="button" id="btn-bulk-add" class="btn btn-success me-1"><i class="fas fa-plus"></i> Tăng (+)</button>
                            <button type="button" id="btn-bulk-sub" class="btn btn-danger me-1"><i class="fas fa-minus"></i> Giảm (-)</button>
                            <button type="button" id="btn-bulk-save" class="btn btn-success me-1"><i class="fas fa-save"></i> Lưu kho hàng loạt</button>
                            <button type="button" id="btn-bulk-cancel" class="btn btn-secondary"><i class="fas fa-times"></i> Hủy</button>
                        </div>
                    </div>
                </div>
            </div>

            <form id="inventoryForm" asp-action="UpdateInventory" method="post">
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="inventory-table">
                        <thead>
                            <tr>
                                <th>ISBN</th>
                                <th>Tên sách</th>
                                <th>Danh mục</th>
                                <th>Tác giả</th>
                                <th style="width: 120px;">Số lượng hiện tại</th>
                                <th style="width: 150px;">Số lượng mới</th>
                                <th>Vị trí</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="book-row" 
                                    data-isbn="@item.ISBN" 
                                    data-book-id="@item.Id" 
                                    data-current-qty="@item.AvailableQuantity"
                                    data-title="@item.Title.ToLower()"
                                    data-category-id="@item.CategoriesId"
                                    data-shelf-id="@item.ShelvesId">
                                    <td><span class="badge bg-secondary">@item.ISBN</span></td>
                                    <td class="fw-bold">@item.Title</td>
                                    <td>@(item.Category?.Name ?? "Chưa phân loại")</td>
                                    <td>@(item.Author?.Name ?? "Ẩn danh")</td>
                                    <td class="current-qty fw-bold text-center">@item.AvailableQuantity</td>
                                    <td>
                                        <input type="number" class="form-control new-qty-input" 
                                               name="updates[@item.Id].NewQuantity" value="@item.AvailableQuantity" 
                                               data-book-id="@item.Id" data-isbn="@item.ISBN" min="0" max="1000" disabled />
                                        <input type="hidden" name="updates[@item.Id].BookId" value="@item.Id" />
                                    </td>
                                    <td>@(item.Shelf?.Name ?? "Chưa xếp kệ")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // State
            let isBulkEditMode = false;

            // DOM Elements
            const $triggerBtn = $('#btn-trigger-bulk');
            const $actionGroup = $('#bulk-action-group');
            const $modifierInput = $('#bulk-modifier-input');
            const $qtyInputs = $('.new-qty-input');
            const $form = $('#inventoryForm');

            // Enable Bulk Edit Mode
            $triggerBtn.on('click', function() {
                isBulkEditMode = true;
                $triggerBtn.addClass('d-none');
                $actionGroup.removeClass('d-none');
                $modifierInput.prop('disabled', false);
                $qtyInputs.prop('disabled', false);
            });

            // Cancel Bulk Edit Mode
            $('#btn-bulk-cancel').on('click', function() {
                isBulkEditMode = false;
                $triggerBtn.removeClass('d-none');
                $actionGroup.addClass('d-none');
                $modifierInput.prop('disabled', true).val(1);
                $qtyInputs.prop('disabled', true);
                
                // Reset all inputs to original quantities
                $('.book-row').each(function() {
                    const originalQty = $(this).data('current-qty');
                    $(this).find('.new-qty-input').val(originalQty);
                });
            });

            // Increase Quantities
            $('#btn-bulk-add').on('click', function() {
                const modifier = parseInt($modifierInput.val()) || 1;
                $qtyInputs.each(function() {
                    const currentVal = parseInt($(this).val()) || 0;
                    $(this).val(currentVal + modifier);
                });
            });

            // Decrease Quantities
            $('#btn-bulk-sub').on('click', function() {
                const modifier = parseInt($modifierInput.val()) || 1;
                $qtyInputs.each(function() {
                    const currentVal = parseInt($(this).val()) || 0;
                    $(this).val(Math.max(0, currentVal - modifier));
                });
            });

            // Save Changes
            $('#btn-bulk-save').on('click', function() {
                $form.submit();
            });

            // Form Submission Handler
            $form.on('submit', function(e) {
                e.preventDefault();
                
                const updates = [];
                let hasChanges = false;

                $('.book-row').each(function() {
                    const isbn = $(this).data('isbn');
                    const bookId = $(this).data('book-id');
                    const originalQty = $(this).data('current-qty');
                    const newQty = parseInt($(this).find('.new-qty-input').val());

                    if (newQty !== originalQty) {
                        hasChanges = true;
                        updates.push({
                            Isbn: isbn,
                            BookId: bookId,
                            NewQuantity: newQty
                        });
                    }
                });

                if (!hasChanges) {
                    Swal.fire({
                        title: 'Thông báo',
                        text: 'Không có thay đổi nào để lưu',
                        icon: 'warning'
                    });
                    return;
                }

                Swal.fire({
                    title: 'Xác nhận cập nhật',
                    text: `Bạn có chắc chắn muốn cập nhật kho cho ${updates.length} sách?`,
                        icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Có, cập nhật',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                    $.ajax({
                        url: $(this).attr('action'),
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(updates),
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire({
                                    title: 'Thành công',
                                    text: response.message,
                                    icon: 'success'
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire({
                                    title: 'Lỗi',
                                    text: response.message,
                                    icon: 'error'
                                });
                            }
                        },
                        error: function() {
                            Swal.fire({
                                title: 'Lỗi',
                                text: 'Có lỗi xảy ra khi cập nhật kho',
                                icon: 'error'
                            });
                        }
                    });
                    }
                });
            });

            // Input validation - prevent negative values and overflow
            $(document).on('input', '.new-qty-input', function() {
                let val = parseInt($(this).val());
                if (isNaN(val) || val < 0) {
                    $(this).val(0);
                } else if (val > 1000) {
                    $(this).val(1000);
                }
                // Prevent typing more than 4 digits
                if ($(this).val().length > 4) {
                    $(this).val($(this).val().slice(0, 4));
                }
            });

            // Input validation for bulk modifier
            $(document).on('input', '#bulk-modifier-input', function() {
                let val = parseInt($(this).val());
                if (isNaN(val) || val < 1) {
                    $(this).val(1);
                } else if (val > 1000) {
                    $(this).val(1000);
                }
                // Prevent typing more than 4 digits
                if ($(this).val().length > 4) {
                    $(this).val($(this).val().slice(0, 4));
                }
            });

            // Filter functionality
            function filterTable() {
                const searchTerm = $('#search-input').val().toLowerCase();
                const categoryFilter = $('#category-filter').val();
                const shelfFilter = $('#shelf-filter').val();

                $('.book-row').each(function() {
                    const $row = $(this);
                    const title = $row.data('title');
                    const isbn = $row.data('isbn').toLowerCase();
                    const categoryId = $row.data('category-id');
                    const shelfId = $row.data('shelf-id');

                    let matchesSearch = title.includes(searchTerm) || isbn.includes(searchTerm);
                    let matchesCategory = categoryFilter === '' || categoryId == categoryFilter;
                    let matchesShelf = shelfFilter === '' || shelfId == shelfFilter;

                    if (matchesSearch && matchesCategory && matchesShelf) {
                        $row.show();
                    } else {
                        $row.hide();
                    }
                });

                // Update visible count
                const visibleCount = $('.book-row:visible').length;
                $('span.text-muted').text(`Tổng cộng ${visibleCount} cuốn sách`);
            }

            // Event listeners for filters
            $('#search-input').on('input', filterTable);
            $('#category-filter').on('change', filterTable);
            $('#shelf-filter').on('change', filterTable);

            // Clear filters button
            $('#clear-filters').on('click', function() {
                $('#search-input').val('');
                $('#category-filter').val('');
                $('#shelf-filter').val('');
                filterTable();
            });
        });
    </script>
}
