@model SOF1022_NHOM1_SD2003_Ver2.Models.SystemSettings

@{
    ViewData["Title"] = "Cài đặt hệ thống";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fas fa-cogs me-2"></i>Cài đặt hệ thống</h4>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-4">
                            <h5 class="text-primary mb-3"><i class="fas fa-calendar-alt me-2"></i>Cài đặt gia hạn sách</h5>
                            
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="MaxExtensionDays" class="form-label fw-bold">Số ngày gia hạn tối đa</label>
                                    <input asp-for="MaxExtensionDays" class="form-control" type="number" min="1" max="30" required />
                                    <small class="text-muted">Số ngày tối đa có thể gia hạn cho mỗi lần yêu cầu</small>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="MaxExtensionCount" class="form-label fw-bold">Số lần gia hạn tối đa</label>
                                    <input asp-for="MaxExtensionCount" class="form-control" type="number" min="1" max="5" required />
                                    <small class="text-muted">Số lần gia hạn tối đa cho mỗi cuốn sách</small>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <h5 class="text-primary mb-3"><i class="fas fa-money-bill-wave me-2"></i>Cài đặt phí phạt</h5>
                            
                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <label asp-for="LateFeePerDay" class="form-label fw-bold">Phí phạt trễ hạn mỗi ngày (VNĐ)</label>
                                    <input asp-for="LateFeePerDay" class="form-control" type="number" min="0" step="1000" required />
                                    <small class="text-muted">Số tiền phạt cho mỗi ngày trễ hạn</small>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <h5 class="text-primary mb-3"><i class="fas fa-book me-2"></i>Cài đặt mượn sách</h5>
                            
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="MaxBorrowBooks" class="form-label fw-bold">Số sách mượn tối đa</label>
                                    <input asp-for="MaxBorrowBooks" class="form-control" type="number" min="1" max="50" required />
                                    <small class="text-muted">Số sách tối đa mỗi độc giả có thể mượn cùng lúc</small>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="BorrowPeriodDays" class="form-label fw-bold">Thời gian mượn mặc định (ngày)</label>
                                    <input asp-for="BorrowPeriodDays" class="form-control" type="number" min="1" max="60" required />
                                    <small class="text-muted">Số ngày mặc định cho mỗi lần mượn</small>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i>Lưu cài đặt
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
