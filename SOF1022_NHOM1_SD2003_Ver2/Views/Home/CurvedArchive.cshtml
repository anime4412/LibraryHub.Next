@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <title>Kệ Sách Tinh Hoa 3D — Thư Viện Điện Tử FPT Polytechnic</title>
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <!-- FontAwesome for Return / Utility icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #ECE8E0;
        }
        .vhs-portal-back-btn {
            position: fixed;
            top: 24px;
            right: 36px;
            z-index: 50;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 18px;
            border-radius: 99px;
            border: 1px solid #1F3FB0;
            background: rgba(236, 232, 224, 0.85);
            backdrop-filter: blur(8px);
            color: #1F3FB0;
            font-family: "Inter Tight", sans-serif;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            text-decoration: none;
            transition: all 0.25s ease;
            box-shadow: 0 4px 14px rgba(31, 63, 176, 0.15);
        }
        .vhs-portal-back-btn:hover {
            background: #1F3FB0;
            color: #ECE8E0;
            transform: translateY(-1px);
        }
        @@media (max-width: 767px) {
            .vhs-portal-back-btn {
                top: 14px;
                right: 56px;
                padding: 6px 12px;
                font-size: 9.5px;
            }
        }
    </style>
</head>
<body>
    <a asp-controller="Home" asp-action="Index" class="vhs-portal-back-btn">
        <i class="fa-solid fa-arrow-left"></i> Về Thư Viện
    </a>

    <!-- Render the complete Curved VHS Archive Component -->
    <partial name="_VhsCurvedArchive" />
</body>
</html>
