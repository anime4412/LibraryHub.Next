@model IEnumerable<SOF1022_NHOM1_SD2003_Ver2.Models.SupportTickets>
@using SOF1022_NHOM1_SD2003_Ver2.Models.Enums

@{
    ViewData["Title"] = "Yêu cầu hỗ trợ";
    var statusFilter = ViewData["StatusFilter"] as SupportTicketStatus?;
    var openCount = ViewData["OpenCount"] as int? ?? 0;
}

@Html.AntiForgeryToken()

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-1 fw-bold">
                                <i class="fa-solid fa-headset text-primary me-2"></i>Yêu cầu hỗ trợ
                            </h4>
                            <p class="text-muted mb-0">Quản lý các yêu cầu hỗ trợ từ độc giả</p>
                        </div>
                        <div class="btn-group" role="group">
                            <a asp-action="Index" asp-route-statusFilter="null" 
                               class="btn @(statusFilter == null ? "btn-primary" : "btn-outline-primary")">
                                Tất cả
                            </a>
                            <a asp-action="Index" asp-route-statusFilter="@SupportTicketStatus.Open" 
                               class="btn @(statusFilter == SupportTicketStatus.Open ? "btn-primary" : "btn-outline-primary")">
                                Chờ xử lý
                                @if (openCount > 0)
                                {
                                    <span class="badge bg-danger ms-1">@openCount</span>
                                }
                            </a>
                            <a asp-action="Index" asp-route-statusFilter="@SupportTicketStatus.InProgress" 
                               class="btn @(statusFilter == SupportTicketStatus.InProgress ? "btn-primary" : "btn-outline-primary")">
                                Đang xử lý
                            </a>
                            <a asp-action="Index" asp-route-statusFilter="@SupportTicketStatus.Closed" 
                               class="btn @(statusFilter == SupportTicketStatus.Closed ? "btn-primary" : "btn-outline-primary")">
                                Đã đóng
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div data-open-count="@openCount" style="display: none;"></div>
                    
                    @if (Model == null || !Model.Any())
                    {
                        <div class="text-center py-5">
                            <i class="fa-solid fa-inbox fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Không có yêu cầu hỗ trợ nào</h5>
                            <p class="text-muted">Chưa có yêu cầu hỗ trợ nào trong danh sách này.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Mã ticket</th>
                                        <th>Độc giả</th>
                                        <th>Chủ đề</th>
                                        <th>Trạng thái</th>
                                        <th>Nhân viên xử lý</th>
                                        <th>Ngày tạo</th>
                                        <th>Hoạt động gần nhất</th>
                                        <th class="text-end">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ticket in Model)
                                    {
                                        <tr>
                                            <td>
                                                <span class="fw-semibold text-primary">@ticket.TicketCode</span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar-circle bg-primary text-white me-2">
                                                        @(ticket.Reader?.FullName?.Substring(0, 1).ToUpper() ?? "D")
                                                    </div>
                                                    <div>
                                                        <div class="fw-semibold">@ticket.Reader?.FullName</div>
                                                        <small class="text-muted">@ticket.Reader?.Email</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="text-muted">
                                                    @(string.IsNullOrEmpty(ticket.Subject) ? "Không có chủ đề" : ticket.Subject)
                                                </span>
                                                @if (ticket.UnreadByStaff)
                                                {
                                                    <span class="badge bg-danger ms-1">Mới</span>
                                                }
                                            </td>
                                            <td>
                                                @switch (ticket.Status)
                                                {
                                                    case SupportTicketStatus.Open:
                                                        <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                                        break;
                                                    case SupportTicketStatus.InProgress:
                                                        <span class="badge bg-info">Đang xử lý</span>
                                                        break;
                                                    case SupportTicketStatus.Closed:
                                                        <span class="badge bg-secondary">Đã đóng</span>
                                                        break;
                                                }
                                            </td>
                                            <td>
                                                @if (ticket.AssignedStaff != null)
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <div class="avatar-circle bg-success text-white me-2" style="width: 30px; height: 30px; font-size: 12px;">
                                                            @(ticket.AssignedStaff.FullName?.Substring(0, 1).ToUpper() ?? "N")
                                                        </div>
                                                        <span>@ticket.AssignedStaff.FullName</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Chưa gán</span>
                                                }
                                            </td>
                                            <td>
                                                <small>@ticket.CreatedDate.ToString("dd/MM/yyyy HH:mm")</small>
                                            </td>
                                            <td>
                                                <small>@ticket.LastMessageDate.ToString("dd/MM/yyyy HH:mm")</small>
                                            </td>
                                            <td class="text-end">
                                                <div class="btn-group">
                                                    <a asp-action="Details" asp-route-id="@ticket.Id" 
                                                       class="btn btn-sm btn-outline-primary">
                                                        <i class="fa-solid fa-eye"></i> Xem
                                                    </a>
                                                    @if (ticket.Status == SupportTicketStatus.Open && Context.HasPermission("support.reply"))
                                                    {
                                                        <button type="button" 
                                                                class="btn btn-sm btn-outline-success claim-ticket-btn"
                                                                data-ticket-id="@ticket.Id">
                                                            <i class="fa-solid fa-hand-paper"></i> Nhận xử lý
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Claim ticket functionality
        document.querySelectorAll('.claim-ticket-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                const ticketId = this.getAttribute('data-ticket-id');
                
                Swal.fire({
                    title: 'Nhận xử lý yêu cầu?',
                    text: 'Bạn sẽ trở thành người chịu trách nhiệm xử lý yêu cầu này.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#198754',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Đồng ý nhận',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        const formData = new FormData();
                        formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
                        
                        fetch('/SupportTickets/Claim?id=' + ticketId, {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                            },
                            body: formData
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Thành công!',
                                    text: data.message,
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => {
                                    window.location.reload();
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Lỗi!',
                                    text: data.message
                                });
                            }
                        })
                        .catch(error => {
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi!',
                                text: 'Có lỗi xảy ra. Vui lòng thử lại.'
                            });
                        });
                    }
                });
            });
        });

        // Real-time: tự động cập nhật danh sách khi có ticket mới / được nhận / bị đóng
        (function () {
            const staffConnection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/support')
                .withAutomaticReconnect()
                .build();

            function notifyAndReload(toastText) {
                if (window.Swal) {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'info',
                        title: toastText,
                        showConfirmButton: false,
                        timer: 1800
                    });
                }
                setTimeout(function () {
                    window.location.reload();
                }, 1200);
            }

            staffConnection.on('NewTicketCreated', function () {
                notifyAndReload('Có yêu cầu hỗ trợ mới');
            });
            staffConnection.on('TicketClaimed', function () {
                notifyAndReload('Một yêu cầu vừa được nhận xử lý');
            });
            staffConnection.on('TicketClosed', function () {
                notifyAndReload('Một yêu cầu vừa được đóng');
            });

            staffConnection.start()
                .then(function () {
                    return staffConnection.invoke('JoinStaffQueue');
                })
                .catch(function (err) {
                    console.error('SignalR staff-queue connection error:', err);
                });
        })();
    </script>
}
