@{
    Layout = null;
    ViewData["Title"] = "Truy cập bị từ chối";
    var userRole = Context.Session.GetString("Role");
    bool isStaff = !string.IsNullOrEmpty(userRole) && userRole != "Reader";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Truy cập bị từ chối - Thư viện điện tử</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link href="~/css/account.css" rel="stylesheet" />
</head>
<body class="auth-page">

    <div class="auth-split">
        <div class="auth-side">
            <div class="auth-side-top">
                <i class="fa-solid fa-bookmark"></i>
                <span>THƯ VIỆN ĐIỆN TỬ</span>
            </div>
            <p class="auth-quote">"Kiến thức<br>là ánh sáng<br>chiếu rọi con đường."</p>
            <div class="auth-card-strip">
                <div class="auth-card-strip-row">
                    <span>TRẠNG THÁI BẢO MẬT</span>
                    <span>KHÔNG ĐỦ QUYỀN HẠN</span>
                </div>
                <div class="auth-barcode">
                    <span></span><span></span><span></span><span></span><span></span>
                    <span></span><span></span><span></span><span></span>
                </div>
            </div>
        </div>
        <div class="auth-form-side">
            <div class="text-center mb-4">
                <div class="mb-3 d-inline-flex p-3 rounded-circle" style="background-color: #fee2e2; color: #dc2626;">
                    <i class="fa-solid fa-shield-halved fa-3x"></i>
                </div>
                <h2 class="text-heading" style="font-family: var(--font-display, 'Lora', serif); font-size: 24px; font-weight: 700; margin-bottom: 8px; color: #0f172a;">
                    Truy cập bị từ chối
                </h2>
                <p class="text-muted small">Bạn không có quyền truy cập vào đường dẫn hoặc tính năng này.</p>
            </div>

            <div class="alert alert-danger border-0 shadow-sm" style="background-color: #fef2f2; border-left: 4px solid #ef4444 !important; border-radius: 8px;">
                <div class="d-flex align-items-start">
                    <i class="fa-solid fa-triangle-exclamation text-danger mt-1 me-2 fs-5"></i>
                    <div>
                        <strong class="text-danger d-block mb-1">Cảnh báo bảo mật hệ thống:</strong>
                        <span class="text-secondary small">
                            Tài khoản của bạn hiện tại chưa được cấp quyền thực hiện chức năng này. Nếu bạn cần truy cập, vui lòng liên hệ <strong>Quản trị viên</strong> để được xem xét phân quyền theo nghiệp vụ.
                        </span>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <div class="d-grid gap-2">
                    @if (isStaff)
                    {
                        <a href="@Url.Action("Index", "Dashboard")" class="btn btn-primary py-2 fw-semibold">
                            <i class="fa-solid fa-chart-pie me-2"></i>Về Trang tổng quan
                        </a>
                    }
                    <a href="@Url.Action("Index", "Home")" class="btn @(isStaff ? "btn-outline-primary" : "btn-primary") py-2 fw-semibold">
                        <i class="fa-solid fa-house me-2"></i>Về trang độc giả
                    </a>
                    <a href="javascript:history.back()" class="btn btn-outline-secondary py-2">
                        <i class="fa-solid fa-arrow-left me-2"></i>Quay lại trang trước
                    </a>
                </div>
            </div>

            <div class="text-center mt-4">
                <p class="text-muted small">
                    <i class="fa-solid fa-headset me-1"></i>
                    Bộ phận kỹ thuật &amp; Hỗ trợ thư viện: <span class="fw-semibold text-dark">admin@library.com</span>
                </p>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
