@{
    Layout = null;
    ViewData["Title"] = "Đăng xuất";
}

<!DOCTYPE html>

<html lang="vi">
<head>

    <meta charset="utf-8" />

    <title>Đăng xuất thành công</title>

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          rel="stylesheet" />

    <link href="~/css/account.css"
          rel="stylesheet" />

</head>

<body class="auth-page">

    <div class="auth-wrapper">

        <div class="login-container">

            <!-- LEFT -->

            <div class="login-info">

                <div class="icon">
                    <i class="fa-solid fa-book-open-reader"></i>
                </div>

                <h1>

                    THƯ VIỆN ĐIỆN TỬ

                </h1>

                <p>

                    Cảm ơn bạn đã sử dụng hệ thống thư viện điện tử.

                    Hẹn gặp lại bạn trong lần truy cập tiếp theo.

                </p>

            </div>

            <!-- RIGHT -->

            <div class="login-card text-center">

                <i class="fa-solid fa-circle-check
                    fa-5x
                    text-success
                    mb-4">
                </i>

                <h2>

                    Đăng xuất thành công

                </h2>

                <p class="text-muted mb-4">

                    Phiên đăng nhập của bạn đã kết thúc an toàn.

                </p>

                <div class="d-grid gap-3">

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-success btn-auth">

                        <i class="fa-solid fa-right-to-bracket me-2"></i>

                        Đăng nhập lại

                    </a>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline-secondary">

                        <i class="fa-solid fa-house me-2"></i>

                        Về trang chủ

                    </a>

                </div>

            </div>

        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
