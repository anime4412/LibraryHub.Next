@{
    Layout = null;
    ViewData["Title"] = "Quên mật khẩu";
}

<!DOCTYPE html>

<html lang="vi">
<head>

    <meta charset="utf-8" />

    <title>Quên mật khẩu</title>

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          rel="stylesheet" />

    <link href="~/css/account.css"
          rel="stylesheet" />

</head>

<body class="auth-page">

    <div class="auth-wrapper">

        <div class="login-container">

            <!-- LEFT -->

            <div class="login-info">

                <div class="icon">

                    <i class="fa-solid fa-unlock-keyhole"></i>

                </div>

                <h1>

                    KHÔI PHỤC MẬT KHẨU

                </h1>

                <p>

                    Nhập email đã đăng ký để gửi yêu cầu
                    khôi phục mật khẩu tài khoản thư viện.

                </p>

                <div class="mt-4">

                    <div class="mb-3">

                        <i class="fa-solid fa-envelope text-warning me-2"></i>

                        Xác minh thông qua Email

                    </div>

                    <div class="mb-3">

                        <i class="fa-solid fa-shield-halved text-warning me-2"></i>

                        Bảo mật tài khoản người dùng

                    </div>

                    <div class="mb-3">

                        <i class="fa-solid fa-user-shield text-warning me-2"></i>

                        Hỗ trợ bởi quản trị viên

                    </div>

                </div>

            </div>


            <!-- RIGHT -->

            <div class="login-card">

                <div class="text-center mb-4">

                    <i class="fa-solid fa-key fa-3x text-success mb-3"></i>

                    <h2>

                        Quên mật khẩu

                    </h2>

                    <p class="text-muted">

                        Nhập email của bạn để gửi yêu cầu khôi phục

                    </p>

                </div>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">

                        <i class="fa-solid fa-circle-check me-2"></i>

                        @TempData["Success"]

                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All"
                         class="alert alert-danger">
                    </div>
                }

                <form asp-action="ForgotPassword"
                      asp-controller="Account"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="mb-4">

                        <label class="form-label">

                            Email

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="fa-solid fa-envelope"></i>

                            </span>

                            <input type="email"
                                   name="email"
                                   class="form-control"
                                   placeholder="Nhập email đã đăng ký"
                                   required />

                        </div>

                    </div>

                    <button type="submit"
                            class="btn btn-success btn-auth w-100">

                        <i class="fa-solid fa-paper-plane me-2"></i>

                        Gửi yêu cầu khôi phục

                    </button>

                </form>

                <hr class="my-4" />

                <div class="auth-link">

                    <a asp-action="Login"
                       asp-controller="Account">

                        <i class="fa-solid fa-arrow-left me-2"></i>

                        Quay lại đăng nhập

                    </a>

                    <div class="text-center mt-3">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="text-secondary">

                            <i class="fa-solid fa-house me-2"></i>

                            Trang chủ

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

</body>

</html>