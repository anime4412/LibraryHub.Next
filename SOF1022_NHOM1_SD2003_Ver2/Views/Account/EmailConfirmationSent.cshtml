@{
    Layout = null;
    ViewData["Title"] = "Xác nhận email";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Xác nhận email - Thư viện điện tử</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link href="~/css/account.css" rel="stylesheet" />
</head>
<body class="auth-page">

    <div class="auth-wrapper">
        <div class="login-container">
            <div class="login-card">
                <div class="text-center mb-4">
                    <i class="fa-solid fa-envelope-circle-check fa-3x text-success mb-3"></i>
                    <h2>Kiểm tra email của bạn</h2>
                    <p class="text-muted">Chúng tôi đã gửi liên kết xác nhận đến email của bạn</p>
                </div>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">
                        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">
                        <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["Error"]
                    </div>
                }

                <div class="alert alert-info">
                    <i class="fa-solid fa-info-circle me-2"></i>
                    <strong>Email xác nhận đã được gửi đến:</strong>
                    <div class="mt-2">
                        <span class="badge bg-primary fs-6">@ViewData["Email"]</span>
                    </div>
                </div>

                <div class="alert alert-warning">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    <strong>Lưu ý:</strong>
                    <ul class="mb-0 mt-2 small">
                        <li>Liên kết xác nhận sẽ hết hạn sau 24 giờ</li>
                        <li>Vui lòng kiểm tra cả thư mục Spam/Junk</li>
                        <li>Nhấp vào liên kết trong email để xác nhận tài khoản</li>
                    </ul>
                </div>

                @if (ViewData["Email"] != null)
                {
                    <form asp-action="ResendConfirmationEmail" asp-controller="Account" method="post" class="mt-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="email" value="@ViewData["Email"]" />
                        <button type="submit" class="btn btn-outline-primary w-100">
                            <i class="fa-solid fa-paper-plane me-2"></i>Gửi lại email xác nhận
                        </button>
                    </form>
                }

                <hr class="my-4" />

                <div class="text-center small">
                    <p class="mb-2">Đã xác nhận email?</p>
                    <a asp-action="Login" asp-controller="Account" class="btn btn-success w-100">
                        <i class="fa-solid fa-right-to-bracket me-2"></i>Đăng nhập ngay
                    </a>
                </div>

                <div class="text-center mt-3 small">
                    <a asp-controller="Home" asp-action="Index" class="text-secondary">
                        <i class="fa-solid fa-house me-1"></i>Quay về trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
