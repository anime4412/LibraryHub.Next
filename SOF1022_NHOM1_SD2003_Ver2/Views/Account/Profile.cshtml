            <div class="d-flex justify-content-end mt-4">
                <button class="btn btn-secondary me-2" onclick="closeTagPinModal()" style="background: rgba(255,255,255,0.1); color: #ffffff; border: 1px solid rgba(255,255,255,0.2);">Hủy</button>
                <button class="btn" id="confirmTagPinBtn" style="background: linear-gradient(135deg, var(--brand-base), var(--brand-hover)); color: var(--brand-ink); font-weight: 600;" onclick="submitTagPin()" disabled>Xác nhận</button>
