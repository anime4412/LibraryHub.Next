@model SOF1022_NHOM1_SD2003_Ver2.Models.Readers

@{
    ViewData["Title"] = "Hồ sơ của tôi";
    var userRole = Context.Session.GetString("Role") ?? "Reader";
    var isAdmin = userRole == "Admin" || userRole == "Librarian";
    
    // Use Admin layout for admin users, Reader layout for regular users
    if (isAdmin)
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_ReaderLayout.cshtml";
        ViewData["HideFooter"] = true;
    }
}

@if (isAdmin)
{
    // Admin Profile View (Simple, matches AdminProfile.cshtml structure)
    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body text-center py-5">
                        <div class="avatar-circle mb-3">
                            <i class="fas fa-user-shield fa-3x"></i>
                        </div>
                        <h4 class="fw-bold mb-1">@Model.FullName</h4>
                        <p class="text-muted mb-3">Quản trị viên</p>
                        <div class="badge bg-primary">Admin</div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">Thông tin tài khoản</h6>
                        <div class="mb-3">
                            <label class="text-muted small">Email</label>
                            <div class="fw-medium">@Model.Email</div>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small">Mã nhân viên</label>
                            <div class="fw-medium">@Model.ReaderCode</div>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small">Ngày đăng ký</label>
                            <div class="fw-medium">@Model.RegisterDate.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small">Trạng thái</label>
                            <div>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Đã khóa</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom py-3">
                        <h5 class="mb-0 fw-bold">Chỉnh sửa hồ sơ</h5>
                    </div>
                    <div class="card-body">
                        <form id="adminProfileForm">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Họ và tên</label>
                                    <input type="text" class="form-control" value="@Model.FullName" disabled>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Email</label>
                                    <input type="email" class="form-control" value="@Model.Email" disabled>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Số điện thoại</label>
                                    <input type="text" class="form-control" id="phone" name="phone" value="@Model.Phone">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">CCCD/CMND</label>
                                    <input type="text" class="form-control" value="@Model.IdentityNumber" disabled>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Địa chỉ</label>
                                <textarea class="form-control" id="address" name="address" rows="3">@Model.Address</textarea>
                            </div>

                            <div class="d-flex justify-content-end gap-2">
                                <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-primary">
                                    <i class="fas fa-key me-2"></i>Đổi mật khẩu
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save me-2"></i>Lưu thay đổi
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            document.getElementById('adminProfileForm').addEventListener('submit', async function(e) {
                e.preventDefault();
                
                const phone = document.getElementById('phone').value;
                const address = document.getElementById('address').value;
                
                const formData = new FormData();
                formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
                formData.append('phone', phone);
                formData.append('address', address);
                
                try {
                    const response = await fetch('/Account/UpdateAdminProfile', {
                        method: 'POST',
                        body: formData
                    });
                    
                    const result = await response.json();
                    
                    if (result.success) {
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công',
                                text: result.message,
                                confirmButtonText: 'Đóng'
                            });
                        } else {
                            Swal.fire({ icon: 'error', title: 'Lỗi', text: result.message });
                        }
                    } else {
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi',
                                text: result.message,
                                confirmButtonText: 'Đóng'
                            });
                        } else {
                            Swal.fire({ icon: 'error', title: 'Lỗi', text: result.message });
                        }
                    }
                } catch (error) {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: 'Đã xảy ra lỗi hệ thống. Vui lòng thử lại.',
                            confirmButtonText: 'Đóng'
                        });
                    } else {
                        Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Đã xảy ra lỗi hệ thống. Vui lòng thử lại.' });
                    }
                }
            });
        </script>
    }
}
else
{
    // Reader Profile View (Full-featured with customization)
    @functions {
        public string GetTimeAgo(DateTime dateTime)
        {
            var now = DateTime.Now;
            var span = now - dateTime;
            
            if (span.TotalSeconds < 60)
                return "Vừa xong";
            if (span.TotalMinutes < 60)
                return $"{(int)span.TotalMinutes} phút trước";
            if (span.TotalHours < 24)
                return $"{(int)span.TotalHours} giờ trước";
            if (span.TotalDays < 7)
                return $"{(int)span.TotalDays} ngày trước";
            if (span.TotalDays < 30)
                return $"{(int)(span.TotalDays / 7)} tuần trước";
            if (span.TotalDays < 365)
                return $"{(int)(span.TotalDays / 30)} tháng trước";
            return $"{(int)(span.TotalDays / 365)} năm trước";
        }
    }

    <style>
        /* Full-page background */
        .profile-page-wrapper {
            min-height: 100vh;
            padding: 20px;
            position: relative;
        }

        /* Video background */
        .video-background {
            position: fixed;
            right: 0;
            bottom: 0;
            min-width: 100%;
            min-height: 100%;
            width: auto;
            height: auto;
            z-index: -100;
            object-fit: cover;
        }

        /* Image background fallback */
        .image-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -100;
            background: url('@(string.IsNullOrEmpty(Model.FullPageBackgroundUrl) ? "https://images.unsplash.com/photo-1519681393784-d120267933ba?w=1920" : Model.FullPageBackgroundUrl)') center/cover no-repeat fixed;
        }

        /* Glassmorphism card */
        .glass-card {
            background: rgba(15, 23, 42, 0.72);
            backdrop-filter: blur(6px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
        }

        /* High contrast text */
        .text-title {
            color: #ffffff;
            font-weight: 600;
        }

        .text-detail {
            color: #e2e8f0;
        }

        .text-label {
            color: var(--brand-base);
            font-weight: 500;
            font-size: 0.875rem;
        }

        /* Edit mode inputs with visible borders */
        .edit-input {
            background: rgba(13, 17, 23, 0.8);
            border: 1px solid #30363d;
            color: #ffffff;
            border-radius: 8px;
            padding: 8px 12px;
        }

        .edit-input:focus {
            border-color: var(--brand-base);
            outline: none;
            box-shadow: 0 0 0 2px rgba(0, 255, 204, 0.2);
        }

        /* Avatar with full proportions */
        .avatar-container {
            width: 160px;
            height: 160px;
            border-radius: 50%;
            border: 4px solid rgba(255, 255, 255, 0.3);
            overflow: hidden;
            background: rgba(0, 0, 0, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }

        .avatar-container img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        /* Bio section with elegant styling and frosted glass effect */
        .bio-section {
            font-style: italic;
            color: #e2e8f0;
            font-size: 1.1rem;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
            position: relative;
            padding: 20px 30px;
            line-height: 1.6;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }

        .bio-section::before {
            content: '"';
            font-size: 4rem;
            position: absolute;
            left: 10px;
            top: -10px;
            color: rgba(0, 255, 204, 0.3);
            font-family: Georgia, serif;
            line-height: 1;
        }

        /* Active Badge with glowing pill style */
        .active-badge {
            background: linear-gradient(45deg, var(--brand-base), #0099ff);
            color: var(--brand-ink);
            font-weight: bold;
            padding: 6px 16px;
            border-radius: 20px;
            box-shadow: 0 0 15px rgba(0, 255, 204, 0.5);
            font-size: 14px;
            display: inline-block;
            animation: glow 2s ease-in-out infinite alternate;
        }

        @@keyframes glow {
            from {
                box-shadow: 0 0 10px rgba(0, 255, 204, 0.5);
            }
            to {
                box-shadow: 0 0 20px rgba(0, 255, 204, 0.8);
            }
        }

        /* Tab navigation */
        .custom-tab-btn {
            background: transparent;
            border: none;
            color: #e2e8f0;
            padding: 12px 20px;
            cursor: pointer;
            border-bottom: 2px solid transparent;
            transition: all 0.3s;
        }

        .custom-tab-btn.active {
            color: var(--brand-base);
            border-bottom-color: var(--brand-base);
        }

        .custom-tab-btn:hover {
            color: #ffffff;
        }

        /* Preset image grid */
        .preset-image {
            height: 100px;
            border-radius: 8px;
            cursor: pointer;
            border: 3px solid transparent;
            transition: all 0.2s;
            object-fit: cover;
        }

        .preset-image:hover {
            transform: scale(1.05);
        }

        .preset-image.selected {
            border-color: var(--brand-base);
        }

        /* Sidebar Dashboard Styles */
        .sidebar-container {
            width: 250px;
            min-height: 100vh;
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(15px);
            border-right: 1px solid rgba(255, 255, 255, 0.1);
            position: fixed;
            left: 0;
            top: 0;
            padding-top: 80px;
            z-index: 100;
        }

        .sidebar-menu-item {
            padding: 15px 25px;
            color: #e2e8f0;
            cursor: pointer;
            transition: all 0.3s ease;
            border-left: 3px solid transparent;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 15px;
        }

        .sidebar-menu-item:hover {
            background: rgba(0, 255, 204, 0.1);
            color: var(--brand-base);
        }

        .sidebar-menu-item.active {
            background: rgba(0, 255, 204, 0.15);
            color: var(--brand-base);
            border-left-color: var(--brand-base);
            font-weight: 600;
        }

        .main-content-area {
            margin-left: 250px;
            padding: 100px 40px 40px 40px;
            min-height: 100vh;
        }

        .tab-content-panel {
            display: none;
        }

        .tab-content-panel.active {
            display: block;
            animation: fadeIn 0.3s ease;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* High contrast text for readability */
        .quest-value {
            color: #ffffff;
            font-weight: 700;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
        }

        .quest-target {
            color: var(--brand-base);
            font-weight: 600;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
        }

        .quest-description {
            color: #ffffff;
            font-weight: 500;
            text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
        }

        /* Modal dropdown styling for high contrast */
        .modal select,
        .modal select option {
            background-color: #1a1f2c !important;
            color: #ffffff !important;
            border: 1px solid #30363d !important;
        }

        .modal select option:hover,
        .modal select option:focus {
            background-color: var(--brand-base) !important;
            color: #121824 !important;
        }

        /* Modal instruction text styling */
        .modal .instruction-text {
            color: #ffd700 !important;
            font-weight: 600 !important;
            text-shadow: 0 0 8px rgba(255, 215, 0, 0.3);
            margin-bottom: 15px !important;
        }

        /* Modal input placeholder styling */
        .modal input::placeholder {
            color: #ffd700 !important;
            font-weight: 500 !important;
            opacity: 0.8 !important;
        }

        .modal input {
            color: #ffffff !important;
        }
    </style>

    <style>
        @@keyframes slideIn {
            from {
                transform: translateX(100%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        @@keyframes slideOut {
            from {
                transform: translateX(0);
                opacity: 1;
            }
            to {
                transform: translateX(100%);
                opacity: 0;
            }
        }

        /* Virtual Bookshelf Styles */
        .virtual-bookshelf {
            position: relative;
            padding: 40px 20px 20px;
            margin: 20px 0;
            border-radius: 12px;
        }

        /* Neon color theming */
        .virtual-bookshelf.neon-gold {
            --shelf-wood-light: #8B6914;
            --shelf-wood-dark: #5C4A0F;
            --shelf-glow: rgba(255, 215, 0, 0.3);
            --shelf-border: #FFD700;
        }

        .virtual-bookshelf.neon-purple {
            --shelf-wood-light: #6B4C8A;
            --shelf-wood-dark: #4A2F5C;
            --shelf-glow: rgba(147, 112, 219, 0.3);
            --shelf-border: #9370DB;
        }

        .virtual-bookshelf.neon-green {
            --shelf-wood-light: #4A7C59;
            --shelf-wood-dark: #2F5C3D;
            --shelf-glow: rgba(144, 238, 144, 0.3);
            --shelf-border: #90EE90;
        }

        .virtual-bookshelf.neon-default {
            --shelf-wood-light: #6B4423;
            --shelf-wood-dark: #4A2F18;
            --shelf-glow: rgba(139, 90, 43, 0.2);
            --shelf-border: #8B5A2B;
        }

        .virtual-bookshelf {
            box-shadow: 0 0 20px var(--shelf-glow), inset 0 0 30px rgba(0,0,0,0.3);
            border: 1px solid var(--shelf-border);
        }

        .books-row {
            display: flex;
            justify-content: center;
            align-items: flex-end;
            gap: 15px;
            padding: 0 40px;
            min-height: 200px;
            position: relative;
            z-index: 2;
        }

        .book-item {
            flex: 0 0 auto;
            width: 120px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .book-item:hover {
            transform: translateY(-6px) rotate(0deg) !important;
            z-index: 10;
        }

        .book-cover-wrapper {
            position: relative;
            width: 100%;
        }

        .book-cover {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 4px 8px 8px 4px;
            box-shadow: 3px 3px 8px rgba(0, 0, 0, 0.5);
            transition: box-shadow 0.3s ease;
        }

        .book-item:hover .book-cover {
            box-shadow: 5px 8px 15px rgba(0, 0, 0, 0.6);
        }

        .remove-book-btn {
            position: absolute;
            top: -8px;
            right: -8px;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: white;
            border: 2px solid white;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transform: scale(0.8);
            transition: all 0.2s ease;
            z-index: 20;
            font-size: 12px;
        }

        .book-item:hover .remove-book-btn {
            opacity: 1;
            transform: scale(1);
        }

        .remove-book-btn:hover {
            background: linear-gradient(135deg, #dc2626, #b91c1c);
            transform: scale(1.1);
        }

        .empty-slot {
            flex: 0 0 auto;
            width: 120px;
            height: 180px;
            border: 2px dashed rgba(255, 255, 255, 0.3);
            border-radius: 4px 8px 8px 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            background: rgba(255, 255, 255, 0.05);
        }

        .empty-slot:hover {
            border-color: var(--brand-base);
            background: rgba(255, 255, 255, 0.1);
        }

        .empty-slot i {
            font-size: 32px;
            color: rgba(255, 255, 255, 0.4);
            transition: all 0.3s ease;
        }

        .empty-slot:hover i {
            color: var(--brand-base);
            transform: scale(1.2);
        }

        .empty-slot-readonly {
            cursor: default;
        }

        .empty-slot-readonly:hover {
            border-color: rgba(255, 255, 255, 0.3);
            background: rgba(255, 255, 255, 0.05);
        }

        .empty-slot-readonly i {
            display: none;
        }

        .bookend {
            position: absolute;
            bottom: 0;
            width: 20px;
            height: 140px;
            border-radius: 4px;
            background: linear-gradient(180deg, var(--shelf-wood-light), var(--shelf-wood-dark));
            box-shadow: 2px 2px 8px rgba(0, 0, 0, 0.4);
            z-index: 1;
        }

        .bookend-left {
            left: 10px;
        }

        .bookend-right {
            right: 10px;
        }

        .shelf-board {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 20px;
            background: linear-gradient(180deg, var(--shelf-wood-light), var(--shelf-wood-dark));
            border-radius: 0 0 8px 8px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
            z-index: 1;
        }

        .shelf-board::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, 
                transparent 0%, 
                rgba(255, 255, 255, 0.2) 20%, 
                rgba(255, 255, 255, 0.3) 50%, 
                rgba(255, 255, 255, 0.2) 80%, 
                transparent 100%);
        }
    </style>

    var backgroundUrl = Model.FullPageBackgroundUrl;
    var isVideo = !string.IsNullOrEmpty(backgroundUrl) && (backgroundUrl.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase) || 
                                                              backgroundUrl.EndsWith(".webm", StringComparison.OrdinalIgnoreCase) ||
                                                              backgroundUrl.EndsWith(".mov", StringComparison.OrdinalIgnoreCase));

    <!-- Video Background -->
    @if (isVideo)
    {
        <video class="video-background" autoplay loop muted playsinline>
            <source src="@backgroundUrl" type="video/mp4">
        </video>
    }
    else
    {
        <div class="image-background"></div>
    }

    <div class="profile-page-wrapper">
        <!-- Left Sidebar -->
        <div class="sidebar-container">
            @if (ViewBag.IsOwnProfile == true)
            {
                <div class="sidebar-menu-item active" onclick="switchTab('info')">
                    <i class="fas fa-user"></i>
                    <span>Thông tin cá nhân</span>
                </div>
            }
            else
            {
                <div class="sidebar-menu-item active" onclick="switchTab('info')">
                    <i class="fas fa-user"></i>
                    <span>Thông tin cá nhân</span>
                </div>
            }
            <div class="sidebar-menu-item @(ViewBag.IsOwnProfile == false ? "" : "")" onclick="switchTab('quests')">
                <i class="fas fa-trophy"></i>
                <span>Nhiệm vụ & Danh hiệu</span>
            </div>
            <div class="sidebar-menu-item" onclick="switchTab('bookshelf')">
                <i class="fas fa-book-reader"></i>
                <span>Kệ sách danh dự</span>
            </div>
            <div class="sidebar-menu-item" onclick="switchTab('guestbook')">
                <i class="fas fa-thumbtack"></i>
                <span>Bảng ghim cảm xúc</span>
            </div>
            @if (ViewBag.IsOwnProfile == true)
            {
                <div class="sidebar-menu-item" onclick="switchTab('customize')">
                    <i class="fas fa-palette"></i>
                    <span>Cá nhân hóa</span>
                </div>
            }
        </div>

        <!-- Main Content Area -->
        <div class="main-content-area">
            
            <!-- Tab: Personal Info -->
            <div id="tab-info" class="tab-content-panel active">
                <div class="glass-card p-5">
                    <div class="d-flex align-items-center mb-5">
                        <div class="avatar-container">
                            @await Html.PartialAsync("_AvatarPartial", Model)
                        </div>
                        <div class="ms-4">
                            <h2 class="text-title mb-2" style="font-size: 32px;">@Model.FullName</h2>
                            @if (!string.IsNullOrEmpty(Model.ActiveBadge))
                            {
                                var badgeIconUrl = Model.ActiveBadge switch
                                {
                                    " Học Giả Đại Thừa" => "/images/Icons/hoc-gia-dai-thua.png",
                                    " Chúa Tể Đêm Trường" => "/images/Icons/chua-te-dem-truong.gif",
                                    " Tri Kỷ Văn Học" => "/images/Icons/tri-ky-van-hoc.png",
                                    " Kẻ Chinh Phục Tri Thức" => "/images/Icons/ke-chinh-phuc.png",
                                    " Độc Giả Tập Sự" => "/images/Icons/doc-gia-tap-su.png",
                                    _ => "/images/Icons/doc-gia-tap-su.png"
                                };
                                <div class="d-flex align-items-center mt-2">
                                    <img id="activeBadgeDisplay" src="@badgeIconUrl" alt="@Model.ActiveBadge" 
                                         style="width: 40px; height: 40px; object-fit: contain;" />
                                    <span class="ms-2" style="color: var(--brand-base); font-weight: 600; font-size: 16px;">@Model.ActiveBadge</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Bio Section - Prominent Display -->
                    @if (!string.IsNullOrEmpty(Model.Bio))
                    {
                        <div class="bio-section mb-5 p-4" id="bioDisplay" style="background: linear-gradient(135deg, rgba(0, 255, 204, 0.1), rgba(0, 204, 255, 0.1)); border: 1px solid rgba(0, 255, 204, 0.3); border-radius: 12px; position: relative;">
                            <i class="fas fa-quote-left" style="color: var(--brand-base); font-size: 24px; position: absolute; top: 16px; left: 16px; opacity: 0.5;"></i>
                            <p class="mb-0" style="color: #e2e8f0; font-size: 18px; font-style: italic; line-height: 1.6; padding-left: 32px; padding-right: 16px;">@Model.Bio</p>
                            <i class="fas fa-quote-right" style="color: var(--brand-base); font-size: 24px; position: absolute; bottom: 16px; right: 16px; opacity: 0.5;"></i>
                        </div>
                    }

                    @if (ViewBag.IsOwnProfile == true)
                    {
                        <div class="d-flex justify-content-end mb-3">
                            <button id="editPersonalInfoBtn" class="btn btn-sm" style="background: linear-gradient(135deg, var(--brand-base), var(--brand-hover)); color: var(--brand-ink); font-weight: 600;" onclick="togglePersonalInfoEdit()">
                                <i class="fas fa-edit me-1"></i>Chỉnh sửa
                            </button>
                        </div>
                        
                        <div id="personalInfoDisplay" class="row">
                            <div class="col-md-6 mb-4">
                                <label class="text-label">Mã độc giả</label>
                                <p class="text-detail mt-2" style="font-size: 16px;">@Model.ReaderCode</p>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="text-label">Email</label>
                                <p class="text-detail mt-2" style="font-size: 16px;">@Model.Email</p>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="text-label">Số điện thoại</label>
                                <p class="text-detail mt-2" style="font-size: 16px;">@Model.Phone</p>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="text-label">Ngày sinh</label>
                                <p class="text-detail mt-2" style="font-size: 16px;">@Model.DateOfBirth?.ToString("dd/MM/yyyy")</p>
                            </div>
                            <div class="col-12 mb-4">
                                <label class="text-label">Địa chỉ</label>
                                <p class="text-detail mt-2" style="font-size: 16px;">@Model.Address</p>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="text-label">CCCD/CMND</label>
                                <p class="text-detail mt-2" style="font-size: 16px;">@Model.IdentityNumber</p>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="text-label">Ngày đăng ký</label>
                                <p class="text-detail mt-2" style="font-size: 16px;">@Model.RegisterDate.ToString("dd/MM/yyyy")</p>
                            </div>
                        </div>

                        <div id="personalInfoEditForm" class="row d-none">
                            <div class="col-md-6 mb-4">
                                <label class="text-label">Mã độc giả</label>
                                <input type="text" class="edit-input w-100" value="@Model.ReaderCode" disabled />
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="text-label">Email</label>
                                <input type="email" class="edit-input w-100" value="@Model.Email" disabled />
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="text-label">Số điện thoại</label>
                                <input type="text" id="editPhone" class="edit-input w-100" value="@Model.Phone" />
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="text-label">Ngày sinh</label>
                                <input type="date" id="editDateOfBirth" class="edit-input w-100" value="@Model.DateOfBirth?.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-12 mb-4">
                                <label class="text-label">Địa chỉ</label>
                                <textarea id="editAddress" class="edit-input w-100" rows="3">@Model.Address</textarea>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="text-label">CCCD/CMND</label>
                                <input type="text" class="edit-input w-100" value="@Model.IdentityNumber" disabled />
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="text-label">Ngày đăng ký</label>
                                <input type="text" class="edit-input w-100" value="@Model.RegisterDate.ToString("dd/MM/yyyy")" disabled />
                            </div>
                            <div class="col-12">
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm" style="background: linear-gradient(135deg, var(--brand-base), var(--brand-hover)); color: var(--brand-ink); font-weight: 600;" onclick="savePersonalInfo()">
                                        <i class="fas fa-save me-1"></i>Lưu thay đổi
                                    </button>
                                    <button class="btn btn-sm" style="background: rgba(239, 68, 68, 0.2); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.5); font-weight: 600;" onclick="cancelPersonalInfoEdit()">
                                        <i class="fas fa-times me-1"></i>Hủy
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Tab: Quests & Badges -->
            <div id="tab-quests" class="tab-content-panel">
                <div class="glass-card p-5">
                    <h3 class="text-title mb-4" style="font-size: 24px;"><i class="fas fa-trophy me-2"></i>Hệ thống Nhiệm vụ Danh hiệu</h3>
                    
                    @if (ViewBag.BadgeQuests != null)
                    {
                        foreach (dynamic quest in ViewBag.BadgeQuests)
                        {
                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center">
                                        <img src="@quest.IconUrl" 
                                             style="width: 32px; height: 32px; object-fit: contain; margin-right: 8px; vertical-align: middle; @(quest.IsUnlocked ? "" : "filter: grayscale(100%) opacity(0.5);")" 
                                             alt="@quest.BadgeName" />
                                        @if (quest.IsUnlocked)
                                        {
                                            <i class="fas fa-check-circle text-success me-2"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-lock text-warning me-2"></i>
                                        }
                                        <span class="@(quest.IsUnlocked ? "active-badge" : "text-muted")" 
                                              style="@(quest.IsUnlocked ? "" : "opacity: 0.6; font-weight: 500; padding: 6px 16px; border-radius: 20px; background: rgba(255,255,255,0.1);")">
                                            @quest.BadgeName
                                        </span>
                                    </div>
                                    <span class="quest-value" style="font-size: 16px;">@quest.Current / <span class="quest-target">@quest.Target</span></span>
                                </div>
                                <p class="quest-description mb-2" style="font-size: 15px;">@quest.Description</p>
                                <div class="progress" style="height: 10px; background: rgba(255, 255, 255, 0.15);">
                                    <div class="progress-bar" 
                                         style="width: @quest.Progress%; 
                                                background: linear-gradient(90deg, var(--brand-base), #0099ff); 
                                                transition: width 0.3s ease;">
                                    </div>
                                </div>
                                <div class="text-end mt-1">
                                    <small class="quest-target" style="font-size: 14px;">@quest.Progress%</small>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Tab: Customize -->
            @if (ViewBag.IsOwnProfile == true)
            {
                <div id="tab-customize" class="tab-content-panel">
                    <div class="glass-card p-5">
                        <h3 class="text-title mb-4" style="font-size: 24px;"><i class="fas fa-palette me-2"></i>Cá nhân hóa giao diện</h3>
                        
                        <div class="mb-4">
                            <label class="text-label">Câu trích dẫn cá nhân (Bio):</label>
                            <div class="d-flex gap-2 mt-2">
                                <textarea id="bioInput" class="edit-input flex-grow-1" rows="4" maxlength="150" placeholder="Viết câu trích dẫn yêu thích của bạn...">@Model.Bio</textarea>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <small class="text-muted" style="color: #8b949e;">Tối đa 150 ký tự</small>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm" style="background: linear-gradient(135deg, var(--brand-base), var(--brand-hover)); color: var(--brand-ink); font-weight: 600;" onclick="saveBio()">
                                        <i class="fas fa-save me-1"></i>Lưu
                                    </button>
                                    <button class="btn btn-sm" style="background: rgba(239, 68, 68, 0.2); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.5); font-weight: 600;" onclick="deleteBio()">
                                        <i class="fas fa-trash me-1"></i>Xóa
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="text-label">Chọn Danh Hiệu hiển thị:</label>
                            <select id="badgeSelect" class="edit-input w-100 mt-2">
                                @if (ViewBag.BadgeQuests != null)
                                {
                                    foreach (dynamic quest in ViewBag.BadgeQuests)
                                    {
                                        <option value="@quest.BadgeName" 
                                                selected="@quest.BadgeName == Model.ActiveBadge"
                                                disabled="@(quest.IsUnlocked ? "" : "disabled")"
                                                style="@(quest.IsUnlocked ? "" : "color: #8b949e;")">
                                            @(quest.IsUnlocked ? "" : "[Khóa] ")@quest.BadgeName
                                        </option>
                                    }
                                }
                            </select>
                            <small class="text-muted mt-1" style="color: #8b949e;">Chỉ có thể chọn danh hiệu đã mở khóa</small>
                        </div>
                        <div class="mb-4">
                            <label class="text-label">Ảnh đại diện:</label>
                            <input type="file" id="avatarFileInput" accept="image/*" class="edit-input w-100 mt-2" />
                            <small class="text-muted mt-1" style="color: #8b949e;">Hỗ trợ: .jpg, .png, .gif, .webp (bao gồm ảnh động GIF)</small>
                        </div>
                        <div class="mb-4">
                            <label class="text-label">Nền toàn trang (Tải tệp ảnh/video):</label>
                            <div class="d-flex gap-2 mt-2">
                                <input type="file" id="backgroundFileInput" accept="image/*,video/*" class="edit-input flex-grow-1" />
                                <button class="btn btn-sm" style="background: rgba(239, 68, 68, 0.2); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.5); font-weight: 600;" onclick="removeBackground()">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                            <small class="text-muted mt-1" style="color: #8b949e;">Hỗ trợ: .jpg, .png, .gif, .mp4, .webm</small>
                        </div>
                        <div class="mb-4">
                            <label class="text-label">Hoặc nhập URL ảnh/video:</label>
                            <input type="text" id="backgroundUrlInput" class="edit-input w-100 mt-2" value="@Model.FullPageBackgroundUrl" placeholder="https://example.com/background.jpg hoặc .mp4" />
                        </div>
                        <button class="btn" style="background: linear-gradient(135deg, var(--brand-base), var(--brand-hover)); color: var(--brand-ink); font-weight: 600;" onclick="saveCustomization()">
                            <i class="fas fa-save me-2"></i>Lưu thay đổi
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div id="tab-customize" class="tab-content-panel" style="display: none;">
                    <!-- Customization hidden for public viewers -->
                </div>
            }

            <!-- Tab: Bookshelf -->
            <div id="tab-bookshelf" class="tab-content-panel">
                <div class="glass-card p-5">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3 class="text-title" style="font-size: 24px;"><i class="fas fa-book-reader me-2"></i>Kệ Sách Danh Dự Cá Nhân</h3>
                        @if (ViewBag.IsOwnProfile == true)
                        {
                            <button class="btn" style="background: linear-gradient(135deg, var(--brand-base), var(--brand-hover)); color: var(--brand-ink); font-weight: 600;" onclick="openBookshelfModal()">
                                <i class="fas fa-cog me-2"></i>Quản lý kệ sách
                            </button>
                        }
                    </div>

                    @{
                        var neonClass = (Model.ActiveBadge ?? "") switch
                        {
                            var b when b.Contains("Học Giả") => "neon-gold",
                            var b when b.Contains("Chúa Tể") || b.Contains("Đêm") => "neon-purple",
                            var b when b.Contains("Tri Kỷ") => "neon-green",
                            _ => "neon-default"
                        };
                    }

                    @if (ViewBag.FeaturedBooks != null && ((List<Books>)ViewBag.FeaturedBooks).Any())
                    {
                        <div class="virtual-bookshelf @neonClass">
                            <!-- Bookend Left -->
                            <div class="bookend bookend-left"></div>
                            
                            <!-- Books Row -->
                            <div class="books-row">
                                @{
                                    var books = (List<Books>)ViewBag.FeaturedBooks;
                                    var bookIndex = 0;
                                }
                                @foreach (var book in books)
                                {
                                    var rotation = (bookIndex % 2 == 0) ? -1.5 : 1.5;
                                    <div class="book-item" style="transform: rotate(@rotation)deg;">
                                        <div class="book-cover-wrapper">
                                            <img src="@book.CoverImage" alt="@book.Title" class="book-cover" title="@book.Title" />
                                            @if (ViewBag.IsOwnProfile == true)
                                            {
                                                <button class="remove-book-btn" onclick="removeFeaturedBook(@book.Id)" title="Gỡ sách khỏi kệ">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                    bookIndex++;
                                }
                                
                                <!-- Empty Slots -->
                                @for (int i = books.Count; i < 4; i++)
                                {
                                    if (ViewBag.IsOwnProfile == true)
                                    {
                                        <div class="empty-slot" onclick="openBookshelfModal()">
                                            <i class="fas fa-plus"></i>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="empty-slot empty-slot-readonly"></div>
                                    }
                                }
                            </div>
                            
                            <!-- Bookend Right -->
                            <div class="bookend bookend-right"></div>
                            
                            <!-- Shelf Board -->
                            <div class="shelf-board"></div>
                        </div>
                    }
                    else
                    {
                        @if (ViewBag.IsOwnProfile == true)
                        {
                            <div class="text-center py-5" style="border: 2px dashed rgba(255,255,255,0.3); border-radius: 15px; padding: 40px;">
                                <i class="fas fa-book-open fa-3x mb-3" style="color: #8b949e;"></i>
                                <p class="text-muted" style="color: #8b949e; font-size: 18px;">Kệ sách hiện đang trống. Bấm nút bên dưới để chọn sách trưng bày!</p>
                                <button class="btn mt-3" style="background: linear-gradient(135deg, var(--brand-base), var(--brand-hover)); color: var(--brand-ink); font-weight: 600;" onclick="openBookshelfModal()">
                                    <i class="fas fa-plus me-2"></i>Thêm sách vào kệ
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5" style="border: 2px dashed rgba(255,255,255,0.3); border-radius: 15px; padding: 40px;">
                                <i class="fas fa-book-open fa-3x mb-3" style="color: #8b949e;"></i>
                                <p class="text-muted" style="color: #8b949e; font-size: 18px;">@Model.FullName chưa trưng bày sách nào.</p>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Tab: Guestbook -->
            <div id="tab-guestbook" class="tab-content-panel">
                <div class="glass-card p-5">
                    <h3 class="text-title mb-4" style="font-size: 24px;"><i class="fas fa-thumbtack me-2"></i>Bảng Ghim Cảm Xúc</h3>
                    
                    @if (ViewBag.IsOwnProfile == false)
                    {
                        <!-- Button to open tag selection modal -->
                        <div class="mb-4">
                            <button class="btn w-100" type="button" onclick="openTagPinModal()" style="background: linear-gradient(135deg, var(--brand-base), var(--brand-hover)); color: var(--brand-ink); font-weight: 600; padding: 12px 20px; border-radius: 10px;">
                                <i class="fas fa-thumbtack me-2"></i>+ Ghim cảm xúc cho @Model.FullName
                            </button>
                        </div>
                    }
                    else
                    {
                        <!-- Message for own profile -->
                        <div class="alert alert-info mb-4" style="background: rgba(0, 123, 255, 0.1); border: 1px solid rgba(0, 123, 255, 0.3); color: #90cdf4;">
                            <i class="fas fa-info-circle me-2"></i>Bạn không thể tự ghim cảm xúc cho chính mình. Hãy chờ độc giả khác vào ghim nhé!
                        </div>
                    }

                    <!-- Tag Pin Board -->
                    <div id="tagPinBoard" class="mt-4">
                        @if (ViewBag.TagPins != null && ((dynamic)ViewBag.TagPins).Count > 0)
                        {
                            @foreach (var pin in (dynamic)ViewBag.TagPins)
                            {
                                <div class="tag-pin-card mb-3" data-pin-id="@pin.Id" style="background: rgba(255,255,255,0.05); border-radius: 12px; padding: 15px; border: 1px solid rgba(255,255,255,0.1);">
                                    <div class="d-flex align-items-start">
                                        <img src="@(string.IsNullOrEmpty(pin.AuthorAvatar) ? "/images/default-avatar.png" : pin.AuthorAvatar)" alt="@pin.AuthorName" style="width: 45px; height: 45px; border-radius: 50%; object-fit: cover; border: 2px solid rgba(0,255,204,0.3);" />
                                        <div class="ms-3 flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <a href="/Account/Profile/@pin.AuthorReaderCode" class="text-decoration-none" style="color: var(--brand-base); font-weight: 600;">
                                                    @pin.AuthorName
                                                </a>
                                                <div class="d-flex align-items-center">
                                                    <small class="text-muted" style="color: #8b949e;">@GetTimeAgo(pin.CreatedAt)</small>
                                                    @if (ViewBag.IsOwnProfile == true)
                                                    {
                                                        <button class="btn btn-sm ms-2" onclick="deleteTagPin(@pin.Id)" style="background: none; border: none; color: #ef4444; padding: 2px 8px;">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                            <div class="mt-2">
                                                @if (pin.Tags != null)
                                                {
                                                    @foreach (var tag in pin.Tags)
                                                    {
                                                        <span class="tag-chip me-1 mb-1" style="display: inline-block; padding: 4px 12px; border-radius: 20px; background: linear-gradient(135deg, var(--brand-base), var(--brand-hover)); color: var(--brand-ink); font-size: 13px; font-weight: 500;">
                                                            @(!string.IsNullOrEmpty(tag.Emoji) ? tag.Emoji + " " : "")@tag.Label
                                                        </span>
                                                    }
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(pin.PresetMessage))
                                            {
                                                <p class="mt-2 mb-0" style="color: #e2e8f0; line-height: 1.5; font-style: italic;">@pin.PresetMessage</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-5" style="border: 2px dashed rgba(255,255,255,0.3); border-radius: 15px; padding: 40px;">
                                <i class="fas fa-thumbtack fa-3x mb-3" style="color: #8b949e;"></i>
                                <p class="text-muted" style="color: #8b949e; font-size: 18px;">Chưa có ghim cảm xúc nào. Hãy là người đầu tiên ghim cảm xúc!</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Notification Container -->
    <div id="toastContainer" style="position: fixed; top: 20px; right: 20px; z-index: 9999;"></div>

    @if (ViewBag.IsOwnProfile == true)
    {
        <!-- Bookshelf Management Modal -->
        <div id="bookshelfModal" class="modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 1000; align-items: center; justify-content: center;">
        <div class="modal-content" style="background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(20px); border-radius: 15px; padding: 30px; max-width: 800px; max-height: 80vh; overflow-y: auto; border: 1px solid rgba(255,255,255,0.1);">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="text-title" style="color: #ffffff; font-weight: 700; text-shadow: 0 2px 4px rgba(0,0,0,0.5);"><i class="fas fa-cog me-2"></i>Quản lý Kệ Sách Danh Dự</h4>
                <button onclick="closeBookshelfModal()" style="background: none; border: none; color: #ffffff; font-size: 24px; cursor: pointer;">&times;</button>
            </div>
            
            <p class="text-muted mb-4 instruction-text" style="color: #ffd700; font-weight: 600; text-shadow: 0 0 8px rgba(255, 215, 0, 0.3);">Chọn tối đa 4 sách từ danh sách sách bạn đã mượn hoặc yêu thích:</p>
            
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <input type="text" id="modalBookSearch" class="form-control" placeholder="Tìm theo tên sách..." style="background: rgba(255,255,255,0.15); color: #ffffff; border: 1px solid #30363d; font-weight: 500;" />
                </div>
                <div class="col-md-3">
                    <select id="modalCategoryFilter" class="form-select" style="background: #1a1f2c; color: #ffffff; border: 1px solid #30363d;">
                        <option value="">Tất cả danh mục</option>
                        @if (ViewBag.Categories != null)
                        {
                            @foreach (var cat in (List<Categories>)ViewBag.Categories)
                            {
                                <option value="@cat.Id" style="background: #1a1f2c; color: #ffffff;">@cat.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select id="modalSortOrder" class="form-select" style="background: #1a1f2c; color: #ffffff; border: 1px solid #30363d;">
                        <option value="new" style="background: #1a1f2c; color: #ffffff;">Mới nhất</option>
                        <option value="name" style="background: #1a1f2c; color: #ffffff;">Tên A-Z</option>
                    </select>
                </div>
            </div>
            
            @{
                var featuredBookIds = new List<int>();
                if (!string.IsNullOrEmpty(Model.FeaturedBookIds))
                {
                    featuredBookIds = Model.FeaturedBookIds.Split(',').Where(x => int.TryParse(x, out _)).Select(int.Parse).ToList();
                }
            }

            @if (ViewBag.AvailableBooks != null && ((List<Books>)ViewBag.AvailableBooks).Any())
            {
                <div class="row" id="availableBooksGrid">
                    @foreach (var book in (List<Books>)ViewBag.AvailableBooks)
                    {
                        var isFeatured = featuredBookIds.Contains(book.Id);
                        <div class="col-md-3 mb-3 modal-book-card-wrapper" data-category-id="@book.CategoriesId">
                            <div class="book-selection-card" style="background: rgba(255,255,255,0.05); border-radius: 10px; padding: 10px; cursor: pointer; border: 2px solid @(isFeatured ? "var(--brand-base)" : "transparent"); transition: all 0.3s ease;" onclick="toggleBookSelection(this, @book.Id)">
                                <img src="@book.CoverImage" alt="@book.Title" style="width: 100%; height: 150px; object-fit: cover; border-radius: 8px; margin-bottom: 10px;" />
                                <div style="color: #ffffff; font-size: 13px; font-weight: 600; text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@book.Title</div>
                                <input type="checkbox" class="book-checkbox" value="@book.Id" @(isFeatured ? "checked=\"checked\"" : "") style="display: none;" />
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted text-center" style="color: #8b949e;">Bạn chưa mượn hoặc yêu thích sách nào.</p>
            }
            
            <div class="d-flex justify-content-end mt-4">
                <button class="btn btn-secondary me-2" onclick="closeBookshelfModal()" style="background: rgba(255,255,255,0.1); color: #ffffff; border: 1px solid rgba(255,255,255,0.2);">Hủy</button>
                <button class="btn" style="background: linear-gradient(135deg, var(--brand-base), var(--brand-hover)); color: var(--brand-ink); font-weight: 600;" onclick="saveBookshelf()">Lưu cấu hình</button>
            </div>
        </div>
    </div>
    }

