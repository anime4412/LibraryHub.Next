                    <button type="button" class="preset-msg-btn" data-pm-key="pm_happy_reading" onclick="togglePresetMessage(this)">Chúc bạn đọc sách vui vẻ <i class="fa-solid fa-book-open ms-1"></i></button>
                    <button type="button" class="preset-msg-btn" data-pm-key="pm_star" onclick="togglePresetMessage(this)">Tặng bạn một ngôi sao <i class="fa-solid fa-star ms-1"></i></button>
                    <button type="button" class="preset-msg-btn" data-pm-key="pm_see_you" onclick="togglePresetMessage(this)">Hẹn gặp lại ở kệ sách khác <i class="fa-solid fa-hand ms-1"></i></button>
