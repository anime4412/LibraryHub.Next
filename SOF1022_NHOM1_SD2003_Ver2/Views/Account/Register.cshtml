@model SOF1022_NHOM1_SD2003_Ver2.Models.Readers
@using SOF1022_NHOM1_SD2003_Ver2.Models.Enums

@{
    Layout = null;
    ViewData["Title"] = "Đăng ký độc giả";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Đăng ký tài khoản độc giả - Thư viện điện tử</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:ital,wght@0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link href="~/css/account.css?v=@DateTime.UtcNow.Ticks" rel="stylesheet" />
    
    <style>
        :root {
            --auth-brand: #E0A527;
            --auth-brand-hover: #C68F1E;
            --auth-brand-ink: #2A1E06;
            --auth-dark: #0F172A;
            --auth-border: #CBD5E1;
            --auth-input-bg: #FFFFFF;
        }

        body.auth-page {
            min-height: 100vh;
            background: radial-gradient(circle at 50% 10%, #FFFFFF 0%, #F5F2EA 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 16px;
            margin: 0;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            color: #1E293B;
            box-sizing: border-box;
        }

        .register-container {
            width: 100%;
            max-width: 860px;
            margin: 0 auto;
            background: #FFFFFF;
            border-radius: 24px;
            box-shadow: 0 25px 60px rgba(15, 23, 42, 0.12), 0 1px 3px rgba(15, 23, 42, 0.06);
            border: 1px solid #E2E8F0;
            overflow: hidden;
            animation: fadeIn 0.4s ease-out;
        }

        /* Top Header Banner */
        .auth-banner {
            background: linear-gradient(135deg, #0F172A 0%, #1E293B 60%, #162438 100%) !important;
            color: #FFFFFF !important;
            text-align: center;
            padding: 36px 32px 30px;
            position: relative;
            border-bottom: 3px solid var(--auth-brand);
        }

        .auth-banner-badge {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: rgba(224, 165, 39, 0.18);
            border: 1.5px solid var(--auth-brand);
            color: var(--auth-brand);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            margin-bottom: 12px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
        }

        .auth-banner h2 {
            font-family: 'Lora', Georgia, serif;
            font-size: 26px;
            font-weight: 700;
            color: #FFFFFF !important;
            letter-spacing: -0.01em;
            margin: 0 0 6px;
        }

        .auth-banner p {
            font-size: 14px;
            color: #94A3B8 !important;
            max-width: 540px;
            margin: 0 auto;
            line-height: 1.55;
        }

        /* Form Body */
        .register-card {
            padding: 36px 44px;
            background: #FFFFFF;
        }

        .form-section-card {
            background: #F8FAFC;
            border: 1.5px solid #E2E8F0;
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 24px;
        }

        .section-title {
            font-family: 'Lora', Georgia, serif;
            font-size: 17.5px;
            font-weight: 700;
            color: #0F172A;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 18px;
            padding-bottom: 10px;
            border-bottom: 1px solid #E2E8F0;
        }

        .section-icon {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            background: rgba(224, 165, 39, 0.15);
            color: var(--auth-brand);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
        }

        /* Input Controls */
        .form-label {
            font-size: 13.5px;
            font-weight: 600;
            color: #334155;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .required-mark {
            color: #DC2626;
            font-size: 14px;
            font-weight: 700;
        }

        .optional-hint {
            color: #94A3B8;
            font-size: 12px;
            font-weight: 400;
        }

        .input-group {
            display: flex !important;
            align-items: stretch !important;
            width: 100% !important;
        }

        .input-group > .input-group-text:first-child {
            background: #F1F5F9 !important;
            border: 1.5px solid #CBD5E1 !important;
            border-right: none !important;
            color: #64748B !important;
            border-top-left-radius: 10px !important;
            border-bottom-left-radius: 10px !important;
            border-top-right-radius: 0 !important;
            border-bottom-right-radius: 0 !important;
            padding: 0 14px;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 44px;
        }

        .form-control,
        .form-select {
            height: 48px !important;
            border-radius: 10px !important;
            border: 1.5px solid #CBD5E1 !important;
            background-color: #FFFFFF !important;
            color: #0F172A !important;
            font-size: 14px !important;
            padding: 10px 14px !important;
            box-shadow: none !important;
            transition: all 0.2s ease;
        }

        .input-group > .form-control:not(:first-child):not(:last-child) {
            border-radius: 0 !important;
            border: 1.5px solid #CBD5E1 !important;
            border-left: none !important;
            border-right: none !important;
        }

        .input-group > .form-control:not(:first-child):last-child {
            border-top-left-radius: 0 !important;
            border-bottom-left-radius: 0 !important;
            border-top-right-radius: 10px !important;
            border-bottom-right-radius: 10px !important;
            border: 1.5px solid #CBD5E1 !important;
            border-left: none !important;
        }

        .form-control:focus,
        .form-select:focus {
            outline: none !important;
            border-color: var(--auth-brand) !important;
            box-shadow: 0 0 0 3.5px rgba(224, 165, 39, 0.2) !important;
        }

        .input-group:focus-within .input-group-text {
            border-color: var(--auth-brand) !important;
            color: var(--auth-brand) !important;
        }

        .input-group > .btn-toggle-eye:last-child {
            background: #F1F5F9 !important;
            border: 1.5px solid #CBD5E1 !important;
            border-left: none !important;
            border-top-left-radius: 0 !important;
            border-bottom-left-radius: 0 !important;
            border-top-right-radius: 10px !important;
            border-bottom-right-radius: 10px !important;
            color: #64748B !important;
            padding: 0 15px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.2s;
            box-shadow: none !important;
        }

        .input-group > .btn-toggle-eye:last-child:hover {
            color: #0F172A !important;
            background: #E2E8F0 !important;
        }

        .input-group > .btn-toggle-eye:last-child:focus {
            outline: none;
        }

        /* Checkbox & Button */
        .form-check-input {
            width: 18px;
            height: 18px;
            border: 1.5px solid #CBD5E1 !important;
            margin-top: 2px;
        }

        .form-check-input:checked {
            background-color: var(--auth-brand) !important;
            border-color: var(--auth-brand) !important;
        }

        .btn-auth-submit {
            background: linear-gradient(135deg, #E0A527 0%, #D49015 100%) !important;
            color: #1E1702 !important;
            font-weight: 700 !important;
            font-size: 16px !important;
            border-radius: 50px !important;
            padding: 14px 28px !important;
            box-shadow: 0 10px 25px rgba(224, 165, 39, 0.35) !important;
            border: none !important;
            width: 100%;
            cursor: pointer;
            transition: all 0.25s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .btn-auth-submit:hover {
            background: linear-gradient(135deg, #ECC047 0%, #DFA01E 100%) !important;
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(224, 165, 39, 0.45) !important;
        }

        .auth-footer-links {
            text-align: center;
            margin-top: 24px;
            font-size: 14px;
            color: #64748B;
        }

        .auth-footer-links a {
            color: var(--auth-brand);
            font-weight: 600;
            text-decoration: none;
        }

        .auth-footer-links a:hover {
            text-decoration: underline;
        }

        .auth-home-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13.5px;
            color: #64748B;
            text-decoration: none;
            margin-top: 14px;
            transition: color 0.2s;
        }

        .auth-home-link:hover {
            color: #0F172A;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(16px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@media (max-width: 768px) {
            .register-card { padding: 24px 20px; }
            .auth-banner { padding: 28px 20px; }
            .auth-banner h2 { font-size: 22px; }
            .form-section-card { padding: 16px; }
        }
    </style>
</head>
<body class="auth-page">

    <div class="register-container">
        <!-- Top Brand Banner -->
        <div class="auth-banner">
            <div class="auth-banner-badge">
                <i class="fa-solid fa-book-open-reader"></i>
            </div>
            <h2>ĐĂNG KÝ TÀI KHOẢN ĐỘC GIẢ</h2>
            <p>Tham gia hệ thống thư viện điện tử để tra cứu, đặt trước và mượn sách kinh điển trực tuyến hoàn toàn miễn phí.</p>
        </div>

        <!-- Form Card Body -->
        <div class="register-card">
            <form asp-action="Register" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="ReaderCode" type="hidden" />
                <input type="hidden" asp-for="Avatar" value="/images/default-avatar.png" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger shadow-sm mb-4 border-0 rounded-3"></div>
                }

                <!-- Section 1: Thông tin cá nhân -->
                <div class="form-section-card">
                    <h3 class="section-title">
                        <span class="section-icon"><i class="fa-solid fa-user"></i></span>
                        1. Thông tin cá nhân
                    </h3>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label">
                                Họ và tên <span class="required-mark">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-regular fa-user"></i></span>
                                <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" required />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label">
                                Ngày sinh <span class="required-mark">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-regular fa-calendar"></i></span>
                                <input asp-for="DateOfBirth" type="date" class="form-control" required />
                            </div>
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">
                                Số điện thoại <span class="required-mark">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-phone"></i></span>
                                <input asp-for="Phone" class="form-control" placeholder="0912 345 678" required />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="IdentityNumber" class="form-label">
                                CCCD / CMND <span class="required-mark">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-regular fa-id-card"></i></span>
                                <input asp-for="IdentityNumber" class="form-control" placeholder="Nhập số CCCD (12 số)" required />
                            </div>
                            <span asp-validation-for="IdentityNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Address" class="form-label">
                                Địa chỉ cư trú <span class="required-mark">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-location-dot"></i></span>
                                <input asp-for="Address" class="form-control" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành phố" required />
                            </div>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Thông tin tài khoản -->
                <div class="form-section-card">
                    <h3 class="section-title">
                        <span class="section-icon"><i class="fa-solid fa-shield-halved"></i></span>
                        2. Thông tin tài khoản &amp; Đăng nhập
                    </h3>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">
                                Email đăng nhập <span class="required-mark">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-regular fa-envelope"></i></span>
                                <input asp-for="Email" type="email" class="form-control" placeholder="email.cuaban@gmail.com" required />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3 col-sm-6">
                            <label asp-for="Genders" class="form-label">
                                Giới tính <span class="optional-hint">(tùy chọn)</span>
                            </label>
                            <select asp-for="Genders" class="form-select">
                                <option value="Male">Nam</option>
                                <option value="Female">Nữ</option>
                                <option value="Other">Khác</option>
                            </select>
                        </div>

                        <div class="col-md-3 col-sm-6">
                            <label asp-for="ReadersType" class="form-label">
                                Đối tượng <span class="optional-hint">(tùy chọn)</span>
                            </label>
                            <select asp-for="ReadersType" class="form-select">
                                <option value="Student">Học sinh / Sinh viên</option>
                                <option value="Teacher">Giáo viên / Giảng viên</option>
                                <option value="Guest">Độc giả tự do</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label">
                                Mật khẩu <span class="required-mark">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                                <input asp-for="Password" id="password" type="password" class="form-control" placeholder="Tối thiểu 6 ký tự" required />
                                <button class="btn-toggle-eye" type="button" onclick="togglePassword('password', 'eyeIcon')" title="Hiện/ẩn mật khẩu">
                                    <i id="eyeIcon" class="fa-regular fa-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label">
                                Xác nhận mật khẩu <span class="required-mark">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                                <input asp-for="ConfirmPassword" id="confirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu" required />
                                <button class="btn-toggle-eye" type="button" onclick="togglePassword('confirmPassword', 'confirmEyeIcon')" title="Hiện/ẩn mật khẩu">
                                    <i id="confirmEyeIcon" class="fa-regular fa-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Terms & Agreement -->
                <div class="form-check my-3">
                    <input class="form-check-input" type="checkbox" id="terms" required />
                    <label class="form-check-label text-secondary small ms-2" for="terms">
                        Tôi đồng ý với mọi <strong>Điều khoản dịch vụ</strong> và <strong>Nội quy sử dụng</strong> của Thư viện điện tử.
                    </label>
                </div>

                <div class="text-center text-muted small mb-3">
                    <span class="required-mark">*</span> Thông tin bắt buộc điền đầy đủ
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn-auth-submit">
                    <i class="fa-solid fa-user-plus"></i>
                    <span>Đăng ký tài khoản độc giả</span>
                </button>
            </form>

            <!-- Links -->
            <div class="auth-footer-links">
                Đã có tài khoản thành viên? <a asp-action="Login" asp-controller="Account">Đăng nhập ngay</a>
                <br />
                <a asp-controller="Home" asp-action="Index" class="auth-home-link">
                    <i class="fa-solid fa-arrow-left"></i> Quay về trang chủ
                </a>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function togglePassword(inputId, iconId) {
            const password = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!password || !icon) return;
            if (password.type === "password") {
                password.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                password.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
</body>
</html>