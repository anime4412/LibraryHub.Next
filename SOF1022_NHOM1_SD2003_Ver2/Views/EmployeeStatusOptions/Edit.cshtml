@model SOF1022_NHOM1_SD2003_Ver2.Models.EmployeeStatusOption

@{
    ViewData["Title"] = "Chỉnh sửa trạng thái";
}

<div class="container-fluid">

    <!-- ========================= PAGE HEADER ========================= -->

    <div class="d-sm-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold text-warning mb-1">
                <i class="fas fa-edit"></i>
                Chỉnh sửa trạng thái
            </h2>

            <nav aria-label="breadcrumb">

                <ol class="breadcrumb">

                    <li class="breadcrumb-item">
                        <a asp-controller="Home"
                           asp-action="Index">
                            Dashboard
                        </a>
                    </li>

                    <li class="breadcrumb-item">
                        <a asp-action="Index">
                            Quản lý trạng thái
                        </a>
                    </li>

                    <li class="breadcrumb-item active">
                        Chỉnh sửa
                    </li>

                </ol>

            </nav>

        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="fas fa-arrow-left"></i>

            Quay lại

        </a>

    </div>

    <!-- ========================= CARD ========================= -->

    <div class="card shadow-lg border-0">

        <div class="card-header bg-warning text-dark">

            <h5 class="mb-0">

                <i class="fas fa-user-tag"></i>

                Thông tin trạng thái

            </h5>

        </div>

        <div class="card-body">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">

            </div>

            <form asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="Id"
                       type="hidden" />

                <!-- Name -->

                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label fw-semibold">
                    </label>

                    <span class="text-danger">*</span>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Nhập tên trạng thái" />

                    <span asp-validation-for="Name"
                          class="text-danger small">
                    </span>

                </div>

                <!-- Description -->

                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label fw-semibold">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"
                              placeholder="Nhập mô tả trạng thái (không bắt buộc)"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger small">
                    </span>

                </div>

                <!-- DisplayOrder -->

                <div class="mb-3">

                    <label asp-for="DisplayOrder"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="DisplayOrder"
                           class="form-control"
                           type="number"
                           min="0"
                           placeholder="Thứ tự hiển thị (số nhỏ hơn sẽ hiển thị trước)" />

                    <span asp-validation-for="DisplayOrder"
                          class="text-danger small">
                    </span>

                </div>

                <!-- Buttons -->

                <div class="row mt-4">

                    <div class="col-12">

                        <hr />

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-secondary">

                                <i class="fas fa-arrow-left"></i>

                                Quay lại

                            </a>

                            <button type="submit"
                                    class="btn btn-success">

                                <i class="fas fa-save"></i>

                                Cập nhật trạng thái

                            </button>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
