@model SOF1022_NHOM1_SD2003_Ver2.Models.Authors

@{
    ViewData["Title"] = "Chi tiết Tác giả";
}

<div class="container-fluid py-4 px-md-5">
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-light p-3 rounded-circle text-warning shadow-sm">
                <i class="fas fa-feather-alt fa-lg"></i>
            </div>
            <div>
                <h4 class="mb-0 text-dark fw-bold">Quản lý Tác giả</h4>
                <small class="text-muted">Xem chi tiết thông tin tác giả trong hệ thống thư viện</small>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm bg-white rounded-3 overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 px-4" style="border-left: 4px solid #ffc107 !important;">
            <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-eye me-2 text-muted"></i>Chi tiết tác giả: @Model.Name</h5>
        </div>
        <div class="card-body p-4 bg-light">
            <div class="card border-0 shadow-sm bg-white rounded-3">
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-12 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <label class="text-muted small fw-semibold">Tên tác giả</label>
                                <div class="fw-bold text-primary fs-3">@Model.Name</div>
                            </div>
                            <div>
                                <span class="badge bg-warning-subtle text-warning border border-warning fs-6 px-3 py-2 rounded-pill">
                                    <i class="fas fa-book me-1"></i> @(Model.Books?.Count ?? 0) tác phẩm trong thư viện
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Ngày sinh</label>
                            <div class="text-dark fw-semibold fs-6">
                                <i class="fas fa-calendar-alt text-danger me-2"></i>
                                @(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("dd/MM/yyyy") : "Đang cập nhật")
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Quốc tịch</label>
                            <div class="text-dark fw-semibold fs-6">
                                <i class="fas fa-globe text-primary me-2"></i>
                                @(string.IsNullOrWhiteSpace(Model.Nationality) ? "Đang cập nhật" : Model.Nationality)
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label class="text-muted small fw-semibold">Tiểu sử & Sự nghiệp</label>
                            <div class="text-secondary p-3 bg-light rounded-3" style="line-height: 1.8; text-align: justify;">
                                @(string.IsNullOrWhiteSpace(Model.Biography) ? "Thông tin tiểu sử đang được cập nhật." : Model.Biography)
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.Books != null && Model.Books.Any())
            {
                <div class="card border-0 shadow-sm bg-white rounded-3 mt-4">
                    <div class="card-header bg-white border-bottom py-3 px-4">
                        <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-list me-2 text-primary"></i>Danh sách tác phẩm của @Model.Name trong thư viện (@Model.Books.Count đầu sách)</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Tên sách</th>
                                        <th>ISBN</th>
                                        <th>Năm XB</th>
                                        <th>Số trang</th>
                                        <th>Số lượng kho</th>
                                        <th class="text-end pe-4">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var book in Model.Books)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold text-dark">@book.Title</div>
                                                <small class="text-muted">@(string.IsNullOrEmpty(book.Edition) ? "Bản chuẩn" : book.Edition)</small>
                                            </td>
                                            <td class="font-monospace small">@book.ISBN</td>
                                            <td>@(book.PublishYear > 0 ? book.PublishYear.ToString() : "-")</td>
                                            <td>@(book.PageCount > 0 ? $"{book.PageCount} tr." : "-")</td>
                                            <td>
                                                <span class="badge @(book.AvailableQuantity > 0 ? "bg-success" : "bg-danger")">
                                                    @book.AvailableQuantity / @book.Quantity
                                                </span>
                                            </td>
                                            <td class="text-end pe-4">
                                                <a asp-controller="Books" asp-action="AdminDetails" asp-route-id="@book.Id" class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-eye me-1"></i>Chi tiết
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <div class="mt-4 pt-3 border-top d-flex gap-2 justify-content-end">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-lg px-4 fs-6 rounded-2"><i class="fas fa-edit me-2"></i>Chỉnh sửa</a>
                <a asp-action="Index" class="btn btn-light border btn-lg px-4 fs-6 rounded-2 text-secondary"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
            </div>
        </div>
    </div>
</div>
