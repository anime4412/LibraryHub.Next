@model List<SOF1022_NHOM1_SD2003_Ver2.Models.DTOs.BroadcastSummaryDto>
@{
    ViewData["Title"] = "Quản lý thông báo";
}

<div class="container py-4">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4">@ViewData["Title"]</h2>

            <ul class="nav nav-tabs mb-4" id="notificationTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="broadcast-tab" data-bs-toggle="tab" data-bs-target="#broadcast" type="button" role="tab">Gửi thông báo mới</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="history-tab" data-bs-toggle="tab" data-bs-target="#history" type="button" role="tab">Lịch sử gửi</button>
                </li>
            </ul>

            <div class="tab-content" id="notificationTabsContent">
                <div class="tab-pane fade show active" id="broadcast" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            <form id="broadcastForm">
                                @Html.AntiForgeryToken()
                                <div class="mb-3">
                                    <label for="title" class="form-label">Tiêu đề <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="title" name="title" required maxlength="200">
                                </div>
                                <div class="mb-3">
                                    <label for="message" class="form-label">Nội dung <span class="text-danger">*</span></label>
                                    <textarea class="form-control" id="message" name="message" rows="4" required maxlength="1000"></textarea>
                                </div>
                                <div class="mb-3">
                                    <label for="targetRole" class="form-label">Gửi đến</label>
                                    <select class="form-select" id="targetRole" name="targetRole">
                                        <option value="All">Tất cả người dùng</option>
                                        <option value="Reader">Độc giả</option>
                                        <option value="Admin">Quản trị viên</option>
                                        <option value="Librarian">Thủ thư</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="link" class="form-label">Link (tùy chọn)</label>
                                    <input type="text" class="form-control" id="link" name="link" placeholder="/Books/Index">
                                    <div class="form-text">Đường dẫn trang người dùng sẽ được chuyển đến khi click vào thông báo</div>
                                </div>
                                <button type="submit" class="btn btn-primary" id="sendBroadcastBtn">
                                    <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                                    Gửi thông báo
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="history" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            @if (Model != null && Model.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Tiêu đề</th>
                                                <th>Nội dung</th>
                                                <th>Gửi đến</th>
                                                <th>Số người nhận</th>
                                                <th>Người gửi</th>
                                                <th>Thời gian</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var broadcast in Model)
                                            {
                                                <tr>
                                                    <td>@broadcast.Title</td>
                                                    <td class="text-truncate" style="max-width: 300px;">@broadcast.Message</td>
                                                    <td>@broadcast.TargetRole</td>
                                                    <td>@broadcast.RecipientCount</td>
                                                    <td>@broadcast.CreatedBy</td>
                                                    <td>@broadcast.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5">
                                    <p class="text-muted">Chưa có thông báo nào được gửi.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('broadcastForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const btn = document.getElementById('sendBroadcastBtn');
            const spinner = btn.querySelector('.spinner-border');
            
            btn.disabled = true;
            spinner.classList.remove('d-none');
            
            const formData = new FormData(this);
            
            fetch('/Notifications/SendBroadcast', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({ icon: 'success', title: 'Thông báo', text: 'Đã gửi thông báo thành công!' });
                    this.reset();
                    // Refresh the history tab
                    location.reload();
                } else {
                    Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Lỗi: ' + data.message });
                }
            })
            .catch(error => {
                console.error('Error:', error);
                Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Đã xảy ra lỗi khi gửi thông báo.' });
            })
            .finally(() => {
                btn.disabled = false;
                spinner.classList.add('d-none');
            });
        });
    </script>
}
