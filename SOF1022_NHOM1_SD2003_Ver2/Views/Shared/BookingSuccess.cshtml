@model SOF1022_NHOM1_SD2003_Ver2.Models.ViewModels.SuccessViewModel

@{
    ViewData["Title"] = "Thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg">
                <div class="card-body text-center py-5">
                    <!-- Success Icon -->
                    <div class="mb-4">
                        <div class="success-icon-wrapper">
                            <i class="fa-solid fa-circle-check success-icon"></i>
                        </div>
                    </div>

                    <!-- Success Title -->
                    <h2 class="text-success fw-bold mb-3">@Model.Title</h2>
                    
                    <!-- Success Message -->
                    <p class="text-muted fs-5 mb-4">@Model.Message</p>

                    <!-- Transaction Details -->
                    @if (Model.TransactionId != null)
                    {
                        <div class="bg-light rounded-3 p-3 mb-4">
                            <div class="row">
                                <div class="col-6 text-end">
                                    <small class="text-muted">Mã giao dịch:</small>
                                </div>
                                <div class="col-6 text-start">
                                    <small class="fw-bold">@Model.TransactionId</small>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-6 text-end">
                                    <small class="text-muted">Thời gian:</small>
                                </div>
                                <div class="col-6 text-start">
                                    <small class="fw-bold">@Model.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</small>
                                </div>
                            </div>
                            @if (Model.Amount.HasValue)
                            {
                                <div class="row mt-2">
                                    <div class="col-6 text-end">
                                        <small class="text-muted">Số tiền:</small>
                                    </div>
                                    <div class="col-6 text-start">
                                        <small class="fw-bold text-success">@Model.Amount.Value:N0} VNĐ</small>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Action Buttons -->
                    <div class="d-grid gap-2">
                        @if (Model.RedirectUrl != null)
                        {
                            <a href="@Model.RedirectUrl" class="btn btn-primary btn-lg fw-bold">
                                <i class="fa-solid fa-arrow-right me-2"></i>@Model.ButtonText
                            </a>
                        }
                        else
                        {
                            <a href="/" class="btn btn-primary btn-lg fw-bold">
                                <i class="fa-solid fa-home me-2"></i>Về trang chủ
                            </a>
                        }
                        
                        @if (Model.ShowHistoryButton)
                        {
                            <a href="/BorrowSlips/MyBorrows" class="btn btn-outline-secondary btn-lg fw-bold">
                                <i class="fa-solid fa-history me-2"></i>Xem lịch sử mượn
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .success-icon-wrapper {
        width: 100px;
        height: 100px;
        margin: 0 auto;
        position: relative;
    }
    
    .success-icon {
        font-size: 100px;
        color: #28a745;
        animation: successPulse 0.6s ease-out;
    }
    
    @@keyframes successPulse {
        0% {
            transform: scale(0);
            opacity: 0;
        }
        50% {
            transform: scale(1.2);
        }
        100% {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>
