@using Microsoft.AspNetCore.Http
@using SOF1022_NHOM1_SD2003_Ver2.Services
@using SOF1022_NHOM1_SD2003_Ver2.Datas
@using Microsoft.EntityFrameworkCore

@{
    var userId = Context.Session.GetString("UserId");
    var userName = Context.Session.GetString("UserName");
    var userRole = Context.Session.GetString("Role");
    var employeeIdStr = Context.Session.GetString("EmployeeId");

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    bool isAdmin = (userRole == "Admin");

    bool HasPermission(string permissionCode)
    {
        return Context.HasPermission(permissionCode);
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script>
        (function () {
            var theme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', theme);
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>
    <title>@ViewData["Title"] - Quản trị Thư viện</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap&subset=vietnamese" rel="stylesheet">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/design-tokens.css" />
    <link rel="stylesheet" href="~/css/components.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/monochrome-icons.css" asp-append-version="true" />
</head>
<body>

    <!-- Ambient Mesh (Taste-Soft Depth) -->
    <div class="ambient-mesh" aria-hidden="true">
        <div class="mesh-blob-1"></div>
        <div class="mesh-blob-2"></div>
    </div>

    <div class="admin-layout">

        <aside class="sidebar">
            <div class="sidebar-logo">
                <div class="logo-icon">
                    <i class="fa-solid fa-book-open-reader"></i>
                </div>
                <div>
                    <h5 class="mb-0">Thư Viện</h5>
                    <small>Trang Quản Trị</small>
                </div>
            </div>

            <nav class="sidebar-nav">
                @if (HasPermission("dashboard.view"))
                {
                    <span class="menu-title">TỔNG QUAN</span>
                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="@(currentController == "Dashboard" ? "active" : "")">
                        <i class="fa-solid fa-chart-pie"></i>
                        <span>Trang tổng quan</span>
                    </a>
                }

                @if (HasPermission("book.view") || HasPermission("category.view") || HasPermission("author.view") || HasPermission("publisher.view") || HasPermission("shelf.view"))
                {
                    <span class="menu-title">QUẢN LÝ THƯ VIỆN</span>
                    
                    @if (HasPermission("book.view"))
                    {
                        <a asp-controller="Books"
                           asp-action="AdminIndex"
                           class="@(currentController == "Books" ? "active" : "")">
                            <i class="fa-solid fa-table-list"></i>
                            <span>Quản lý Sách</span>
                        </a>
                    }

                    @if (HasPermission("category.view"))
                    {
                        <a asp-controller="Categories"
                           asp-action="Index"
                           class="@(currentController == "Categories" ? "active" : "")">
                            <i class="fa-solid fa-layer-group"></i>
                            <span>Danh mục sách</span>
                        </a>
                    }

                    @if (HasPermission("author.view"))
                    {
                        <a asp-controller="Authors"
                           asp-action="Index"
                           class="@(currentController == "Authors" ? "active" : "")">
                            <i class="fa-solid fa-user-pen"></i>
                            <span>Tác giả</span>
                        </a>
                    }

                    @if (HasPermission("publisher.view"))
                    {
                        <a asp-controller="Publishers"
                           asp-action="Index"
                           class="@(currentController == "Publishers" ? "active" : "")">
                            <i class="fa-solid fa-building"></i>
                            <span>Nhà xuất bản</span>
                        </a>
                    }

                    @if (HasPermission("shelf.view"))
                    {
                        <a asp-controller="Shelves"
                           asp-action="Index"
                           class="@(currentController == "Shelves" ? "active" : "")">
                            <i class="fa-solid fa-boxes-stacked"></i>
                            <span>Kệ sách</span>
                        </a>
                    }
                }

                @if (HasPermission("reader.view") || HasPermission("employee.view"))
                {
                    <span class="menu-title">NGƯỜI DÙNG</span>
                    @if (HasPermission("reader.view"))
                    {
                        <a asp-controller="Readers"
                           asp-action="Index"
                           class="@(currentController == "Readers" ? "active" : "")">
                            <i class="fa-solid fa-users"></i>
                            <span>Độc giả</span>
                        </a>
                    }

                    @if (HasPermission("employee.view"))
                    {
                        <a asp-controller="Employees"
                           asp-action="Index"
                           class="@(currentController == "Employees" ? "active" : "")">
                            <i class="fa-solid fa-user-tie"></i>
                            <span>Nhân viên</span>
                        </a>
                    }
                }

                @if (HasPermission("borrow.view") || HasPermission("reservation.view") || HasPermission("fine.view"))
                {
                    <span class="menu-title">MƯỢN TRẢ SÁCH</span>
                    @if (HasPermission("borrow.view"))
                    {
                        <a asp-controller="BorrowSlips"
                           asp-action="Index"
                           class="@(currentController == "BorrowSlips" ? "active" : "")">
                            <i class="fa-solid fa-file-signature"></i>
                            <span>Phiếu mượn sách</span>
                        </a>
                    }

                    @if (HasPermission("reservation.view"))
                    {
                        <a asp-controller="Reservations"
                           asp-action="Index"
                           class="@(currentController == "Reservations" ? "active" : "")">
                            <i class="fa-solid fa-calendar-check"></i>
                            <span>Đơn đặt trước</span>
                        </a>
                    }

                    @if (HasPermission("fine.view"))
                    {
                        <a asp-controller="Fines"
                           asp-action="Index"
                           class="@(currentController == "Fines" ? "active" : "")">
                            <i class="fa-solid fa-money-bill-wave"></i>
                            <span>Quản lý phạt tiền</span>
                        </a>
                    }
                }

                @if (HasPermission("notification.view"))
                {
                    <span class="menu-title">THÔNG BÁO</span>
                    <a asp-controller="Notifications"
                       asp-action="AdminIndex"
                       class="@(currentController == "Notifications" ? "active" : "")">
                        <i class="fa-solid fa-bell"></i>
                        <span>Thông báo</span>
                    </a>
                }

                @if (HasPermission("settings.edit") || isAdmin)
                {
                    <span class="menu-title">HỆ THỐNG</span>
                    <a asp-controller="SystemSettings"
                       asp-action="Index"
                       class="@(currentController == "SystemSettings" ? "active" : "")">
                        <i class="fa-solid fa-gear"></i>
                        <span>Cài đặt hệ thống</span>
                    </a>
                }
                <a asp-controller="Home"
                   asp-action="Index"
                   class="@(currentController == "Home" ? "active" : "")">
                    <i class="fa-solid fa-globe"></i>
                    <span>Xem trang độc giả</span>
                </a>
            </nav>

            <div class="sidebar-user">
                <div class="avatar">
                    <i class="fa-solid fa-user-shield"></i>
                </div>
                <div>
                    <strong>@userName</strong>
                    <br>
                    <small>@(string.IsNullOrEmpty(userRole) ? "Quản trị viên" : (userRole == "Admin" ? "Quản trị viên" : userRole))</small>
                </div>
            </div>
        </aside>

        <main class="main-content">

            <header class="topbar">
                <div class="topbar-left">
                    <h3 class="page-title">@ViewData["Title"]</h3>
                    <span class="page-subtitle">Hệ thống Quản lý Thư viện</span>
                </div>

                <div class="topbar-right">
                    <div class="search-box">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" placeholder="Tìm kiếm mọi thứ..." />
                    </div>

                    <partial name="_NotificationBellPartial" />

                    <button class="top-btn" id="themeToggleBtnAdmin" title="Chuyển chế độ sáng/tối" type="button">
                        <i class="fa-solid fa-moon" id="themeIconAdmin"></i>
                    </button>

                    @if (HasPermission("settings.edit") || isAdmin)
                    {
                        <a asp-controller="SystemSettings" asp-action="Index" class="top-btn" title="Cài đặt hệ thống">
                            <i class="fa-solid fa-gear"></i>
                        </a>
                    }

                    <div class="dropdown">
                        <button class="profile-btn dropdown-toggle" data-bs-toggle="dropdown">
                            <div class="profile-avatar">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <div class="profile-info">
                                <strong>@userName</strong>
                                <small>@(string.IsNullOrEmpty(userRole) ? "Quản trị viên" : (userRole == "Admin" ? "Quản trị viên" : userRole))</small>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4">
                            <li>
                                <h6 class="dropdown-header">Xin chào @userName</h6>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" asp-controller="Account" asp-action="AdminProfile">
                                    <i class="fa-solid fa-user me-2"></i> Hồ sơ cá nhân
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                    <i class="fa-solid fa-key me-2"></i> Đổi mật khẩu
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" asp-controller="Home" asp-action="Index">
                                    <i class="fa-solid fa-arrow-left me-2"></i> Ra trang chính
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="#" data-bs-toggle="modal" data-bs-target="#logoutModal">
                                    <i class="fa-solid fa-right-from-bracket me-2"></i> Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <section class="page-content">
                @RenderBody()
            </section>

            <footer class="admin-footer">
                <div class="footer-left">
                    <strong>Hệ thống Quản lý Thư viện</strong>
                    <br />
                    <small>Quản lý Thư viện Điện tử</small>
                </div>
                <div class="footer-right">
                    &copy; 2026 Bản quyền thuộc về Library Admin
                </div>
            </footer>

        </main>
    </div>

    @if (HasPermission("borrow.create") || HasPermission("reservation.create") || HasPermission("book.create") || HasPermission("category.create") || HasPermission("author.create") || HasPermission("publisher.create") || HasPermission("shelf.create") || HasPermission("reader.create") || (HasPermission("employee.create") && isAdmin))
    {
        <div class="quick-action dropdown">
            <button class="quick-btn" data-bs-toggle="dropdown" aria-label="Thao tác nhanh">
                <i class="fa-solid fa-plus"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4">
                @if (HasPermission("borrow.create"))
                {
                    <li>
                        <a class="dropdown-item" asp-controller="BorrowSlips" asp-action="Create">
                            <i class="fas fa-file-invoice text-primary me-2"></i> Tạo phiếu mượn hộ
                        </a>
                    </li>
                }
                @if (HasPermission("reservation.create"))
                {
                    <li>
                        <a class="dropdown-item" asp-controller="Reservations" asp-action="Create">
                            <i class="fas fa-bookmark text-info me-2"></i> Đặt trước sách hộ
                        </a>
                    </li>
                }
                @if (HasPermission("book.create"))
                {
                    <li>
                        <a class="dropdown-item" asp-controller="Books" asp-action="Create">
                            <i class="fas fa-book text-success me-2"></i> Thêm sách mới
                        </a>
                    </li>
                }
                @if (HasPermission("category.create"))
                {
                    <li>
                        <a class="dropdown-item" asp-controller="Categories" asp-action="Create">
                            <i class="fas fa-tags text-warning me-2"></i> Thêm danh mục
                        </a>
                    </li>
                }
                @if (HasPermission("author.create"))
                {
                    <li>
                        <a class="dropdown-item" asp-controller="Authors" asp-action="Create">
                            <i class="fas fa-feather-alt text-secondary me-2"></i> Thêm tác giả
                        </a>
                    </li>
                }
                @if (HasPermission("publisher.create"))
                {
                    <li>
                        <a class="dropdown-item" asp-controller="Publishers" asp-action="Create">
                            <i class="fas fa-building text-muted me-2"></i> Thêm nhà xuất bản
                        </a>
                    </li>
                }
                @if (HasPermission("shelf.create"))
                {
                    <li>
                        <a class="dropdown-item" asp-controller="Shelves" asp-action="Create">
                            <i class="fas fa-boxes text-dark me-2"></i> Thêm kệ sách
                        </a>
                    </li>
                }
                @if (HasPermission("reader.create"))
                {
                    <li>
                        <a class="dropdown-item" asp-controller="Readers" asp-action="Create">
                            <i class="fas fa-user-graduate text-danger me-2"></i> Thêm độc giả
                        </a>
                    </li>
                }
                @if (HasPermission("employee.create") && isAdmin)
                {
                    <li>
                        <a class="dropdown-item" asp-controller="Employees" asp-action="Create">
                            <i class="fas fa-user-shield text-primary me-2"></i> Thêm nhân viên
                        </a>
                    </li>
                }
            </ul>
        </div>
    }

    <button id="btnTop" class="back-top">
        <i class="fa-solid fa-arrow-up"></i>
    </button>

    <div class="modal fade" id="logoutModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <h4 class="fw-bold text-danger">
                        <i class="fa-solid fa-right-from-bracket me-2"></i> Đăng xuất
                    </h4>
                    <button class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <div class="logout-icon mb-4">
                        <i class="fa-solid fa-circle-question"></i>
                    </div>
                    <h5>Bạn có chắc chắn muốn đăng xuất?</h5>
                    <p class="text-muted mt-3">
                        Phiên đăng nhập hiện tại sẽ kết thúc. Bạn cần đăng nhập lại để tiếp tục truy cập trang quản trị.
                    </p>
                </div>
                <div class="modal-footer border-0 justify-content-center pb-4">
                    <button class="btn btn-light px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-danger px-4">Đăng xuất</a>
                </div>
            </div>
        </div>
    </div>

    <div id="loadingOverlay" style="display:none;">
        <div class="loading-box">
            <div class="spinner-border text-success"></div>
            <div class="mt-3">Đang tải dữ liệu...</div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Back To Top
        const btnTop = document.getElementById("btnTop");
        window.onscroll = function () {
            if (document.documentElement.scrollTop > 250) {
                btnTop.classList.add("show");
            } else {
                btnTop.classList.remove("show");
            }
        };
        btnTop.onclick = function () {
            window.scrollTo({ top: 0, behavior: "smooth" });
        };

        // Safe Loading Overlay helpers with auto-timeout safeguard
        let loadingTimeout = null;
        window.showLoading = function () {
            const overlay = document.getElementById("loadingOverlay");
            if (overlay) {
                overlay.classList.add("active");
                overlay.style.display = "flex";
                if (loadingTimeout) clearTimeout(loadingTimeout);
                loadingTimeout = setTimeout(window.hideLoading, 8000);
            }
        };
        window.hideLoading = function () {
            if (loadingTimeout) { clearTimeout(loadingTimeout); loadingTimeout = null; }
            const overlay = document.getElementById("loadingOverlay");
            if (overlay) {
                overlay.classList.remove("active");
                overlay.style.display = "none";
            }
        };

        // Đảm bảo không bao giờ bị kẹt overlay khi chuyển trang hoặc mở popup modal
        window.addEventListener("pageshow", window.hideLoading);
        window.addEventListener("load", window.hideLoading);
        document.addEventListener("DOMContentLoaded", window.hideLoading);
        document.addEventListener("show.bs.modal", window.hideLoading);
        document.addEventListener("shown.bs.modal", window.hideLoading);
        if (typeof $ !== 'undefined') {
            $(document).on('show.bs.modal hide.bs.modal shown.bs.modal hidden.bs.modal', function () {
                window.hideLoading();
            });
        }

        // Đảm bảo không bao giờ bị kẹt backdrop sau khi đóng modal
        document.addEventListener('hidden.bs.modal', function () {
            if (!document.querySelector('.modal.show')) {
                document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
                document.body.classList.remove('modal-open');
                document.body.style.removeProperty('overflow');
                document.body.style.removeProperty('padding-right');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    
    <!-- Notification System -->
    <script src="~/js/notification.js"></script>
    
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Global SweetAlert2 Toast Notification Utility
        window.showToast = function(icon, message) {
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            });
            Toast.fire({ icon: icon, title: message });
        };

        // Admin Dark/Light Mode Toggle
        (function() {
            const toggleBtn = document.getElementById('themeToggleBtnAdmin');
            const icon = document.getElementById('themeIconAdmin');
            const currentTheme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', currentTheme);
            document.documentElement.setAttribute('data-bs-theme', currentTheme);
            if (icon) {
                icon.className = currentTheme === 'dark' ? 'fa-solid fa-sun text-warning' : 'fa-solid fa-moon';
            }
            if (toggleBtn) {
                toggleBtn.addEventListener('click', function() {
                    const nextTheme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
                    document.documentElement.setAttribute('data-theme', nextTheme);
                    document.documentElement.setAttribute('data-bs-theme', nextTheme);
                    localStorage.setItem('theme', nextTheme);
                    if (icon) {
                        icon.className = nextTheme === 'dark' ? 'fa-solid fa-sun text-warning' : 'fa-solid fa-moon';
                    }
                });
            }
        })();
    </script>

    <!-- PolyLib AI Assistant -->
    @await Html.PartialAsync("_AiChatWidget")
</body>
</html>