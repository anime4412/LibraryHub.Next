@* =============================================================================
   Curved 3D Book Archive Component (Kệ Sách Tinh Hoa 3D - Dữ Liệu Sách Thật)
   Razor Partial View: _VhsCurvedArchive.cshtml
   ============================================================================= *@
@model dynamic

<!-- Google Fonts: Inter Tight, Newsreader -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&display=swap" rel="stylesheet">

<div class="vhs-archive-root" id="vhsArchiveRoot">
    <!-- Paper Grain Texture Layer -->
    <div class="vhs-grain" aria-hidden="true"></div>

    <!-- Soft Floor Shadow for Active Curved Shelf -->
    <div class="vhs-floor-shadow" id="vhsFloorShadow" aria-hidden="true"></div>

    <!-- Header: KỆ SÁCH TINH HOA 3D & DANH MỤC -->
    <header class="vhs-shelf-top-header">
        <div class="vhs-header-left">
            <div class="vhs-badge-pill">
                <i class="fa-solid fa-bookmark me-1 text-primary"></i> KỆ SÁCH TINH HOA 3D
            </div>
            <h1 class="vhs-main-heading">Không Gian Tri Thức Đỉnh Cao</h1>
            <p class="vhs-main-subheading">KHÔNG GIAN TƯƠNG TÁC TÁC PHẨM KINH ĐIỂN &amp; TRI THỨC THẾ GIỚI</p>
        </div>
        <div class="vhs-header-right">
            <div class="vhs-category-nav" id="vhsCategoryNav">
                <button type="button" class="vhs-cat-btn active" data-cat="all">Tất cả</button>
                <button type="button" class="vhs-cat-btn" data-cat="Văn học">Văn học</button>
                <button type="button" class="vhs-cat-btn" data-cat="Kỹ năng sống">Kỹ năng sống</button>
                <button type="button" class="vhs-cat-btn" data-cat="Khoa học">Khoa học</button>
                <button type="button" class="vhs-cat-btn" data-cat="Thiếu nhi">Thiếu nhi</button>
                <button type="button" class="vhs-cat-btn" data-cat="Kinh doanh">Kinh doanh</button>
            </div>
            <div class="vhs-search-box">
                <input type="text" id="vhsSearchInput" class="vhs-search-input" placeholder="Tìm theo tên sách, tác giả hoặc ISBN..." autocomplete="off" />
                <button type="button" id="vhsSearchBtn" class="vhs-search-submit">
                    <span>Tìm kiếm</span> <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Curved 3D Shelf Stage -->
    <section class="vhs-shelf-viewport" id="vhsShelfViewport" aria-label="Curved 3D Book Shelf">
        <div class="vhs-probe" id="vhsHeightProbe" aria-hidden="true"></div>
        <div class="vhs-stage" id="vhs3DStage"></div>
    </section>

    <!-- Play / Open Ring Floating on Active Cover -->
    <div class="vhs-play-ring" id="vhsPlayRing" title="Xem chi tiết sách" aria-label="Xem chi tiết sách">
        <i class="fa-solid fa-book-open vhs-play-icon"></i>
    </div>

    <!-- Book Dynamic Caption (Single-Element Transform: Chống Chồng Lấn Chữ Tuyệt Đối) -->
    <div class="vhs-caption" id="vhsCaption">
        <div class="vhs-counter-badge" id="vhsCounterBadge">1 / 12</div>
        <div class="vhs-mask-wrap">
            <h2 class="vhs-title" id="vhsTitle">Đắc Nhân Tâm</h2>
        </div>
        <div class="vhs-mask-wrap">
            <div class="vhs-subtitle vhs-lbl" id="vhsSubtitle">DALE CARNEGIE · KỸ NĂNG SỐNG</div>
        </div>
        <div class="vhs-rule"></div>
        <div class="vhs-mask-wrap">
            <div class="vhs-year-genre" id="vhsYearGenre">NĂM 1936 · 320 TRANG</div>
        </div>

        <!-- Action Buttons (Mượn sách ngay & Xem chi tiết) -->
        <div class="vhs-action-buttons">
            <a href="/BorrowSlips/Create?bookId=1" id="vhsMainBorrowBtn" class="vhs-action-btn vhs-action-btn-primary">
                <i class="fa-solid fa-book-bookmark me-1"></i> Mượn sách ngay
            </a>
            <a href="/Books/Details/1" id="vhsMainDetailBtn" class="vhs-action-btn vhs-action-btn-secondary">
                <i class="fa-solid fa-circle-info me-1"></i> Xem chi tiết
            </a>
        </div>

        <!-- Left / Right Navigation Arrows -->
        <button type="button" class="vhs-arrow vhs-arrow-prev" id="vhsArrowPrev" aria-label="Sách trước">
            <svg viewBox="0 0 24 12" width="24" height="12" fill="none" stroke="currentColor" stroke-width="1.4">
                <path d="M6 1L1 6l5 5M1 6h23"/>
            </svg>
        </button>
        <button type="button" class="vhs-arrow vhs-arrow-next" id="vhsArrowNext" aria-label="Sách tiếp theo">
            <svg viewBox="0 0 24 12" width="24" height="12" fill="none" stroke="currentColor" stroke-width="1.4">
                <path d="M18 1l5 5-5 5M23 6H0"/>
            </svg>
        </button>
    </div>

    <!-- Timeline / Index Ruler (Tủ Sách Tinh Hoa) -->
    <div class="vhs-timeline" id="vhsTimeline" aria-label="Thước điều hướng sách">
        <div class="vhs-timeline-line"></div>
        <div class="vhs-timeline-dot" id="vhsTimelineDot"></div>
        <div class="vhs-timeline-ticks" id="vhsTimelineTicks"></div>
    </div>

    <!-- Footer Counter & Mode Indicator -->
    <footer class="vhs-footer">
        <div class="vhs-lbl">KỆ SÁCH TINH HOA 3D · THƯ VIỆN ĐIỆN TỬ</div>
        <div class="vhs-footer-right">
            <span class="vhs-lbl" id="vhsBookCounter">1 / 12</span>
            <span class="vhs-lbl text-muted">· KÉO XOAY HOẶC CUỘN ĐỂ DUYỆT</span>
        </div>
    </footer>

    <!-- Interactive Custom Cursor -->
    <div class="vhs-cursor" id="vhsCursor" aria-hidden="true">
        <div class="vhs-cursor-ring"></div>
        <div class="vhs-cursor-dot"></div>
        <div class="vhs-cursor-label">
            <span>XEM</span>
            <span class="vhs-cursor-sub">CHI TIẾT</span>
        </div>
    </div>

    <!-- Full-Screen Detail Paper Sheet (Mở Sách Lớn Loang Mực Tinh Tế) -->
    <div class="vhs-detail" id="vhsDetailSheet" aria-hidden="true">
        <header class="vhs-detail-header">
            <button type="button" class="vhs-box vhs-lbl vhs-detail-close" id="vhsDetailClose">
                <i class="fa-solid fa-xmark me-1"></i> ĐÓNG / QUAY LẠI
            </button>
            <div class="vhs-lbl vhs-detail-brand">THƯ VIỆN ĐIỆN TỬ — CHI TIẾT TÁC PHẨM</div>
        </header>

        <div class="vhs-detail-body">
            <!-- Left Column: Book Real Information -->
            <div class="vhs-detail-info">
                <div class="vhs-detail-mask">
                    <span class="vhs-lbl text-cobalt" id="vhsDetailSub">DALE CARNEGIE · KỸ NĂNG SỐNG</span>
                </div>
                <div class="vhs-detail-mask">
                    <h1 class="vhs-detail-title" id="vhsDetailTitle">Đắc Nhân Tâm</h1>
                </div>
                <div class="vhs-detail-mask">
                    <div class="vhs-detail-meta" id="vhsDetailMeta">XUẤT BẢN: 1936 · SỐ TRANG: 320</div>
                </div>
                <div class="vhs-detail-mask">
                    <p class="vhs-detail-synopsis" id="vhsDetailSynopsis">
                        Đắc Nhân Tâm của Dale Carnegie là cuốn sách kinh điển và bán chạy nhất mọi thời đại về nghệ thuật đối nhân xử thế.
                    </p>
                </div>
                <div class="vhs-detail-mask">
                    <div class="vhs-detail-credit" id="vhsDetailAuthor">Tác giả: Dale Carnegie</div>
                </div>
                <div class="vhs-detail-mask pt-3 d-flex flex-wrap gap-2">
                    <a href="#" id="vhsDetailLink" class="vhs-detail-watch-btn vhs-lbl">
                        <i class="fa-solid fa-book-open me-2"></i> XEM CHI TIẾT SÁCH
                    </a>
                    <a href="#" id="vhsDetailBorrowLink" class="vhs-detail-borrow-btn vhs-lbl">
                        <i class="fa-solid fa-hand-holding-heart me-2"></i> MƯỢN SÁCH NGAY
                    </a>
                </div>
            </div>

            <!-- Right Column: Real Book Cover SVG with Ink Bleed Effect -->
            <div class="vhs-detail-poster-col">
                <svg class="vhs-poster-svg" id="vhsPosterSvg" viewBox="0 0 474 680" preserveAspectRatio="xMidYMid meet">
                    <defs>
                        <filter id="vhsInkFilter" x="-20%" y="-20%" width="140%" height="140%">
                            <feTurbulence type="fractalNoise" baseFrequency="0.011" numOctaves="3" seed="7" result="noise" />
                            <feDisplacementMap in="SourceGraphic" in2="noise" scale="90" xChannelSelector="R" yChannelSelector="G" />
                        </filter>

                        <mask id="vhsInkMask">
                            <rect width="474" height="680" fill="black" />
                            <g filter="url(#vhsInkFilter)">
                                <circle id="vhsInkBlob0" cx="150" cy="250" r="0" fill="white" />
                                <circle id="vhsInkBlob1" cx="340" cy="450" r="0" fill="white" />
                                <circle id="vhsInkBlob2" cx="250" cy="100" r="0" fill="white" />
                                <circle id="vhsInkBlob3" cx="90" cy="580" r="0" fill="white" />
                                <circle id="vhsInkBlob4" cx="400" cy="180" r="0" fill="white" />
                                <circle id="vhsInkBlob5" cx="260" cy="620" r="0" fill="white" />
                                <circle id="vhsInkBlob6" cx="230" cy="350" r="0" fill="white" />
                            </g>
                        </mask>
                        <clipPath id="vhsPosterClip">
                            <rect width="474" height="680" rx="8" ry="8" />
                        </clipPath>
                    </defs>

                    <g clip-path="url(#vhsPosterClip)">
                        <image id="vhsPosterImg" x="0" y="0" width="474" height="680"
                               mask="url(#vhsInkMask)" preserveAspectRatio="xMidYMid slice" />
                    </g>
                </svg>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --paper: #ECE8E0;
        --sheet: #F3F0EA;
        --ink: #141414;
        --muted: #6D6A63;
        --cobalt: #1F3FB0;
        --rule: rgba(20, 20, 20, 0.9);
        --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
        --H: min(43vh, 31vw);
        --cy: 46%;
    }

    @@media (max-width: 991px) {
        :root {
            --H: min(58vw, 36svh);
            --cy: 48%;
        }
    }

    .vhs-archive-root {
        position: relative;
        width: 100%;
        height: 100vh;
        min-height: 720px;
        background-color: var(--paper);
        color: var(--ink);
        font-family: "Inter Tight", system-ui, -apple-system, sans-serif;
        overflow: hidden;
        user-select: none;
        -webkit-user-select: none;
        -webkit-font-smoothing: antialiased;
        border-bottom: 1px solid rgba(20, 20, 20, 0.15);
    }

    /* Top Shelf Header */
    .vhs-shelf-top-header {
        position: absolute;
        top: 24px;
        left: 40px;
        right: 40px;
        z-index: 35;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        pointer-events: auto;
    }

    .vhs-header-left {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .vhs-badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        background: rgba(31, 63, 176, 0.08);
        border: 1px solid rgba(31, 63, 176, 0.2);
        border-radius: 99px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--cobalt);
        width: fit-content;
    }

    .vhs-main-heading {
        font-size: clamp(20px, 2.2vw, 28px);
        font-weight: 800;
        color: #111827;
        margin: 2px 0 0 0;
        letter-spacing: -0.02em;
    }

    .vhs-main-subheading {
        font-size: 10.5px;
        font-weight: 600;
        color: #6b7280;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin: 0;
    }

    .vhs-header-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 10px;
    }

    .vhs-category-nav {
        display: flex;
        align-items: center;
        gap: 6px;
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(8px);
        padding: 4px;
        border-radius: 99px;
        border: 1px solid rgba(0, 0, 0, 0.08);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .vhs-cat-btn {
        padding: 6px 14px;
        border-radius: 99px;
        border: none;
        background: transparent;
        font-size: 12px;
        font-weight: 600;
        color: #4b5563;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .vhs-cat-btn:hover {
        color: var(--cobalt);
        background: rgba(31, 63, 176, 0.06);
    }

    .vhs-cat-btn.active {
        background: #111827;
        color: #ffffff;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    }

    .vhs-search-box {
        display: flex;
        align-items: center;
        background: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.12);
        border-radius: 99px;
        padding: 4px 6px 4px 16px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
        width: 380px;
        max-width: 100%;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .vhs-search-box:focus-within {
        border-color: var(--cobalt);
        box-shadow: 0 4px 18px rgba(31, 63, 176, 0.18);
    }

    .vhs-search-input {
        border: none;
        outline: none;
        background: transparent;
        font-size: 13px;
        color: #1f2937;
        width: 100%;
    }

    .vhs-search-submit {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #111827;
        color: #ffffff;
        border: none;
        border-radius: 99px;
        padding: 7px 14px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s;
        white-space: nowrap;
    }

    .vhs-search-submit:hover {
        background: var(--cobalt);
    }

    @@media (max-width: 991px) {
        .vhs-shelf-top-header {
            flex-direction: column;
            align-items: center;
            text-align: center;
            top: 14px;
            left: 14px;
            right: 14px;
            gap: 12px;
        }
        .vhs-header-left {
            align-items: center;
        }
        .vhs-header-right {
            align-items: center;
            width: 100%;
        }
        .vhs-category-nav {
            overflow-x: auto;
            max-width: 100%;
            padding: 3px 6px;
        }
        .vhs-search-box {
            width: 100%;
        }
    }

    /* Cursor */
    .vhs-cursor {
        pointer-events: none !important;
    }

    /* Paper Grain Layer */
    .vhs-grain {
        position: absolute;
        inset: 0;
        z-index: 40;
        pointer-events: none;
        mix-blend-mode: multiply;
        opacity: 0.55;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 220 220' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3CfeColorMatrix type='matrix' values='0 0 0 0 0.45 0 0 0 0 0.42 0 0 0 0 0.38 0 0 0 0 0.22 0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    }

    .vhs-lbl {
        font-family: "Inter Tight", sans-serif;
        font-weight: 600;
        font-size: 11px;
        line-height: 1.2;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--cobalt);
    }

    .vhs-box {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 28px;
        padding: 0 14px;
        border: 1px solid var(--rule);
        border-radius: 99px;
        background: transparent;
        color: var(--cobalt);
        text-decoration: none;
        cursor: pointer;
        transition: background-color 0.2s, color 0.2s;
    }
    .vhs-box:hover {
        background: var(--cobalt);
        color: var(--paper);
    }

    .text-cobalt { color: var(--cobalt) !important; }

    /* Floor Shadow */
    .vhs-floor-shadow {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        top: calc(var(--cy) + var(--H) * 0.47);
        width: min(96vw, calc(var(--H) * 3.6));
        height: calc(var(--H) * 0.26);
        background: radial-gradient(50% 50% at 50% 40%, rgba(40,32,20,0.30), rgba(40,32,20,0.10) 55%, transparent 72%);
        z-index: 5;
        pointer-events: none;
    }

    /* 3D Shelf Stage */
    .vhs-shelf-viewport {
        position: absolute;
        left: 0;
        right: 0;
        top: calc(var(--cy) - var(--H) / 2 - 50px);
        height: calc(var(--H) + 100px);
        perspective: 1400px;
        perspective-origin: 50% 50%;
        z-index: 10;
        touch-action: pan-y;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .vhs-probe {
        position: absolute;
        height: var(--H);
        width: 1px;
        opacity: 0;
        pointer-events: none;
    }

    .vhs-stage {
        position: relative;
        width: 0;
        height: 0;
        transform-style: preserve-3d;
    }

    /* Individual 3D Book Object */
    .vhs-tape {
        position: absolute;
        width: 0;
        height: 0;
        top: 0;
        left: 0;
        transform-style: preserve-3d;
        will-change: transform;
    }

    .vhs-face {
        position: absolute;
        height: var(--H);
        top: calc(-1 * var(--H) / 2);
        backface-visibility: hidden;
        border-radius: 3px;
        background-repeat: no-repeat;
        box-sizing: border-box;
    }

    .vhs-face::after {
        content: "";
        position: absolute;
        inset: 0;
        background: #000000;
        border-radius: 3px;
        pointer-events: none;
        transition: opacity 0.1s linear;
    }

    /* Book Spine Face */
    .vhs-sp {
        left: calc(-1 * var(--ws) / 2);
        width: var(--ws);
        transform: translateZ(calc(var(--d) / 2));
        box-shadow: inset 0 0 6px rgba(0,0,0,0.4);
    }
    .vhs-sp::after {
        opacity: var(--sp-shade, 0);
    }

    /* Book Front Cover Face */
    .vhs-cv {
        left: calc(-1 * var(--d) / 2);
        width: var(--d);
        transform: rotateY(90deg) translateZ(calc(var(--ws) / 2));
        box-shadow: 0 34px 60px -25px rgba(20, 16, 10, 0.65);
        cursor: pointer;
        background-size: cover;
        background-position: center;
    }
    .vhs-cv::after {
        opacity: var(--cv-shade, 0);
    }

    /* Floating Play / Open Ring */
    .vhs-play-ring {
        position: absolute;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 1.5px solid var(--cobalt);
        background: rgba(236, 232, 224, 0.9);
        color: var(--cobalt);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 25;
        transform: translate(-50%, -50%) scale(0);
        pointer-events: auto;
        cursor: pointer;
        transition: background-color 0.2s, color 0.2s, transform 0.15s ease-out;
        box-shadow: 0 4px 16px rgba(31, 63, 176, 0.2);
    }
    .vhs-play-ring:hover {
        background: var(--cobalt);
        color: var(--paper);
    }
    .vhs-play-icon {
        font-size: 15px;
    }

    /* Caption: KHẮC PHỤC TRIỆT ĐỂ LỖI CHỒNG CHỮ */
    .vhs-caption {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        top: calc(var(--cy) + var(--H) / 2 + 3.2vh);
        width: min(84vw, 700px);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 8px;
        z-index: 20;
    }

    .vhs-mask-wrap {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 28px;
    }

    .vhs-title {
        font-family: "Inter Tight", sans-serif;
        font-weight: 700;
        font-size: clamp(26px, 3.2vw, 44px);
        letter-spacing: -0.015em;
        line-height: 1.15;
        color: var(--cobalt);
        margin: 0;
        white-space: nowrap;
        text-overflow: ellipsis;
        max-width: 100%;
        overflow: hidden;
        transition: transform 0.25s var(--ease), opacity 0.25s;
    }

    .vhs-subtitle {
        font-size: 10.5px;
        letter-spacing: 0.16em;
        color: var(--cobalt);
        margin: 0;
        white-space: nowrap;
        text-overflow: ellipsis;
        max-width: 100%;
        overflow: hidden;
        transition: transform 0.25s var(--ease), opacity 0.25s;
    }

    .vhs-rule {
        width: 24px;
        height: 1.5px;
        background: var(--cobalt);
        margin: 1px 0;
    }

    .vhs-year-genre {
        font-family: "Inter Tight", sans-serif;
        font-weight: 500;
        font-size: 11px;
        letter-spacing: 0.08em;
        color: var(--ink);
        text-transform: uppercase;
        white-space: nowrap;
        transition: transform 0.25s var(--ease), opacity 0.25s;
    }

    /* Counter Badge */
    .vhs-counter-badge {
        display: inline-block;
        padding: 3px 14px;
        border-radius: 99px;
        background: rgba(0, 0, 0, 0.06);
        border: 1px solid rgba(0, 0, 0, 0.1);
        font-size: 11px;
        font-weight: 700;
        color: #4b5563;
