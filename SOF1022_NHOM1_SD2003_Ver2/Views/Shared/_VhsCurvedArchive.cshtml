        let ws = H * 142 / 840;
        let d = H * 474 / 900;
        let gap = H * 0.035;
        let isMobile = window.innerWidth <= 767;
        let U = isMobile ? H * 1.05 : H * 1.3;
        const P = 1400;

        let XS = [];
        function recomputeXS() {
            XS = [];
            let acc = 0;
            const maxU = 3 * U;
            for (let u = 0; u <= maxU; u += 2) {
                acc += 2 / (1 + Math.pow(u / U, 1.6));
                XS.push(acc);
            }
        }
        recomputeXS();

        function xsc(u) {
            const idx = Math.min(XS.length - 1, Math.floor(Math.abs(u) / 2));
            return Math.sign(u) * (XS[idx] || 0);
        }

        function B(r) {
            if (Math.abs(r) < 1) return (r + Math.sin(Math.PI * r) / Math.PI) / 2;
            return r > 0 ? 0.5 : -0.5;
        }

        function F(r) {
            return r * (ws + gap) + (d - ws + 1.4 * gap) * B(r);
