            return 1 / (1 + Math.pow(Math.abs(u) / U, 1.6));
        }

        function rel(v, s) {
            let r = (v - s) % 36;
            if (r < -18) r += 36;
            if (r >= 18) r -= 36;
            return r;
        }

        function smoothstep(val) {
            const x = Math.max(0, Math.min(1, val));
            return x * x * (3 - 2 * x);
        }

        // Sinh 36 cuốn sách 3D (3 chu kỳ của 12 sách thật)
        const tapes = [];
        const spineUrlCache = USER_BOOKS.map(b => createBookSpineCanvas(b));

        for (let copy = 0; copy < 3; copy++) {
            for (let i = 0; i < 12; i++) {
                const v = copy * 12 + i;
                const book = USER_BOOKS[i];

                const tapeEl = document.createElement('div');
                tapeEl.className = 'vhs-tape';
                tapeEl.dataset.v = v;
                tapeEl.dataset.filmIdx = i;

                // Gáy sách (Spine)
                const spEl = document.createElement('div');
                spEl.className = 'vhs-face vhs-sp';
                spEl.style.backgroundImage = `url("${spineUrlCache[i]}")`;
                spEl.style.backgroundSize = '100% 100%';

                // Mặt bìa sách (Front Cover)
                const cvEl = document.createElement('div');
                cvEl.className = 'vhs-face vhs-cv';
                cvEl.style.backgroundImage = `url("${book.cover}")`;

                tapeEl.appendChild(spEl);
                tapeEl.appendChild(cvEl);
                stage.appendChild(tapeEl);

                tapes.push({
                    v, filmIdx: i, el: tapeEl, cvEl, spEl, lift: 0
                });
            }
        }

        // Xây dựng thước phân đoạn 12 cuốn sách
        if (timelineTicks) {
            for (let i = 0; i < 12; i++) {
                const pct = (i / 11) * 100;
                const tick = document.createElement('div');
                tick.className = 'vhs-tick vhs-tick-major';
                tick.style.left = `${pct}%`;
                timelineTicks.appendChild(tick);

                const lbl = document.createElement('div');
                lbl.className = 'vhs-tick-label';
                if (i === 0) lbl.classList.add('align-left');
                if (i === 11) lbl.classList.add('align-right');
                lbl.style.left = `${pct}%`;
                lbl.textContent = USER_BOOKS[i].year > 0 ? USER_BOOKS[i].year : `№ ${i + 1}`;
                timelineTicks.appendChild(lbl);
            }
        }

        // Biến trạng thái
        let s = 12; // Bắt đầu ở cuốn Đắc Nhân Tâm (index 0 + 12 = 12)
        let T = 12;
        let activeBookIdx = 0;
        let isDetailOpen = false;
        let isDragging = false;
        let dragStartX = 0;
        let dragStartT = 0;
        let mouseX = window.innerWidth / 2;
        let mouseY = window.innerHeight / 2;
        let cursorX = mouseX;
        let cursorY = mouseY;
        let tiltX = 0, targetTiltX = 0;
        let tiltY = 0, targetTiltY = 0;
        let hoveredTape = null;

        // CẬP NHẬT CHỮ ĐƠN PHẦN TỬ: CHỐNG CHỒNG CHÉO CHỮ TUYỆT ĐỐI
        function setCaptionDirect(el, newText, dir = 1) {
            if (el.textContent === newText) return;
            el.textContent = newText;
            el.animate([
                { transform: `translateY(${dir * 18}px)`, opacity: 0 },
                { transform: 'translateY(0)', opacity: 1 }
            ], {
                duration: 220,
                easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)',
                fill: 'both'
            });
        }

        function updateBookCaption(newIdx, dir = 1) {
            const book = USER_BOOKS[newIdx];
            if (!book) return;

            setCaptionDirect(titleEl, book.title, dir);
            setCaptionDirect(subtitleEl, `${book.author.toUpperCase()} · ${book.category.toUpperCase()}`, dir);
            setCaptionDirect(yearGenreEl, `NĂM ${book.year > 0 ? book.year : 'CỔ ĐẠI'} · ${book.pages} TRANG`, dir);

            if (bookCounter) {
                bookCounter.textContent = `${newIdx + 1} / 12`;
            }
            if (counterBadge) {
                counterBadge.textContent = `${newIdx + 1} / 12`;
            }
            if (mainBorrowBtn) {
                mainBorrowBtn.href = `/BorrowSlips/Create?bookId=${book.id}`;
            }
            if (mainDetailBtn) {
                mainDetailBtn.href = `/Books/Details/${book.id}`;
            }
        }

        // Điều hướng theo danh mục
        if (categoryNav) {
            categoryNav.addEventListener('click', (e) => {
                const btn = e.target.closest('.vhs-cat-btn');
                if (!btn) return;
                categoryNav.querySelectorAll('.vhs-cat-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                const cat = btn.dataset.cat;
                if (cat === 'all') {
                    T = 12; // Cuộn về cuốn đầu tiên
                    return;
                }
                const matchIdx = USER_BOOKS.findIndex(b => b.category.toLowerCase().includes(cat.toLowerCase()));
                if (matchIdx !== -1) {
                    T = 12 + matchIdx;
                }
            });
        }

        // Tìm kiếm sách trên kệ
        function handleShelfSearch() {
            if (!searchInput) return;
            const q = searchInput.value.trim().toLowerCase();
            if (!q) return;

            const matchIdx = USER_BOOKS.findIndex(b => 
                b.title.toLowerCase().includes(q) || 
                b.author.toLowerCase().includes(q) || 
                b.category.toLowerCase().includes(q));

            if (matchIdx !== -1) {
                T = 12 + matchIdx;
                searchInput.blur();
            } else {
                alert(`Không tìm thấy "${searchInput.value}" trên kệ sách 3D. Bạn có thể tra cứu trong toàn bộ kho sách của thư viện.`);
            }
        }

        if (searchBtn) searchBtn.addEventListener('click', handleShelfSearch);
        if (searchInput) {
            searchInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    handleShelfSearch();
                }
            });
        }

        function syncMeasurements() {
            H = probe.clientHeight || 300;
            ws = H * 142 / 840;
            d = H * 474 / 900;
            gap = H * 0.035;
            isMobile = window.innerWidth <= 767;
            U = isMobile ? H * 1.05 : H * 1.3;
            recomputeXS();

            root.style.setProperty('--ws', `${ws}px`);
            root.style.setProperty('--d', `${d}px`);
        }
        syncMeasurements();

        window.addEventListener('resize', syncMeasurements);
        window.addEventListener('pointermove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
        });

        // Kéo chuột duyệt sách
        let hasMovedDrag = false;
        root.addEventListener('pointerdown', (e) => {
            if (isDetailOpen) return;
            if (e.target.closest('.vhs-arrow, .vhs-timeline, .vhs-play-ring, .vhs-detail')) return;

            isDragging = true;
            hasMovedDrag = false;
            dragStartX = e.clientX;
            dragStartT = T;
        });

        window.addEventListener('pointermove', (e) => {
            if (!isDragging) return;
            const dx = e.clientX - dragStartX;
            if (Math.abs(dx) > 5) hasMovedDrag = true;
            T = dragStartT - dx / (ws + gap);
        });

        window.addEventListener('pointerup', () => {
            if (isDragging) {
                isDragging = false;
                T = Math.round(T);
            }
        });

        // Cuộn chuột
        let wheelTimeout;
        root.addEventListener('wheel', (e) => {
            if (isDetailOpen) return;
            const delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
            T += (delta / (ws + gap)) * 0.5;
            clearTimeout(wheelTimeout);
            wheelTimeout = setTimeout(() => {
                T = Math.round(T);
            }, 160);
        }, { passive: true });

        // Phím mũi tên
        window.addEventListener('keydown', (e) => {
            if (isDetailOpen) {
                if (e.key === 'Escape') closeDetail();
                return;
            }
            if (e.key === 'ArrowLeft') {
                T = Math.round(T - 1);
            } else if (e.key === 'ArrowRight') {
                T = Math.round(T + 1);
            } else if (e.key === 'Enter') {
                openDetail();
            }
        });

        arrowPrev.addEventListener('click', () => { T = Math.round(T - 1); });
        arrowNext.addEventListener('click', () => { T = Math.round(T + 1); });
        playRing.addEventListener('click', openDetail);

        // Bấm vào sách
        tapes.forEach(t => {
            t.el.addEventListener('pointerenter', () => { hoveredTape = t; });
            t.el.addEventListener('pointerleave', () => { if (hoveredTape === t) hoveredTape = null; });

            t.el.addEventListener('click', (e) => {
                if (hasMovedDrag || isDetailOpen) return;
                const r = rel(t.v, s);
                if (Math.abs(r) < 0.5) {
                    openDetail();
                } else {
                    T = Math.round(T + r);
                }
            });
        });

        // Thước điều hướng
        timelineEl.addEventListener('click', (e) => {
            const rect = timelineEl.getBoundingClientRect();
            const pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
            const targetIdx = Math.round(pct * 11);

            const currentIdx = ((Math.round(T) % 12) + 12) % 12;
            let diff = targetIdx - currentIdx;
            if (diff > 6) diff -= 12;
            if (diff < -6) diff += 12;
            T = Math.round(T + diff);
        });

        function updateCursorClass() {
            if (!cursor) return;
            const target = document.elementFromPoint(mouseX, mouseY);
            if (!target) return;

            const isOverActiveCover = target.closest('.vhs-cv') && Math.abs(T - s) < 0.3;
            const isOverSpine = target.closest('.vhs-sp');
            const isOverBtn = target.closest('button, a, .vhs-timeline, .vhs-play-ring');

            cursor.classList.toggle('open', !!isOverActiveCover && !isDetailOpen);
            cursor.classList.toggle('spine', !!isOverSpine && !isDetailOpen);
            cursor.classList.toggle('btn', !!isOverBtn);
        }

        // Mở Trang Chi Tiết Sách
        function openDetail() {
            if (isDetailOpen) return;
            isDetailOpen = true;

            const book = USER_BOOKS[activeBookIdx];
            document.getElementById('vhsDetailSub').textContent = `${book.author.toUpperCase()} · ${book.category.toUpperCase()}`;
            document.getElementById('vhsDetailTitle').textContent = book.title;
            document.getElementById('vhsDetailMeta').textContent = `XUẤT BẢN: ${book.year > 0 ? book.year : 'CỔ ĐẠI'} · SỐ TRANG: ${book.pages}`;
            document.getElementById('vhsDetailSynopsis').textContent = book.synopsis;
            document.getElementById('vhsDetailAuthor').textContent = `Tác giả: ${book.author} · Thể loại: ${book.category}`;

            // Gán link chi tiết và mượn sách
            const detailLink = document.getElementById('vhsDetailLink');
            const borrowLink = document.getElementById('vhsDetailBorrowLink');
            if (detailLink) detailLink.href = `/Books/Details/${book.id}`;
            if (borrowLink) borrowLink.href = `/Books/Details/${book.id}`;

            // Gán ảnh bìa sách thật vào poster SVG
            posterImg.setAttribute('href', book.cover);

            const activeTape = tapes.find(t => t.filmIdx === activeBookIdx && Math.abs(rel(t.v, s)) < 0.5);
            let startRect = { top: window.innerHeight * 0.25, left: window.innerWidth * 0.35, width: d, height: H };
            if (activeTape) {
                const r = activeTape.cvEl.getBoundingClientRect();
                if (r.width > 0 && r.height > 0) startRect = r;
            }

            const insetStart = `inset(${startRect.top}px ${window.innerWidth - (startRect.left + startRect.width)}px ${window.innerHeight - (startRect.top + startRect.height)}px ${startRect.left}px round 3px)`;
            const insetEnd = 'inset(0px 0px 0px 0px round 0px)';

            detailSheet.style.display = 'block';
            detailSheet.setAttribute('aria-hidden', 'false');

            detailSheet.animate([
                { clipPath: insetStart },
                { clipPath: insetEnd }
            ], {
                duration: 1050,
                easing: 'cubic-bezier(0.76, 0, 0.18, 1)',
                fill: 'both'
            });

            const textLines = detailSheet.querySelectorAll('.vhs-detail-mask > *');
            textLines.forEach((line, idx) => {
                line.animate([
                    { transform: 'translateY(110%)' },
                    { transform: 'translateY(0)' }
                ], {
                    duration: 900,
                    delay: 620 + idx * 75,
                    easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)',
                    fill: 'both'
                });
            });

            const blobs = [
                { id: 'vhsInkBlob0', delay: 0 },
                { id: 'vhsInkBlob1', delay: 120 },
                { id: 'vhsInkBlob2', delay: 220 },
                { id: 'vhsInkBlob3', delay: 300 },
                { id: 'vhsInkBlob4', delay: 360 },
                { id: 'vhsInkBlob5', delay: 420 },
                { id: 'vhsInkBlob6', delay: 180 }
            ];

            blobs.forEach(b => {
                const el = document.getElementById(b.id);
                if (el) {
                    el.animate([
                        { r: 0 },
                        { r: 650 }
                    ], {
                        duration: 1250,
                        delay: 520 + b.delay,
                        easing: 'cubic-bezier(0.25, 1, 0.5, 1)',
                        fill: 'both'
                    });
                }
            });
        }

        function closeDetail() {
            if (!isDetailOpen) return;

            const activeTape = tapes.find(t => t.filmIdx === activeBookIdx && Math.abs(rel(t.v, s)) < 0.5);
            let endRect = { top: window.innerHeight * 0.25, left: window.innerWidth * 0.35, width: d, height: H };
            if (activeTape) {
                const r = activeTape.cvEl.getBoundingClientRect();
                if (r.width > 0 && r.height > 0) endRect = r;
            }

            const insetStart = 'inset(0px 0px 0px 0px round 0px)';
            const insetEnd = `inset(${endRect.top}px ${window.innerWidth - (endRect.left + endRect.width)}px ${window.innerHeight - (endRect.top + endRect.height)}px ${endRect.left}px round 3px)`;

            const anim = detailSheet.animate([
                { clipPath: insetStart },
                { clipPath: insetEnd }
            ], {
                duration: 850,
                easing: 'cubic-bezier(0.76, 0, 0.18, 1)',
                fill: 'both'
            });

            anim.onfinish = () => {
                detailSheet.style.display = 'none';
                detailSheet.setAttribute('aria-hidden', 'true');
                isDetailOpen = false;
            };
        }

        detailClose.addEventListener('click', closeDetail);

        // Vòng lặp chuyển động
        let lastTime = performance.now();

        function tick(now) {
            requestAnimationFrame(tick);
            const dt = Math.min(0.05, (now - lastTime) / 1000);
            lastTime = now;

            const kSpring = isDragging ? 18 : 5.2;
            s += (T - s) * (1 - Math.exp(-kSpring * dt));

            if (s > 48) { s -= 36; T -= 36; }
            if (s < -12) { s += 36; T += 36; }

            const newActive = ((Math.round(s) % 12) + 12) % 12;
            if (newActive !== activeBookIdx) {
                const dir = Math.sign(T - s) || 1;
                activeBookIdx = newActive;
                updateBookCaption(activeBookIdx, dir);
            }

            // Điểm thước đo
            const floorS = Math.floor(s);
            const frac = s - floorS;
            let targetDotPct = (((((floorS % 12) + 12) % 12) + frac) / 11) * 100;
            targetDotPct = Math.max(0, Math.min(100, targetDotPct));
            timelineDot.style.left = `${targetDotPct}%`;

            // Độ nghiêng khi rê chuột lên bìa chính
            const screenW = window.innerWidth;
            const screenH = window.innerHeight;
            const shelfCenterY = screenH * 0.42;
            const isPointerOnCover = Math.abs(mouseX - screenW / 2) < 0.55 * d &&
                                     Math.abs(mouseY - shelfCenterY) < 0.55 * H &&
                                     Math.abs(T - s) < 0.3 && !isDetailOpen;

            if (isPointerOnCover) {
                targetTiltY = ((mouseX - screenW / 2) / (0.55 * d)) * 8;
                targetTiltX = -((mouseY - shelfCenterY) / (H / 2)) * 5;
            } else {
                targetTiltY = ((mouseX - screenW / 2) / screenW) * 4;
                targetTiltX = 0;
            }

            tiltX += (targetTiltX - tiltX) * (1 - Math.exp(-7 * dt));
            tiltY += (targetTiltY - tiltY) * (1 - Math.exp(-7 * dt));

            // Vòng mở sách
            const ringScale = isDetailOpen ? 0 : smoothstep(Math.max(0, 1 - Math.abs(T - s) * 3));
            playRing.style.left = `calc(50% - ${d / 2 + 6}px)`;
            playRing.style.top = `calc(${shelfCenterY}px + ${0.36 * H}px)`;
            playRing.style.transform = `translate(-50%, -50%) scale(${ringScale})`;

            // Biến đổi 36 cuốn sách trên cung cong 3D
            tapes.forEach(t => {
                const r = rel(t.v, s);
                const isHovered = hoveredTape === t && Math.abs(r) > 0.5;
                const targetLift = isHovered ? 1 : 0;
                t.lift += (targetLift - t.lift) * (1 - Math.exp(-12 * dt));

                const o = smoothstep(Math.max(0, 1 - Math.abs(r)));
                const u = F(r);

                if (Math.abs(u) > U * 1.95) {
                    t.el.style.display = 'none';
                    return;
                }
                t.el.style.display = '';

                const sc = scl(u);
                const k = 1 / sc;
                const z = P * (1 - k) + o * H * 0.1;
                const x = xsc(u) * k;
                const y = (H * 0.5 * (1 - sc) * 0.42 + o * H * 0.012 - t.lift * H * 0.05) * k;

                const rotY = Math.sign(u) * Math.min(1, Math.abs(u) / U) * 26 * (1 - o) - 90 * o + tiltY * o;
                const rotX = tiltX * o;

                t.el.style.transform = `translate3d(${x}px, ${y}px, ${z}px) rotateX(${rotX}deg) rotateY(${rotY}deg)`;
                t.el.style.zIndex = Math.round(3000 + z);

                const spineShade = Math.min(0.6, o * 0.55 + (1 - sc) * 0.32);
                const coverShade = (1 - o) * 0.82;
                t.el.style.setProperty('--sp-shade', spineShade);
                t.el.style.setProperty('--cv-shade', coverShade);
            });

            if (cursor) {
                cursorX += (mouseX - cursorX) * (1 - Math.exp(-16 * dt));
                cursorY += (mouseY - cursorY) * (1 - Math.exp(-16 * dt));
                cursor.style.transform = `translate3d(${cursorX}px, ${cursorY}px, 0)`;
                updateCursorClass();
            }
        }

        requestAnimationFrame(tick);
    })();
</script>
