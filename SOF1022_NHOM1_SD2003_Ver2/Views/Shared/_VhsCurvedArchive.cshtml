        // Tạo Canvas Gáy Sách Thực Tế Động (Gáy Sách Dập Kim Đẳng Cấp)
        function createBookSpineCanvas(book) {
            const c = document.createElement('canvas');
            c.width = 120;
            c.height = 840;
            const ctx = c.getContext('2d');

            // Nền da gáy sách
            ctx.fillStyle = book.spineColor || '#141418';
            ctx.fillRect(0, 0, c.width, c.height);

            // Xớ vải / da dập chìm
            ctx.fillStyle = 'rgba(255, 255, 255, 0.04)';
            for (let y = 0; y < c.height; y += 4) {
                if (Math.random() > 0.4) ctx.fillRect(0, y, c.width, 1.5);
            }

            // Gân nổi gáy sách (Binding Ribs)
            const ribs = [80, 180, 660, 760];
            ribs.forEach(y => {
                ctx.fillStyle = 'rgba(0,0,0,0.4)';
                ctx.fillRect(10, y - 2, 100, 4);
                ctx.fillStyle = 'rgba(212, 175, 55, 0.6)';
                ctx.fillRect(10, y + 2, 100, 2);
            });

            // Tên sách dọc mạ vàng
            ctx.save();
            ctx.translate(60, 420);
            ctx.rotate(Math.PI / 2);
            ctx.textAlign = 'center';
            ctx.fillStyle = '#f5e4b3';
            ctx.font = '600 24px "Inter Tight", sans-serif';
            ctx.letterSpacing = '3px';
            ctx.fillText(book.title.toUpperCase(), 0, 8);
            ctx.restore();

            // Tên tác giả ở chân gáy
            ctx.save();
            ctx.translate(60, 710);
            ctx.rotate(Math.PI / 2);
            ctx.textAlign = 'center';
            ctx.fillStyle = 'rgba(245, 228, 179, 0.8)';
            ctx.font = '500 15px "Inter Tight", sans-serif';
            ctx.letterSpacing = '1.5px';
            ctx.fillText(book.author.toUpperCase(), 0, 5);
            ctx.restore();

            return c.toDataURL();
        }

        // DOM Elements
        const root = document.getElementById('vhsArchiveRoot');
        const stage = document.getElementById('vhs3DStage');
        const probe = document.getElementById('vhsHeightProbe');
        const playRing = document.getElementById('vhsPlayRing');
        const titleEl = document.getElementById('vhsTitle');
        const subtitleEl = document.getElementById('vhsSubtitle');
        const yearGenreEl = document.getElementById('vhsYearGenre');
