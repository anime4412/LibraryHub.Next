                <a class="navbar-brand fw-bold d-flex align-items-center gap-2 text-decoration-none"
                   asp-controller="Home" asp-action="Index">
                    <div class="logo-icon-wrapper d-flex align-items-center justify-content-center">
                        <i class="fa-solid fa-book-open-reader fs-5 text-warning"></i>
                    </div>
                    <span class="logo-text">
                        <span class="logo-word-primary">THƯ VIỆN</span>
                        <span class="logo-word-accent">ĐIỆN TỬ</span>
                    </span>
                </a>

                <button class="navbar-toggler border-0 shadow-none px-2" type="button"
                        data-bs-toggle="collapse" data-bs-target="#readerNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="readerNavbar">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 d-flex align-items-center gap-2 gap-lg-3">
                        <li class="nav-item">
                            <a class="nav-link rounded-pill px-3 py-1.5 fw-semibold" asp-controller="Home" asp-action="Index" style="white-space: nowrap;">
                                <span>Trang chủ</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link rounded-pill px-3 py-1.5 fw-semibold" asp-controller="Books" asp-action="Index" style="white-space: nowrap;">
                                <span>Kho sách</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link rounded-pill px-3 py-1.5 fw-semibold" asp-controller="Books" asp-action="Random" style="white-space: nowrap;">
                                <span>Sách ngẫu nhiên</span>
                            </a>
                        </li>

                        @if (role == "Reader")
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle rounded-pill px-3 py-1.5 fw-semibold d-flex align-items-center gap-1" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="white-space: nowrap;">
                                    <span>Dịch vụ</span>
                                </a>
                                <ul class="dropdown-menu shadow-lg border-0 rounded-4 animate fade-in" style="background-color: var(--bg-card); border: 1px solid var(--hairline);">
                                    <li>
                                        <a class="dropdown-item py-2 rounded-3" asp-controller="BorrowSlips" asp-action="Create" style="color: var(--text-primary);">
                                             Tạo phiếu mượn
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 rounded-3" asp-controller="BorrowSlips" asp-action="MyBorrows" style="color: var(--text-primary);">
                                             Sách đang mượn
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 rounded-3" asp-controller="Reservations" asp-action="MyReservation" style="color: var(--text-primary);">
                                             Đặt trước sách
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 rounded-3" asp-controller="Fines" asp-action="MyFines" style="color: var(--text-primary);">
                                             Tra cứu tiền phạt
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle rounded-pill px-3 py-1.5 fw-semibold d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="white-space: nowrap;">
                                    <span>Dịch vụ</span>
                                    <i class="fa-solid fa-lock fs-11 text-muted"></i>
                                </a>
                                <ul class="dropdown-menu shadow-lg border-0 rounded-4 animate fade-in" style="background-color: var(--bg-card); border: 1px solid var(--hairline);">
                                    <li>
                                        <a class="dropdown-item py-2 locked-service rounded-3" href="#" style="color: var(--text-primary);">
                                             Tạo phiếu mượn <i class="fa-solid fa-lock ms-2 fs-11 text-muted"></i>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 locked-service rounded-3" href="#" style="color: var(--text-primary);">
                                             Sách đang mượn <i class="fa-solid fa-lock ms-2 fs-11 text-muted"></i>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 locked-service rounded-3" href="#" style="color: var(--text-primary);">
                                             Đặt trước sách <i class="fa-solid fa-lock ms-2 fs-11 text-muted"></i>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 locked-service rounded-3" href="#" style="color: var(--text-primary);">
                                             Tra cứu tiền phạt <i class="fa-solid fa-lock ms-2 fs-11 text-muted"></i>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <div class="ms-auto d-flex align-items-center gap-2 layout-auth-zone">
                        <!-- Dark Mode Toggle -->
                        <button class="theme-toggle" id="themeToggle" type="button" title="Chuyển chế độ sáng/tối">
                            <i class="fa-solid fa-moon" id="themeIcon"></i>
                        </button>
                        
                        @if (!isLogin)
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-taste-gold shadow-sm">
                                <span>Đăng nhập</span>
                                <span class="btn-taste-circle"><i class="fa-solid fa-right-to-bracket"></i></span>
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-taste-ghost">
                                <span>Đăng ký</span>
                            </a>
                        }
                        else
                        {
                            <partial name="_NotificationBellPartial" />

                            @if (role != "Reader" && !string.IsNullOrEmpty(role))
                            {
                                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-bold" title="Vào trang quản trị">
                                    <i class="fa-solid fa-gauge-high me-1"></i>Quản trị
                                </a>
                            }

                            <button class="btn btn-taste-ghost rounded-pill px-3 py-1.5 d-flex align-items-center" type="button" data-bs-toggle="modal" data-bs-target="#profileModal">
                                @{
                                    var tempReader = new SOF1022_NHOM1_SD2003_Ver2.Models.Readers { FullName = displayUserName, Avatar = reader?.Avatar };
                                }
                                <div style="width: 24px; height: 24px;" class="me-2">
                                    @await Html.PartialAsync("_AvatarPartial", tempReader)
                                </div>
                                <span class="fw-semibold">@displayUserName</span>
                                @if (!string.IsNullOrEmpty(activeBadgeIconUrl))
                                {
                                    <img id="globalNavbarBadge" src="@activeBadgeIconUrl" style="width: 18px; height: 18px; object-fit: contain; margin-left: 6px;" title="@activeBadge" />
                                }
                            </button>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="main-wrapper reader-content-wrap">
        @Html.AntiForgeryToken()
        @RenderBody()
    </main>

    @if (ViewData["HideFooter"] == null || !(bool)ViewData["HideFooter"])
    {
    <footer class="footer-reader">
        <div class="container">
            <div class="row" style="gap: var(--card-gap);">
                <style>
                    @@media (max-width: 991px) {
                        .footer-reader .row {
                            gap: var(--section-gap-sm) !important;
                        }
                    }
                </style>
                <div class="col-lg-4">
                    <h3 class="fw-bold text-heading mb-3 d-flex align-items-center gap-2" style="font-family: var(--font-sans); font-size: var(--text-xl); font-weight: 600; margin-bottom: 8px;">
                        <i class="fa-solid fa-book-open-reader text-emerald"></i> THƯ VIỆN ĐIỆN TỬ
                    </h3>
                    <p class="text-secondary fs-14 lh-lg">
                        Hệ thống quản lý thư viện hiện đại, mang lại trải nghiệm tìm kiếm, mượn trả tài liệu kỹ thuật số tối ưu và nhanh chóng nhất cho độc giả.
                    </p>
                </div>
                <div class="col-lg-2 offset-lg-1">
                    <h3 class="text-heading fw-bold uppercase tracking-wider mb-3" style="font-family: var(--font-sans); font-size: var(--text-xl); font-weight: 600; margin-bottom: 8px;">Khám phá</h3>
                    <ul class="footer-menu ps-0 mb-0">
                        <li><a asp-controller="Home" asp-action="Index" class="text-subtle">Trang chủ</a></li>
                        <li><a asp-controller="Books" asp-action="Index" class="text-subtle">Kho sách</a></li>
                        <li><a href="#" class="text-subtle">Chính sách mượn</a></li>
                    </ul>
                </div>
                <div class="col-lg-2">
                    <h3 class="text-heading fw-bold uppercase tracking-wider mb-3" style="font-family: var(--font-sans); font-size: var(--text-xl); font-weight: 600; margin-bottom: 8px;">Dịch vụ</h3>
                    <ul class="footer-menu ps-0 mb-0 text-secondary fs-14">
                        <li class="py-1"><i class="fa-solid fa-angle-right me-1 fs-11" style="color: var(--brand-base);"></i> Đặt trước sách</li>
                        <li class="py-1"><i class="fa-solid fa-angle-right me-1 fs-11" style="color: var(--brand-base);"></i> Gia hạn phiếu</li>
                        <li class="py-1"><i class="fa-solid fa-angle-right me-1 fs-11" style="color: var(--brand-base);"></i> Đọc trực tuyến</li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h3 class="text-heading fw-bold uppercase tracking-wider mb-3" style="font-family: var(--font-sans); font-size: var(--text-xl); font-weight: 600; margin-bottom: 8px;">Liên hệ</h3>
                    <div class="d-flex flex-column gap-2 text-secondary fs-14">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-envelope flex-shrink-0" style="color: var(--brand-base);"></i> library@gmail.com
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-phone flex-shrink-0" style="color: var(--brand-base);"></i> 0123 456 789
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-location-dot flex-shrink-0" style="color: var(--brand-base);"></i> FPT Polytechnic
                        </div>
                    </div>
                </div>
            </div>

            <hr class="my-4 border-secondary opacity-25">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 text-secondary" style="font-family: var(--mono); font-size: 12px; letter-spacing: 0.04em;">
                <span>&copy; @DateTime.Now.Year Library Management System. Vanguard Soft Edition.</span>
                <div class="d-flex gap-3 social-links">
                    <a href="#" style="color: var(--brand-base);"><i class="fab fa-facebook fa-lg"></i></a>
                    <a href="#" style="color: var(--brand-base);"><i class="fab fa-youtube fa-lg"></i></a>
                    <a href="#" style="color: var(--brand-base);"><i class="fab fa-instagram fa-lg"></i></a>
                    <a href="#" style="color: var(--brand-base);"><i class="fab fa-github fa-lg"></i></a>
                </div>
            </div>
        </div>
    </footer>
    }

    <div class="modal fade" id="logoutModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content logout-modal-content border-0 shadow-lg rounded-4 overflow-hidden" style="background: var(--bg-card, #ffffff) !important; border: 1px solid var(--border-color, #e2e8f0) !important;">
                <div class="modal-body text-center py-4 px-4">
                    <div class="logout-icon-circle mb-3 mx-auto d-flex align-items-center justify-content-center shadow-sm" style="width: 68px; height: 68px; border-radius: 50%; background: #fee2e2; color: #dc2626; border: 3px solid #fecaca;">
                        <i class="fa-solid fa-right-from-bracket fs-2"></i>
                    </div>
                    <h4 class="logout-title fw-bold mb-2" style="color: var(--text-primary, #0f172a) !important; font-size: 21px;">Đăng xuất tài khoản?</h4>
                    <p class="logout-desc mb-4" style="color: var(--text-secondary, #334155) !important; font-size: 15px; font-weight: 500;">Phiên làm việc hiện tại của bạn sẽ lập tức kết thúc.</p>
                    <div class="d-flex gap-3 justify-content-center">
                        <button type="button" class="btn btn-logout-cancel flex-fill fw-semibold py-2 px-3 rounded-pill" data-bs-dismiss="modal">Hủy</button>
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-danger flex-fill fw-bold py-2 px-3 rounded-pill shadow-sm">Đăng xuất</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <!-- Profile Modal -->
    <div class="modal fade" id="profileModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4" style="background-color: var(--bg-card); color: var(--text-primary); border: 1px solid var(--border-color) !important;">
                <div class="modal-header border-0 pb-0">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body px-4 pb-4">
                    <!-- Profile Header -->
                    <div class="text-center mb-4">
                        <div style="width: 80px; height: 80px; margin: 0 auto;" class="mb-3">
                            @{
                                var modalReader = new SOF1022_NHOM1_SD2003_Ver2.Models.Readers { FullName = displayUserName, Avatar = reader?.Avatar };
                            }
                            @await Html.PartialAsync("_AvatarPartial", modalReader)
                        </div>
                        <h3 class="text-heading fw-bold mb-1" style="font-family: var(--font-sans); font-size: var(--text-xl); font-weight: 600; margin-bottom: 8px;">@displayUserName</h3>
                        @if (!string.IsNullOrEmpty(activeBadge))
                        {
                            <span class="badge bg-emerald-soft text-emerald fs-12 px-3 py-1 rounded-pill">
                                <i class="fas fa-award me-1"></i>@activeBadge
                            </span>
                        }
                    </div>

                    <!-- Profile Info -->
                    <div class="rounded-3 p-3 mb-3" style="background-color: var(--bg-deep); border: 1px solid var(--border-color);">
                        <div class="d-flex align-items-center mb-2">
                            <i class="fas fa-envelope text-muted me-3" style="width: 20px;"></i>
                            <div>
                                <small class="text-secondary d-block">Email</small>
                                <span class="text-heading fs-14 fw-semibold" id="profileEmail">Đang tải...</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center mb-0">
                            <i class="fas fa-phone text-muted me-3" style="width: 20px;"></i>
                            <div>
                                <small class="text-secondary d-block">Số điện thoại</small>
                                <span class="text-heading fs-14 fw-semibold" id="profilePhone">Đang tải...</span>
                            </div>
                        </div>
                    </div>

                    <!-- Change Display Name -->
                    <div class="rounded-3 p-3 mb-3" style="background-color: var(--bg-deep); border: 1px solid var(--border-color);">
                        <label class="text-secondary fs-13 mb-2 fw-medium">Tên hiển thị</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="editDisplayName" value="@userName" maxlength="30" style="background-color: var(--bg-card); color: var(--text-primary); border-color: var(--border-color);" />
                            <button class="btn btn-warning fw-semibold px-3" type="button" id="updateDisplayNameBtn" title="Lưu thay đổi">
                                <i class="fas fa-floppy-disk"></i>
                            </button>
                        </div>
                        <div id="displayNameFeedback" class="fs-12 mt-2"></div>
                    </div>

                    <!-- Quick Actions -->
                    <div class="d-grid gap-2">
                        <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary rounded-3 py-2 text-heading d-flex align-items-center justify-content-center gap-2">
                            <i class="fas fa-id-card"></i><span>Hồ sơ cá nhân đầy đủ</span>
                        </a>
                        <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-secondary rounded-3 py-2 text-heading d-flex align-items-center justify-content-center gap-2">
                            <i class="fas fa-lock"></i><span>Đổi mật khẩu</span>
                        </a>
                        @if (role != "Reader" && !string.IsNullOrEmpty(role))
                        {
                            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-warning rounded-3 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2">
                                <i class="fas fa-screwdriver-wrench"></i><span>Trang quản trị (@role)</span>
                            </a>
                        }
                        <hr class="my-2" style="border-color: var(--border-color);" />
                        <a href="#" class="btn btn-danger rounded-3 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2" data-bs-toggle="modal" data-bs-target="#logoutModal">
                            <i class="fas fa-right-from-bracket"></i><span>Đăng xuất</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/quick-help.js"></script>
    <script>
        // Đảm bảo không bao giờ bị kẹt backdrop sau khi đóng modal
        document.addEventListener('hidden.bs.modal', function () {
            if (!document.querySelector('.modal.show')) {
                document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
                document.body.classList.remove('modal-open');
                document.body.style.removeProperty('overflow');
                document.body.style.removeProperty('padding-right');
            }
        });

        // Handle locked services for anonymous users
        document.addEventListener('DOMContentLoaded', function() {
            const lockedServices = document.querySelectorAll('.locked-service');
            lockedServices.forEach(function(service) {
                service.addEventListener('click', function(e) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'warning',
                        title: 'Bạn cần đăng nhập',
                        text: 'Vui lòng đăng nhập để sử dụng đầy đủ các dịch vụ trực tuyến của Thư viện (Đặt trước, gia hạn, theo dõi phiếu mượn).',
                        showCancelButton: true,
                        confirmButtonText: 'Đăng nhập ngay',
                        cancelButtonText: 'Đăng ký',
                        confirmButtonColor: '#10b981',
                        cancelButtonColor: '#6c757d',
                        reverseButtons: true
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '/Account/Login';
                        } else if (result.dismiss === Swal.DismissReason.cancel) {
                            window.location.href = '/Account/Register';
                        }
                    });
                });
            });
        });

        // Load user profile data when modal opens
        document.getElementById('profileModal').addEventListener('show.bs.modal', async function() {
            try {
                const response = await fetch('/Account/GetProfileData');
                const data = await response.json();
                if (data.success) {
                    document.getElementById('profileEmail').textContent = data.email || 'Chưa cập nhật';
                    document.getElementById('profilePhone').textContent = data.phone || 'Chưa cập nhật';
                    document.getElementById('editDisplayName').value = data.displayName || '';
                }
            } catch (error) {
                console.error('Error loading profile data:', error);
            }
        });

        // Update display name
        let validationTimeout;
        document.getElementById('editDisplayName').addEventListener('input', function() {
            clearTimeout(validationTimeout);
            const value = this.value.trim();
            const feedback = document.getElementById('displayNameFeedback');
            
            if (value.length === 0) {
                feedback.textContent = '';
                feedback.className = 'fs-12 mt-2';
                return;
            }

            validationTimeout = setTimeout(() => validateDisplayName(value), 500);
        });

        async function validateDisplayName(displayName) {
            try {
                const response = await fetch('/Account/ValidateDisplayName', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `displayName=${encodeURIComponent(displayName)}`
                });
                const result = await response.json();
                const feedback = document.getElementById('displayNameFeedback');
                
                if (result.isValid) {
                    feedback.textContent = result.message;
                    feedback.className = 'fs-12 mt-2 text-success';
                    document.getElementById('updateDisplayNameBtn').disabled = false;
                } else {
                    feedback.textContent = result.message;
                    feedback.className = 'fs-12 mt-2 text-danger';
                    document.getElementById('updateDisplayNameBtn').disabled = true;
                }
            } catch (error) {
                console.error('Validation error:', error);
            }
        }

        document.getElementById('updateDisplayNameBtn').addEventListener('click', async function() {
            const displayName = document.getElementById('editDisplayName').value.trim();
            const btn = this;
            
            if (!displayName) {
                Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Vui lòng nhập tên hiển thị' });
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

            try {
                const response = await fetch('/Account/UpdateDisplayName', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: `displayName=${encodeURIComponent(displayName)}`
                });
                const result = await response.json();

                if (result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công!',
                        text: result.message,
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire({ icon: 'error', title: 'Lỗi', text: result.message });
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-save"></i>';
                }
            } catch (error) {
                console.error('Error:', error);
                Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Có lỗi xảy ra, vui lòng thử lại' });
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-save"></i>';
            }
        });

        // Dark Mode Toggle Functionality
        document.addEventListener('DOMContentLoaded', function() {
            const themeToggle = document.getElementById('themeToggle');
            const themeIcon = document.getElementById('themeIcon');
            const html = document.documentElement;

            // Check for saved theme preference or default to light
            const savedTheme = localStorage.getItem('theme') || 'light';
            html.setAttribute('data-theme', savedTheme);
            html.setAttribute('data-bs-theme', savedTheme);
            updateThemeIcon(savedTheme);

            // Toggle theme on button click
            themeToggle.addEventListener('click', function() {
                const currentTheme = html.getAttribute('data-theme');
                const newTheme = currentTheme === 'light' ? 'dark' : 'light';
                
                html.setAttribute('data-theme', newTheme);
                html.setAttribute('data-bs-theme', newTheme);
                localStorage.setItem('theme', newTheme);
                updateThemeIcon(newTheme);
            });

            function updateThemeIcon(theme) {
                if (theme === 'dark') {
                    themeIcon.classList.remove('fa-moon');
                    themeIcon.classList.add('fa-sun');
                } else {
                    themeIcon.classList.remove('fa-sun');
                    themeIcon.classList.add('fa-moon');
                }
            }
        });
    </script>
    
