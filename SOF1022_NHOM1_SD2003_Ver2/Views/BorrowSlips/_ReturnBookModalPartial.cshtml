@model SOF1022_NHOM1_SD2003_Ver2.Models.BorrowSlips

@*
    LƯU Ý:
    - Partial này được load động qua AJAX (fetch) rồi gắn vào #returnModalContainer bằng
      innerHTML, nên tại một thời điểm CHỈ CÓ 1 modal tồn tại trong DOM -> giữ id cố định
      "damageModal" là đúng và an toàn (không cần id theo @@Model.Id).
    - QUAN TRỌNG: thẻ <script> nhúng trong HTML được gán qua innerHTML SẼ KHÔNG được trình
      duyệt thực thi (đây là hành vi bảo mật mặc định của mọi trình duyệt). Vì vậy toàn bộ
      logic JS xử lý cho modal này (đổi tình trạng, tính tiền phạt, nút xác nhận trả sách...)
      đã được chuyển sang gắn trực tiếp trong <script> của Index.cshtml bằng event delegation
      trên `document`, để đảm bảo luôn hoạt động kể cả khi modal được chèn động sau này.
*@

<style>
    #damageModal .form-select {
        position: relative;
    }

    #damageModal .dropdown-menu {
        z-index: 1053 !important;
    }

    #damageModal .modal-body,
    #damageModal .table,
    #damageModal .form-select,
    #damageModal .form-control {
        pointer-events: auto !important;
    }

    #damageModal td {
        position: relative;
    }
</style>

<!-- RETURN BOOK MODAL cho phiếu mượn #@Model.Id -->
<div class="modal fade damage-modal" id="damageModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title" style="font-family: var(--font-sans); font-size: var(--text-xl); font-weight: 600; margin-bottom: 8px;">
                    <i class="fa-solid fa-undo-alt me-2"></i>Xác nhận trả sách - Phiếu #@Model.Id
                </h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" class="borrow-slip-id-input" value="@Model.Id" />
                <p class="mb-3">Chọn tình trạng trả cho từng cuốn sách:</p>

                <!-- Books Table -->
                <div class="table-responsive">
                    <table class="table table-bordered table-hover" style="table-layout: fixed; min-width: 900px;">
                        <colgroup>
                            <col style="width:40px">
                            <col>
                            <col style="width:100px">
                            <col style="width:150px">
                            <col style="width:190px">
                            <col style="width:110px">
                            <col style="width:110px">
                        </colgroup>
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Tên sách</th>
                                <th>Giá sách</th>
                                <th>Tình trạng trả</th>
                                <th>Chi tiết hư hại</th>
                                <th>% Hư hại</th>
                                <th class="text-end">Tiền phạt</th>
                            </tr>
                        </thead>
                        <tbody class="books-table-body">
                            @if (Model.BorrowDetails != null && Model.BorrowDetails.Any())
                            {
                                var index = 0;
                                foreach (var detail in Model.BorrowDetails.Where(bd => !bd.IsReturned && bd.Books != null))
                                {
                                    index++;
                                    <tr data-book-id="@detail.BookId" data-borrow-detail-id="@detail.Id">
                                        <td class="fw-bold">@index</td>
                                        <td>
                                            <div class="fw-bold">@detail.Books.Title</div>
                                            <small class="text-muted">ID: @detail.BookId</small>
                                        </td>
                                        <td>@detail.Books.Price.ToString("N0") VNĐ</td>
                                        <td>
                                            <select class="form-select form-select-sm book-condition-select"
                                                    data-book-id="@detail.BookId"
                                                    data-borrow-detail-id="@detail.Id"
                                                    data-price="@detail.Books.Price"
                                                    data-title="@detail.Books.Title">
                                                <option value="good">Nguyên vẹn</option>
                                                <option value="damaged">Hư hỏng</option>
                                                <option value="lost">Bị mất</option>
                                            </select>
                                        </td>
                                        <td>
                                            <!-- Admin/thủ thư nhập lại lý do hư hại mà độc giả đã trình bày -->
                                            <textarea class="form-control form-control-sm damage-details-input d-none"
                                                      rows="2"
                                                      data-book-id="@detail.BookId"
                                                      placeholder="Nhập lý do hư hại độc giả cung cấp..."></textarea>
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm damage-percent-select d-none"
                                                    data-book-id="@detail.BookId"
                                                    data-price="@detail.Books.Price">
                                                <option value="10">10%</option>
                                                <option value="20">20%</option>
                                                <option value="30">30%</option>
                                                <option value="40">40%</option>
                                                <option value="50">50%</option>
                                                <option value="60">60%</option>
                                                <option value="70">70%</option>
                                                <option value="80">80%</option>
                                                <option value="90">90%</option>
                                                <option value="100" selected>100%</option>
                                            </select>
                                        </td>
                                        <td class="text-end">
                                            <span class="fw-bold book-fine-amount" data-book-id="@detail.BookId">0 VNĐ</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Total fine calculation -->
                <div class="alert alert-info mt-3 total-fine-section">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Tổng tiền phạt sự cố:</span>
                        <span class="fw-bold fs-5 text-danger total-fine-amount">0 VNĐ</span>
                    </div>
                    <div class="mt-2 small text-muted fine-summary"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-primary confirm-return-btn">
                    <i class="fa-solid fa-check me-2"></i>Xác nhận trả sách
                </button>
            </div>
        </div>
    </div>
</div>
