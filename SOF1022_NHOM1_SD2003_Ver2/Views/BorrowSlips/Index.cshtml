    function quickExtendLoan(id) {
        Swal.fire({
            title: 'Gia hạn mượn tại quầy',
            text: 'Chọn số ngày muốn gia hạn thêm:',
            input: 'select',
            inputOptions: {
                '7': 'Gia hạn thêm 7 ngày (1 tuần)',
                '14': 'Gia hạn thêm 14 ngày (2 tuần)',
                '21': 'Gia hạn thêm 21 ngày (3 tuần)',
                '30': 'Gia hạn thêm 30 ngày (1 tháng)'
            },
            inputValue: '7',
            showCancelButton: true,
            confirmButtonText: 'Xác nhận gia hạn',
            cancelButtonText: 'Hủy',
            confirmButtonColor: '#ffc107',
            showLoaderOnConfirm: true,
            preConfirm: (days) => {
                const formData = new FormData();
                formData.append('id', id);
                formData.append('extendDays', days);
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                formData.append('__RequestVerificationToken', token);

                return fetch('/BorrowSlips/ExtendLoan/' + id, {
                    method: 'POST',
                    body: formData
                })
                .then(res => res.json())
                .then(data => {
                    if (!data.success) {
                        throw new Error(data.message || 'Có lỗi xảy ra');
                    }
