@model IEnumerable<SOF1022_NHOM1_SD2003_Ver2.Models.BorrowSlips>

@{
    ViewData["Title"] = "Phiếu mượn";
}

@Html.AntiForgeryToken()

<style>
    [data-theme="dark"] .card {
        background-color: #1A1D24;
        border-color: #30363D;
    }

    [data-theme="dark"] .card-header {
        background-color: #21262D;
        border-color: #30363D;
    }

    [data-theme="dark"] .card-header.bg-white {
        background-color: #21262D;
    }

    [data-theme="dark"] .form-control,
    [data-theme="dark"] .form-select {
        background-color: #0D1117;
        border-color: #30363D;
        color: #F0F6FC;
    }

    [data-theme="dark"] .form-control:focus,
    [data-theme="dark"] .form-select:focus {
        background-color: #0D1117;
        border-color: #10B981;
        color: #F0F6FC;
    }

    [data-theme="dark"] .form-control::placeholder {
        color: #6E7681;
    }

    [data-theme="dark"] .table {
        color: #F0F6FC;
    }

    [data-theme="dark"] .table thead th {
        background-color: #21262D;
        border-color: #30363D;
    }

    [data-theme="dark"] .table tbody tr {
        background-color: #1A1D24;
        border-color: #30363D;
    }

    [data-theme="dark"] .table tbody tr:hover {
        background-color: #21262D;
    }

    [data-theme="dark"] .text-muted {
        color: #6E7681 !important;
    }

    [data-theme="dark"] h2,
    [data-theme="dark"] h3,
    [data-theme="dark"] h4,
    [data-theme="dark"] h5 {
        color: #F0F6FC;
    }

    [data-theme="dark"] .form-label {
        color: #8B949E;
    }
</style>

<div class="container-fluid" style="padding-top: var(--section-gap); padding-bottom: var(--section-gap);">
        <style>
            @@media (max-width: 991px) {
                .container-fluid {
                    padding-top: var(--section-gap-sm) !important;
                    padding-bottom: var(--section-gap-sm) !important;
                }
            }
        </style>

    <!-- PAGE HEADER -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h2 class="fw-bold mb-1" style="font-family: var(--font-display); font-size: var(--text-3xl); font-weight: 600; margin-bottom: 12px;">
                        <i class="fa-solid fa-file-invoice text-primary me-2"></i>
                        Quản lý Phiếu mượn
                    </h2>
                    <p class="text-muted mb-0">
                        Theo dõi và quản lý danh sách phiếu mượn sách trong hệ thống
                    </p>
                </div>
                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                    <a asp-action="ExportBorrowReport" class="btn btn-outline-success">
                        <i class="fa-solid fa-file-excel me-1"></i> Xuất Excel
                    </a>
                    <a asp-controller="Reservations"
                       asp-action="Pending"
                       class="btn btn-primary ms-1">
                        <i class="fa-solid fa-circle-check me-1"></i>
                        Duyệt phiếu mượn
                    </a>
                    <a asp-action="History" class="btn btn-outline-secondary ms-1">
                        <i class="fa-solid fa-clock-rotate-left me-1"></i>
                        Lịch sử
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- STATISTICS -->
    <div class="row mb-4" style="gap: var(--card-gap);">
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Tổng phiếu mượn</div>
                    <h3 class="fw-bold mt-2" style="font-family: var(--font-sans); font-size: var(--text-xl); font-weight: 600; margin-bottom: 8px;">@ViewBag.TotalCount</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Chờ duyệt</div>
                    <h3 class="fw-bold text-warning mt-2" style="font-family: var(--font-sans); font-size: var(--text-xl); font-weight: 600; margin-bottom: 8px;">@ViewBag.PendingApprovalCount</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Đang mượn</div>
                    <h3 class="fw-bold text-success mt-2" style="font-family: var(--font-sans); font-size: var(--text-xl); font-weight: 600; margin-bottom: 8px;">@ViewBag.BorrowingCount</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Quá hạn</div>
                    <h3 class="fw-bold text-danger mt-2" style="font-family: var(--font-sans); font-size: var(--text-xl); font-weight: 600; margin-bottom: 8px;">@ViewBag.OverdueCount</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- SEARCH & FILTER -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-lg-4">
                        <label class="form-label fw-semibold">Tìm kiếm</label>
                        <input class="form-control"
                               name="searchString"
                               value="@ViewBag.SearchString"
                               placeholder="Mã phiếu, tên người mượn..." />
                    </div>
                    <div class="col-lg-3">
                        <label class="form-label fw-semibold">Trạng thái</label>
                        <select class="form-select" name="statusFilter" onchange="this.form.submit()">
                            <option value="All" selected="@(ViewBag.StatusFilter == "All" || string.IsNullOrEmpty(ViewBag.StatusFilter))">Tất cả</option>
                            <option value="PendingApproval" selected="@(ViewBag.StatusFilter == "PendingApproval")">Chờ duyệt</option>
                            <option value="PendingPickup" selected="@(ViewBag.StatusFilter == "PendingPickup")">Chờ nhận</option>
                            <option value="PendingExtension" selected="@(ViewBag.StatusFilter == "PendingExtension")">Chờ gia hạn</option>
                            <option value="Borrowing" selected="@(ViewBag.StatusFilter == "Borrowing")">Đang mượn</option>
                            <option value="Overdue" selected="@(ViewBag.StatusFilter == "Overdue")">Quá hạn</option>
                            <option value="Incident" selected="@(ViewBag.StatusFilter == "Incident")">Sự cố/Bồi thường</option>
                            <option value="Completed" selected="@(ViewBag.StatusFilter == "Completed")">Đã trả</option>
                        </select>
                    </div>
                    <div class="col-lg-2 d-grid">
                        <button class="btn btn-primary">
                            <i class="fa-solid fa-magnifying-glass me-2"></i>
                            Tìm kiếm
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- BORROW SLIPS TABLE -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="fw-bold mb-0" style="font-family: var(--font-sans); font-size: var(--text-xl); font-weight: 600; margin-bottom: 8px;">Danh sách phiếu mượn</h3>
                <span class="text-muted">Tổng cộng @Model.Count() phiếu</span>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:120px">Mã phiếu</th>
                        <th style="width:150px">Độc giả</th>
                        <th style="width:80px">Số lượng</th>
                        <th style="width:120px">Ngày mượn</th>
                        <th style="width:120px">Hạn trả</th>
                        <th style="width:150px">Trạng thái</th>
                        <th style="width:200px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var statusClass = "bg-success-subtle text-success";
                        var statusText = "Đã trả";
                        var statusIcon = "fa-circle-check";
                        var showIssueButtons = false;
                        var showReturnButton = false;
                        var showExtensionApproval = false;
                        var showConfirmHandover = false;

                        if (item.BorrowStatus == SOF1022_NHOM1_SD2003_Ver2.Models.Enums.BorrowStatus.PendingApproval)
                        {
                            statusClass = "bg-warning-subtle text-warning";
                            statusText = "Chờ duyệt";
                            statusIcon = "fa-clock";
                            showIssueButtons = true;
                        }
                        else if (item.BorrowStatus == SOF1022_NHOM1_SD2003_Ver2.Models.Enums.BorrowStatus.ApprovedAwaitingPickup)
                        {
                            statusClass = "bg-info-subtle text-info";
                            statusText = "Chờ nhận sách";
                            statusIcon = "fa-hand-holding";
                            showConfirmHandover = true;
                        }
                        else if (item.BorrowStatus == SOF1022_NHOM1_SD2003_Ver2.Models.Enums.BorrowStatus.PendingExtension)
                        {
                            statusClass = "bg-warning-subtle text-warning";
                            statusText = "Chờ duyệt gia hạn";
                            statusIcon = "fa-hourglass-half";
                            showExtensionApproval = true;
                        }
                        else if (item.BorrowStatus == SOF1022_NHOM1_SD2003_Ver2.Models.Enums.BorrowStatus.Borrowing)
                        {
                            if (item.DueDate < DateTime.Now)
                            {
                                statusClass = "bg-danger-subtle text-danger";
                                statusText = "Quá hạn";
                                statusIcon = "fa-triangle-exclamation";
                            }
                            else
                            {
                                statusClass = "bg-success-subtle text-success";
                                statusText = "Đang mượn";
                                statusIcon = "fa-book-open-reader";
                            }
                            showReturnButton = true;
                        }
                        else if (item.BorrowStatus == SOF1022_NHOM1_SD2003_Ver2.Models.Enums.BorrowStatus.Returned)
                        {
                            statusClass = "bg-secondary-subtle text-secondary";
                            statusText = "Đã trả";
                            statusIcon = "fa-circle-check";
                        }

                        // Check if any borrow detail has been extended
                        var hasBeenExtended = item.BorrowDetails?.Any(bd => bd.ExtensionCount >= 1) ?? false;

                        <tr>
                            <!-- Mã phiếu -->
                            <td>
                                <span class="badge bg-secondary">@item.BorrowCode</span>
                            </td>

                            <!-- Độc giả -->
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold me-2" style="width:36px;height:36px;font-size:14px;">
                                        @((!string.IsNullOrWhiteSpace(item.Readers?.FullName)) ? item.Readers.FullName.Substring(0, 1).ToUpper() : "R")
                                    </div>
                                    <div>
                                        <div class="fw-bold text-truncate" style="max-width:150px;" title="@(item.Readers?.FullName ?? "Chưa có người mượn")">
                                            @(item.Readers?.FullName ?? "Chưa có người mượn")
                                        </div>
                                        <small class="text-muted">ID: @item.Id</small>
                                    </div>
                                </div>
                            </td>

                            <!-- Số lượng -->
                            <td>
                                <span class="fw-bold">@item.TotalBooks</span> cuốn
                            </td>

                            <!-- Ngày mượn -->
                            <td>
                                @if (item.BorrowStatus == SOF1022_NHOM1_SD2003_Ver2.Models.Enums.BorrowStatus.PendingApproval)
                                {
                                    <input type="date" class="form-control form-control-sm" style="width:130px;" name="borrowDate-@item.Id" value="@item.BorrowDate.ToString("yyyy-MM-dd")" id="borrowDate-@item.Id" onchange="calculateDueDate(@item.Id)" />
                                }
                                else
                                {
                                    <span>@item.BorrowDate.ToString("dd/MM/yyyy")</span>
                                }
                            </td>

                            <!-- Hạn trả -->
                            <td>
                                @if (item.BorrowStatus == SOF1022_NHOM1_SD2003_Ver2.Models.Enums.BorrowStatus.PendingApproval)
                                {
                                    <div class="d-flex align-items-center gap-1">
                                        <select class="form-select form-select-sm" style="min-width: 96px; width: 96px;" name="borrowDays-@item.Id" id="borrowDays-@item.Id" onchange="calculateDueDate(@item.Id)">
                                            <option value="7">7 ngày</option>
                                            <option value="14" selected>14 ngày</option>
                                            <option value="30">30 ngày</option>
                                        </select>
                                        <input type="date" class="form-control form-control-sm" style="width:110px;" name="dueDate-@item.Id" value="@item.DueDate.ToString("yyyy-MM-dd")" id="dueDate-@item.Id" readonly />
                                    </div>
                                }
                                else
                                {
                                    <span class="@(statusClass.Contains("danger") ? "text-danger fw-bold" : "")">@item.DueDate.ToString("dd/MM/yyyy")</span>
                                }
                            </td>

                            <!-- Trạng thái -->
                            <td>
                                <span class="badge @statusClass">
                                    <i class="fa-solid @statusIcon me-1"></i>@statusText
                                </span>
                                @if (showExtensionApproval)
                                {
                                    var pendingExtension = item.BorrowDetails?.FirstOrDefault(bd => bd.RequestedExtensionDays.HasValue);
                                    if (pendingExtension != null)
                                    {
                                        <div class="mt-1">
                                            <small class="text-muted">Gia hạn: @pendingExtension.RequestedExtensionDays.Value ngày</small>
                                        </div>
                                        <div class="mt-1" id="validation-status-@pendingExtension.Id">
                                            <span class="badge bg-secondary">
                                                <i class="fa-solid fa-spinner fa-spin me-1"></i>Đang kiểm tra...
                                            </span>
                                        </div>
                                    }
                                }
                                @if (hasBeenExtended)
                                {
                                    <div class="mt-1">
                                        <small class="text-muted">Đã gia hạn (Max)</small>
                                    </div>
                                }
                            </td>

                            <!-- Thao tác -->
                            <td>
                                <div class="d-flex align-items-center gap-1" style="white-space: nowrap;">
                                    <!-- View Details button - LEFT -->
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm" title="Chi tiết">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    
                                    <!-- Action buttons - RIGHT -->
                                    @if (showIssueButtons && (Context.HasPermission("borrow.create") || Context.HasPermission("borrow.edit")))
                                    {
                                        <button onclick="approveIssueBook(@item.Id)" class="btn btn-success btn-sm">
                                            <i class="fas fa-check-circle me-1"></i>Duyệt
                                        </button>
                                        <button onclick="rejectReservation(@item.Id)" class="btn btn-outline-danger btn-sm">
                                            <i class="fas fa-times-circle me-1"></i>Từ chối
                                        </button>
                                    }
                                    else if (showConfirmHandover && Context.HasPermission("borrow.edit"))
                                    {
                                        <button onclick="confirmHandover(@item.Id)" class="btn btn-success btn-sm">
                                            <i class="fas fa-hand-holding me-1"></i>Giao sách
                                        </button>
                                    }
                                    else if (showExtensionApproval && Context.HasPermission("borrow.edit"))
                                    {
                                        var pendingExtension = item.BorrowDetails?.FirstOrDefault(bd => bd.RequestedExtensionDays.HasValue);
                                        if (pendingExtension != null)
                                        {
                                            <button id="approve-btn-@pendingExtension.Id" onclick="approveExtension(@pendingExtension.Id, @pendingExtension.RequestedExtensionDays.Value)" class="btn btn-success btn-sm" disabled>
                                                <i class="fas fa-check-circle me-1"></i>Gia hạn
                                            </button>
                                            <button onclick="rejectExtension(@pendingExtension.Id)" class="btn btn-outline-danger btn-sm">
                                                <i class="fas fa-times-circle me-1"></i>Từ chối
                                            </button>
                                        }
                                    }
                                    else if (showReturnButton && Context.HasPermission("borrow.confirm_return"))
                                    {
                                        <button onclick="confirmReturnBook(@item.Id)" class="btn btn-primary btn-sm">
                                            <i class="fas fa-undo-alt me-1"></i>Trả sách
                                        </button>
                                        @if (Context.HasPermission("borrow.edit"))
                                        {
                                            <button onclick="quickExtendLoan(@item.Id)" class="btn btn-outline-warning btn-sm" title="Gia hạn mượn tại quầy">
                                                <i class="fas fa-clock-rotate-left me-1"></i>Gia hạn
                                            </button>
                                        }
                                    }
                                </div>
                                
                                @if (!string.IsNullOrWhiteSpace(item.Note))
                                {
                                    <small class="text-muted d-block mt-1 text-truncate" style="max-width:200px;" title="@item.Note">
                                        <i class="fa-solid fa-comment-dots me-1"></i>@item.Note
                                    </small>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- EMPTY STATE -->
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body text-center py-5">
                <i class="fa-solid fa-folder-open fa-5x text-secondary mb-4 opacity-50"></i>
                <h3 class="fw-bold" style="font-family: var(--font-sans); font-size: var(--text-xl); font-weight: 600; margin-bottom: 8px;">Không tìm thấy dữ liệu</h3>
                <p class="text-muted">
                    Hệ thống không tìm thấy phiếu mượn nào trùng khớp hoặc chưa có dữ liệu khởi tạo.
                </p>
            </div>
        </div>
    }
</div>

<!-- Shared Return Book Modal -->
<div id="returnModalContainer"></div>

<style>
    .card {
        border-radius: 14px;
    }
    .card-header {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border);
    }
    .table {
        margin-bottom: 0;
    }
    .table thead th {
        font-weight: 700;
        border-bottom: 2px solid var(--border);
        white-space: nowrap;
    }
    .table tbody td {
        vertical-align: middle;
    }
    .table tbody tr {
        transition: .25s ease;
    }
    .table tbody tr:hover {
        background: #f8fbff;
    }
    .form-control {
        height: 38px;
        border-radius: 8px;
    }
    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: none;
    }
    .btn {
        border-radius: 8px;
    }
    .badge {
        font-weight: 600;
        padding: 6px 10px;
    }
    @@media(max-width:992px) {
        .table {
            min-width: 1000px;
        }
    }
</style>

<script>
    function calculateDueDate(id) {
        const borrowDateInput = document.getElementById(`borrowDate-${id}`);
        const borrowDaysSelect = document.getElementById(`borrowDays-${id}`);
        const dueDateInput = document.getElementById(`dueDate-${id}`);
        
        if (borrowDateInput && borrowDaysSelect && dueDateInput) {
            const dateVal = borrowDateInput.value;
            if (!dateVal) return;

            const borrowDate = new Date(dateVal);
            
            if (isNaN(borrowDate.getTime())) {
                return;
            }

            const days = parseInt(borrowDaysSelect.value) || 7;
            const dueDate = new Date(borrowDate);
            dueDate.setDate(dueDate.getDate() + days);
            
            if (isNaN(dueDate.getTime())) {
                return;
            }
            
            const formattedDueDate = dueDate.toISOString().split('T')[0];
            dueDateInput.value = formattedDueDate;
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('[id^="borrowDate-"]').forEach(input => {
            const id = input.id.replace('borrowDate-', '');
            calculateDueDate(id);
            input.addEventListener('change', function() {
                calculateDueDate(id);
            });
        });
    });

    function approveIssueBook(id) {
        const borrowDateInput = document.getElementById(`borrowDate-${id}`);
        const dueDateInput = document.getElementById(`dueDate-${id}`);
        const borrowDaysSelect = document.getElementById(`borrowDays-${id}`);
        
        let url = '/BorrowSlips/ApproveIssueBook';
        let body = null;
        
        if (borrowDateInput && borrowDaysSelect) {
            const borrowDate = borrowDateInput.value;
            const durationDays = borrowDaysSelect ? parseInt(borrowDaysSelect.value) : 14;
            
            if (!borrowDate || isNaN(new Date(borrowDate).getTime())) {
                Swal.fire('Lỗi', 'Ngày mượn không hợp lệ, vui lòng kiểm tra lại!', 'error');
                return;
            }
            
            body = JSON.stringify({
                borrowSlipId: id,
                borrowDate: borrowDate,
                durationDays: durationDays
            });
        } else {
            body = JSON.stringify({
                borrowSlipId: id,
                borrowDate: new Date().toISOString().split('T')[0],
                durationDays: 14
            });
        }
        
        Swal.fire({
            title: 'Xác nhận giao sách',
            text: 'Bạn có chắc chắn muốn xác nhận giao sách cho phiếu mượn này?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Xác nhận',
            cancelButtonText: 'Hủy bỏ'
        }).then((result) => {
            if (result.isConfirmed) {
                fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: body
                })
                .then(response => {
                    if (!response.ok) {
                        return response.text().then(text => {
                            throw new Error(`Server returned ${response.status}: ${text.substring(0, 200)}...`);
                        });
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        Swal.fire('Thành công', data.message, 'success').then(() => {
                            location.reload();
                        });
                    } else if (data.isOutOfStock || data.message.includes("hết sạch trong kho")) {
                        Swal.fire({
                            title: 'Sách đã hết trong kho!',
                            text: 'Cuốn sách này hiện đã được giao cho độc giả khác. Bạn có muốn tự động chuyển yêu cầu mượn của độc giả này sang trạng thái "Đặt trước" (Reservation - Xếp hàng chờ sách) không?',
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonColor: '#3085d6',
                            cancelButtonColor: '#d33',
                            confirmButtonText: 'Chuyển sang Đặt trước',
                            cancelButtonText: 'Không, chỉ từ chối mượn'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                $.ajax({
                                    url: '/BorrowSlips/ConvertToReservation/' + id,
                                    type: 'POST',
                                    headers: {
                                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                                    },
                                    success: function(res) {
                                        if (res.success) {
                                            Swal.fire('Đã chuyển đổi!', 'Yêu cầu đã được chuyển thành danh sách Đặt trước.', 'success').then(() => {
                                                location.reload();
                                            });
                                        } else {
                                            Swal.fire('Lỗi', res.message, 'error');
                                        }
                                    }
                                });
                            } else if (result.dismiss === Swal.DismissReason.cancel) {
                                $.ajax({
                                    url: '/BorrowSlips/RejectDueToNoStock/' + id,
                                    type: 'POST',
                                    headers: {
                                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                                    },
                                    success: function(res) {
                                        Swal.fire('Đã từ chối', 'Phiếu mượn này đã bị hủy bỏ do hết sách.', 'info').then(() => {
                                            location.reload();
                                        });
                                    }
                                });
                            }
                        });
                    } else {
                        Swal.fire('Lỗi', data.message, 'error');
                    }
                })
                .catch(error => {
                    let errorMessage = 'Có lỗi xảy ra khi xác nhận giao sách';
                    if (error.message) {
                        errorMessage = `Lỗi: ${error.message}`;
                    }
                    Swal.fire('Lỗi', errorMessage, 'error');
                });
            }
        });
    }

    function confirmHandover(id) {
        Swal.fire({
            title: 'Xác nhận đã giao sách',
            text: 'Bạn có chắc chắn đã giao sách cho độc giả? Điều này sẽ bắt đầu tính thời gian mượn.',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Xác nhận đã giao',
            cancelButtonText: 'Hủy bỏ'
        }).then((result) => {
            if (result.isConfirmed) {
                fetch('/BorrowSlips/ConfirmHandover/' + id, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire('Thành công', data.message, 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Lỗi', data.message, 'error');
                    }
                })
                .catch(error => {
                    Swal.fire('Lỗi', 'Có lỗi xảy ra khi xác nhận giao sách', 'error');
