    function rejectReservation(id) {
        Swal.fire({
            title: 'Từ chối duyệt phiếu mượn',
            text: 'Vui lòng nhập lý do từ chối:',
            input: 'text',
            inputPlaceholder: 'Ví dụ: Sách bị hỏng, Thẻ độc giả bị khóa...',
            showCancelButton: true,
            confirmButtonText: 'Từ chối',
            cancelButtonText: 'Hủy',
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            inputValidator: (value) => {
                if (!value) {
                    return 'Vui lòng nhập lý do từ chối!'
                }
            }
        }).then((result) => {
            if (result.isConfirmed) {
                const reason = result.value;
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                
                if (!token) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: 'Không tìm thấy token bảo mật. Vui lòng tải lại trang.',
                        confirmButtonText: 'Đóng'
                    });
                    return;
                }

                const formData = new FormData();
                formData.append("__RequestVerificationToken", token);
                formData.append("id", id);
                formData.append("reason", reason);

                fetch('/BorrowSlips/RejectReservation', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công',
                            text: data.message,
                            confirmButtonText: 'Đóng'
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: data.message,
                            confirmButtonText: 'Đóng'
                        });
                    }
                })
                .catch(error => {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: 'Có lỗi xảy ra khi từ chối phiếu mượn',
                        confirmButtonText: 'Đóng'
                    });
                });
            }
        });
    }

    function approveExtension(id, requestedDays) {
        Swal.fire({
            title: 'Duyệt yêu cầu gia hạn',
            html: `
                <div class="text-start">
                    <label class="form-label fw-bold">Số ngày gia hạn:</label>
                    <input type="number" id="extensionDays" class="form-control mb-3" value="${requestedDays}" min="1" max="14">
                    <small class="text-muted">Admin có thể nhập số ngày tùy theo quyết định (tối đa 14 ngày)</small>
                </div>
            `,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Duyệt gia hạn',
            cancelButtonText: 'Hủy',
            confirmButtonColor: '#198754',
            cancelButtonColor: '#dc3545',
            preConfirm: () => {
                const days = document.getElementById('extensionDays').value;
                if (!days || days < 1 || days > 14) {
                    Swal.showValidationMessage('Vui lòng nhập số ngày gia hạn hợp lệ (1-14 ngày)');
                    return false;
                }
                return days;
            }
        }).then((result) => {
            if (result.isConfirmed) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                
                if (!token) {
                    Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Không tìm thấy token bảo mật. Vui lòng tải lại trang.' });
                    return;
                }

                const formData = new FormData();
                formData.append("__RequestVerificationToken", token);
                formData.append("detailId", id);
                formData.append("extensionDays", result.value);

                fetch('/BorrowSlips/ApproveExtension', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công',
                            text: data.message,
                            confirmButtonText: 'Đóng'
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: data.message,
                            confirmButtonText: 'Đóng'
                        });
                    }
                })
                .catch(error => {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: 'Có lỗi xảy ra khi duyệt gia hạn',
                        confirmButtonText: 'Đóng'
                    });
                });
            }
        });
    }

    function rejectExtension(id) {
        const reason = prompt('Vui lòng nhập lý do từ chối gia hạn:');
        if (reason !== null) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            
            if (!token) {
                Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Không tìm thấy token bảo mật. Vui lòng tải lại trang.' });
                return;
            }

            const formData = new FormData();
            formData.append("__RequestVerificationToken", token);
            formData.append("detailId", id);
            formData.append("reason", reason || "");

            fetch('/BorrowSlips/RejectExtension', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({ icon: 'success', title: 'Thông báo', text: data.message });
                    location.reload();
                } else {
                    Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Lỗi: ' + data.message });
                }
            })
            .catch(error => {
                Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Có lỗi xảy ra khi từ chối gia hạn' });
            });
        }
    }

    function checkExtensionValidation(detailId) {
        fetch(`/BorrowSlips/CheckExtensionValidation?detailId=${detailId}`)
            .then(response => response.json())
            .then(data => {
                const statusElement = document.getElementById(`validation-status-${detailId}`);
                const approveButton = document.getElementById(`approve-btn-${detailId}`);
                
                if (statusElement && data.success) {
                    if (data.canApprove) {
                        statusElement.innerHTML = '<span class="badge bg-success"><i class="fa-solid fa-check-circle me-1"></i>Hợp lệ</span>';
                        if (approveButton) {
                            approveButton.disabled = false;
                        }
                    } else {
                        const issues = data.validationIssues || [];
                        let badgeClass = 'bg-warning text-dark';
                        // TODO: Keep text-dark here because bg-warning is a fixed light background that doesn't change with theme
                        let icon = 'fa-exclamation-triangle';
                        
                        if (issues.includes('Có người đặt trước')) {
                            badgeClass = 'bg-danger';
                            icon = 'fa-ban';
                        }
                        
                        statusElement.innerHTML = `<span class="badge ${badgeClass}"><i class="fa-solid ${icon} me-1"></i>${data.message} (Bị chặn)</span>`;
                        if (approveButton) {
                            approveButton.disabled = true;
                        }
                    }
                }
            })
            .catch(error => {
                const statusElement = document.getElementById(`validation-status-${detailId}`);
                if (statusElement) {
                    statusElement.innerHTML = '<span class="badge bg-secondary">Lỗi kiểm tra</span>';
                }
            });
    }

    function confirmReturnBook(id) {
        // Load the shared Partial View
        fetch(`/BorrowSlips/GetReturnBookModal/${id}`)
            .then(response => response.text())
            .then(html => {
                document.getElementById('returnModalContainer').innerHTML = html;

                // Khởi tạo modal Bootstrap (partial chỉ chứa HTML/CSS -
                // toàn bộ xử lý tương tác đã được gắn sẵn bằng event delegation ở dưới)
                const modalElement = document.getElementById('damageModal');
                if (modalElement) {
                    const modal = bootstrap.Modal.getOrCreateInstance(modalElement, { backdrop: 'static', keyboard: false });
                    modal.show();
                }
            })
            .catch(error => {
                console.error('Error loading modal:', error);
                Swal.fire('Lỗi', 'Không thể tải modal trả sách', 'error');
            });
    }

    // =====================================================================
    // XỬ LÝ TƯƠNG TÁC CHO MODAL TRẢ SÁCH (#damageModal)
    // Modal được tải động qua AJAX + innerHTML (xem confirmReturnBook ở trên),
    // nên KHÔNG thể đặt các listener này trong <script> của partial - script
    // chèn qua innerHTML sẽ không được trình duyệt thực thi. Toàn bộ được gắn
    // 1 lần duy nhất ở đây bằng event delegation trên `document`, nhờ đó vẫn
    // hoạt động đúng với nội dung modal được chèn vào sau.
    // =====================================================================
    (function () {
        function formatVND(amount) {
            return `${Math.round(amount).toLocaleString('vi-VN')} VNĐ`;
        }

        function toggleDamageFields(row, condition) {
            const detailsInput = row.querySelector('.damage-details-input');
            const percentSelect = row.querySelector('.damage-percent-select');
            const showDamageFields = condition === 'damaged';

            if (detailsInput) {
                detailsInput.classList.toggle('d-none', !showDamageFields);
                if (!showDamageFields) detailsInput.value = '';
            }
            if (percentSelect) {
                percentSelect.classList.toggle('d-none', !showDamageFields);
            }
        }

        // Tính tiền phạt cho 1 dòng sách theo đúng bậc:
        // 10-40%  -> không phạt
        // 50%     -> 10.000 VNĐ
        // 60%     -> 15.000 VNĐ
        // 70%     -> 20.000 VNĐ
        // 80-100% -> phạt theo % giá sách
        // Mất sách -> phạt 100% giá sách
        function computeRowFine(row) {
            const conditionSelect = row.querySelector('.book-condition-select');
            if (!conditionSelect) return 0;

            const price = parseFloat(conditionSelect.dataset.price) || 0;
            const condition = conditionSelect.value;
            const percentSelect = row.querySelector('.damage-percent-select');
            let fine = 0;

            if (condition === 'lost') {
                fine = price;
            } else if (condition === 'damaged') {
                const percent = percentSelect ? parseInt(percentSelect.value, 10) : 100;

                if (percent >= 10 && percent <= 40) {
                    fine = 0;
                } else if (percent === 50) {
                    fine = 10000;
                } else if (percent === 60) {
                    fine = 15000;
                } else if (percent === 70) {
                    fine = 20000;
                } else if (percent >= 80 && percent <= 100) {
                    fine = price * (percent / 100);
                }
            }

            const fineEl = row.querySelector('.book-fine-amount');
            if (fineEl) fineEl.textContent = formatVND(fine);

            return fine;
        }

        function calculateTotalFine(modalEl) {
            let totalFine = 0;
            let normalCount = 0, damagedCount = 0, lostCount = 0;

            modalEl.querySelectorAll('.books-table-body tr').forEach(row => {
                const conditionSelect = row.querySelector('.book-condition-select');
                if (!conditionSelect) return;

                totalFine += computeRowFine(row);

                switch (conditionSelect.value) {
                    case 'good': normalCount++; break;
                    case 'damaged': damagedCount++; break;
                    case 'lost': lostCount++; break;
                }
            });

            const totalAmountEl = modalEl.querySelector('.total-fine-amount');
            const summaryEl = modalEl.querySelector('.fine-summary');

            if (totalAmountEl) totalAmountEl.textContent = formatVND(totalFine);

            if (summaryEl) {
                const parts = [];
                if (normalCount > 0) parts.push(`${normalCount} cuốn nguyên vẹn`);
                if (damagedCount > 0) parts.push(`${damagedCount} cuốn hư hỏng`);
                if (lostCount > 0) parts.push(`${lostCount} cuốn bị mất`);
                summaryEl.textContent = parts.length ? parts.join(', ') : 'Chưa chọn tình trạng';
            }

            return totalFine;
        }

        // Đổi tình trạng trả (Nguyên vẹn / Hư hỏng / Mất) -> hiện/ẩn ô chi tiết + % hư hại
        document.addEventListener('change', function (e) {
            if (e.target.matches('#damageModal .book-condition-select')) {
                const row = e.target.closest('tr');
                const modalEl = e.target.closest('.modal');
                toggleDamageFields(row, e.target.value);
                calculateTotalFine(modalEl);
            } else if (e.target.matches('#damageModal .damage-percent-select')) {
                const modalEl = e.target.closest('.modal');
                calculateTotalFine(modalEl);
            }
        });

        // Tính lại tiền phạt mỗi khi modal trả sách được mở
        document.addEventListener('show.bs.modal', function (e) {
            if (e.target.matches('#damageModal')) {
                calculateTotalFine(e.target);
            }
        });

        function closeModalCleanly(modalEl) {
            const instance = bootstrap.Modal.getInstance(modalEl);
            if (instance) instance.hide();

            setTimeout(() => {
                if (!document.querySelector('.modal.show')) {
                    document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
                    document.body.classList.remove('modal-open');
                    document.body.style.removeProperty('overflow');
                    document.body.style.removeProperty('padding-right');
                }
            }, 150);
        }

        // Xác nhận trả sách: gửi tình trạng + chi tiết hư hại + % hư hại + tiền phạt từng
        // cuốn lên server để BE lưu kết quả trả sách VÀ tạo phiếu phạt tương ứng (nếu có)
        // vào "Quản lý phạt tiền".
        document.addEventListener('click', function (e) {
            const btn = e.target.closest('#damageModal .confirm-return-btn');
            if (!btn || btn.disabled) return;

            const modalEl = btn.closest('.modal');
            const borrowSlipId = modalEl.querySelector('.borrow-slip-id-input').value;

            const bookConditions = [];
            modalEl.querySelectorAll('.books-table-body tr').forEach(row => {
                const conditionSelect = row.querySelector('.book-condition-select');
                if (!conditionSelect) return;

                const isDamaged = conditionSelect.value === 'damaged';
                const percentSelect = row.querySelector('.damage-percent-select');
                const detailsInput = row.querySelector('.damage-details-input');
                const fineEl = row.querySelector('.book-fine-amount');
                const fineAmount = fineEl ? parseFloat(fineEl.textContent.replace(/[^\d]/g, '')) || 0 : 0;

                bookConditions.push({
                    bookId: parseInt(conditionSelect.dataset.bookId, 10),
                    borrowDetailId: parseInt(row.dataset.borrowDetailId, 10),
                    condition: conditionSelect.value,                                   // good | damaged | lost
                    damagePercent: isDamaged && percentSelect ? parseInt(percentSelect.value, 10) : null,
                    damageDetails: isDamaged && detailsInput ? detailsInput.value.trim() : null,
                    fineAmount: fineAmount
                });
            });

            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Đang xử lý...';

            fetch('/BorrowSlips/ProcessReturn', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({
                    borrowSlipId: parseInt(borrowSlipId, 10),
                    bookConditions: bookConditions
                })
            })
                .then(response => response.json())
                .then(data => {
                    closeModalCleanly(modalEl);

                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công',
                            text: data.message || 'Đã xác nhận trả sách. Phiếu phạt (nếu có) đã được lưu vào Quản lý phạt tiền.',
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => location.reload());
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: data.message || 'Có lỗi xảy ra khi trả sách'
                        });
                    }
                })
                .catch(() => {
                    closeModalCleanly(modalEl);
                    Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Có lỗi xảy ra kết nối' });
                })
                .finally(() => {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa-solid fa-check me-2"></i>Xác nhận trả sách';
                });
        });
    })();

    document.addEventListener('DOMContentLoaded', function() {
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                var showExtensionApproval = item.BorrowStatus == SOF1022_NHOM1_SD2003_Ver2.Models.Enums.BorrowStatus.PendingExtension;
                if (showExtensionApproval)
                {
                    var pendingExtension = item.BorrowDetails?.FirstOrDefault(bd => bd.RequestedExtensionDays.HasValue);
                    if (pendingExtension != null)
                    {
                        <text>
                        checkExtensionValidation(@pendingExtension.Id);
                        </text>
                    }
                }
            }
        }
    });
</script>
