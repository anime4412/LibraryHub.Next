@model SOF1022_NHOM1_SD2003_Ver2.Models.BorrowSlips

@{
    Layout = null;
    ViewData["Title"] = $"Phiếu mượn {Model.BorrowCode ?? $"PM{Model.Id:D5}"}";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            font-family: 'Times New Roman', Times, serif;
            color: #212529;
            background-color: #f8f9fa;
            padding: 20px;
        }

        .print-container {
            max-width: 800px;
            margin: auto;
            background: #ffffff;
            padding: 40px;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .header-title {
            text-align: center;
            margin-bottom: 25px;
        }

        .header-title h3 {
            font-size: 20px;
            font-weight: bold;
            text-transform: uppercase;
            margin-bottom: 5px;
        }

        .header-title h4 {
            font-size: 16px;
            font-weight: bold;
            text-transform: uppercase;
            color: #0d6efd;
            margin-bottom: 8px;
        }

        .header-title p {
            font-size: 14px;
            margin-bottom: 0;
            color: #6c757d;
        }

        .slip-meta {
            margin-bottom: 20px;
            font-size: 15px;
            line-height: 1.8;
        }

        .table-custom th {
            background-color: #f1f3f5 !important;
            font-weight: bold;
            text-align: center;
        }

        .signature-block {
            margin-top: 50px;
            display: flex;
            justify-content: space-between;
            text-align: center;
        }

        .signature-title {
            font-weight: bold;
            font-size: 15px;
            margin-bottom: 70px;
        }

        .signature-name {
            font-weight: 600;
        }

        .rules-box {
            margin-top: 30px;
            padding: 12px 18px;
            border: 1px dashed #ced4da;
            border-radius: 6px;
            font-size: 13px;
            color: #495057;
            background-color: #fafbfc;
        }

        .no-print-bar {
            max-width: 800px;
            margin: 0 auto 20px auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        @@media print {
            body {
                background-color: #ffffff;
                padding: 0;
            }
            .print-container {
                box-shadow: none;
                padding: 15px;
                max-width: 100%;
            }
            .no-print, .no-print-bar {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <div class="no-print-bar">
        <button onclick="window.history.back()" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
        </button>
        <div>
            <button onclick="window.print()" class="btn btn-primary">
                <i class="fa-solid fa-print me-1"></i> In phiếu mượn
            </button>
        </div>
    </div>

    <div class="print-container">
        <!-- Header -->
        <div class="row align-items-center mb-3">
            <div class="col-8">
                <div class="fw-bold text-uppercase" style="font-size: 14px;">TRƯỜNG CAO ĐẲNG FPT POLYTECHNIC</div>
                <div class="fw-bold text-uppercase" style="font-size: 15px; color: #0d6efd;">THƯ VIỆN ĐIỆN TỬ FPT POLYTECHNIC</div>
                <div class="small text-muted">Địa chỉ: Tòa nhà FPT Polytechnic, Phố Trịnh Văn Bô, Nam Từ Liêm, Hà Nội</div>
            </div>
            <div class="col-4 text-end">
                <div class="small">Mã phiếu: <strong>@(Model.BorrowCode ?? $"PM{Model.Id:D5}")</strong></div>
                <div class="small text-muted">Ngày lập: @Model.BorrowDate.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>

        <hr />

        <div class="header-title">
            <h3>PHIẾU MƯỢN SÁCH</h3>
            <p>Trạng thái: <span class="badge bg-secondary">@Model.BorrowStatus</span></p>
        </div>

        <!-- Reader Info -->
        <div class="slip-meta row">
            <div class="col-6">
                <div><strong>Độc giả:</strong> @(Model.Readers?.FullName ?? "N/A")</div>
                <div><strong>Mã thẻ thư viện:</strong> @(Model.Readers?.ReaderCode ?? "N/A")</div>
                <div><strong>Số điện thoại:</strong> @(Model.Readers?.Phone ?? "N/A")</div>
            </div>
            <div class="col-6">
                <div><strong>Email:</strong> @(Model.Readers?.Email ?? "N/A")</div>
                <div><strong>Ngày mượn:</strong> @Model.BorrowDate.ToString("dd/MM/yyyy")</div>
                <div><strong>Hạn trả sách:</strong> <span class="text-danger fw-bold">@Model.DueDate.ToString("dd/MM/yyyy")</span></div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Note))
            {
                <div class="col-12 mt-2">
                    <strong>Ghi chú:</strong> <em>@Model.Note</em>
                </div>
            }
        </div>

        <!-- Borrowed Books Table -->
        <h5 class="fw-bold mb-2">Danh sách sách mượn (@(Model.BorrowDetails?.Count ?? 0) cuốn)</h5>
        <table class="table table-bordered table-custom">
            <thead>
                <tr>
                    <th style="width: 50px;">STT</th>
                    <th>Tên sách</th>
                    <th>Tác giả / Thể loại</th>
                    <th style="width: 130px;">ISBN</th>
                    <th style="width: 120px;">Hạn trả</th>
                    <th style="width: 100px;">Tình trạng</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.BorrowDetails != null && Model.BorrowDetails.Any())
                {
                    int index = 1;
                    foreach (var item in Model.BorrowDetails)
                    {
                        <tr>
                            <td class="text-center">@index</td>
                            <td>
                                <strong>@(item.Books?.Title ?? "N/A")</strong>
                            </td>
                            <td>
                                @(item.Books?.Author?.Name ?? "N/A")<br />
                                <small class="text-muted">@(item.Books?.Category?.Name ?? "")</small>
                            </td>
                            <td class="text-center">@(item.Books?.ISBN ?? "N/A")</td>
                            <td class="text-center">@((item.DueDate ?? Model.DueDate).ToString("dd/MM/yyyy"))</td>
                            <td class="text-center">@(item.ConditionBefore ?? "Tốt")</td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">Không có chi tiết sách mượn.</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Library Rules -->
        <div class="rules-box">
            <strong>Quy định mượn trả tài liệu:</strong>
            <ul class="mb-0 ps-3 mt-1">
                <li>Độc giả có trách nhiệm bảo quản nguyên vẹn sách trong suốt thời gian mượn.</li>
                <li>Mỗi lần gia hạn tối đa thêm 7 ngày (tối đa 2 lần gia hạn nếu sách không có người đặt trước).</li>
                <li>Trả sách quá hạn sẽ bị tính phí phạt 5.000 VNĐ / ngày / cuốn sách.</li>
                <li>Làm mất hoặc hỏng sách sẽ phải bồi thường theo đúng giá trị và nội quy thư viện.</li>
            </ul>
        </div>

        <!-- Signatures -->
        <div class="signature-block">
            <div style="width: 250px;">
                <div class="signature-title">NGƯỜI MƯỢN SÁCH</div>
                <div class="text-muted small mb-5">(Ký và ghi rõ họ tên)</div>
                <div class="signature-name">@(Model.Readers?.FullName ?? "")</div>
            </div>
            <div style="width: 250px;">
                <div class="signature-title">THỦ THƯ XÁC NHẬN</div>
                <div class="text-muted small mb-5">(Ký và ghi rõ họ tên)</div>
                <div class="signature-name">@(Model.CreatedBy ?? "Thủ thư thư viện")</div>
            </div>
        </div>
    </div>
</body>
</html>
