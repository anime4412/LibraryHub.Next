<script>
    function getAntiForgeryToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    }

    function loadSlipDetails(slipId) {
        const contentEl = document.getElementById('slipDetailsContent');
        if (!contentEl) return;

        contentEl.innerHTML = '<div class="text-center py-4"><i class="fa-solid fa-spinner fa-spin fa-2x text-secondary"></i><p class="mt-2 text-muted">Đang tải chi tiết phiếu...</p></div>';
        new bootstrap.Modal(document.getElementById('slipDetailsModal')).show();

        fetch('/BorrowSlips/GetDetails/' + slipId)
            .then(response => response.json())
            .then(result => {
                if (!result.success) {
                    contentEl.innerHTML = `<div class="alert alert-danger mb-0">${result.message || 'Không tìm thấy chi tiết phiếu mượn'}</div>`;
                    return;
                }

                const slip = result.data;
                const isPending = slip.borrowStatus === 0;
                const isApprovedAwaitingPickup = slip.borrowStatus === 1;
                const canCancel = isPending || isApprovedAwaitingPickup;
                const isOverdue = slip.statusText === 'Quá hạn';

                let content = `
                    <div class="mb-4">
                        <h6 style="color: var(--brand-base); font-weight: 700;">#${slip.borrowCode}</h6>
                        <div class="row mt-3">
                            <div class="col-md-6">
                                <small style="color: var(--text-secondary);">Ngày tạo:</small>
                                <div style="color: var(--text-primary); font-weight: 600;">${new Date(slip.borrowDate).toLocaleDateString('vi-VN')}</div>
                            </div>
                            <div class="col-md-6">
                                <small style="color: var(--text-secondary);">Trạng thái:</small>
                                <div style="color: var(--text-primary); font-weight: 600;">${slip.statusText}</div>
                            </div>
                        </div>
                    </div>
                    <h6 style="color: var(--text-primary); font-weight: 600; margin-bottom: 12px;">Danh sách sách:</h6>
                    <div class="row g-2 mb-4">
                `;

                (slip.items || []).forEach(item => {
                    content += `
                        <div class="col-md-6">
                            <div style="background: var(--bg-card); padding: 10px; border-radius: 8px; border: 1px solid var(--border-color);">
                                <div style="display: flex; gap: 10px; align-items: center;">
                                    <img src="${item.bookCover || '/images/default-book-cover.jpg'}" alt="${item.bookTitle}" style="width: 40px; height: 50px; object-fit: cover; border-radius: 4px;" />
                                    <div style="flex: 1;">
                                        <div style="color: var(--text-primary); font-size: 13px; font-weight: 600;">${item.bookTitle}</div>
                                        <span class="badge bg-secondary" style="font-size: 11px;">Số lượng: 1</span>
                                    </div>
                                </div>
                                ${canCancel ? `
                                    <button type="button" class="btn btn-sm btn-outline-danger mt-2 w-100" onclick="cancelBorrowItem(${item.detailId})">
                                        <i class="fa-solid fa-trash-alt me-1"></i>Hủy cuốn này
                                    </button>` : ''}
                            </div>
                        </div>
                    `;
                });

                content += `
                    </div>
                    <h6 style="color: var(--text-primary); font-weight: 600; margin-bottom: 12px;">Thông tin bổ sung:</h6>
                    <div style="background: var(--bg-input); padding: 12px; border-radius: 8px; border: 1px solid var(--border-color);">
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <small style="color: var(--text-secondary);">Hạn trả:</small>
                                <div style="color: ${isOverdue ? 'var(--danger)' : 'var(--text-primary)'}; font-weight: 600;">${new Date(slip.dueDate).toLocaleDateString('vi-VN')}</div>
                            </div>
                            <div class="col-md-6 mb-2">
                                <small style="color: var(--text-secondary);">Số sách:</small>
                                <div style="color: var(--text-primary); font-weight: 600;">${slip.totalBooks}</div>
                            </div>
                        </div>
                    </div>
                `;

                contentEl.innerHTML = content;
            })
            .catch(() => {
                contentEl.innerHTML = '<div class="alert alert-danger mb-0">Có lỗi xảy ra khi tải chi tiết phiếu mượn</div>';
            });
    }

    let currentFineId = null;
    let paymentVerificationInterval = null;
    let paymentStartTime = null;

    function showQRPaymentModal(fineId, amount, transactionCode) {
        if (!fineId) {
            Swal.fire({
                icon: 'error',
                title: 'Lỗi',
                text: 'Không tìm thấy thông tin khoản phạt'
            });
            return;
        }

        currentFineId = fineId;
        document.getElementById('qrPaymentAmount').textContent = amount.toLocaleString('vi-VN') + ' VNĐ';
        document.getElementById('qrTransactionCode').textContent = transactionCode || '-';

        // Generate VietQR code with banking info and transaction code
        const qrData = `00020101021226580016vn.com0000005303704${transactionCode}5802VN6304`;
        const qrImageUrl = `https://img.vietqr.io/image/970418-105884348544-compact2.png?amount=${amount}&addInfo=${transactionCode}`;
        document.getElementById('qrCodeImage').src = qrImageUrl;

        // Reset verification status
        document.getElementById('paymentVerificationStatus').classList.add('d-none');
        document.getElementById('confirmQRPaymentBtn').disabled = false;
        document.getElementById('confirmQRPaymentBtn').innerHTML = '<i class="fas fa-check me-2"></i>Xác nhận thanh toán';
        document.getElementById('cancelPaymentBtn').disabled = false;

        new bootstrap.Modal(document.getElementById('qrPaymentModal')).show();
    }

    function confirmQRPayment() {
        if (!currentFineId) {
            Swal.fire({
                icon: 'error',
                title: 'Lỗi',
                text: 'Không tìm thấy thông tin khoản phạt'
            });
            return;
        }

        const confirmBtn = document.getElementById('confirmQRPaymentBtn');
        const cancelBtn = document.getElementById('cancelPaymentBtn');
        const verificationStatus = document.getElementById('paymentVerificationStatus');
        const verificationMessage = document.getElementById('verificationMessage');

        confirmBtn.disabled = true;
        cancelBtn.disabled = true;
        confirmBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang xử lý...';
        verificationStatus.classList.remove('d-none');
        verificationMessage.textContent = 'Đang kiểm tra thanh toán...';

        paymentStartTime = new Date();
        let elapsedSeconds = 0;
        const maxWaitSeconds = 180; // 3 minutes

        // Start payment verification with polling
        paymentVerificationInterval = setInterval(() => {
            elapsedSeconds = Math.floor((new Date() - paymentStartTime) / 1000);
            const remainingSeconds = maxWaitSeconds - elapsedSeconds;

            if (remainingSeconds <= 0) {
                // Timeout - payment not received
                clearInterval(paymentVerificationInterval);
                verificationStatus.classList.remove('alert-warning');
                verificationStatus.classList.add('alert-danger');
                verificationMessage.innerHTML = '<i class="fas fa-times-circle me-2"></i>Hết thời gian chờ thanh toán (3 phút)';
                confirmBtn.disabled = false;
                confirmBtn.innerHTML = '<i class="fas fa-redo me-2"></i>Thử lại';
                cancelBtn.disabled = false;
                return;
            }

            // Update status message with countdown
            const minutes = Math.floor(remainingSeconds / 60);
            const seconds = remainingSeconds % 60;
            verificationMessage.textContent = `Đang kiểm tra thanh toán... (${minutes}:${seconds.toString().padStart(2, '0')} còn lại)`;

            // Check payment status every 5 seconds
            if (elapsedSeconds % 5 === 0) {
                checkPaymentStatus();
            }
        }, 1000);

        // Initial payment check
        checkPaymentStatus();
    }

    function checkPaymentStatus() {
        const token = getAntiForgeryToken();
        if (!token) {
            clearInterval(paymentVerificationInterval);
            Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Không tìm thấy token bảo mật. Vui lòng tải lại trang.' });
            return;
        }

        fetch('/Fines/CheckPaymentStatus', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({ fineId: currentFineId })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success && data.paid) {
                // Payment successful
                clearInterval(paymentVerificationInterval);
                const verificationStatus = document.getElementById('paymentVerificationStatus');
                const verificationMessage = document.getElementById('verificationMessage');

                verificationStatus.classList.remove('alert-warning');
                verificationStatus.classList.add('alert-success');
                verificationMessage.innerHTML = '<i class="fas fa-check-circle me-2"></i>Thanh toán thành công!';

                setTimeout(() => {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thanh toán thành công!',
                        text: 'Khoản phạt đã được thanh toán thành công.',
                        timer: 2000,
                        showConfirmButton: false
                    }).then(() => {
                        location.reload();
                    });
                }, 1000);
            } else if (data.insufficient) {
                // Insufficient funds
                clearInterval(paymentVerificationInterval);
                const verificationStatus = document.getElementById('paymentVerificationStatus');
                const verificationMessage = document.getElementById('verificationMessage');

                verificationStatus.classList.remove('alert-warning');
                verificationStatus.classList.add('alert-danger');
                verificationMessage.innerHTML = '<i class="fas fa-exclamation-triangle me-2"></i>Không đủ tiền hoặc số tiền chuyển không đúng';

                const confirmBtn = document.getElementById('confirmQRPaymentBtn');
                const cancelBtn = document.getElementById('cancelPaymentBtn');
                confirmBtn.disabled = false;
                confirmBtn.innerHTML = '<i class="fas fa-redo me-2"></i>Thử lại';
                cancelBtn.disabled = false;
            }
        })
        .catch(error => {
            console.error('Error checking payment status:', error);
        });
    }

    function cancelBorrowItem(detailId) {
        Swal.fire({
            title: 'Xác nhận hủy cuốn sách',
            text: 'Bạn có chắc chắn muốn hủy cuốn sách này khỏi phiếu mượn?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Đồng ý',
            cancelButtonText: 'Hủy',
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#6c757d'
        }).then((result) => {
            if (!result.isConfirmed) return;

            const token = getAntiForgeryToken();
            if (!token) {
                Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Không tìm thấy token bảo mật. Vui lòng tải lại trang.' });
                return;
            }

            fetch('/BorrowSlips/CancelItem', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ detailId: detailId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({ icon: 'success', title: 'Đã hủy', text: data.message }).then(() => location.reload());
                } else {
                    Swal.fire({ icon: 'error', title: 'Lỗi', text: data.message || 'Không thể hủy cuốn sách' });
                }
            })
            .catch(() => Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Có lỗi xảy ra khi kết nối' }));
        });
    }

