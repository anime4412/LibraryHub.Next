<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
@model SOF1022_NHOM1_SD2003_Ver2.Models.ViewModels.MyBorrowViewModel

@{
    ViewData["Title"] = "Sách của tôi";
}

@Html.AntiForgeryToken()


<div class="container" style="padding-top: var(--section-gap); padding-bottom: var(--section-gap);">
        <style>
            @@media (max-width: 991px) {
                .container {
                    padding-top: var(--section-gap-sm) !important;
                    padding-bottom: var(--section-gap-sm) !important;
                }
            }
        </style>

    <!-- Advanced Filter Section -->
    <div class="card bg-white border-secondary mb-4" style="box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
        <div class="card-body">
            <form asp-action="MyBorrows" method="get">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-secondary text-secondary">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" class="form-control bg-white border-secondary text-dark" name="searchString" value="@ViewBag.SearchString" placeholder="Tìm kiếm tên sách..." />
                            <!-- TODO: Keep text-dark here because bg-white is a fixed light background that doesn't change with theme -->
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select bg-white border-secondary text-dark" name="statusFilter">
                            <!-- TODO: Keep text-dark here because bg-white is a fixed light background that doesn't change with theme -->
                            <option value="">Tất cả trạng thái</option>
                            <option value="active" selected="@(ViewBag.StatusFilter == "active" ? "selected" : null)">Đang mượn</option>
                            <option value="overdue" selected="@(ViewBag.StatusFilter == "overdue" ? "selected" : null)">Quá hạn</option>
                            <option value="returned" selected="@(ViewBag.StatusFilter == "returned" ? "selected" : null)">Đã trả</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select bg-white border-secondary text-dark" name="sortOrder">
                            <!-- TODO: Keep text-dark here because bg-white is a fixed light background that doesn't change with theme -->
                            <option value="">Sắp xếp mặc định</option>
                            <option value="borrow_date_desc" selected="@(ViewBag.SortOrder == "borrow_date_desc" ? "selected" : null)">Ngày mượn (mới nhất)</option>
                            <option value="borrow_date_asc" selected="@(ViewBag.SortOrder == "borrow_date_asc" ? "selected" : null)">Ngày mượn (cũ nhất)</option>
                            <option value="due_date_desc" selected="@(ViewBag.SortOrder == "due_date_desc" ? "selected" : null)">Hạn trả (gần nhất)</option>
                            <option value="due_date_asc" selected="@(ViewBag.SortOrder == "due_date_asc" ? "selected" : null)">Hạn trả (xa nhất)</option>
                            <option value="name_asc" selected="@(ViewBag.SortOrder == "name_asc" ? "selected" : null)">Tên A-Z</option>
                            <option value="name_desc" selected="@(ViewBag.SortOrder == "name_desc" ? "selected" : null)">Tên Z-A</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-warning w-100 fw-bold">
                            <i class="bi bi-filter me-2"></i>Lọc
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-heading fw-bold d-flex align-items-center" style="font-family: var(--font-display); font-size: var(--text-3xl); font-weight: 600; margin-bottom: 12px;">
            <i class="fa-solid fa-book-bookmark text-warning me-3"></i> Sách đang mượn
        </h2>
    </div>

    @if (Model.CurrentBorrows != null && Model.CurrentBorrows.Any())
    {
        // Group by slip code (using BorrowDate as proxy for slip grouping)
        var groupedBorrows = Model.CurrentBorrows.GroupBy(b => b.BorrowSlipId);
        
        <div class="row g-4 mb-5">
            @foreach (var slipGroup in groupedBorrows)
            {
                var firstItem = slipGroup.First();
                var slipCode = !string.IsNullOrEmpty(firstItem.BorrowCode) ? firstItem.BorrowCode : ("BR" + firstItem.BorrowSlipId.ToString("D6"));
                var isOverdue = firstItem.Status == "Quá hạn";
                var isPending = firstItem.BorrowStatus == SOF1022_NHOM1_SD2003_Ver2.Models.Enums.BorrowStatus.PendingApproval;
                var isApprovedAwaitingPickup = firstItem.BorrowStatus == SOF1022_NHOM1_SD2003_Ver2.Models.Enums.BorrowStatus.ApprovedAwaitingPickup;
                var isApprovedNotPickedUp = isApprovedAwaitingPickup && firstItem.PickupDeadline.HasValue && firstItem.PickupDeadline > DateTime.Now;
                var isPendingExtension = firstItem.BorrowStatus == SOF1022_NHOM1_SD2003_Ver2.Models.Enums.BorrowStatus.PendingExtension;
                
                <div class="col-12">
                    <div class="slip-card @(isOverdue ? "border-danger" : "")">
                        <!-- Slip Header -->
                        <div class="slip-header">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="slip-code">#@slipCode</span>
                                    @if (isPending)
                                    {
                                        <span class="badge bg-warning text-dark ms-2">
                                            <!-- TODO: Keep text-dark here because bg-warning is a fixed light background that doesn't change with theme -->
                                            <i class="fa-solid fa-clock me-1"></i> Chờ duyệt
                                        </span>
                                    }
                                    else if (isApprovedNotPickedUp)
                                    {
                                        <span class="badge bg-info ms-2">
                                            <i class="fa-solid fa-check-circle me-1"></i> Đã duyệt
                                        </span>
                                    }
                                    else if (isPendingExtension)
                                    {
                                        <span class="badge bg-warning text-dark ms-2">
                                            <!-- TODO: Keep text-dark here because bg-warning is a fixed light background that doesn't change with theme -->
                                            <i class="fa-solid fa-hourglass-half me-1"></i> Chờ duyệt gia hạn
                                        </span>
                                    }
                                    else if (isOverdue)
                                    {
                                        <span class="badge bg-danger ms-2">
                                            <i class="fa-solid fa-triangle-exclamation me-1"></i> Quá hạn
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success ms-2">
                                            <i class="fa-solid fa-circle-check me-1"></i> Đang mượn
                                        </span>
                                    }
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-light" onclick="loadSlipDetails(@firstItem.BorrowSlipId)">
                                    <i class="fa-solid fa-eye me-1"></i> Chi tiết
                                </button>
                            </div>
                        </div>

                        <!-- Book List -->
                        <div class="slip-body">
                            <div class="row g-3">
                                @foreach (var item in slipGroup)
                                {
                                    <div class="col-md-6 col-lg-4">
                                        <div class="book-item-mini">
                                            <img src="@item.BookCoverImage" alt="@item.BookTitle" class="book-thumb" />
                                            <div class="book-info">
                                                <h3 class="book-title text-truncate" title="@item.BookTitle" style="font-family: var(--font-sans); font-size: var(--text-xl); font-weight: 600; margin-bottom: 8px;">@item.BookTitle</h3>
                                                <span class="badge bg-secondary">Số lượng: 1</span>
                                                @if (isPending || isApprovedNotPickedUp)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-danger mt-2 w-100"
                                                            onclick="cancelBorrowItem(@item.BorrowDetailId)">
                                                        <i class="fa-solid fa-trash-alt me-1"></i>Hủy cuốn này
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Meta Info -->
                        <div class="slip-meta">
                            <div class="row">
                                <div class="col-md-4">
                                    <small class="text-muted">Ngày tạo:</small>
                                    <div class="fw-bold">@firstItem.BorrowDate.ToString("dd/MM/yyyy")</div>
                                </div>
                                @if (isPending || isApprovedNotPickedUp)
                                {
                                    <div class="col-md-4">
                                        <small class="text-muted">Hạn nhận:</small>
                                        <div class="fw-bold @(isApprovedNotPickedUp ? "text-info" : "text-warning")">@firstItem.PickupDeadline?.ToString("dd/MM/yyyy HH:mm")</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-md-4">
                                        <small class="text-muted">Hạn trả:</small>
                                        <div class="fw-bold @(isOverdue ? "text-danger" : "text-light")">@firstItem.DueDate.ToString("dd/MM/yyyy")</div>
                                    </div>
                                }
                                <div class="col-md-4">
                                    <small class="text-muted">Số sách:</small>
                                    <div class="fw-bold">@slipGroup.Count()</div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Bar -->
                        <div class="slip-actions d-flex gap-3 flex-wrap">
                            @if (isPending || isApprovedNotPickedUp)
                            {
                                <button type="button" class="btn btn-danger" onclick="cancelBorrowSlip(@firstItem.BorrowSlipId)">
                                    <i class="fa-solid fa-trash-alt me-2"></i>Hủy phiếu mượn
                                </button>
                                <button type="button" class="btn btn-outline-info" onclick="loadSlipDetails(@firstItem.BorrowSlipId)">
                                    <i class="fa-solid fa-eye me-1"></i> Xem chi tiết phiếu
                                </button>
                                @if (isApprovedNotPickedUp)
                                {
                                    <div class="alert alert-info py-2 mb-0 ms-2">
                                        <small><i class="fa-solid fa-info-circle me-1"></i> Vui lòng đến thư viện trước @firstItem.PickupDeadline?.ToString("dd/MM/yyyy") để nhận sách</small>
                                    </div>
                                }
                            }
                            else if (isOverdue)
                            {
                                <div class="alert alert-danger py-2 mb-0">
                                    <small><i class="fa-solid fa-triangle-exclamation me-1"></i> Phiếu mượn đã quá hạn! Vui lòng đến thư viện để trả sách và thanh toán phạt.</small>
                                </div>
                            }
                            else
                            {
                                var canExtend = slipGroup.Any(b => b.ExtensionCount < 2);
                                if (canExtend && !Model.HasUnpaidFines)
                                {
                                    <button type="button" onclick="requestExtension(@firstItem.BorrowDetailId)" class="btn btn-primary">
                                        <i class="fa-solid fa-paper-plane me-2"></i>Gửi yêu cầu gia hạn
                                    </button>
                                }
                                else if (Model.HasUnpaidFines)
                                {
                                    <button type="button" class="btn btn-secondary" disabled>
                                        <i class="fa-solid fa-lock me-2"></i>Gia hạn bị khóa do nợ phạt
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-secondary" disabled>
                                        <i class="fa-solid fa-check-circle me-2"></i>Đã gia hạn tối đa
                                    </button>
                                }
                                <button type="button" class="btn btn-outline-info" onclick="loadSlipDetails(@firstItem.BorrowSlipId)">
                                    <i class="fa-solid fa-eye me-1"></i> Xem phiếu/Mã QR
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="custom-empty-state my-5">
            <i class="fa-solid fa-face-smile fa-3x text-secondary opacity-50 mb-3"></i>
            <p class="text-heading mb-0">Tuyệt vời! Bạn không có cuốn sách nào đang mượn hoặc quá hạn.</p>
        </div>
    }

    <hr class="custom-hr my-5">

    <h2 class="text-heading mb-4 d-flex align-items-center fw-bold" style="font-family: var(--font-display); font-size: var(--text-3xl); font-weight: 600; margin-bottom: 12px;">
        <i class="fa-solid fa-clock-rotate-left text-warning me-3"></i> Lịch sử mượn sách
    </h2>

    @if (Model.History != null && Model.History.Any())
    {
        <div class="table-responsive custom-table-container">
            <table class="table table-dark align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Bìa</th>
                        <th>Tên sách</th>
                        <th>Ngày mượn</th>
                        <th>Hạn trả</th>
                        <th>Ngày trả</th>
                        <th>Trạng thái</th>
                        <th class="pe-4 text-end">Chi phí phạt</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.History)
                    {
                        <tr>
                            <td class="ps-4" width="90">
                                <div class="table-book-img">
                                    <img src="@item.BookCoverImage" alt="bìa" />
                                </div>
                            </td>
                            <td class="fw-bold text-white max-w-250">
                                <div class="text-truncate" title="@item.BookTitle">@item.BookTitle</div>
                            </td>
                            <td class="text-secondary">@item.BorrowDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-secondary">@item.DueDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-light">
                                @(item.ReturnedDate?.ToString("dd/MM/yyyy") ?? "-")
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    @if (item.Status == "Đã hủy - quá hạn nhận sách")
                                    {
                                        <span class="badge bg-secondary text-white fw-bold"><i class="fa-solid fa-circle-xmark me-1"></i>Đã hủy - quá hạn nhận sách</span>
                                        <small class="text-muted d-block w-100 fs-12">Bạn đã không đến nhận sách trong thời hạn quy định</small>
                                    }
                                    else if (item.Status == "Đã hủy")
                                    {
                                        <span class="badge bg-secondary text-white fw-bold"><i class="fa-solid fa-ban me-1"></i>Đã hủy</span>
                                    }
                                    else if (item.IsLost)
                                    {
                                        <span class="badge bg-warning text-dark fw-bold"><i class="fa-solid fa-circle-question me-1"></i>Mất sách</span>
                                        <!-- TODO: Keep text-dark here because bg-warning is a fixed light background that doesn't change with theme -->
                                    }
                                    else if (item.IsDamaged)
                                    {
                                        <span class="badge bg-secondary text-white fw-bold"><i class="fa-solid fa-heart-crack me-1"></i>Hư hỏng</span>
                                    }
                                    else if (item.IsLate)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Trả muộn</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Đúng hạn</span>
                                    }
                                </div>
                            </td>
                            <td class="pe-4 text-end">
                                <div class="d-flex flex-column align-items-end gap-1">
                                    @if (item.FineAmount > 0 && item.Status != "Đã hủy" && item.Status != "Đã hủy - quá hạn nhận sách")
                                    {
                                        <span class="text-danger fw-bold">@item.FineAmount.ToString("N0") VNĐ</span>
                                        @if (item.FineStatus == "Chờ xử lý" || item.FineStatus == "Unpaid" || string.IsNullOrEmpty(item.FineStatus))
                                        {
                                            <button type="button" class="btn btn-sm btn-warning" onclick="showQRPaymentModal(@item.FineId, @item.FineAmount, '@item.TransactionCode')">
                                                <i class="fas fa-qrcode me-1"></i> Thanh toán bằng QR
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Đã thanh toán</span>
                                        }
                                        <a href="/Fines/MyFines" class="btn btn-sm btn-outline-info">
                                            <i class="fas fa-eye"></i> Chi tiết phạt
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-success">0 VNĐ</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="custom-empty-state my-5">
            <i class="fa-solid fa-folder-open fa-3x text-secondary opacity-50 mb-3"></i>
            <p class="text-heading mb-0">Bạn chưa thực hiện giao dịch mượn sách nào từ trước đến nay.</p>
        </div>
    }
</div>

<!-- Slip Details Modal -->
<div class="modal fade" id="slipDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="background: var(--bg-card); border: 1px solid var(--border-color);">
            <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                <h3 class="modal-title" style="color: var(--text-primary); font-family: var(--font-sans); font-size: var(--text-xl); font-weight: 600; margin-bottom: 8px;">
                    <i class="fa-solid fa-file-contract me-2" style="color: var(--brand-base);"></i>
                    Chi tiết phiếu mượn
                </h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: invert(1);"></button>
            </div>
            <div class="modal-body" style="color: var(--text-primary);">
                <div id="slipDetailsContent">
                    <!-- Content will be loaded dynamically -->
                </div>
            </div>
            <div class="modal-footer" style="border-top: 1px solid #E2E8F0;">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- QR Payment Modal -->
<div class="modal fade" id="qrPaymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: var(--bg-card); border: 1px solid var(--border-color);">
            <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                <h3 class="modal-title" style="color: var(--text-primary); font-family: var(--font-sans); font-size: var(--text-xl); font-weight: 600; margin-bottom: 8px;">
                    <i class="fas fa-qrcode me-2" style="color: var(--brand-base);"></i>
                    Thanh toán bằng QR
                </h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: invert(1);"></button>
            </div>
            <div class="modal-body" style="color: var(--text-primary);">
                <div class="text-center">
                    <div class="mb-3">
                        <img id="qrCodeImage" src="" alt="VietQR Code" class="img-fluid" style="max-width: 200px; border: 2px solid var(--border-color); border-radius: 8px;" />
                    </div>
                    <div class="alert alert-info mb-3">
                        <small><strong>Thông tin tài khoản:</strong></small><br>
                        <small>LE PHU AN</small><br>
                        <small>105884348544</small><br>
                        <small>VietinBank - CN DONG NAI - HOI SO</small>
                    </div>
                    <h3 class="fw-bold mb-2" style="font-family: var(--font-sans); font-size: var(--text-xl); font-weight: 600; margin-bottom: 8px;">Mã giao dịch:</h3>
                    <p class="h5 text-primary fw-bold mb-3" id="qrTransactionCode">-</p>
                    <h3 class="fw-bold mb-2" style="font-family: var(--font-sans); font-size: var(--text-xl); font-weight: 600; margin-bottom: 8px;">Số tiền cần thanh toán:</h3>
                    <p class="h3 text-danger fw-bold mb-3" id="qrPaymentAmount">0 VNĐ</p>
                    <p class="text-muted small mb-4">
                        Vui lòng chuyển khoản với nội dung chứa mã giao dịch trên.<br>
                        Hệ thống sẽ kiểm tra thanh toán trong vòng 3 phút.
                    </p>
                    <div id="paymentVerificationStatus" class="d-none">
                        <div class="alert alert-warning mb-0">
                            <i class="fas fa-spinner fa-spin me-2"></i>
                            <span id="verificationMessage">Đang kiểm tra thanh toán...</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="border-top: 1px solid #E2E8F0;">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="cancelPaymentBtn">Hủy</button>
                <button type="button" class="btn btn-success" id="confirmQRPaymentBtn" onclick="confirmQRPayment()">
                    <i class="fas fa-check me-2"></i>Xác nhận thanh toán
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background: var(--bg-deep);
        color: var(--text-primary);
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    /* Thẻ bao quát Card mượn sách */
    .borrow-card {
        background: var(--bg-card);
        border-radius: 18px;
        overflow: hidden;
        transition: transform .35s, box-shadow .35s, border-color .35s;
        border: 1px solid var(--border-color);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .borrow-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(245, 158, 11, 0.12);
        border-color: rgba(245, 158, 11, 0.3) !important;
    }

    /* Borrow Slip Card Styles */
    .slip-card {
        background: var(--bg-card);
        border-radius: 16px;
        border: 1px solid var(--border-color);
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .slip-card:hover {
        box-shadow: 0 8px 24px rgba(245, 158, 11, 0.15);
        border-color: rgba(245, 158, 11, 0.3);
    }

    .slip-card.border-danger {
        border-color: rgba(239, 68, 68, 0.5);
    }

    .slip-card.border-danger:hover {
        box-shadow: 0 8px 24px rgba(239, 68, 68, 0.2);
    }

    .slip-header {
        background: linear-gradient(135deg, var(--bg-input) 0%, var(--bg-card) 100%);
        padding: 16px 20px;
        border-bottom: 1px solid var(--border-color);
    }

    .slip-code {
        font-size: 18px;
        font-weight: 700;
        color: var(--brand-base);
        letter-spacing: 1px;
    }

    .slip-body {
        padding: 20px;
    }

    .book-item-mini {
        display: flex;
        gap: 12px;
        background: var(--bg-card);
        padding: 12px;
        border-radius: 10px;
        border: 1px solid var(--border-color);
        transition: all 0.2s ease;
    }

    .book-item-mini:hover {
        background: var(--bg-input);
