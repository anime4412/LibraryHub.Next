    function requestExtension(id) {
        // Use SweetAlert2 for extension request
        Swal.fire({
            title: 'Gửi yêu cầu gia hạn',
            html: `
                <div class="text-start">
                    <label class="form-label fw-bold">Số ngày muốn gia hạn:</label>
                    <select id="extensionDays" class="form-select mb-3">
                        <option value="1">1 ngày</option>
                        <option value="3">3 ngày</option>
                        <option value="7" selected>7 ngày</option>
                        <option value="14">14 ngày</option>
                    </select>
                    <label class="form-label fw-bold">Lý do gia hạn:</label>
                    <select id="extensionReason" class="form-select mb-3">
                        <option value="Chưa đọc xong sách">Chưa đọc xong sách</option>
                        <option value="Đang ôn thi / Làm đồ án">Đang ôn thi / Làm đồ án</option>
                        <option value="Bận công tác / Việc cá nhân">Bận công tác / Việc cá nhân</option>
                        <option value="Lý do khác">Lý do khác</option>
                    </select>
                </div>
            `,
            showCancelButton: true,
            confirmButtonText: 'Gửi yêu cầu',
            cancelButtonText: 'Hủy',
            confirmButtonColor: '#0d6efd',
            cancelButtonColor: '#6c757d',
            preConfirm: () => {
                const days = document.getElementById('extensionDays').value;
                const reason = document.getElementById('extensionReason').value;
                return { days, reason };
            }
        }).then((result) => {
            if (result.isConfirmed) {
                const { days, reason } = result.value;
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                
                if (!token) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: 'Không tìm thấy token bảo mật. Vui lòng tải lại trang.',
                        confirmButtonText: 'Đóng'
                    });
                    return;
                }

                const formData = new FormData();
                formData.append("__RequestVerificationToken", token);
                formData.append("detailId", id);
                formData.append("requestedDays", days);
                formData.append("reason", reason);

                fetch('/BorrowSlips/RequestExtension', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công',
                            text: data.message,
                            confirmButtonText: 'Đóng'
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: data.message,
                            confirmButtonText: 'Đóng'
                        });
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: 'Có lỗi xảy ra khi gửi yêu cầu gia hạn',
                        confirmButtonText: 'Đóng'
                    });
                });
            }
        });
    }

