@model IEnumerable<SOF1022_NHOM1_SD2003_Ver2.Models.BorrowSlips>

@using SOF1022_NHOM1_SD2003_Ver2.Models.Enums

@{
    ViewData["Title"] = "Lịch sử phiếu mượn";
}

<style>
    [data-theme="dark"] .card {
        background-color: #1A1D24;
        border-color: #30363D;
    }

    [data-theme="dark"] .card-header {
        background-color: #21262D;
        border-color: #30363D;
    }

    [data-theme="dark"] .card-header.bg-white {
        background-color: #21262D;
    }

    [data-theme="dark"] .form-control {
        background-color: #0D1117;
        border-color: #30363D;
        color: #F0F6FC;
    }

    [data-theme="dark"] .form-control:focus {
        background-color: #0D1117;
        border-color: #10B981;
        color: #F0F6FC;
    }

    [data-theme="dark"] .form-control::placeholder {
        color: #6E7681;
    }

    [data-theme="dark"] .table {
        color: #F0F6FC;
    }

    [data-theme="dark"] .table thead th {
        background-color: #21262D;
        border-color: #30363D;
    }

    [data-theme="dark"] .table tbody tr {
        background-color: #1A1D24;
        border-color: #30363D;
    }

    [data-theme="dark"] .table tbody tr:hover {
        background-color: #21262D;
    }

    [data-theme="dark"] .empty-state {
        background-color: #1A1D24;
        border-color: #30363D;
    }

    [data-theme="dark"] .text-muted {
        color: #6E7681 !important;
    }
</style>

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h2 class="fw-bold mb-1">
                        <i class="fa-solid fa-clock-rotate-left text-primary me-2"></i>
                        Lịch sử Phiếu Mượn
                    </h2>
                    <p class="text-muted mb-0">
                        Theo dõi lịch sử mượn trả sách của độc giả
                    </p>
                </div>
                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-arrow-left me-2"></i>
                        Quay lại
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- STATISTICS -->
    <div class="row g-3 mb-4">
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Tổng phiếu</div>
                    <h3 class="fw-bold mt-2">@Model.Count()</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Đã trả</div>
                    <h3 class="fw-bold text-success mt-2">@Model.Count(m => m.BorrowStatus == BorrowStatus.Returned)</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Đã hủy</div>
                    <h3 class="fw-bold text-secondary mt-2">@Model.Count(m => m.BorrowStatus != BorrowStatus.Returned)</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Tổng sách mượn</div>
                    <h3 class="fw-bold text-primary mt-2">@Model.Sum(m => m.TotalBooks)</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- SEARCH -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="History" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-lg-10">
                        <label class="form-label fw-semibold">Tìm kiếm</label>
                        <input class="form-control"
                               name="search"
                               value="@ViewBag.SearchString"
                               placeholder="Mã phiếu, tên độc giả..." />
                    </div>
                    <div class="col-lg-2 d-grid">
                        <button class="btn btn-primary">
                            <i class="fa-solid fa-magnifying-glass me-2"></i>
                            Tìm kiếm
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- HISTORY TABLE -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Lịch sử mượn trả</h5>
                <span class="text-muted">Tổng cộng @Model.Count() phiếu</span>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:120px">Mã phiếu</th>
                        <th style="width:150px">Độc giả</th>
                        <th style="width:80px">Số sách</th>
                        <th style="width:120px">Ngày mượn</th>
                        <th style="width:120px">Ngày trả</th>
                        <th style="width:140px">Trạng thái</th>
                        <th style="width:150px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <i class="fa-solid fa-inbox fa-4x text-secondary mb-3 opacity-50"></i>
                                <h5 class="fw-bold">Không có lịch sử</h5>
                                <p class="text-muted">Chưa có phiếu mượn nào được hoàn tất</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            var readerName = item.Readers?.FullName ?? "N/A";
                            var avatarLetter = !string.IsNullOrWhiteSpace(readerName) && readerName != "N/A" ? readerName.Substring(0, 1).ToUpper() : "N";
                            var isReturned = item.BorrowStatus == BorrowStatus.Returned;

                            <tr>
                                <!-- Mã phiếu -->
                                <td>
                                    <span class="badge bg-secondary">@item.BorrowCode</span>
                                </td>

                                <!-- Độc giả -->
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold me-2" style="width:36px;height:36px;font-size:14px;">
                                            @avatarLetter
                                        </div>
                                        <div>
                                            <div class="fw-bold text-truncate" style="max-width:150px;" title="@readerName">
                                                @readerName
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Số sách -->
                                <td>
                                    <span class="fw-bold">@item.TotalBooks</span> cuốn
                                </td>

                                <!-- Ngày mượn -->
                                <td>
                                    @item.BorrowDate.ToString("dd/MM/yyyy")
                                </td>

                                <!-- Ngày trả -->
                                <td>
                                    @(item.ReturnDate?.ToString("dd/MM/yyyy") ?? "N/A")
                                </td>

                                <!-- Trạng thái -->
                                <td>
                                    @if (isReturned)
                                    {
                                        <span class="badge bg-success-subtle text-success">
                                            <i class="fa-solid fa-circle-check me-1"></i>Đã trả
                                        </span>
                                    }
                                    else if (item.BorrowStatus == BorrowStatus.CanceledDueToTimeout)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">
                                            <i class="fa-solid fa-circle-xmark me-1"></i>Đã hủy - quá hạn nhận sách
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">
                                            <i class="fa-solid fa-circle-xmark me-1"></i>Đã hủy
                                        </span>
                                    }
                                </td>

                                <!-- Thao tác -->
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm">
                                        <i class="fa-solid fa-eye me-1"></i>Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 14px;
    }
    .card-header {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border);
    }
    .table {
        margin-bottom: 0;
    }
    .table thead th {
        font-weight: 700;
        border-bottom: 2px solid var(--border);
        white-space: nowrap;
    }
    .table tbody td {
        vertical-align: middle;
    }
    .table tbody tr {
        transition: .25s ease;
    }
    .table tbody tr:hover {
        background: #f8fbff;
    }
    .form-control {
        height: 38px;
        border-radius: 8px;
    }
    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: none;
    }
    .btn {
        border-radius: 8px;
    }
    .badge {
        font-weight: 600;
        padding: 6px 10px;
    }
    @@media(max-width:992px) {
        .table {
            min-width: 1000px;
        }
    }
</style>
