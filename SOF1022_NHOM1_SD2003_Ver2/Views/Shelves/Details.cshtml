@model SOF1022_NHOM1_SD2003_Ver2.Models.Shelves

@{
    ViewData["Title"] = "Chi tiết Kệ sách";
}

<div class="container-fluid py-4 px-md-5">
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-light p-3 rounded-circle text-secondary shadow-sm">
                <i class="fas fa-boxes fa-lg"></i>
            </div>
            <div>
                <h4 class="mb-0 text-dark fw-bold">Quản lý Kệ sách</h4>
                <small class="text-muted">Xem chi tiết thông tin kệ sách trong hệ thống thư viện</small>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm bg-white rounded-3 overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 px-4" style="border-left: 4px solid #6c757d !important;">
            <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-eye me-2 text-muted"></i>Chi tiết kệ sách: @Model.Name</h5>
        </div>
        <div class="card-body p-4 bg-light">
            <div class="card border-0 shadow-sm bg-white rounded-3">
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Mã kệ</label>
                            <div class="fw-bold text-dark">@Model.Code</div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Tên kệ</label>
                            <div class="fw-bold text-primary fs-4">@Model.Name</div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Khu vực</label>
                            <div class="text-dark">@Model.Area</div>
                        </div>
                        <div class="col-md-12">
                            <label class="text-muted small fw-semibold">Mô tả</label>
                            <div class="text-muted">@Model.Description</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm bg-white rounded-3 mt-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3"><i class="fas fa-chart-bar me-2 text-success"></i>Sức chứa kệ sách</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Sức chứa tối đa</label>
                            <div class="fw-bold text-dark fs-5">@Model.Capacity cuốn</div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Tổng số sách đang chứa</label>
                            <div class="fw-bold text-primary fs-5">@(ViewBag.TotalQuantity ?? 0) cuốn</div>
                        </div>
                        <div class="col-12">
                            @{
                                int currentCount = ViewBag.TotalQuantity ?? 0;
                                int capacity = Model.Capacity;
                                double percentage = capacity > 0 ? (double)currentCount / capacity * 100 : 0;
                                string progressClass = percentage < 80 ? "bg-success" : (percentage < 100 ? "bg-warning" : "bg-danger");
                            }
                            <div class="d-flex justify-content-between small mb-1">
                                <span>Tỷ lệ sử dụng</span>
                                <span class="fw-semibold">@percentage.ToString("0.0")%</span>
                            </div>
                            <div class="progress" style="height: 20px;">
                                <div class="progress-bar @progressClass" style="width: @percentage%" role="progressbar">
                                    @currentCount / @capacity cuốn
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top d-flex gap-2 justify-content-end">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary btn-lg px-4 fs-6 rounded-2"><i class="fas fa-edit me-2"></i>Chỉnh sửa</a>
                <a asp-action="Index" class="btn btn-light border btn-lg px-4 fs-6 rounded-2 text-secondary"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
            </div>
        </div>
    </div>
</div>
