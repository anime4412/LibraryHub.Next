@model SOF1022_NHOM1_SD2003_Ver2.Models.Shelves

@{
    ViewData["Title"] = "Thêm Kệ sách Mới";
}

<div class="container-fluid py-4 px-md-5">
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-light p-3 rounded-circle text-secondary shadow-sm">
                <i class="fas fa-boxes fa-lg"></i>
            </div>
            <div>
                <h4 class="mb-0 text-dark fw-bold">Quản lý Kệ sách</h4>
                <small class="text-muted">Thêm kệ sách mới vào hệ thống thư viện</small>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm bg-white rounded-3 overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 px-4" style="border-left: 4px solid #6c757d !important;">
            <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-plus-circle me-2 text-muted"></i>Biểu mẫu thêm kệ sách mới</h5>
        </div>
        <div class="card-body p-4 bg-light">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="Code" class="form-label fw-semibold text-secondary">Mã kệ</label>
                        <input asp-for="Code" class="form-control form-control-lg border-2 shadow-none rounded-2" placeholder="Nhập mã kệ..." />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-semibold text-secondary">Tên kệ</label>
                        <input asp-for="Name" class="form-control form-control-lg border-2 shadow-none rounded-2" placeholder="Nhập tên kệ..." />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Area" class="form-label fw-semibold text-secondary">Khu vực</label>
                        <input asp-for="Area" class="form-control form-control-lg border-2 shadow-none rounded-2" placeholder="Nhập khu vực..." />
                        <span asp-validation-for="Area" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Description" class="form-label fw-semibold text-secondary">Mô tả</label>
                        <textarea asp-for="Description" class="form-control form-control-lg border-2 shadow-none rounded-2" rows="3" placeholder="Nhập mô tả kệ sách..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Capacity" class="form-label fw-semibold text-secondary">Sức chứa tối đa</label>
                        <input asp-for="Capacity" class="form-control form-control-lg border-2 shadow-none rounded-2" type="number" min="1" max="5000" placeholder="Nhập sức chứa tối đa..." />
                        <span asp-validation-for="Capacity" class="text-danger small"></span>
                        <small class="text-muted">Số lượng sách tối đa có thể đặt trên kệ này (từ 1 - 5,000 cuốn)</small>
                    </div>
                </div>

                <div class="mt-5 pt-3 border-top d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-light border btn-lg px-4 fs-6 rounded-2 text-secondary"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
                    <button type="submit" class="btn btn-secondary btn-lg px-5 fs-6 rounded-2 shadow-sm"><i class="fas fa-save me-2"></i>Lưu dữ liệu</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
